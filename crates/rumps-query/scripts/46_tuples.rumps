; Tuple literals and access

; Basic tuple construction
LET pair = (1, "hello")
OUTPUT pair.0
OUTPUT pair.1

; Triple
LET triple = (true, 42, "world")
OUTPUT triple.0
OUTPUT triple.1
OUTPUT triple.2

; Nested tuples
LET nested = ((1, 2), (3, 4))
LET inner1 = nested.0
LET inner2 = nested.1
OUTPUT inner1.0
OUTPUT inner1.1
OUTPUT inner2.0
OUTPUT inner2.1

; Empty tuple (unit)
LET unit = ()
OUTPUT unit

; Single-element tuple (trailing comma required)
LET single = (42,)
OUTPUT single.0

; Tuple in expression
LET first = (1, 2).0
LET second = (1, 2).1
LET sum = first + second
OUTPUT sum

; Tuple with function results
LET expr_tuple = (1 + 2, 3 * 4, "test")
OUTPUT expr_tuple.0
OUTPUT expr_tuple.1
OUTPUT expr_tuple.2

; Tuple truthiness (non-empty is truthy)
IF pair {
  OUTPUT "pair is truthy"
}

; Tuple passed to closure
LET get_first = t => t.0
LET get_second = t => t.1
OUTPUT get_first((10, 20))
OUTPUT get_second((10, 20))
