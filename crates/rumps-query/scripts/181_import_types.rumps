; Import types tests
;
; Tests that import M.{ MyType } brings type names into scope for use
; in type annotations (let bindings).

; All imports at top
import Shapes.{ Circle }
import Shapes.{ }  ; brings `Display` class instance into scope
import Units.{ Meters, Feet }
import Payload.{ Data }
import Geometry.{ Shape as S }
import Colors.{ ... }
import Multi.{ A, B, C }
import Generic.{ Box }

fun main() {
  ; ============ Named import of type ============

  ; Use imported type name in annotation
  let c1: Circle = Shapes.Circle.Circle(1.5)
  write Display:display(c1)

  ; ============ Named import of newtype ============

  ; Use imported newtype in annotations
  let dist: Meters = 5.0
  let converted: Feet = Units.to-feet(dist)
  write converted

  ; ============ Named import of union ============

  ; Use imported union in annotation
  let d1: Data = 42
  let d2: Data = "hello"
  write d1
  write d2

  ; ============ Aliased import ============

  ; Use alias in annotation
  let shape: S = Geometry.Shape.Rect(10.0, 20.0)
  write shape

  ; ============ Wildcard import brings types ============

  ; Types from wildcard import
  let rgb: RGB = (255, 128, 0)
  let color: Color = Colors.Color.Custom(rgb)
  write color

  ; ============ Multiple types from same module ============

  let a: A = 1
  let b: B = "two"
  let c: C = true
  write a
  write b
  write c

  ; ============ Import parameterized type ============

  ; Use imported parameterized type
  let box1: Box[Int] = Generic.Box.Full(42)
  let box2: Box[String] = Generic.Box.Empty
  write box1
  write box2
}

module Shapes {
  +type Circle = Circle(Float)

  class Display for Circle {
    fun display(c: Circle) -> String {
      match c {
        Circle.Circle(r) => { "Circle(r={r})" }
      }
    }
  }
}

module Units {
  +newtype Meters = Float
  +newtype Feet = Float

  +fun to-feet(m: Meters) -> Feet {
    m * 3.28084
  }
}

module Payload {
  +union Data = Int | String
}

module Geometry {
  +type Shape = Rect(Float, Float) | Circle(Float)
}

module Colors {
  +newtype RGB = (Int, Int, Int)
  +type Color = Red | Green | Blue | Custom(RGB)
}

module Multi {
  +newtype A = Int
  +newtype B = String
  +newtype C = Bool
}

module Generic {
  +type Box[T] = Full(T) | Empty
}
