description: "; Test: WRITE statement\n; Tests various WRITE scenarios\n\n; Output literal integer\nWRITE 42\n; Expected: 42\n\n; Output literal float\nWRITE 3.14159\n; Expected: 3.14159\n\n; Output literal string\nWRITE \"Hello, World!\"\n; Expected: Hello, World!\n\n; Output literal boolean\nWRITE TRUE\nWRITE FALSE\n; Expected: true, false\n\n; Output variable\nLET x = 123\nWRITE x\n; Expected: 123\n\n; Output expression result\nWRITE 10 + 20 * 3\n; Expected: 70\n\n; Output string interpolation\nWRITE \"{\"Hello\"} {\"RUMPS\"}\"\n; Expected: Hello RUMPS\n\n; Output comparison result\nWRITE 5 < 10\n; Expected: true\n\n; Output logical result\nWRITE TRUE AND FALSE\n; Expected: false\n\nWRITE NOT FALSE\n; Expected: true\n\n; Output from block result\nLET result = {\n  LET a = 5\n  LET b = 10\n  a + b\n}\nWRITE result\n; Expected: 15\n\n; Multiple outputs in sequence\nWRITE \"Line 1\"\nWRITE \"Line 2\"\nWRITE \"Line 3\"\n\nWRITE \"WRITE test complete\"\n"
