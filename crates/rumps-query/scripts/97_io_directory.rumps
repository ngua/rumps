; Io.Directory module primitives
; Tests file system operations
;
; NOTE: Uses a unique temp directory under /tmp that is cleaned up at the end

fun main() {
  ; ============ Setup: create temp directory ============

  ; Generate unique directory name using Random.uuid
  let test-uuid = Random.uuid()
  let test-dir-path = "/tmp/rumps-test-{test-uuid}"
  let test-dir = test-dir-path as FilePath

  ; Create the test directory
  let _ = Io.Directory.create-dir(test-dir)

  ; ============ FilePath coercion ============

  ; Create FilePath via as cast
  let p1 = "/tmp/rumps-test" as FilePath
  write p1 is FilePath  ; true

  ; ============ pwd ============

  ; Get current working directory
  let cwd = Io.Directory.pwd()
  write cwd is FilePath  ; true

  ; ============ exists / is-file / is-dir ============

  ; Check if test directory exists and is a directory
  let dir-exists = Io.Directory.exists(test-dir)
  write dir-exists  ; true

  let dir-is-dir = Io.Directory.is-dir(test-dir)
  write dir-is-dir  ; true

  let dir-is-file = Io.Directory.is-file(test-dir)
  write dir-is-file  ; false

  ; Check non-existent path
  let fake = "/nonexistent/path/xyz123" as FilePath
  let fake-exists = Io.Directory.exists(fake)
  write fake-exists  ; false

  ; ============ get-env ============

  ; PATH environment variable should exist on most systems
  let path-env = Io.Directory.get-env("PATH")
  write path-env is Option[String]  ; true

  ; Non-existent env var
  let no-such-var = Io.Directory.get-env("RUMPS_NONEXISTENT_VAR_12345")
  write :display(no-such-var)  ; Option.None

  ; ============ write-file / read-file ============

  ; Write a file to our temp directory
  let test-file-path = "{test-dir-path}/test-file.txt"
  let test-file = test-file-path as FilePath
  let test-contents = "Hello, RUMPS!"

  let _ = Io.Directory.write-file({ path: test-file, contents: test-contents })

  ; Verify the file exists
  let file-exists = Io.Directory.exists(test-file)
  write file-exists  ; true

  let file-is-file = Io.Directory.is-file(test-file)
  write file-is-file  ; true

  ; Read the file back
  let read-contents = Io.Directory.read-file(test-file)
  write read-contents  ; Hello, RUMPS!

  ; ============ append-file ============

  ; Append to the file
  let append-str = "\nAppended line"
  let _ = Io.Directory.append-file({ path: test-file, contents: append-str })

  ; Read the updated file
  let appended-contents = Io.Directory.read-file(test-file)
  write appended-contents  ; Hello, RUMPS!\nAppended line

  ; ============ create-dir / create-dir-all ============

  ; Create a single directory
  let subdir-path = "{test-dir-path}/subdir"
  let subdir = subdir-path as FilePath
  let _ = Io.Directory.create-dir(subdir)

  let subdir-exists = Io.Directory.exists(subdir)
  write subdir-exists  ; true

  ; Create nested directories
  let nested-path = "{test-dir-path}/a/b/c"
  let nested = nested-path as FilePath
  let _ = Io.Directory.create-dir-all(nested)

  let nested-exists = Io.Directory.exists(nested)
  write nested-exists  ; true

  ; ============ list-dir ============

  ; List contents of test directory (should have at least test-file.txt and subdir)
  let entries = Io.Directory.list-dir(test-dir)
  write entries is Array[Path]  ; true

  ; Each entry is a Path (File or Dir)
  let first = Array.head(entries)
  write first is Option[Path]  ; true

  ; Should have multiple entries
  let entry-count = Iterable:length(entries)
  write entry-count >= 2  ; true (at least test-file.txt and subdir)

  ; ============ copy-path ============

  ; Copy the test file
  let copy-dest-path = "{test-dir-path}/test-file-copy.txt"
  let copy-dest = copy-dest-path as FilePath
  let _ = Io.Directory.copy-path({ src: test-file, dest: copy-dest })

  let copy-exists = Io.Directory.exists(copy-dest)
  write copy-exists  ; true

  ; Verify contents are the same
  let copy-contents = Io.Directory.read-file(copy-dest)
  write copy-contents == appended-contents  ; true

  ; ============ move-path ============

  ; Move (rename) the copy
  let move-dest-path = "{test-dir-path}/test-file-moved.txt"
  let move-dest = move-dest-path as FilePath
  let _ = Io.Directory.move-path({ src: copy-dest, dest: move-dest })

  ; Original should not exist
  let old-exists = Io.Directory.exists(copy-dest)
  write old-exists  ; false

  ; New location should exist
  let new-exists = Io.Directory.exists(move-dest)
  write new-exists  ; true

  ; ============ remove ============

  ; Remove the moved file
  let _ = Io.Directory.remove(move-dest)

  let removed-exists = Io.Directory.exists(move-dest)
  write removed-exists  ; false

  ; ============ set-pwd ============

  ; Save current directory, change to temp dir, then restore
  let orig-cwd = Io.Directory.pwd()
  let _ = Io.Directory.set-pwd(test-dir)

  let new-cwd = Io.Directory.pwd()
  ; The new cwd should end with our test dir name
  write Io.Directory.is-dir(new-cwd)  ; true

  ; Restore original cwd
  let _ = Io.Directory.set-pwd(orig-cwd)

  ; ============ set-env ============

  ; Set an environment variable
  let _ = Io.Directory.set-env({ name: "RUMPS_TEST_VAR", value: "test-value-123" })

  ; Read it back
  let env-val = Io.Directory.get-env("RUMPS_TEST_VAR")
  write :display(env-val)  ; Option.Some("test-value-123")

  ; ============ Path as FilePath ============

  ; Path.File can be cast to FilePath
  let file-path = Path.File(test-file) as FilePath
  write file-path is FilePath  ; true

  ; Path.Dir can be cast to FilePath
  let dir-path = Path.Dir(test-dir) as FilePath
  write dir-path is FilePath  ; true

  ; ============ canonicalize ============

  ; Canonicalize the test directory
  let canonical = Io.Directory.canonicalize(test-dir)
  write canonical is FilePath  ; true
  write Io.Directory.exists(canonical)  ; true

  ; ============ parent ============

  ; Get parent of test file
  let file-parent = Io.Directory.parent(test-file)
  write file-parent is Option[FilePath]  ; true

  ; The parent should exist (use unwrap-or to get the value)
  let parent-fp = Option.unwrap-or(file-parent, "/" as FilePath)
  write Io.Directory.exists(parent-fp)  ; true

  ; Root has no parent (or returns empty)
  let root-parent = Io.Directory.parent("/" as FilePath)
  write :display(root-parent)  ; Option.None

  ; ============ file-name ============

  ; Get file name of test file
  let fname = Io.Directory.file-name(test-file)
  write :display(fname)  ; Option.Some("test-file.txt")

  ; Get file name of directory
  let dname = Io.Directory.file-name(test-dir)
  write dname is Option[String]  ; true

  ; ============ extension ============

  ; Get extension of test file
  let ext = Io.Directory.extension(test-file)
  write :display(ext)  ; Option.Some("txt")

  ; Get extension of file without extension
  let no-ext-path = "{test-dir-path}/noext"
  let no-ext-file = no-ext-path as FilePath
  let _ = Io.Directory.write-file({ path: no-ext-file, contents: "no extension" })
  let no-ext = Io.Directory.extension(no-ext-file)
  write :display(no-ext)  ; Option.None

  ; ============ with-extension ============

  ; Change extension
  let new-ext = Io.Directory.with-extension(test-file, "md")
  write :display(Io.Directory.extension(new-ext))  ; Option.Some("md")

  ; Add extension
  let added-ext = Io.Directory.with-extension(no-ext-file, "json")
  write :display(Io.Directory.extension(added-ext))  ; Option.Some("json")

  ; ============ join ============

  ; Join path components
  let joined = Io.Directory.join(test-dir, ["foo", "bar", "baz.txt"])
  write joined is FilePath  ; true
  write :display(Io.Directory.file-name(joined))  ; Option.Some("baz.txt")

  ; ============ temp-dir ============

  ; Get system temp directory
  let tmp = Io.Directory.temp-dir()
  write tmp is FilePath  ; true
  write Io.Directory.is-dir(tmp)  ; true

  ; ============ Cleanup: remove-all ============

  ; Clean up the entire test directory
  let _ = Io.Directory.remove-all(test-dir)

  let cleanup-exists = Io.Directory.exists(test-dir)
  write cleanup-exists  ; false

  write "All Io.Directory tests passed"
}
