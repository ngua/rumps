; Option and Result module primitives
; Tests Option.unwrap-or, Option.map, Result.unwrap-or, Result.map, Result.map-err

fun safe-div(n, d) {
  if d == 0 { Option.None } else { Option.Some(n // d) }
}

fun parse-positive(x) {
  if x > 0 { Option.Some(x) } else { Option.None }
}

fun halve(x) {
  if x % 2 == 0 { Option.Some(x // 2) } else { Option.None }
}

fun safe-div-res(n, d) {
  if d == 0 { Result.Err("div by zero") } else { Result.Ok(n // d) }
}

fun validate(x) {
  if x >= 0 { Result.Ok(x) } else { Result.Err("negative") }
}

fun halve-res(x) {
  if x % 2 == 0 { Result.Ok(x // 2) } else { Result.Err("odd") }
}

fun try-parse(s) {
  if s == "42" { Result.Ok(42) } else { Result.Err("parse failed") }
}

fun main() {
  ; ============ Option.unwrap-or ============

  let some-val = Option.Some(42)
  let none-val = Option.None

  write Option.unwrap-or(some-val, 0)  ; 42
  write Option.unwrap-or(none-val, 0)  ; 0
  write Option.unwrap-or(Option.Some("hello"), "default")  ; "hello"
  write Option.unwrap-or(Option.None, "default")  ; "default"

  ; ============ Option.map ============

  let double = x => x * 2
  let to-upper = s => String.upper(s)

  write Option.map(Option.Some(21), double)  ; Some(42)
  write Option.map(Option.None, double)  ; None
  write Option.map(Option.Some("hello"), to-upper)  ; Some("HELLO")
  write Option.map(Option.None, to-upper)  ; None

  ; Inline closure
  write Option.map(Option.Some(5), x => x + 1)  ; Some(6)

  ; Chaining map
  let opt = Option.Some(10)
  let mapped = Option.map(opt, x => x * 2)
  write mapped  ; Some(20)
  write Option.map(mapped, x => x + 5)  ; Some(25)

  ; ============ Result.unwrap-or ============

  let ok-val = Result.Ok(100)
  let err-val = Result.Err("something went wrong")

  write Result.unwrap-or(ok-val, 0)  ; 100
  write Result.unwrap-or(err-val, 0)  ; 0
  write Result.unwrap-or(Result.Ok("success"), "fallback")  ; "success"
  write Result.unwrap-or(Result.Err("fail"), "fallback")  ; "fallback"

  ; ============ Result.map ============

  write Result.map(Result.Ok(21), double)  ; Ok(42)
  write Result.map(Result.Err("err"), double)  ; Err("err")
  write Result.map(Result.Ok("hello"), to-upper)  ; Ok("HELLO")
  write Result.map(Result.Err("err"), to-upper)  ; Err("err")

  ; Inline closure
  write Result.map(Result.Ok(5), x => x + 1)  ; Ok(6)

  ; ============ Result.map-err ============

  let add-prefix = e => "Error: {e}"

  write Result.map-err(Result.Err("failed"), add-prefix)  ; Err("Error: failed")
  write Result.map-err(Result.Ok(42), add-prefix)  ; Ok(42)
  write Result.map-err(Result.Err("oops"), e => String.upper(e))  ; Err("OOPS")
  write Result.map-err(Result.Ok("ok"), e => String.upper(e))  ; Ok("ok")

  ; ============ Combining operations ============

  ; Option.map then unwrap-or
  let maybe-num = Option.Some(10)
  let doubled-or-zero = Option.unwrap-or(Option.map(maybe-num, x => x * 2), 0)
  write doubled-or-zero  ; 20

  let no-num = Option.None
  let doubled-or-zero-none = Option.unwrap-or(Option.map(no-num, x => x * 2), 0)
  write doubled-or-zero-none  ; 0

  ; Result.map then unwrap-or
  let res-ok = Result.Ok(5)
  let res-mapped = Result.unwrap-or(Result.map(res-ok, x => x * 3), 0)
  write res-mapped  ; 15

  let res-err = Result.Err("bad")
  let res-err-mapped = Result.unwrap-or(Result.map(res-err, x => x * 3), 0)
  write res-err-mapped  ; 0

  ; ============ Type variants still work ============

  ; Ensure Option.None and Result.Ok etc. still work as type constructors
  let opt-none = Option.None
  let opt-some = Option.Some(1)
  write opt-none is Option.None  ; true
  write opt-some is Option.Some(_)  ; true

  let res-ok-check = Result.Ok(1)
  let res-err-check = Result.Err("x")
  write res-ok-check is Result.Ok(_)  ; true
  write res-err-check is Result.Err(_)  ; true

  ; ============ Chainable:chain (Option) ============

  ; Returns the inner Option when Some
  write Chainable:chain(Option.Some(10), x => safe-div(x, 2))  ; Some(5)
  write Chainable:chain(Option.Some(10), x => safe-div(x, 0))  ; None
  write Chainable:chain(Option.None, x => safe-div(x, 2))  ; None

  ; Chaining chain
  write Chainable:chain(Chainable:chain(Option.Some(8), parse-positive), halve)  ; Some(4)
  write Chainable:chain(Chainable:chain(Option.Some(-1), parse-positive), halve)  ; None
  write Chainable:chain(Chainable:chain(Option.Some(7), parse-positive), halve)  ; None (7 is odd)

  ; ============ Chainable:chain (Result) ============

  ; Returns the inner Result when Ok
  write Chainable:chain(Result.Ok(10), x => safe-div-res(x, 2))  ; Ok(5)
  write Chainable:chain(Result.Ok(10), x => safe-div-res(x, 0))  ; Err("div by zero")
  write Chainable:chain(Result.Err("bad input"), x => safe-div-res(x, 2))  ; Err("bad input")

  ; Chaining chain
  write Chainable:chain(Chainable:chain(Result.Ok(8), validate), halve-res)  ; Ok(4)
  write Chainable:chain(Chainable:chain(Result.Ok(-1), validate), halve-res)  ; Err("negative")
  write Chainable:chain(Chainable:chain(Result.Ok(7), validate), halve-res)  ; Err("odd")

  ; ============ Option.flatten ============

  ; Some(Some(v)) -> Some(v)
  write Option.flatten(Option.Some(Option.Some(42)))  ; Some(42)
  write Option.flatten(Option.Some(Option.Some("hello")))  ; Some("hello")

  ; Some(None) -> None
  write Option.flatten(Option.Some(Option.None))  ; None

  ; None -> None
  write Option.flatten(Option.None)  ; None

  ; Practical: flatten after map that returns Option
  let maybe-find = arr => Array.head(arr)
  let nested = Option.map(Option.Some([1, 2, 3]), maybe-find)
  write nested  ; Some(Some(1))
  write Option.flatten(nested)  ; Some(1)

  let empty-nested = Option.map(Option.Some([]), maybe-find)
  write empty-nested  ; Some(None)
  write Option.flatten(empty-nested)  ; None

  ; ============ Result.flatten ============

  ; Ok(Ok(v)) -> Ok(v)
  write Result.flatten(Result.Ok(Result.Ok(42)))  ; Ok(42)
  write Result.flatten(Result.Ok(Result.Ok("success")))  ; Ok("success")

  ; Ok(Err(e)) -> Err(e)
  write Result.flatten(Result.Ok(Result.Err("inner error")))  ; Err("inner error")

  ; Err(e) -> Err(e)
  write Result.flatten(Result.Err("outer error"))  ; Err("outer error")

  ; Practical: flatten after map that returns Result
  let nested-res = Result.map(Result.Ok("42"), try-parse)
  write nested-res  ; Ok(Ok(42))
  write Result.flatten(nested-res)  ; Ok(42)

  let nested-err = Result.map(Result.Ok("bad"), try-parse)
  write nested-err  ; Ok(Err("parse failed"))
  write Result.flatten(nested-err)  ; Err("parse failed")

  ; ============ Result.hush ============

  ; Ok(v) -> Some(v)
  write Result.hush(Result.Ok(42))  ; Some(42)
  write Result.hush(Result.Ok("hello"))  ; Some("hello")

  ; Err(e) -> None (discards error)
  write Result.hush(Result.Err("oops"))  ; None
  write Result.hush(Result.Err(123))  ; None

  ; Practical: convert fallible operation to optional
  let res: Result[Int, String] = Result.Ok(100)
  let opt2 = Result.hush(res)
  write opt2  ; Some(100)

  let bad-res: Result[Int, String] = Result.Err("failed")
  write Result.hush(bad-res)  ; None

  ; ============ Option.note ============

  ; Some(v) -> Ok(v)
  write Option.note("not found", Option.Some(42))  ; Ok(42)
  write Option.note("missing", Option.Some("hello"))  ; Ok("hello")

  ; None -> Err(e) (using provided error)
  write Option.note("not found", Option.None)  ; Err("not found")
  write Option.note(404, Option.None)  ; Err(404)

  ; Practical: convert optional lookup to result
  let maybe: Option[Int] = Option.Some(999)
  let noted: Result[Int, String] = Option.note("value missing", maybe)
  write noted  ; Ok(999)

  let empty: Option[Int] = Option.None
  write Option.note("value missing", empty)  ; Err("value missing")

  ; ============ hush/note roundtrips ============

  ; Ok -> hush -> note (preserves value)
  let start = Result.Ok(123)
  let hushed = Result.hush(start)
  let back: Result[Int, String] = Option.note("lost", hushed)
  write back  ; Ok(123)

  ; Some -> note -> hush (preserves value)
  let s = Option.Some(456)
  let noted2: Result[Int, String] = Option.note("err", s)
  let h = Result.hush(noted2)
  write h  ; Some(456)

  ; Err -> hush loses information
  let e = Result.Err("important error")
  let lost = Result.hush(e)
  write lost  ; None

  ; None -> note adds error
  let n = Option.None
  let gained: Result[Int, String] = Option.note("added error", n)
  write gained  ; Err("added error")
}
