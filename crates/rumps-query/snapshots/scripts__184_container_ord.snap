source: crates/rumps-query/tests/scripts.rs
description: "; Test: Ord instances for container types\n; Arrays, tuples, Options, and Results should be comparable when elements are Ord\n\nfun main() {\n  ; === Array comparisons (lexicographic) ===\n\n  write [1, 2, 3] < [1, 2, 4]\n  ; Expected: true (element-wise, `3 < 4`)\n\n  write [1, 2, 3] < [1, 2, 3]\n  ; Expected: false (equal)\n\n  write [1, 2, 3] > [1, 2, 2]\n  ; Expected: true\n\n  write [1, 2] < [1, 2, 3]\n  ; Expected: true (shorter prefix)\n\n  write [1, 2, 3] < [1, 2]\n  ; Expected: false (longer)\n\n  write [\"a\", \"b\"] < [\"a\", \"c\"]\n  ; Expected: true\n\n  write [true, false] < [true, true]\n  ; Expected: true (`false < true`)\n\n  ; === Tuple comparisons (lexicographic) ===\n\n  write (1, 2) < (1, 3)\n  ; Expected: true\n\n  write (1, 2) < (2, 0)\n  ; Expected: true (first element decides)\n\n  write (\"a\", 1) < (\"a\", 2)\n  ; Expected: true\n\n  write (\"a\", 1) < (\"b\", 0)\n  ; Expected: true (first element decides)\n\n  ; === Option comparisons (None < Some) ===\n\n  let none: Option[Int] = Option.None\n  let some1 = Option.Some(1)\n  let some2 = Option.Some(2)\n\n  write none < some1\n  ; Expected: true (`None < Some`)\n\n  write some1 < some2\n  ; Expected: true (`1 < 2`)\n\n  write some2 < some1\n  ; Expected: false\n\n  write none < none\n  ; Expected: false (equal)\n\n  ; === Result comparisons (Err < Ok) ===\n\n  let err1: Result[Int, String] = Result.Err(\"a\")\n  let err2: Result[Int, String] = Result.Err(\"b\")\n  let ok1: Result[Int, String] = Result.Ok(1)\n  let ok2: Result[Int, String] = Result.Ok(2)\n\n  write err1 < ok1\n  ; Expected: true (`Err < Ok`)\n\n  write err1 < err2\n  ; Expected: true (`\"a\" < \"b\"`)\n\n  write ok1 < ok2\n  ; Expected: true (`1 < 2`)\n\n  write ok2 < err1\n  ; Expected: false (`Ok > Err`)\n\n  ; === Ordering comparisons (Lt < Eq < Gt) ===\n\n  write Ordering.Lt < Ordering.Eq\n  ; Expected: true\n\n  write Ordering.Eq < Ordering.Gt\n  ; Expected: true\n\n  write Ordering.Lt < Ordering.Gt\n  ; Expected: true\n\n  write Ordering.Gt < Ordering.Lt\n  ; Expected: false\n\n  write Ordering.Eq <= Ordering.Eq\n  ; Expected: true\n\n  ; === Map comparisons (sorted by key, then lexicographic) ===\n\n  let m1 = Map.from-entries([(\"a\", 1), (\"b\", 2)])\n  let m2 = Map.from-entries([(\"a\", 1), (\"b\", 3)])\n  let m3 = Map.from-entries([(\"a\", 1), (\"c\", 2)])\n\n  write m1 < m2\n  ; Expected: true (same keys, `2 < 3`)\n\n  write m1 < m3\n  ; Expected: true (`\"b\" < \"c\"`)\n\n  ; Maps with same entries in different insertion order should be equal\n  let m4 = Map.from-entries([(\"b\", 2), (\"a\", 1)])\n  write m1 <= m4\n  ; Expected: true (equal after sorting by key)\n\n  write m1 >= m4\n  ; Expected: true (equal after sorting by key)\n\n  ; Map operators use async tree semantics.\n  write m1 == m4\n  ; Expected: true\n\n  write m1 != m4\n  ; Expected: false\n\n  write m1 < m2\n  ; Expected: true\n\n  write m1 < m3\n  ; Expected: true\n\n  write Ord:compare(m1, m4) == Ordering.Eq\n  ; Expected: true\n\n  write Eq:eq(m1, m4)\n  ; Expected: true\n\n  let merged = Concatable:concat(m1, Map.from-entries([(\"b\", 4)]))\n  write merged[\"b\"]\n  ; Expected: 4\n\n  ; === Time comparisons ===\n\n  let epoch = Time.epoch()\n  let t1 = Time.add-seconds(epoch, 1000)\n  let t2 = Time.add-seconds(epoch, 2000)\n\n  write t1 < t2\n  ; Expected: true\n\n  write t2 > t1\n  ; Expected: true\n\n  write t1 < t1\n  ; Expected: false (equal)\n\n  ; === Nested containers ===\n\n  write [[1, 2], [3, 4]] < [[1, 2], [3, 5]]\n  ; Expected: true\n\n  write [(1, \"a\"), (2, \"b\")] < [(1, \"a\"), (2, \"c\")]\n  ; Expected: true\n\n  write \"Container Ord test complete\"\n}\n"
