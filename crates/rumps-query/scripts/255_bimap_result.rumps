; Bimappable:bimap on Result; Ok invokes f, Err invokes g

fun main() {
  ; bimap on Ok (only f called)
  let ok: Result[Int, String] = Result.Ok(42)
  write :display(Bimappable:bimap(x => x + 1, s => "{s}!", ok))

  ; bimap on Err (only g called)
  let err: Result[Int, String] = Result.Err("oops")
  write :display(Bimappable:bimap(x => x + 1, s => "{s}!", err))

  ; type-changing bimap
  let r: Result[Int, Int] = Result.Ok(5)
  write :display(Bimappable:bimap(x => "{x}", x => x > 0, r))

  let r2: Result[Int, Int] = Result.Err(0)
  write :display(Bimappable:bimap(x => "{x}", x => x > 0, r2))

  ; partial application
  let bm = Bimappable:bimap(x => x * 2, s => String.upper(s))
  write :display(bm(Result.Ok(10)))
  write :display(bm(Result.Err("hello")))
}
