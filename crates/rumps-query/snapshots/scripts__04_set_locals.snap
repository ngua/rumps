description: "; Test: $SET locals (B-tree variables)\n; Tests $SET for local variables with subscripts\n\n; Simple $SET without subscripts\n$SET x = 100\n$OUTPUT $GET x\n; Expected: 100\n\n$SET x = 200\n$OUTPUT $GET x\n; Expected: 200\n\n; $SET with single subscript\n$SET items(1) = \"first\"\n$SET items(2) = \"second\"\n$SET items(3) = \"third\"\n\n; $SET with multiple subscripts\n$SET patient(123, \"name\") = \"John Doe\"\n$SET patient(123, \"age\") = 45\n$SET patient(123, \"active\") = TRUE\n\n$SET patient(456, \"name\") = \"Jane Smith\"\n$SET patient(456, \"age\") = 32\n$SET patient(456, \"active\") = FALSE\n\n; Nested subscripts\n$SET tree(1, 2, 3) = \"deep\"\n$SET tree(1, 2, 4) = \"also deep\"\n\n; Mixed subscript types\n$SET mixed(\"key\", 42, TRUE) = \"mixed types\"\n\n; Numeric subscripts\n$SET arr(0) = \"zero\"\n$SET arr(1) = \"one\"\n$SET arr(10) = \"ten\"\n$SET arr(100) = \"hundred\"\n\n; String subscripts\n$SET dict(\"alpha\") = 1\n$SET dict(\"beta\") = 2\n$SET dict(\"gamma\") = 3\n\n$OUTPUT \"$SET locals test complete\"\n"
