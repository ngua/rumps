---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: Pipeline Operator (|>)\n; Tests left-to-right function application\n\n; === Pipeline with named function ===\n\nfun double (x) { x * 2 }\nfun square (x) { x * x }\nfun inc (x) { x + 1 }\n\n; === Pipeline with typed functions ===\n\nfun typed-double (x: Int) -> Int { x * 2 }\nfun typed-inc (x: Int) -> Int { x + 1 }\n\n; === Higher-order with typed parameters ===\n\nfun apply-twice (f, x) {\n  f(f(x))\n}\n\nfun negate (x) { 0 - x }\n\nfun add-10 (x) { x + 10 }\nfun half (x) { x // 2 }\n\nfun add (x, y) { x + y }\nfun mul (a, b, c) { a * b * c }\n\nfun main() {\n  ; === Basic pipeline with closure ===\n\n  write 5 |> (x => x * 2)\n  ; Expected: 10\n\n  write 10 |> (x => x + 5)\n  ; Expected: 15\n\n  write 5 |> double\n  ; Expected: 10\n\n  write 5 |> square\n  ; Expected: 25\n\n  ; === Pipeline chain (left-associative) ===\n\n  write 5 |> double |> square\n  ; Expected: 100 (double(5)=10, square(10)=100)\n\n  write 5 |> square |> double\n  ; Expected: 50 (square(5)=25, double(25)=50)\n\n  write 5 |> inc |> double |> square\n  ; Expected: 144 (inc(5)=6, double(6)=12, square(12)=144)\n\n  ; === Pipeline with inline closures ===\n\n  write 10 |> (x => x + 1) |> (x => x * 2)\n  ; Expected: 22 (10+1=11, 11*2=22)\n\n  write 3 |> (x => x * x) |> (x => x + 1)\n  ; Expected: 10 (3*3=9, 9+1=10)\n\n  ; === Pipeline precedence (lower than all other ops) ===\n\n  write 1 + 2 |> double\n  ; Expected: 6 (1+2=3, double(3)=6)\n\n  write 10 - 4 |> square\n  ; Expected: 36 ((10-4)=6, square(6)=36)\n\n  write 2 * 3 |> inc\n  ; Expected: 7 (2*3=6, inc(6)=7)\n\n  write 5 |> typed-double\n  ; Expected: 10\n\n  write 5 |> typed-double |> typed-inc\n  ; Expected: 11\n\n  ; === Pipeline with closures capturing variables ===\n\n  let factor = 3\n  let scale = x => x * factor\n\n  write 10 |> scale\n  ; Expected: 30\n\n  let offset = 100\n  let shift = x => x + offset\n\n  write 5 |> double |> shift\n  ; Expected: 110 (double(5)=10, shift(10)=110)\n\n  let quad = x => apply-twice(double, x)\n\n  write 3 |> quad\n  ; Expected: 12 (3*2=6, 6*2=12)\n\n  ; === Chained pipelines with various transforms ===\n\n  write 5 |> double |> negate\n  ; Expected: -10\n\n  write 5 |> negate |> double\n  ; Expected: -10\n\n  ; === Complex pipeline expression ===\n\n  write 4 |> square |> add-10 |> half\n  ; Expected: 13 (square(4)=16, add-10(16)=26, half(26)=13)\n\n  ; === Pipeline with `.` placeholder (multi-arg functions) ===\n\n  write 5 |> add(10, .)\n  ; Expected: 15 (add(10, 5)=15)\n\n  write 3 |> add(., 7)\n  ; Expected: 10 (add(3, 7)=10)\n\n  write 2 |> mul(., 3, .)\n  ; Expected: 12 (mul(2, 3, 2)=12)\n\n  ; === Chained pipelines with `.` placeholder ===\n\n  write 1 |> add(., 2) |> mul(., 3, 4)\n  ; Expected: 36 (add(1, 2)=3, mul(3, 3, 4)=36)\n\n  ; === Pipeline placeholder with built-in functions ===\n\n  let arr = [1, 2, 3, 4, 5]\n  write :display(arr |> Array.slice(., 1, 3))\n  ; Expected: [2, 3]\n\n  write \"Pipeline test complete\"\n}\n"
