description: "; Test: logical operators\n; Tests and, or, not with both keyword and symbol forms\n\nfun main() {\n  ; and operator (keyword)\n  write true and true\n  ; Expected: true\n\n  write true and false\n  ; Expected: false\n\n  write false and true\n  ; Expected: false\n\n  write false and false\n  ; Expected: false\n\n  ; and operator (symbol)\n  write true && true\n  ; Expected: true\n\n  write true && false\n  ; Expected: false\n\n  ; or operator (keyword)\n  write true or true\n  ; Expected: true\n\n  write true or false\n  ; Expected: true\n\n  write false or true\n  ; Expected: true\n\n  write false or false\n  ; Expected: false\n\n  ; or operator (symbol)\n  write true || false\n  ; Expected: true\n\n  write false || false\n  ; Expected: false\n\n  ; not operator (keyword)\n  write not true\n  ; Expected: false\n\n  write not false\n  ; Expected: true\n\n  ; not operator (symbol)\n  write !true\n  ; Expected: false\n\n  write !false\n  ; Expected: true\n\n  ; Precedence: not before and before or\n  write not false and true\n  ; Expected: true (not binds tighter)\n\n  write true or false and false\n  ; Expected: true (and binds tighter than or)\n\n  write false or true and true\n  ; Expected: true\n\n  ; Parentheses override precedence\n  write (true or false) and false\n  ; Expected: false\n\n  write not (true and false)\n  ; Expected: true\n\n  ; Complex expressions\n  write (true and false) or (false or true)\n  ; Expected: true\n\n  write not (false or false)\n  ; Expected: true\n\n  write (not false) and (not false)\n  ; Expected: true\n\n  ; With variables\n  let a = true\n  let b = false\n  write a and not b\n  ; Expected: true\n\n  write not a or b\n  ; Expected: false\n\n  write (a or b) and (not b)\n  ; Expected: true\n\n  write \"Logical operators test complete\"\n}\n"
