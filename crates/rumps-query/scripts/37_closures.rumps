; Test: Closures
; Tests closure definition, binding, and display

; === Single parameter closure ===

LET double = x => x * 2
WRITE double
; Expected: <closure(1)>

LET identity = x => x
WRITE identity
; Expected: <closure(1)>

; === Multi-parameter closure ===

LET add = (a, b) => a + b
WRITE add
; Expected: <closure(2)>

LET triple = (a, b, c) => a + b + c
WRITE triple
; Expected: <closure(3)>

; === Nullary closure ===

LET const = () => 42
WRITE const
; Expected: <closure(0)>

; === Typed parameter closure ===

LET typed = (x: Int) => x + 1
WRITE typed
; Expected: <closure(1)>

LET multi-typed = (x: Int, y: String) => y
WRITE multi-typed
; Expected: <closure(2)>

; === Closure with return type ===

LET with-ret = (x: Int) -> Int => x * x
WRITE with-ret
; Expected: <closure(1)>

; === Nested closure in expression ===

LET nested = (x => x + 1)
WRITE nested
; Expected: <closure(1)>

; === Closure with complex body ===

LET complex = (a, b) => { a * b + 1 }
WRITE complex
; Expected: <closure(2)>

WRITE "Closure test complete"
