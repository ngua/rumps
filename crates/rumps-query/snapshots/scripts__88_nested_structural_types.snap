---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: Nested structural types in various contexts\n; Verifies that anonymous records with nested fields work everywhere\n\nnewtype Inner = { value: Int }\nnewtype Outer = { child: Inner }\n\nfun get-inner(obj: { inner: { val: Int } }) -> Int {\n  obj.inner.val\n}\n\nfun get-deep(obj: { a: { b: { c: String } } }) -> String {\n  obj.a.b.c\n}\n\nfun make-nested(x: Int) -> { outer: { inner: Int } } {\n  { outer: { inner: x } }\n}\n\nfun main() {\n  ; ============================================================\n  ; NESTED STRUCTURAL variantS IN let BINDINGS\n  ; ============================================================\n\n  let simple: { a: Int } = { a: 1 }\n  write simple.a\n  ; Expected: 1\n\n  let nested: { a: { b: Int } } = { a: { b: 10 } }\n  write nested.a.b\n  ; Expected: 10\n\n  let deep: { x: { y: { z: String } } } = { x: { y: { z: \"hello\" } } }\n  write deep.x.y.z\n  ; Expected: hello\n\n  let multi: { a: { b: Int }, c: { d: String } } = { a: { b: 1 }, c: { d: \"two\" } }\n  write multi.a.b\n  ; Expected: 1\n  write multi.c.d\n  ; Expected: two\n\n  ; ============================================================\n  ; NESTED STRUCTURAL variantS IN is PATTERNS\n  ; ============================================================\n\n  write { a: 1 } is { a: Int }\n  ; Expected: true\n\n  write { a: { b: 1 } } is { a: { b: Int } }\n  ; Expected: true\n\n  write { a: { b: { c: 1 } } } is { a: { b: { c: Int } } }\n  ; Expected: true\n\n  ; Wrong inner type\n  write { a: { b: \"hello\" } } is { a: { b: Int } }\n  ; Expected: false\n\n  ; Missing inner field\n  write { a: { c: 1 } } is { a: { b: Int } }\n  ; Expected: false\n\n  ; Extra fields are OK (extensible records)\n  write { a: { b: 1, c: 2 } } is { a: { b: Int } }\n  ; Expected: true\n\n  ; ============================================================\n  ; MIXED NESTED variantS\n  ; ============================================================\n\n  let mixed: { arr: Array[Int], nested: { x: Int } } = { arr: [1, 2, 3], nested: { x: 42 } }\n  write mixed.arr is Array[_]\n  ; Expected: true\n  write mixed.nested.x\n  ; Expected: 42\n\n  ; ============================================================\n  ; NESTED STRUCTURAL variantS with OPTION\n  ; ============================================================\n\n  let opt: Option[{ a: { b: Int } }] = Option.Some({ a: { b: 99 } })\n  write opt is Option.Some(_)\n  ; Expected: true\n\n  if opt is Option.Some(val) {\n    write val.a.b\n  }\n  ; Expected: 99\n\n  ; ============================================================\n  ; NESTED IN FUNCTION PARAMETERS\n  ; ============================================================\n\n  write get-inner({ inner: { val: 777 } })\n  ; Expected: 777\n\n  write get-deep({ a: { b: { c: \"deep\" } } })\n  ; Expected: deep\n\n  ; ============================================================\n  ; NESTED IN FUNCTION RETURN variantS\n  ; ============================================================\n\n  let made = make-nested(123)\n  write made.outer.inner\n  ; Expected: 123\n\n  ; ============================================================\n  ; COMBINED with NAMED STRUCT variantS\n  ; ============================================================\n\n  let named: Outer = { child: { value: 42 } }\n  write named.child.value\n  ; Expected: 42\n\n  ; Anonymous nested inside named\n  let hybrid: { wrapper: Inner } = { wrapper: { value: 55 } }\n  write hybrid.wrapper.value\n  ; Expected: 55\n\n  write \"Nested structural types test complete\"\n}\n"
