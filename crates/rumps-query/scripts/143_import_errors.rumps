; Test: IMPORT statement errors
; Tests various error conditions for imports

; Error: Import from non-existent module
IMPORT NonExistent.{ foo }

; Error: Import non-existent member
IMPORT Math.{ nonexistent }

; Error: Import private member from user module
IMPORT Priv.{ internal }

; Error: Exclusion without wildcard
IMPORT Math.{ floor, -ceil }

FUN main() {
  ; Error: Import must appear at top of scope
  {
    LET x = 1
    IMPORT Math.{ abs }
  }
}

; Module must be defined for import to resolve
MODULE Priv {
  LET secret = 42
  FUN internal() -> Int { secret }
  +FUN public() -> Int { 1 }
}
