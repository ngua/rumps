---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: block expressions\n; Tests block syntax with multiple statements and tail expressions\n\nfun main() {\n  ; Simple block with tail expression\n  let x = {\n    let a = 10\n    let b = 20\n    a + b\n  }\n  write x\n  ; Expected: 30\n\n  ; Block with no tail (returns None)\n  let y = {\n    write \"Side effect\"\n  }\n  ; y should be Option.None or unit\n\n  ; Nested blocks\n  let z = {\n    let outer = 5\n    {\n      let inner = 10\n      outer + inner\n    }\n  }\n  write z\n  ; Expected: 15\n\n  ; Block with @set (side effect, no return)\n  {\n    @set counter{} 0\n    @set counter{} 1\n    @set counter{} 2\n  }\n  let c = @get counter{}\n  write c\n  ; Expected: 2\n\n  ; Block scope isolation\n  let val = 100\n  {\n    let val = 200\n    write val\n    ; Expected: 200\n  }\n  write val\n  ; Expected: 100 (outer val unchanged due to let shadowing)\n\n  ; Block with conditional\n  let result = {\n    let score = 75\n    if score >= 70 {\n      \"pass\"\n    } else {\n      \"fail\"\n    }\n  }\n  write result\n  ; Expected: pass\n\n  ; Multiple statements before tail\n  let multi = {\n    let a = 1\n    let b = 2\n    let c = 3\n    write \"Computing...\"\n    a + b + c\n  }\n  write multi\n  ; Expected: Computing... then 6\n\n  write \"Block test complete\"\n}\n"
---
