; Union type tests

; === Builtin unions: Storable and Scalar ===

; Storable contains: Bool | Int | Float | Char | String | Json
; Scalar contains: Bool | Int | Float | String

; IS checks against Storable
LET b: Bool = true
LET i: Int = 42
LET f: Float = 3.14
LET c: Char = 'x'
LET s: String = "hello"

OUTPUT b IS Storable
OUTPUT i IS Storable
OUTPUT f IS Storable
OUTPUT c IS Storable
OUTPUT s IS Storable

; Non-storables
LET arr = [1, 2, 3]
LET obj = { x: 1 }
LET tup = (1, 2)
OUTPUT arr IS Storable
OUTPUT obj IS Storable
OUTPUT tup IS Storable

; IS checks against Scalar
OUTPUT b IS Scalar
OUTPUT i IS Scalar
OUTPUT f IS Scalar
OUTPUT s IS Scalar
OUTPUT c IS Scalar  ; Char is NOT Scalar

; === AS cast for Storable (infallible) ===

LET int-val: Int = 100
LET storable-int = int-val AS Storable
OUTPUT storable-int IS Storable
OUTPUT storable-int IS Int

LET str-val: String = "test"
LET storable-str = str-val AS Storable
OUTPUT storable-str IS Storable
OUTPUT storable-str IS String

; === User-defined unions ===

UNION NumericId = Int | String

LET id1: Int = 123
LET id2: String = "abc-456"

OUTPUT id1 IS NumericId
OUTPUT id2 IS NumericId

; Non-member
LET not-id: Float = 1.5
OUTPUT not-id IS NumericId

; === Union type in function signatures ===

FUN format-id(id: NumericId) -> String {
  MATCH id {
    n IS Int => { "ID#" ++ (n AS String) }
    s IS String => { "ID:" ++ s }
    _ => { "unknown" }
  }
}

OUTPUT format-id(123)
OUTPUT format-id("xyz")

; === MATCH with IS patterns ===

LET val1 = 42
LET result1 = MATCH val1 {
  n IS Int => { "int: " ++ (n AS String) }
  s IS String => { "str: " ++ s }
  b IS Bool => { "bool" }
  _ => { "other" }
}
OUTPUT result1

LET val2 = "hello"
LET result2 = MATCH val2 {
  n IS Int => { "int: " ++ (n AS String) }
  s IS String => { "str: " ++ s }
  b IS Bool => { "bool" }
  _ => { "other" }
}
OUTPUT result2

LET val3 = true
LET result3 = MATCH val3 {
  n IS Int => { "int" }
  s IS String => { "str" }
  b IS Bool => { "bool: " ++ (b AS String) }
  _ => { "other" }
}
OUTPUT result3

; === Inline union types ===

LET mixed: Int | String = 99
OUTPUT mixed IS Int
OUTPUT mixed IS String

LET mixed2: Int | String = "foo"
OUTPUT mixed2 IS Int
OUTPUT mixed2 IS String

; === Complex match with guards ===

FUN classify(v: Storable) -> String {
  MATCH v {
    n IS Int IF n > 100 => { "large int" }
    n IS Int IF n > 0 => { "positive int" }
    n IS Int => { "non-positive int" }
    s IS String IF String.length(s) > 10 => { "long string" }
    s IS String => { "short string" }
    b IS Bool => { "boolean" }
    _ => { "other storable" }
  }
}

OUTPUT classify(500)
OUTPUT classify(50)
OUTPUT classify(0)
OUTPUT classify("hello world!!!")
OUTPUT classify("hi")
OUTPUT classify(true)
OUTPUT classify(3.14)

; === JSON scalar extraction returns Option[Scalar] ===

LET data = { "name": "Alice", "age": 30, "active": true, "score": 3.14 }

; ->> returns Option[Scalar]
LET name-opt = data->>("name")
LET age-opt = data->>("age")
LET active-opt = data->>("active")
LET score-opt = data->>("score")
LET missing-opt = data->>("missing")

OUTPUT name-opt IS Option
OUTPUT age-opt IS Option
OUTPUT missing-opt IS Option.None

; Unwrapped values are Scalar (the union type)
LET name-val = name-opt!
LET age-val = age-opt!
LET active-val = active-opt!
LET score-val = score-opt!

OUTPUT name-val IS Scalar
OUTPUT age-val IS Scalar
OUTPUT active-val IS Scalar
OUTPUT score-val IS Scalar

; Can narrow Scalar with IS
OUTPUT name-val IS String
OUTPUT age-val IS Int
OUTPUT active-val IS Bool
OUTPUT score-val IS Float

; === Type narrowing with MATCH on JSON scalars ===

FUN describe-scalar(opt: Option[Scalar]) -> String {
  MATCH opt {
    Option.None => { "missing" }
    Option.Some(s) => {
      MATCH s {
        v IS String => { "string: " ++ v }
        v IS Int => { "int: " ++ (v AS String) }
        v IS Bool => { "bool: " ++ (v AS String) }
        v IS Float => { "float: " ++ (v AS String) }
        _ => { "unknown scalar" }
      }
    }
  }
}

OUTPUT describe-scalar(data->>("name"))
OUTPUT describe-scalar(data->>("age"))
OUTPUT describe-scalar(data->>("active"))
OUTPUT describe-scalar(data->>("score"))
OUTPUT describe-scalar(data->>("missing"))

; === Static field extraction with .. also returns Option[Scalar] ===

LET static-name = data..name
LET static-age = data..age

OUTPUT static-name IS Option
OUTPUT static-name! IS Scalar
OUTPUT static-name! IS String

OUTPUT static-age IS Option
OUTPUT static-age! IS Scalar
OUTPUT static-age! IS Int

; === Returning union types from functions ===

FUN get-id(use-int: Bool) -> Int | String {
  IF use-int { 42 } ELSE { "abc-123" }
}

LET id-int = get-id(true)
LET id-str = get-id(false)

OUTPUT id-int IS Int
OUTPUT id-int IS String
OUTPUT id-str IS Int
OUTPUT id-str IS String

; Return Storable
FUN get-storable(kind: Int) -> Storable {
  MATCH kind {
    0 => { true }
    1 => { 42 }
    2 => { 3.14 }
    3 => { 'x' }
    4 => { "hello" }
    _ => { { "json": true } }
  }
}

OUTPUT get-storable(0) IS Bool
OUTPUT get-storable(1) IS Int
OUTPUT get-storable(2) IS Float
OUTPUT get-storable(3) IS Char
OUTPUT get-storable(4) IS String
OUTPUT get-storable(5) IS Json

; Return Scalar
FUN get-scalar(kind: Int) -> Scalar {
  MATCH kind {
    0 => { true }
    1 => { 42 }
    2 => { 3.14 }
    _ => { "default" }
  }
}

OUTPUT get-scalar(0) IS Bool
OUTPUT get-scalar(1) IS Int
OUTPUT get-scalar(2) IS Float
OUTPUT get-scalar(3) IS String

; Return user-defined union
FUN parse-id(s: String) -> NumericId {
  LET as-int = s READ Int
  MATCH as-int {
    Result.Ok(n) => { n }
    Result.Err(_) => { s }
  }
}

OUTPUT parse-id("123") IS Int
OUTPUT parse-id("abc") IS String
