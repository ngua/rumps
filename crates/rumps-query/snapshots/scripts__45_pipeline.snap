---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: Pipeline Operator (|>)\n; Tests left-to-right function application\n\n; === Basic pipeline with closure ===\n\nOUTPUT 5 |> (x => x * 2)\n; Expected: 10\n\nOUTPUT 10 |> (x => x + 5)\n; Expected: 15\n\n; === Pipeline with named function ===\n\nFUN double (x) { x * 2 }\nFUN square (x) { x * x }\nFUN inc (x) { x + 1 }\n\nOUTPUT 5 |> double\n; Expected: 10\n\nOUTPUT 5 |> square\n; Expected: 25\n\n; === Pipeline chain (left-associative) ===\n\nOUTPUT 5 |> double |> square\n; Expected: 100 (double(5)=10, square(10)=100)\n\nOUTPUT 5 |> square |> double\n; Expected: 50 (square(5)=25, double(25)=50)\n\nOUTPUT 5 |> inc |> double |> square\n; Expected: 144 (inc(5)=6, double(6)=12, square(12)=144)\n\n; === Pipeline with inline closures ===\n\nOUTPUT 10 |> (x => x + 1) |> (x => x * 2)\n; Expected: 22 (10+1=11, 11*2=22)\n\nOUTPUT 3 |> (x => x * x) |> (x => x + 1)\n; Expected: 10 (3*3=9, 9+1=10)\n\n; === Pipeline precedence (lower than all other ops) ===\n\nOUTPUT 1 + 2 |> double\n; Expected: 6 (1+2=3, double(3)=6)\n\nOUTPUT 10 - 4 |> square\n; Expected: 36 ((10-4)=6, square(6)=36)\n\nOUTPUT 2 * 3 |> inc\n; Expected: 7 (2*3=6, inc(6)=7)\n\n; === Pipeline with typed functions ===\n\nFUN typed-double (x: Int) -> Int { x * 2 }\nFUN typed-inc (x: Int) -> Int { x + 1 }\n\nOUTPUT 5 |> typed-double\n; Expected: 10\n\nOUTPUT 5 |> typed-double |> typed-inc\n; Expected: 11\n\n; === Pipeline with closures capturing variables ===\n\nLET factor = 3\nLET scale = x => x * factor\n\nOUTPUT 10 |> scale\n; Expected: 30\n\nLET offset = 100\nLET shift = x => x + offset\n\nOUTPUT 5 |> double |> shift\n; Expected: 110 (double(5)=10, shift(10)=110)\n\n; === Pipeline with higher-order functions ===\n\nFUN apply-twice (f, x) {\n  f(f(x))\n}\n\nLET quad = x => apply-twice(double, x)\n\nOUTPUT 3 |> quad\n; Expected: 12 (3*2=6, 6*2=12)\n\n; === Chained pipelines with various transforms ===\n\nFUN negate (x) { 0 - x }\n\nOUTPUT 5 |> double |> negate\n; Expected: -10\n\nOUTPUT 5 |> negate |> double\n; Expected: -10\n\n; === Complex pipeline expression ===\n\nFUN add-10 (x) { x + 10 }\nFUN half (x) { x // 2 }\n\nOUTPUT 4 |> square |> add-10 |> half\n; Expected: 13 (square(4)=16, add-10(16)=26, half(26)=13)\n\nOUTPUT \"Pipeline test complete\"\n"
