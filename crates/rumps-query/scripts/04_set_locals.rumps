; Test: @set locals (B-tree variables)
; Tests @set for local variables with subscripts

fun main() {
  ; Simple @set without subscripts (use {} for root ref)
  @set x{} 100
  write @get x{}
  ; Expected: 100

  @set x{} 200
  write @get x{}
  ; Expected: 200

  ; @set with single subscript
  @set items{1} "first"
  @set items{2} "second"
  @set items{3} "third"

  ; @set with multiple subscripts
  @set patient{123, "name"} "John Doe"
  @set patient{123, "age"} 45
  @set patient{123, "active"} true

  @set patient{456, "name"} "Jane Smith"
  @set patient{456, "age"} 32
  @set patient{456, "active"} false

  ; Nested subscripts
  @set tree{1, 2, 3} "deep"
  @set tree{1, 2, 4} "also deep"

  ; Mixed subscript types
  @set mixed{"key", 42, true} "mixed types"

  ; Numeric subscripts
  @set arr{0} "zero"
  @set arr{1} "one"
  @set arr{10} "ten"
  @set arr{100} "hundred"

  ; String subscripts
  @set dict{"alpha"} 1
  @set dict{"beta"} 2
  @set dict{"gamma"} 3

  write "@set locals test complete"
}
