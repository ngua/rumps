; Test: transaction expression
; Transactions wrap global writes and return Result[T, String]

fun main() {
  ; Basic transaction with global write
  let write-result = transaction {
    @set ^TEST{1, "name"} "Alice"
    @set ^TEST{1, "age"} 30
    @get ^TEST{1, "name"}
  }
  write write-result

  ; Verify write persisted
  write @get ^TEST{1, "age"}

  ; Transaction returning unit (write-only)
  let unit-result = transaction {
    let _ = @set ^TEST{2, "status"} "active"
  }
  write unit-result
  write @get ^TEST{2, "status"}

  ; Transaction with multiple statements and computation
  let multi = transaction {
    let a = 10
    let b = 20
    @set ^TEST{4, "sum"} a + b
    a + b
  }
  write multi
  write @get ^TEST{4, "sum"}

  ; Accessing outer scope from transaction
  let x = 100
  let access-outer = transaction {
    @set ^TEST{5, "val"} x + 1
    x + 1
  }
  write access-outer

  ; Transaction result matching
  let txn-result = transaction {
    @set ^TEST{6, "m"} "success"
    "success"
  }
  let matched = match txn-result {
    Result.Ok(s) => { "got: {s}" }
    Result.Err(e) => { "error: {e}" }
  }
  write matched

  ; Rollback on error: write then fail, verify write is not persisted
  let rollback-test = transaction {
    @set ^ROLLBACK{"key"} "should not persist"
    let x = Option.None!
    "unreachable"
  }
  write rollback-test
  write @get ^ROLLBACK{"key"}

  ; Bulk write/read test using forever inside transaction
  let bulk-result = transaction {
    ; Write 100 values to ^BULK{0} through ^BULK{99}
    forever 0 (n, cont) => {
      if n >= 100 {
        n
      } else {
        @set ^BULK{n} n * 2
        cont(n + 1)
      }
    }

    ; Read them back and count how many exist
    let count = forever { i: 0, found: 0 } (state, cont) => {
      if state.i >= 100 {
        state.found
      } else {
        let val = @get ^BULK{state.i}
        let inc = match val {
          Option.Some(_) => { 1 }
          Option.None => { 0 }
        }
        cont({ i: state.i + 1, found: state.found + inc })
      }
    }
    count
  }
  write bulk-result

  write "transaction test complete"
}
