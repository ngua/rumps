source: crates/rumps-query/tests/scripts.rs
description: "; Nested module types tests\n;\n; Tests that types in nested modules can be accessed without full qualification\n; from child modules (looking up the module chain).\n\nIMPORT Outer.{ }\nIMPORT Outer.Inner.{ }\n\n; ============ Child module accesses parent module types ============\n\nMODULE Outer {\n  +NEWTYPE Id = Int\n\n  ; Inner module can use `Id` without `Outer.` prefix\n  MODULE Inner {\n    +FUN make-id(n: Int) -> Id { n }\n    +FUN id-value(i: Id) -> Int { i }\n  }\n}\n\nLET id: Outer.Id = Outer.Inner.make-id(42)\nWRITE Outer.Inner.id-value(id)\n\n; ============ Deeply nested modules ============\n\nMODULE A {\n  +TYPE Status = Active | Inactive\n\n  MODULE B {\n    ; Can access A.Status as just `Status`\n    +FUN is-active(s: Status) -> Bool {\n      MATCH s {\n        Status.Active => { TRUE }\n        Status.Inactive => { FALSE }\n      }\n    }\n\n    MODULE C {\n      ; Can still access A.Status as just `Status`\n      +FUN toggle(s: Status) -> Status {\n        MATCH s {\n          Status.Active => { Status.Inactive }\n          Status.Inactive => { Status.Active }\n        }\n      }\n    }\n  }\n}\n\nLET s1 = A.Status.Active\nWRITE A.B.is-active(s1)\nLET s2 = A.B.C.toggle(s1)\nWRITE A.B.is-active(s2)\n\n; ============ NEWTYPE lookup through module chain ============\n\nMODULE Root {\n  +NEWTYPE Score = Int\n\n  MODULE Level1 {\n    +NEWTYPE Multiplier = Float\n\n    MODULE Level2 {\n      ; Can access both Score and Multiplier without full qualification\n      ; Newtypes are the underlying type, so direct arithmetic works\n      +FUN compute(s: Score, m: Multiplier) -> Float {\n        (s: Int as Float) * m\n      }\n    }\n  }\n}\n\nLET score: Root.Score = 100\nLET mult: Root.Level1.Multiplier = 1.5\nWRITE Root.Level1.Level2.compute(score, mult)\n\n; ============ UNION lookup through module chain ============\n\nMODULE Config {\n  +UNION Value = Int | String | Bool\n\n  MODULE Parser {\n    +FUN is-int(v: Value) -> Bool {\n      v IS Int\n    }\n  }\n}\n\nLET v1: Config.Value = 42\nLET v2: Config.Value = \"hello\"\nWRITE Config.Parser.is-int(v1)\nWRITE Config.Parser.is-int(v2)\n\n; ============ TYPE with variants in nested module ============\n\nMODULE Container {\n  +TYPE Box[T] = Full(T) | Empty\n\n  MODULE Ops {\n    ; Can use `Box` without `Container.` prefix\n    +FUN is-full[T](b: Box[T]) -> Bool {\n      MATCH b {\n        Box.Full(_) => { TRUE }\n        Box.Empty => { FALSE }\n      }\n    }\n\n    +FUN map[A, B](b: Box[A], f: (A) -> B) -> Box[B] {\n      MATCH b {\n        Box.Full(v) => { Box.Full(f(v)) }\n        Box.Empty => { Box.Empty }\n      }\n    }\n  }\n}\n\nLET box1 = Container.Box.Full(10)\nLET box2: Container.Box[Int] = Container.Box.Empty\nWRITE Container.Ops.is-full(box1)\nWRITE Container.Ops.is-full(box2)\nLET mapped = Container.Ops.map(box1, (x: Int) => x * 2)\nWRITE mapped\n\n; ============ Multiple types at different levels ============\n\nMODULE Multi {\n  +NEWTYPE A = Int\n\n  MODULE Sub1 {\n    +NEWTYPE B = String\n\n    MODULE Sub2 {\n      ; Can access both A and B\n      +FUN combine(a: A, b: B) -> String {\n        \"{a}: {b}\"\n      }\n    }\n  }\n}\n\nLET a: Multi.A = 123\nLET b: Multi.Sub1.B = \"test\"\nWRITE Multi.Sub1.Sub2.combine(a, b)\n"
