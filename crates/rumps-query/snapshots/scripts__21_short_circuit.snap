source: crates/rumps-query/tests/scripts.rs
description: "; Test: short-circuit evaluation\n; Uses @set side effects to verify RHS is/isn't evaluated\n\nfun main() {\n  ; === Setup ===\n  @set counter{} 0\n\n  ; === Short-circuit and (false and ...) ===\n  ; RHS should not be evaluated\n\n  @set counter{} 0\n  let r1 = false and {\n    @set counter{} 100\n    true\n  }\n  write @get counter{}\n  ; Expected: 0 (block not evaluated)\n\n  ; === Non-short-circuit and (true and ...) ===\n  ; RHS SHOULD be evaluated\n\n  @set counter{} 0\n  let r2 = true and {\n    @set counter{} 200\n    true\n  }\n  write @get counter{}\n  ; Expected: 200 (block was evaluated)\n\n  ; === Short-circuit or (true or ...) ===\n  ; RHS should not be evaluated\n\n  @set counter{} 0\n  let r3 = true or {\n    @set counter{} 300\n    false\n  }\n  write @get counter{}\n  ; Expected: 0 (block not evaluated)\n\n  ; === Non-short-circuit or (false or ...) ===\n  ; RHS SHOULD be evaluated\n\n  @set counter{} 0\n  let r4 = false or {\n    @set counter{} 400\n    true\n  }\n  write @get counter{}\n  ; Expected: 400 (block was evaluated)\n\n  ; === Chained short-circuit ===\n\n  @set counter{} 0\n  let r5 = false and {\n    @set counter{} 1\n    false\n  } and {\n    @set counter{} 2\n    true\n  }\n  write @get counter{}\n  ; Expected: 0 (first false short-circuits entire chain)\n\n  @set counter{} 0\n  let r6 = true or {\n    @set counter{} 1\n    true\n  } or {\n    @set counter{} 2\n    false\n  }\n  write @get counter{}\n  ; Expected: 0 (first true short-circuits entire chain)\n\n  ; === Mixed and/or ===\n\n  @set counter{} 0\n  let r7 = (false and {\n    @set counter{} 10\n    true\n  }) or {\n    @set counter{} 20\n    true\n  }\n  write @get counter{}\n  ; Expected: 20 (and short-circuits, or evaluates RHS)\n\n  @set counter{} 0\n  let r8 = (true or {\n    @set counter{} 10\n    false\n  }) and {\n    @set counter{} 30\n    true\n  }\n  write @get counter{}\n  ; Expected: 30 (or short-circuits, and evaluates RHS)\n\n  write \"done\"\n}\n"
