---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: JSON type and access operators\n; Tests JSON literals, field access, type conversions, and heterogeneous arrays\n\n; ============================================================\n; JSON LITERALS (quoted keys)\n; ============================================================\n\nLET j = { \"name\": \"Alice\", \"age\": 30, \"active\": TRUE }\n\n; Type checking\nOUTPUT j IS Json\n; Expected: TRUE\n\n; ============================================================\n; JSON FIELD ACCESS (returns Json)\n; ============================================================\n\nLET name = j.name\nOUTPUT name IS Json\n; Expected: TRUE\n\n; Missing field returns Json null\nLET missing = j.missing\nOUTPUT missing IS Json\n; Expected: TRUE\n\n; ============================================================\n; NESTED JSON ACCESS\n; ============================================================\n\nLET nested = {\n  \"user\": {\n    \"profile\": {\n      \"firstName\": \"Bob\"\n    }\n  }\n}\n\nOUTPUT nested.user.profile.firstName IS Json\n; Expected: TRUE\n\n; ============================================================\n; NATIVE OBJECTS (unquoted keys) vs JSON\n; ============================================================\n\nLET obj = { name: \"Alice\", age: 30 }\nOUTPUT obj IS Object\n; Expected: TRUE\n\n; Native object field access returns native type\nOUTPUT obj.name IS String\n; Expected: TRUE\n\n; ============================================================\n; JSON SCALAR EXTRACTION WITH .. (returns Option)\n; ============================================================\n\nLET data = { \"a\": 1, \"b\": 2, \"c\": 3 }\nLET a-scalar = data..a\nOUTPUT a-scalar IS Option.Some(_)\n; Expected: TRUE\n\n; Unwrap scalar extraction\nOUTPUT a-scalar!\n; Expected: 1\n\n; Another scalar extraction\nLET c-val = data..c\nOUTPUT c-val!\n; Expected: 3\n\n; Missing key with .. returns Option.None\nLET miss = data..missing\nOUTPUT miss IS Option.None\n; Expected: TRUE\n\n; Scalar extraction from string field\nLET strs = { \"greeting\": \"hello\" }\nLET s = strs..greeting\nOUTPUT s!\n; Expected: hello\n\n; Scalar extraction from bool field\nLET bools = { \"flag\": TRUE }\nLET b = bools..flag\nOUTPUT b!\n; Expected: TRUE\n\n; Scalar extraction from float field\nLET floats = { \"pi\": 3.14 }\nLET f = floats..pi\nOUTPUT f!\n; Expected: 3.14\n\n; ============================================================\n; DYNAMIC JSON ACCESS WITH -> AND ->>\n; ============================================================\n\nLET key = \"b\"\nLET dyn = data->(key)\nOUTPUT dyn IS Json\n; Expected: TRUE\n\n; Dynamic scalar access with ->>(expr)\nLET key-c = \"c\"\nLET dyn-c = data->>(key-c)\nOUTPUT dyn-c!\n; Expected: 3\n\n; ============================================================\n; AS Json COERCION (native -> Json)\n; ============================================================\n\n; Native object -> Json\nLET native-obj = { x: 1, y: 2 }\nLET json-obj = native-obj AS Json\nOUTPUT json-obj IS Json\n; Expected: TRUE\n\n; Array -> Json\nLET arr = [1, 2, 3]\nLET json-arr = arr AS Json\nOUTPUT json-arr IS Json\n; Expected: TRUE\n\n; Scalar -> Json\nLET int-json = 42 AS Json\nOUTPUT int-json IS Json\n; Expected: TRUE\n\nLET str-json = \"hello\" AS Json\nOUTPUT str-json IS Json\n; Expected: TRUE\n\nLET bool-json = TRUE AS Json\nOUTPUT bool-json IS Json\n; Expected: TRUE\n\n; ============================================================\n; Json READ T CONVERSIONS (Json -> native)\n; ============================================================\n\nLET j-data = { \"name\": \"John\", \"age\": 30, \"active\": TRUE, \"score\": 3.14 }\n\n; Json -> String\nLET name-result = j-data.name READ String\nOUTPUT name-result IS Result.Ok(_)\n; Expected: TRUE\nOUTPUT name-result!\n; Expected: John\n\n; Json -> Int\nLET age-result = j-data.age READ Int\nOUTPUT age-result IS Result.Ok(_)\n; Expected: TRUE\nOUTPUT age-result!\n; Expected: 30\n\n; Json -> Bool\nLET active-result = j-data.active READ Bool\nOUTPUT active-result IS Result.Ok(_)\n; Expected: TRUE\nOUTPUT active-result!\n; Expected: TRUE\n\n; Json -> Float\nLET score-result = j-data.score READ Float\nOUTPUT score-result IS Result.Ok(_)\n; Expected: TRUE\nOUTPUT score-result!\n; Expected: 3.14\n\n; Json -> Object\nLET obj-data = { \"nested\": { \"a\": 1, \"b\": 2 } }\nLET nested-result = obj-data.nested READ Object\nOUTPUT nested-result IS Result.Ok(_)\n; Expected: TRUE\n\n; READ type mismatch returns Result.Err\nLET bad-int = j-data.name READ Int\nOUTPUT bad-int IS Result.Err(_)\n; Expected: TRUE\n\n; READ on missing field (JSON null) returns Result.Err for non-Option types\nLET null-data = { \"other\": 1 }\nLET null-read = null-data.missing READ Int\nOUTPUT null-read IS Result.Err(_)\n; Expected: TRUE\n\n; ============================================================\n; HETEROGENEOUS ARRAYS -> Json\n; ============================================================\n\n; Mixed types become Json\nLET hetero = [1, \"two\", TRUE, 3.14]\nOUTPUT hetero IS Json\n; Expected: TRUE\n\n; String mixed with other types\nLET str-mix = [\"a\", 1, \"hello\"]\nOUTPUT str-mix IS Json\n; Expected: TRUE\n\n; Two elements of different types\nLET two-mix = [42, \"hello\"]\nOUTPUT two-mix IS Json\n; Expected: TRUE\n\n; Homogeneous arrays stay as Array\nLET homo-int = [1, 2, 3]\nOUTPUT homo-int IS Array\n; Expected: TRUE\n\nLET homo-str = [\"a\", \"b\", \"c\"]\nOUTPUT homo-str IS Array\n; Expected: TRUE\n\nOUTPUT \"JSON test complete\"\n"
