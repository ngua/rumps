---
source: crates/rumps-query/tests/scripts.rs
description: "; Coalesce operator (??) tests\n; `??` unwraps Option.Some/Result.Ok or falls back to right operand\n\nfun main() {\n  ; === Option.None coalesces to fallback ===\n\n  ; Option.None falls back to right operand\n  write Option.None ?? \"fallback1\"\n  ; Expected: fallback1\n\n  ; Option.Some unwraps to its value\n  write Option.Some(42) ?? 0\n  ; Expected: 42\n\n  ; === Chained coalesce ===\n\n  ; Chain of None values falls through to final fallback\n  let result = Option.None ?? Option.None ?? 3\n  write result\n  ; Expected: 3\n\n  ; First non-None wins\n  let chain-2 = Option.None ?? Option.Some(\"found\") ?? \"default\"\n  write chain-2\n  ; Expected: found\n\n  ; === Result coalesce ===\n\n  ; Result.Ok unwraps to its value\n  write Result.Ok(100) ?? 0\n  ; Expected: 100\n\n  ; Result.Err falls back to right operand\n  write Result.Err(\"oops\") ?? 999\n  ; Expected: 999\n\n  ; === Coalesce in expressions ===\n\n  ; Coalesce result can be used in further expressions\n  let val = (Option.None ?? 5) + 1\n  write val\n  ; Expected: 6\n\n  ; Coalesce with string concatenation\n  let greeting = Option.None ?? \"Hello\"\n  write \"{greeting} World\"\n  ; Expected: Hello World\n\n  ; Coalesce with Option.Some in expression\n  let num = (Option.Some(10) ?? 0) * 2\n  write num\n  ; Expected: 20\n\n  write \"Coalesce tests complete\"\n}\n"
---
fallback1
42
3
found
