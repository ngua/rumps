source: crates/rumps-query/tests/scripts.rs
description: "; Test: lex simple expressions\n; Tests basic tokenization of literals, identifiers, and operators\n\nfun main() {\n  ; Integer literals\n  let a = 42\n  let b = 0\n  let c = -123\n\n  ; Float literals\n  let d = 3.14\n  let e = 0.5\n  let f = -2.718\n\n  ; String literals\n  let s1 = \"hello\"\n  let s2 = \"world with spaces\"\n  let s3 = \"\"\n\n  ; Boolean keywords\n  let t = true\n  let f = false\n\n  ; Train-case identifier\n  let my-var = 100\n\n  ; All operators in one place\n  let x = 1 + 2 - 3 * 4 // 5 % 6\n  let cmp = 1 < 2\n  let eq = 3 == 3\n  let neq = 4 != 5\n  let ge = 10 >= 5\n  let le = 5 <= 10\n  let gt = 10 > 5\n  let lt = 5 < 10\n\n  ; Logical operators\n  let and1 = true and false\n  let or1 = true or false\n  let not1 = not true\n  let and2 = true && false\n  let or2 = true || false\n  let not2 = !false\n\n  ; String interpolation (replaces concat)\n  let concat = \"{\"hello\"} {\"world\"}\"\n\n  write \"Lexer test complete\"\n}\n"
---
Lexer test complete
