; Error: wrong field type in nested struct

TYPE Address = { street: String, city: String, zip: String }
TYPE Patient = { id: Int, name: String, address: Address }

; address.zip should be String, not Int
LET p: Patient = {
  id: 1,
  name: "Alice",
  address: { street: "123 Main", city: "NYC", zip: 10001 }
}
