---
source: crates/rumps-query/tests/scripts.rs
description: "; Time module primitives\n; Tests Time.now, Time.epoch, Time.parse, Time.format,\n; Time.add-seconds, Time.diff-seconds, Time.year, Time.month,\n; Time.day, Time.hour, Time.minute, Time.second\n\n; ============ Time.epoch ============\n\nLET epoch = Time.epoch()\nWRITE epoch\n\n; Epoch components\nWRITE Time.year(epoch)    ; 1970\nWRITE Time.month(epoch)   ; 1\nWRITE Time.day(epoch)     ; 1\nWRITE Time.hour(epoch)    ; 0\nWRITE Time.minute(epoch)  ; 0\nWRITE Time.second(epoch)  ; 0\n\n; ============ Time.add-seconds ============\n\nLET one-hour = Time.add-seconds(epoch, 3600)\nWRITE Time.hour(one-hour)  ; 1\n\nLET one-day = Time.add-seconds(epoch, 86400)\nWRITE Time.day(one-day)  ; 2\n\n; Negative seconds (subtract)\nLET back = Time.add-seconds(one-hour, -3600)\nWRITE Time.hour(back)  ; 0\n\n; ============ Time.diff-seconds ============\n\nLET diff1 = Time.diff-seconds(one-hour, epoch)\nWRITE diff1  ; 3600.0\n\nLET diff2 = Time.diff-seconds(epoch, one-hour)\nWRITE diff2  ; -3600.0\n\nLET diff3 = Time.diff-seconds(one-day, epoch)\nWRITE diff3  ; 86400.0\n\n; ============ Time.format and Time.parse ============\n\n; Format epoch to ISO-like string\nLET fmt = Time.format(\"%Y-%m-%d %H:%M:%S %z\", epoch)\nWRITE fmt  ; 1970-01-01 00:00:00 +0000\n\n; Format with different patterns\nLET date-only = Time.format(\"%Y-%m-%d\", epoch)\nWRITE date-only  ; 1970-01-01\n\nLET time-only = Time.format(\"%H:%M:%S\", epoch)\nWRITE time-only  ; 00:00:00\n\n; Parse a date string back\nLET parsed = Time.parse(\"%Y-%m-%d %H:%M:%S %z\", \"2024-06-15 14:30:45 +0000\")\nWRITE parsed  ; Result[Time, String]\n\n; Check that parsed is Ok\nWRITE parsed IS Result.Ok(_)  ; true\n\n; Unwrap and check components\nLET t = parsed!\nWRITE Time.year(t)    ; 2024\nWRITE Time.month(t)   ; 6\nWRITE Time.day(t)     ; 15\nWRITE Time.hour(t)    ; 14\nWRITE Time.minute(t)  ; 30\nWRITE Time.second(t)  ; 45\n\n; ============ Parse error handling ============\n\nLET bad-parse = Time.parse(\"%Y-%m-%d\", \"not-a-date\")\nWRITE bad-parse IS Result.Err(_)  ; true\n\n; ============ Time.now ============\n\n; Just verify it runs and returns a Time\nLET now = Time.now()\nWRITE now IS Time  ; true\n\n; ============ Chaining with pipeline ============\n\nLET chain = Time.add-seconds(Time.epoch(), 3661)  ; 1 hour, 1 minute, 1 second\nWRITE Time.hour(chain)    ; 1\nWRITE Time.minute(chain)  ; 1\nWRITE Time.second(chain)  ; 1\n\n; ============ Formatting variations ============\n\nLET t2 = Time.add-seconds(epoch, 90061)  ; 1 day + 1 hour + 1 minute + 1 second\n\nWRITE Time.format(\"%d/%m/%Y\", t2)  ; 02/01/1970\nWRITE Time.format(\"%I:%M %p\", t2)  ; 01:01 AM\n"
