---
source: crates/rumps-query/tests/scripts.rs
description: "; Array module primitives\n; Tests Iterable:length, Array.push, Array.pop, Array.head, Array.tail,\n; Iterable:reverse, Array.sort, Array.slice, Iterable:contains, Array.concat\n\nfun main() {\n  ; ============ Iterable:length ============\n\n  let nums = [1, 2, 3, 4, 5]\n  write Iterable:length(nums)  ; 5\n\n  let empty = []\n  write Iterable:length(empty)  ; 0\n\n  let single = [42]\n  write Iterable:length(single)  ; 1\n\n  ; ============ Array.push ============\n\n  let base-arr = [1, 2, 3]\n  let pushed = Array.push(base-arr, 4)\n  write pushed  ; [1, 2, 3, 4]\n\n  ; Original unchanged (immutable)\n  write base-arr  ; [1, 2, 3]\n\n  ; Push to empty array\n  let pushed-empty = Array.push([], 1)\n  write pushed-empty  ; [1]\n\n  ; ============ Array.pop ============\n\n  let to-pop = [1, 2, 3]\n  let popped = Array.pop(to-pop)\n  write popped  ; [1, 2]\n\n  ; Pop from single element\n  let pop-single = Array.pop([42])\n  write pop-single  ; []\n\n  ; Pop from empty (returns empty)\n  let pop-empty = Array.pop([])\n  write pop-empty  ; []\n\n  ; ============ Array.head ============\n\n  let head-arr = [10, 20, 30]\n  let first = Array.head(head-arr)\n  write first  ; Option.Some(10)\n\n  ; Head of empty array\n  let head-empty = Array.head([])\n  write head-empty  ; Option.None\n\n  ; Head with unwrap\n  let head-val = Array.head([100, 200])!\n  write head-val  ; 100\n\n  ; ============ Array.tail ============\n\n  let tail-arr = [1, 2, 3, 4]\n  let rest = Array.tail(tail-arr)\n  write rest  ; [2, 3, 4]\n\n  ; Tail of single element\n  let tail-single = Array.tail([42])\n  write tail-single  ; []\n\n  ; Tail of empty array\n  let tail-empty = Array.tail([])\n  write tail-empty  ; []\n\n  ; ============ Iterable:reverse ============\n\n  let to-reverse = [1, 2, 3, 4, 5]\n  let reversed = Iterable:reverse(to-reverse)\n  write reversed  ; [5, 4, 3, 2, 1]\n\n  ; Reverse single element\n  let rev-single = Iterable:reverse([42])\n  write rev-single  ; [42]\n\n  ; Reverse empty\n  let rev-empty = Iterable:reverse([])\n  write rev-empty  ; []\n\n  ; ============ Array.sort ============\n\n  let unsorted = [3, 1, 4, 1, 5, 9, 2, 6]\n  let sorted = Array.sort(unsorted)\n  write sorted  ; [1, 1, 2, 3, 4, 5, 6, 9]\n\n  ; Sort already sorted\n  let already-sorted = Array.sort([1, 2, 3])\n  write already-sorted  ; [1, 2, 3]\n\n  ; Sort reverse order\n  let sort-reverse = Array.sort([3, 2, 1])\n  write sort-reverse  ; [1, 2, 3]\n\n  ; Sort strings\n  let unsorted-strs = [\"banana\", \"apple\", \"cherry\"]\n  let sorted-strs = Array.sort(unsorted-strs)\n  write sorted-strs  ; [\"apple\", \"banana\", \"cherry\"]\n\n  ; Sort booleans\n  let unsorted-bools = [true, false, true, false]\n  let sorted-bools = Array.sort(unsorted-bools)\n  write sorted-bools  ; [false, false, true, true]\n\n  ; Sort empty\n  let sort-empty = Array.sort([])\n  write sort-empty  ; []\n\n  ; ============ Array.slice ============\n\n  let slice-arr = [0, 1, 2, 3, 4, 5]\n  let sliced = Array.slice(slice-arr, 1, 4)\n  write sliced  ; [1, 2, 3]\n\n  ; Slice from start\n  let slice-start = Array.slice(slice-arr, 0, 3)\n  write slice-start  ; [0, 1, 2]\n\n  ; Slice to end\n  let slice-end = Array.slice(slice-arr, 3, 6)\n  write slice-end  ; [3, 4, 5]\n\n  ; Slice full array\n  let slice-full = Array.slice(slice-arr, 0, 6)\n  write slice-full  ; [0, 1, 2, 3, 4, 5]\n\n  ; Slice empty range\n  let slice-none = Array.slice(slice-arr, 2, 2)\n  write slice-none  ; []\n\n  ; Slice with clamped bounds\n  let slice-clamp = Array.slice([1, 2, 3], 0, 100)\n  write slice-clamp  ; [1, 2, 3]\n\n  ; Slice with negative start (clamped to 0)\n  let slice-neg = Array.slice([1, 2, 3], -5, 2)\n  write slice-neg  ; [1, 2]\n\n  ; ============ Iterable:contains ============\n\n  let contains-arr = [1, 2, 3, 4, 5]\n  write Iterable:contains(contains-arr, 3)  ; true\n  write Iterable:contains(contains-arr, 10)  ; false\n\n  ; Contains in empty array\n  write Iterable:contains([], 1)  ; false\n\n  ; Contains with strings\n  let str-arr = [\"hello\", \"world\"]\n  write Iterable:contains(str-arr, \"hello\")  ; true\n  write Iterable:contains(str-arr, \"foo\")  ; false\n\n  ; Contains with booleans\n  let bool-arr = [true, false]\n  write Iterable:contains(bool-arr, true)  ; true\n\n  ; ============ Array.concat ============\n\n  let arr-a = [1, 2, 3]\n  let arr-b = [4, 5, 6]\n  let combined = Array.concat(arr-a, arr-b)\n  write combined  ; [1, 2, 3, 4, 5, 6]\n\n  ; Concat with empty first\n  let concat-empty-a = Array.concat([], [1, 2, 3])\n  write concat-empty-a  ; [1, 2, 3]\n\n  ; Concat with empty second\n  let concat-empty-b = Array.concat([1, 2, 3], [])\n  write concat-empty-b  ; [1, 2, 3]\n\n  ; Concat two empty\n  let concat-both-empty = Array.concat([], [])\n  write concat-both-empty  ; []\n\n  ; Concat strings\n  let concat-strs = Array.concat([\"a\", \"b\"], [\"c\", \"d\"])\n  write concat-strs  ; [\"a\", \"b\", \"c\", \"d\"]\n\n  ; ============ Chaining operations ============\n\n  ; Get first element of sorted reversed array\n  let chain-arr = [3, 1, 4, 1, 5]\n  let chain-result = Array.head(Iterable:reverse(Array.sort(chain-arr)))!\n  write chain-result  ; 5\n\n  ; Slice then reverse\n  let slice-rev = Iterable:reverse(Array.slice([0, 1, 2, 3, 4], 1, 4))\n  write slice-rev  ; [3, 2, 1]\n\n  ; Push then length\n  let push-len = Iterable:length(Array.push([1, 2], 3))\n  write push-len  ; 3\n\n  ; ============ Pipeline usage ============\n\n  let pipeline-arr = [5, 3, 8, 1, 9]\n  let pipeline-result = pipeline-arr\n    |> Array.sort\n    |> Iterable:reverse\n    |> (arr => Array.slice(arr, 0, 3))\n  write pipeline-result  ; [9, 8, 5]\n}\n"
