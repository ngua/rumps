---
source: crates/rumps-query/tests/scripts.rs
description: "; Naked class method syntax: `:method` without class prefix\n\nfun main() {\n  ; Naked class method calls (unique method names resolve automatically)\n  write \"add: {:add(3, 4)}\"\n  write \"sub: {:sub(10, 3)}\"\n  write \"neg: {:neg(-5)}\"\n  write \"compare: {:display(:compare(1, 2))}\"\n  write \"eq: {:eq(3, 3)}\"\n  write \"display: {:display(42)}\"\n  write \"concat: {:concat(\"hello\", \" world\")}\"\n\n  ; Naked class method references\n  let f = :add\n  write \"ref add: {f(10, 20)}\"\n\n  let g = :neg\n  write \"ref neg: {g(-42)}\"\n\n  let h = :compare\n  write \"ref compare: {:display(h(5, 5))}\"\n\n  ; HoF with naked syntax\n  let nums = [1, 2, 3, 4, 5]\n  let doubled = :map(x => x * 2, nums)\n  write \"map: {:display(doubled)}\"\n\n  let evens = :filter(x => x % 2 == 0, nums)\n  write \"filter: {:display(evens)}\"\n\n  let sum = :fold((acc, x) => acc + x, 0, nums)\n  write \"fold: {sum}\"\n\n  let joined = :fold-map(x => \"{x}\", nums)\n  write \"fold-map: {joined}\"\n\n  ; Pipe with naked syntax\n  write \"length: {nums |> :length}\"\n  write \"unwrap: {Option.Some(99) |> :unwrap}\"\n\n  ; Method ref passed to HOF\n  let arrs = [[1, 2], [3], [4, 5, 6]]\n  let flat = :fold(:concat, [], arrs)\n  write \"flatten: {:display(flat)}\"\n\n  let fm = :fold-map\n  write \"fold-map ref: {:display(fm(x => [x], [6, 7]))}\"\n\n  ; Stored ref used later\n  let len = :length\n  write \"stored ref: {len([10, 20, 30])}\"\n}\n"
---
add: 7
sub: 7
neg: 5
compare: -1
eq: true
display: 42
concat: hello world
ref add: 30
ref neg: 42
ref compare: 0
map: [ 2, 4, 6, 8, 10 ]
filter: [ 2, 4 ]
fold: 15
fold-map: 12345
length: 5
unwrap: 99
flatten: [ 1, 2, 3, 4, 5, 6 ]
fold-map ref: [ 6, 7 ]
stored ref: 3
