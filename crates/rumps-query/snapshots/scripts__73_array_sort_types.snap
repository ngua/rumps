---
source: crates/rumps-query/tests/scripts.rs
description: "; Test Array.sort with various types\n\nnewtype Priority = Int\n\nclass Ord for Priority {\n  fun compare(a: Priority, b: Priority) -> Ordering {\n    let x: Int = a\n    let y: Int = b\n    if x > y { Ordering.Lt } else {\n      if x == y { Ordering.Eq } else { Ordering.Gt }\n    }\n  }\n}\n\nfun main() {\n  ; --- Scalars ---\n  write Array.sort([3, 1, 4, 1, 5, 9, 2, 6])\n  let words: Array[Word] = [3, 1, 2]\n  write Array.sort(words)\n  write Array.sort([\"banana\", \"apple\", \"cherry\"])\n  write Array.sort([true, false, true, false])\n  write Array.sort([3.14, 1.0, 2.71])\n  write Array.sort(['b', 'a', 'c'])\n  write Array.sort([Ordering.Gt, Ordering.Lt, Ordering.Eq])\n\n  ; --- Option ---\n  ; None < Some, then by payload\n  write Array.sort([Option.Some(3), Option.None, Option.Some(1), Option.None, Option.Some(2)])\n\n  ; --- Result ---\n  ; Err < Ok, then by payload\n  write Array.sort([Result.Ok(2), Result.Err(\"b\"), Result.Ok(1), Result.Err(\"a\")])\n\n  ; --- Tuples ---\n  ; Lexicographic ordering\n  write Array.sort([(2, \"b\"), (1, \"z\"), (2, \"a\"), (1, \"a\")])\n  write Array.sort([(1, 2, 3), (1, 1, 9), (1, 2, 1)])\n\n  ; --- Nested Options ---\n  write Array.sort([Option.Some(Option.Some(2)), Option.Some(Option.None), Option.None, Option.Some(Option.Some(1))])\n\n  ; --- User-defined Ord instance ---\n  let low: Priority = 1\n  let med: Priority = 2\n  let high: Priority = 3\n  let tasks = [low, high, med, low, high]\n  write Array.sort(tasks)\n\n  ; --- Time ---\n  let epoch = Time.epoch()\n  let t1 = Time.add-seconds(epoch, 1)\n  let t2 = Time.add-seconds(epoch, 2)\n  write Array.sort([t2, t1])\n\n  ; --- Arrays of arrays ---\n  write Array.sort([[3, 1], [1, 2], [1, 1], [2, 0]])\n\n  ; --- Maps ---\n  let m1: Map[String, Int] = Map.from-entries([(\"a\", 1), (\"b\", 2)])\n  let m2: Map[String, Int] = Map.from-entries([(\"a\", 1), (\"b\", 3)])\n  let m3: Map[String, Int] = Map.from-entries([(\"a\", 1), (\"c\", 2)])\n  write Array.sort([m3, m2, m1])\n\n  ; --- Mixed with pipeline ---\n  let sorted-options = [Option.Some(5), Option.None, Option.Some(3)] |> Array.sort\n  write sorted-options\n}\n"
---
[ 1, 1, 2, 3, 4, 5, 6, 9 ]
[ 1, 2, 3 ]
[ "apple", "banana", "cherry" ]
[ false, false, true, true ]
[ 1.0, 2.71, 3.14 ]
[ 'a', 'b', 'c' ]
[ Ordering.Lt, Ordering.Eq, Ordering.Gt ]
[ Option.None, Option.None, Option.Some(1), Option.Some(2), Option.Some(3) ]
[ Result.Err("a"), Result.Err("b"), Result.Ok(1), Result.Ok(2) ]
[ (1, "a"), (1, "z"), (2, "a"), (2, "b") ]
[ (1, 1, 9), (1, 2, 1), (1, 2, 3) ]
[ Option.None, Option.Some(Option.None), Option.Some(Option.Some(1)), Option.Some(Option.Some(2)) ]
[ 3, 3, 2, 1, 1 ]
[ 1970-01-01T00:00:01+00:00, 1970-01-01T00:00:02+00:00 ]
[ [ 1, 1 ], [ 1, 2 ], [ 2, 0 ], [ 3, 1 ] ]
[ { "a" => 1, "b" => 2 }, { "a" => 1, "b" => 3 }, { "a" => 1, "c" => 2 } ]
[ Option.None, Option.Some(3), Option.Some(5) ]
