---
source: crates/rumps-query/tests/scripts.rs
description: "; Prefix `?` operator (wrap) for Option and Result types\n\n; Basic Option wrapping (default when unconstrained)\nLET opt1 = ?42\nLET opt2 = ?\"hello\"\nLET opt3 = ?true\nWRITE \"opt1 = {opt1}\"\nWRITE \"opt2 = {opt2}\"\nWRITE \"opt3 = {opt3}\"\n\n; Explicit Option annotation\nLET opt4: Option[Int] = ?100\nLET opt5: Option[String] = ?\"world\"\nWRITE \"opt4 = {opt4}\"\nWRITE \"opt5 = {opt5}\"\n\n; Result wrapping when context expects Result\nFUN needs-result(x: Result[Int, String]) -> Int {\n  x ?? -1\n}\n\nWRITE \"needs-result(?42) = {needs-result(?42)}\"\nWRITE \"needs-result(?0) = {needs-result(?0)}\"\n\n; Explicit Result annotation\nLET res1: Result[Int, String] = ?123\nLET res2: Result[Bool, Int] = ?true\nWRITE \"res1 = {res1}\"\nWRITE \"res2 = {res2}\"\n\n; Wrap in function return position\nFUN make-opt(x: Int) -> Option[Int] {\n  ?x\n}\n\nFUN make-result(x: Int) -> Result[Int, String] {\n  ?x\n}\n\nWRITE \"make-opt(5) = {make-opt(5)}\"\nWRITE \"make-result(10) = {make-result(10)}\"\n\n; Wrap with expressions\nLET opt-expr = ?(1 + 2 * 3)\nWRITE \"opt-expr = {opt-expr}\"\n\n; Chained with coalesce\nLET val = ?42 ?? 0\nWRITE \"?42 ?? 0 = {val}\"\n\n; Wrap in array context\nLET opts: Array[Option[Int]] = [?1, ?2, ?3]\nWRITE \"opts = {opts}\"\n\n; Nested wrap\nLET nested: Option[Option[Int]] = ?(?5)\nWRITE \"nested = {nested}\"\n\n; Wrap None/Err values explicitly\nLET none-in-some: Option[Option[Int]] = ?Option.None\nWRITE \"none-in-some = {none-in-some}\"\n\n; Result with different error types\nFUN err-string(x: Result[Int, String]) -> Result[Int, String] { x }\nFUN err-int(x: Result[Int, Int]) -> Result[Int, Int] { x }\n\nWRITE \"err-string(?1) = {err-string(?1)}\"\nWRITE \"err-int(?2) = {err-int(?2)}\"\n"
---
"opt1 = Option.Some(42)"
"opt2 = Option.Some("hello")"
"opt3 = Option.Some(TRUE)"
"opt4 = Option.Some(100)"
"opt5 = Option.Some("world")"
"needs-result(?42) = 42"
"needs-result(?0) = 0"
"res1 = Result.Ok(123)"
"res2 = Result.Ok(TRUE)"
"make-opt(5) = Option.Some(5)"
"make-result(10) = Result.Ok(10)"
"opt-expr = Option.Some(7)"
"?42 ?? 0 = 42"
"opts = [ Option.Some(1), Option.Some(2), Option.Some(3) ]"
"nested = Option.Some(Option.Some(5))"
"none-in-some = Option.Some(Option.None)"
"err-string(?1) = Result.Ok(1)"
"err-int(?2) = Result.Ok(2)"
