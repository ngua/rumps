; Top-level LET hoisting: forward references from functions to
; top-level LET bindings defined later in the source.

fun main() {
  ; Forward reference to top-level LET (the original bug).
  write ys

  ; Forward reference via helper.
  write add-one-to-x()

  ; Reference to an annotated top-level LET via helper.
  write get-greeting()

  ; Direct forward reference.
  write greeting

  ; Generic helper forward-referencing a hoisted LET.
  write len-of(ys)
}

fun add-one-to-x() -> Int {
  x + 1
}

fun get-greeting() -> String {
  annotated
}

fun len-of[T](arr: Array[T]) -> Int {
  Iterable:length(arr)
}

let ys = [1, 2, 3]
let x = 41
let greeting = "hello"
let annotated: String = "world"
