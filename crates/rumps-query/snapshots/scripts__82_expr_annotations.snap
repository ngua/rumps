---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: Expression type annotations\n; Tests `(expr) : Type` syntax for inline type annotations\n\nfun main() {\n  ; === Basic expression annotations ===\n\n  ; Int annotation\n  let x = (42) : Int\n  write x\n  ; Expected: 42\n\n  ; String annotation\n  let s = (\"hello\") : String\n  write s\n  ; Expected: hello\n\n  ; Bool annotation\n  let b = (true) : Bool\n  write b\n  ; Expected: true\n\n  ; Float annotation\n  let f = (3.14) : Float\n  write f\n  ; Expected: 3.14\n\n  ; === Annotating expressions ===\n\n  ; Annotate arithmetic expression\n  let sum = (1 + 2) : Int\n  write sum\n  ; Expected: 3\n\n  ; Annotate function call result\n  let len = (Iterable:length([1, 2, 3])) : Int\n  write len\n  ; Expected: 3\n\n  ; === Parameterized type annotations ===\n\n  ; Option[Int] with Some\n  let opt = (Option.Some(10)) : Option[Int]\n  write :display(opt)\n  ; Expected: Option.Some(10)\n\n  ; Option[String] with None\n  let none = (Option.None) : Option[String]\n  write :display(none)\n  ; Expected: Option.None\n\n  ; Result[Int, String] with Ok\n  let res = (Result.Ok(42)) : Result[Int, String]\n  write :display(res)\n  ; Expected: Result.Ok(42)\n\n  ; === Nested type annotations ===\n\n  ; Array[Int]\n  let arr = ([1, 2, 3]) : Array[Int]\n  write :display(arr)\n  ; Expected: [ 1, 2, 3 ]\n\n  ; === Chained usage ===\n\n  ; Use annotated expression in pipeline\n  let piped = (5) : Int |> (n => n * 2)\n  write piped\n  ; Expected: 10\n\n  ; Use in arithmetic\n  let doubled = (10) : Int + (20) : Int\n  write doubled\n  ; Expected: 30\n\n  ; === Tuple with type annotation (double parens) ===\n\n  ; Annotate a tuple with double parentheses\n  let tup = ((1, 2)) : (Int, Int)\n  write tup\n  ; Expected: ( 1, 2 )\n\n  ; Tuple in arithmetic context\n  let pair = ((10, 20)) : (Int, Int)\n  write pair.0 + pair.1\n  ; Expected: 30\n\n  write \"Expression annotation test complete\"\n}\n"
---
