; is operator with parameterized types (Array[T], Map[K, V])
; Tests that element/key/value types are checked, not just the container type

fun main() {
  ; === Array element type checks ===

  let floats = [1.0, 2.0, 3.0]
  write floats is Array[Float]
  ; true

  write floats is Array[Int]
  ; false - floats are not ints

  write floats is Array[Char]
  ; false

  let ints = [1, 2, 3]
  write ints is Array[Int]
  ; true

  write ints is Array[Float]
  ; false

  write ints is Array[String]
  ; false

  ; === Empty array with annotation ===

  ; Empty array without annotation is polymorphic (UNKNOWN element type)
  let empty = []
  write empty is Array[Int]
  ; true - UNKNOWN matches anything

  write empty is Array[String]
  ; true - UNKNOWN matches anything

  ; Empty array with annotation has concrete element type
  let empty-bool: Array[Bool] = []
  write empty-bool is Array[Bool]
  ; true

  write empty-bool is Array[Int]
  ; false - annotated as Bool, not Int

  write empty-bool is Array[String]
  ; false

  ; === Map key/value type checks ===

  let str-to-int = { "a" => 1, "b" => 2 }
  write str-to-int is Map[String, Int]
  ; true

  write str-to-int is Map[String, String]
  ; false - values are Int, not String

  write str-to-int is Map[Int, Int]
  ; false - keys are String, not Int

  ; Empty map with annotation
  let empty-map: Map[Int, Bool] = Map.empty()
  write empty-map is Map[Int, Bool]
  ; true

  write empty-map is Map[String, Int]
  ; false - annotated as Map[Int, Bool]

  let tuple-key-map = { (1, "a") => true }
  write tuple-key-map is TupleKeyBoolMap
  ; true

  write tuple-key-map is ReversedTupleKeyBoolMap
  ; false - key tuple fields are ordered

  ; === Inline annotation syntax ===

  ; Verify inline annotations also refine types
  let inline-arr = ([]) : Array[Char]
  write inline-arr is Array[Char]
  ; true

  write inline-arr is Array[Int]
  ; false - inline annotation makes it concrete

  let box-int = { inner: 42 }
  write box-int is Box[Int]
  ; true

  write box-int is Box[String]
  ; false

  write box-int is Box[Float]
  ; false

  ; === Tuple type checks ===

  write (1, 'a') is (Int, Char)
  ; true

  write (1, 'a') is (Char, Int)
  ; false - order matters

  write (1, 2) is (Int, Int)
  ; true

  write (1, 2, 3) is (Int, Int, Int)
  ; true

  ; Single-element tuples
  let single: (Int,) = (42,)
  write single is (Int,)
  ; true

  ; Single-element tuple in closure annotations
  let f = (x: (Int,)) -> (Int,) => x
  write :display(f((1,)))
  ; (1,)

  ; Empty tuple
  write () is ()
  ; true

  write "parameterized is tests complete"
}

; === User-defined parameterized types ===

newtype Box[T] = { inner: T }
newtype TupleKeyBoolMap = Map[(Int, String), Bool]
newtype ReversedTupleKeyBoolMap = Map[(String, Int), Bool]
