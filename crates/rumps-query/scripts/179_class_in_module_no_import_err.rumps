; CLASS instance without import; should error with helpful suggestion

FUN main() {
  ; No import; should error
  LET c = Shapes.Circle.Circle(3.14)
  WRITE Display:display(c)
}

MODULE Shapes {
  +TYPE Circle = Circle(Float)

  CLASS Display FOR Shapes.Circle {
    FUN display(c: Shapes.Circle) -> String {
      MATCH c {
        Shapes.Circle.Circle(r) => { "Circle(r={r})" }
      }
    }
  }
}
