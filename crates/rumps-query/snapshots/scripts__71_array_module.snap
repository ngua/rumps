---
source: crates/rumps-query/tests/scripts.rs
description: "; Array module functions\n; Tests Array.map, Array.filter, Array.reduce, Array.foreach\n\n; Array.map with closure\nLET nums = [1, 2, 3, 4, 5]\nLET doubled = Array.map(x => x * 2, nums)\nOUTPUT doubled  ; [2, 4, 6, 8, 10]\n\n; Array.map on empty array\nLET empty = []\nLET mapped-empty = Array.map(x => x + 1, empty)\nOUTPUT mapped-empty  ; []\n\n; Array.map with named function\nFUN square (n: Int) -> Int { n * n }\nLET squares = Array.map(square, [1, 2, 3])\nOUTPUT squares  ; [1, 4, 9]\n\n; Array.filter with closure\nLET evens = Array.filter(x => x % 2 == 0, nums)\nOUTPUT evens  ; [2, 4]\n\n; Array.filter on empty array\nLET filtered-empty = Array.filter(x => x > 0, empty)\nOUTPUT filtered-empty  ; []\n\n; Array.filter with named function\nFUN is-positive (n: Int) -> Bool { n > 0 }\nLET positives = Array.filter(is-positive, [-1, 0, 1, 2])\nOUTPUT positives  ; [1, 2]\n\n; Array.filter keeping all\nLET all-kept = Array.filter(x => TRUE, [1, 2, 3])\nOUTPUT all-kept  ; [1, 2, 3]\n\n; Array.filter keeping none\nLET none-kept = Array.filter(x => FALSE, [1, 2, 3])\nOUTPUT none-kept  ; []\n\n; Array.reduce with sum\nLET sum = Array.reduce((acc, x) => acc + x, 0, nums)\nOUTPUT sum  ; 15\n\n; Array.reduce on empty array returns initial value\nLET empty-sum = Array.reduce((acc, x) => acc + x, 100, empty)\nOUTPUT empty-sum  ; 100\n\n; Array.reduce with string concatenation\nLET words = [\"hello\", \" \", \"world\"]\nLET combined = Array.reduce((acc, s) => acc ++ s, \"\", words)\nOUTPUT combined  ; \"hello world\"\n\n; Array.reduce with named function\nFUN add (a: Int, b: Int) -> Int { a + b }\nLET total = Array.reduce(add, 0, [1, 2, 3, 4])\nOUTPUT total  ; 10\n\n; Combining Array functions\nLET result = Array.reduce(\n  (acc, x) => acc + x,\n  0,\n  Array.map(x => x * x, Array.filter(x => x % 2 == 1, [1, 2, 3, 4, 5]))\n)\nOUTPUT result  ; 1 + 9 + 25 = 35\n\n; Pipeline usage with Array functions (using wrapper closures)\nLET piped = [1, 2, 3, 4, 5]\n  |> (arr => Array.filter(x => x > 2, arr))\n  |> (arr => Array.map(x => x * 10, arr))\nOUTPUT piped  ; [30, 40, 50]\n\n; Module functions can be passed as first-class values\nLET filter-fn = Array.filter\nLET data = [1, 2, 3, 4, 5]\nLET filtered = filter-fn(x => x > 2, data)\nOUTPUT filtered  ; [3, 4, 5]\n\n; Array.map with Option results (homogeneous tagged values)\nLET with-opts = Array.map(x => Option.Some(x), [1, 2, 3])\nOUTPUT with-opts  ; [Option.Some(1), Option.Some(2), Option.Some(3)]\n\n; Nested Array.map (callback uses Array function)\nLET nested = [[1, 2], [3, 4]]\nLET doubled-nested = Array.map(arr => Array.map(x => x * 2, arr), nested)\nOUTPUT doubled-nested  ; [[2, 4], [6, 8]]\n\n; === Array.foreach ===\n\n; Array.foreach for side effects (outputs each element)\nOUTPUT \"foreach:\"\nLET fe-result = Array.foreach(x => { OUTPUT x }, [10, 20, 30])\nOUTPUT fe-result  ; Unit\n\n; Array.foreach on empty array (no side effects)\nLET fe-empty = Array.foreach(x => { OUTPUT x }, [])\nOUTPUT fe-empty  ; Unit\n\n; Array.foreach with range\nOUTPUT \"range foreach:\"\nLET fe-range = Array.foreach(n => { OUTPUT n }, 1..4)\nOUTPUT fe-range  ; Unit\n"
