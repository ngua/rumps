---
source: crates/rumps-query/tests/scripts.rs
description: "; Option and Result module primitives\n; Tests Option.unwrap-or, Result.unwrap-or, Result.map-err\n\nfun safe-div(n, d) {\n  if d == 0 { Option.None } else { Option.Some(n // d) }\n}\n\nfun parse-positive(x) {\n  if x > 0 { Option.Some(x) } else { Option.None }\n}\n\nfun halve(x) {\n  if x % 2 == 0 { Option.Some(x // 2) } else { Option.None }\n}\n\nfun safe-div-res(n, d) {\n  if d == 0 { Result.Err(\"div by zero\") } else { Result.Ok(n // d) }\n}\n\nfun validate(x) {\n  if x >= 0 { Result.Ok(x) } else { Result.Err(\"negative\") }\n}\n\nfun halve-res(x) {\n  if x % 2 == 0 { Result.Ok(x // 2) } else { Result.Err(\"odd\") }\n}\n\nfun main() {\n  ; ============ Option.unwrap-or ============\n\n  let some-val = Option.Some(42)\n  let none-val = Option.None\n\n  write Option.unwrap-or(some-val, 0)  ; 42\n  write Option.unwrap-or(none-val, 0)  ; 0\n  write Option.unwrap-or(Option.Some(\"hello\"), \"default\")  ; \"hello\"\n  write Option.unwrap-or(Option.None, \"default\")  ; \"default\"\n\n  ; ============ Result.unwrap-or ============\n\n  let ok-val = Result.Ok(100)\n  let err-val = Result.Err(\"something went wrong\")\n\n  write Result.unwrap-or(ok-val, 0)  ; 100\n  write Result.unwrap-or(err-val, 0)  ; 0\n  write Result.unwrap-or(Result.Ok(\"success\"), \"fallback\")  ; \"success\"\n  write Result.unwrap-or(Result.Err(\"fail\"), \"fallback\")  ; \"fallback\"\n\n  ; ============ Result.map-err ============\n\n  let add-prefix = e => \"Error: {e}\"\n\n  write :display(Result.map-err(Result.Err(\"failed\"), add-prefix))  ; Err(\"Error: failed\")\n  write :display(Result.map-err(Result.Ok(42), add-prefix))  ; Ok(42)\n  write :display(Result.map-err(Result.Err(\"oops\"), e => String.upper(e)))  ; Err(\"OOPS\")\n  write :display(Result.map-err(Result.Ok(\"ok\"), e => String.upper(e)))  ; Ok(\"ok\")\n\n  ; ============ Type variants still work ============\n\n  ; Ensure Option.None and Result.Ok etc. still work as type constructors\n  let opt-none = Option.None\n  let opt-some = Option.Some(1)\n  write opt-none is Option.None  ; true\n  write opt-some is Option.Some(_)  ; true\n\n  let res-ok-check = Result.Ok(1)\n  let res-err-check = Result.Err(\"x\")\n  write res-ok-check is Result.Ok(_)  ; true\n  write res-err-check is Result.Err(_)  ; true\n\n  ; ============ Chainable:chain (Option) ============\n\n  ; Returns the inner Option when Some\n  write :display(Chainable:chain(Option.Some(10), x => safe-div(x, 2)))  ; Some(5)\n  write :display(Chainable:chain(Option.Some(10), x => safe-div(x, 0)))  ; None\n  write :display(Chainable:chain(Option.None, x => safe-div(x, 2)))  ; None\n\n  ; Chaining chain\n  write :display(Chainable:chain(Chainable:chain(Option.Some(8), parse-positive), halve))  ; Some(4)\n  write :display(Chainable:chain(Chainable:chain(Option.Some(-1), parse-positive), halve))  ; None\n  write :display(Chainable:chain(Chainable:chain(Option.Some(7), parse-positive), halve))  ; None (7 is odd)\n\n  ; ============ Chainable:chain (Result) ============\n\n  ; Returns the inner Result when Ok\n  write :display(Chainable:chain(Result.Ok(10), x => safe-div-res(x, 2)))  ; Ok(5)\n  write :display(Chainable:chain(Result.Ok(10), x => safe-div-res(x, 0)))  ; Err(\"div by zero\")\n  write :display(Chainable:chain(Result.Err(\"bad input\"), x => safe-div-res(x, 2)))  ; Err(\"bad input\")\n\n  ; Chaining chain\n  write :display(Chainable:chain(Chainable:chain(Result.Ok(8), validate), halve-res))  ; Ok(4)\n  write :display(Chainable:chain(Chainable:chain(Result.Ok(-1), validate), halve-res))  ; Err(\"negative\")\n  write :display(Chainable:chain(Chainable:chain(Result.Ok(7), validate), halve-res))  ; Err(\"odd\")\n\n  ; ============ Option.flatten ============\n\n  ; Some(Some(v)) -> Some(v)\n  write :display(Option.flatten(Option.Some(Option.Some(42))))  ; Some(42)\n  write :display(Option.flatten(Option.Some(Option.Some(\"hello\"))))  ; Some(\"hello\")\n\n  ; Some(None) -> None\n  write :display(Option.flatten(Option.Some(Option.None)))  ; None\n\n  ; None -> None\n  write :display(Option.flatten(Option.None))  ; None\n\n  ; ============ Result.flatten ============\n\n  ; Ok(Ok(v)) -> Ok(v)\n  write :display(Result.flatten(Result.Ok(Result.Ok(42))))  ; Ok(42)\n  write :display(Result.flatten(Result.Ok(Result.Ok(\"success\"))))  ; Ok(\"success\")\n\n  ; Ok(Err(e)) -> Err(e)\n  write :display(Result.flatten(Result.Ok(Result.Err(\"inner error\"))))  ; Err(\"inner error\")\n\n  ; Err(e) -> Err(e)\n  write :display(Result.flatten(Result.Err(\"outer error\")))  ; Err(\"outer error\")\n\n  ; ============ Result.hush ============\n\n  ; Ok(v) -> Some(v)\n  write :display(Result.hush(Result.Ok(42)))  ; Some(42)\n  write :display(Result.hush(Result.Ok(\"hello\")))  ; Some(\"hello\")\n\n  ; Err(e) -> None (discards error)\n  write :display(Result.hush(Result.Err(\"oops\")))  ; None\n  write :display(Result.hush(Result.Err(123)))  ; None\n\n  ; Practical: convert fallible operation to optional\n  let res: Result[Int, String] = Result.Ok(100)\n  let opt2 = Result.hush(res)\n  write :display(opt2)  ; Some(100)\n\n  let bad-res: Result[Int, String] = Result.Err(\"failed\")\n  write :display(Result.hush(bad-res))  ; None\n\n  ; ============ Option.note ============\n\n  ; Some(v) -> Ok(v)\n  write :display(Option.note(\"not found\", Option.Some(42)))  ; Ok(42)\n  write :display(Option.note(\"missing\", Option.Some(\"hello\")))  ; Ok(\"hello\")\n\n  ; None -> Err(e) (using provided error)\n  write :display(Option.note(\"not found\", Option.None))  ; Err(\"not found\")\n  write :display(Option.note(404, Option.None))  ; Err(404)\n\n  ; Practical: convert optional lookup to result\n  let maybe: Option[Int] = Option.Some(999)\n  let noted: Result[Int, String] = Option.note(\"value missing\", maybe)\n  write :display(noted)  ; Ok(999)\n\n  let empty: Option[Int] = Option.None\n  write :display(Option.note(\"value missing\", empty))  ; Err(\"value missing\")\n\n  ; ============ hush/note roundtrips ============\n\n  ; Ok -> hush -> note (preserves value)\n  let start = Result.Ok(123)\n  let hushed = Result.hush(start)\n  let back: Result[Int, String] = Option.note(\"lost\", hushed)\n  write :display(back)  ; Ok(123)\n\n  ; Some -> note -> hush (preserves value)\n  let s = Option.Some(456)\n  let noted2: Result[Int, String] = Option.note(\"err\", s)\n  let h = Result.hush(noted2)\n  write :display(h)  ; Some(456)\n\n  ; Err -> hush loses information\n  let e = Result.Err(\"important error\")\n  let lost = Result.hush(e)\n  write :display(lost)  ; None\n\n  ; None -> note adds error\n  let n = Option.None\n  let gained: Result[Int, String] = Option.note(\"added error\", n)\n  write :display(gained)  ; Err(\"added error\")\n}\n"
