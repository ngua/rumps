---
source: crates/rumps-query/tests/scripts.rs
description: "; Map module primitives\n; Tests Map.empty, Map.length, Map.keys, Map.values, Map.entries,\n; Map.has, Map.lookup, Map.insert, Map.remove, Map.merge, Map.from-entries\n;\n; Note: `{}` is ambiguous and parsed as an empty object. Use Map.empty() for empty maps.\n\n; ============ Map literals ============\n\nLET m = { 1 => \"one\", 2 => \"two\", 3 => \"three\" }\nWRITE m\n\nLET str-keys = { \"a\" => 1, \"b\" => 2 }\nWRITE str-keys\n\n; ============ Map.empty ============\n\nLET e = Map.empty()\nWRITE e\nWRITE Map.length(e)  ; 0\n\n; ============ Map.length ============\n\nWRITE Map.length(m)  ; 3\nWRITE Map.length(str-keys)  ; 2\n\n; ============ Map.keys ============\n\nLET keys1 = Map.keys(m)\nWRITE keys1  ; [1, 2, 3]\n\nLET keys2 = Map.keys(str-keys)\nWRITE keys2  ; [\"a\", \"b\"]\n\nLET keys3 = Map.keys(e)\nWRITE keys3  ; []\n\n; ============ Map.values ============\n\nLET vals1 = Map.values(m)\nWRITE vals1  ; [\"one\", \"two\", \"three\"]\n\nLET vals2 = Map.values(str-keys)\nWRITE vals2  ; [1, 2]\n\nLET vals3 = Map.values(e)\nWRITE vals3  ; []\n\n; ============ Map.entries ============\n\nLET ent1 = Map.entries(m)\nWRITE ent1  ; [(1, \"one\"), (2, \"two\"), (3, \"three\")]\n\nLET ent2 = Map.entries(str-keys)\nWRITE ent2  ; [(\"a\", 1), (\"b\", 2)]\n\n; ============ Map.has ============\n\nWRITE Map.has(m, 1)  ; true\nWRITE Map.has(m, 2)  ; true\nWRITE Map.has(m, 4)  ; false\nWRITE Map.has(e, 1)  ; false\n\nWRITE Map.has(str-keys, \"a\")  ; true\nWRITE Map.has(str-keys, \"c\")  ; false\n\n; ============ Map.lookup ============\n\nWRITE Map.lookup(m, 1)  ; Some(\"one\")\nWRITE Map.lookup(m, 2)  ; Some(\"two\")\nWRITE Map.lookup(m, 4)  ; None\nWRITE Map.lookup(e, 1)  ; None\n\nWRITE Map.lookup(str-keys, \"a\")  ; Some(1)\nWRITE Map.lookup(str-keys, \"z\")  ; None\n\n; ============ Map.insert ============\n\nLET m2 = Map.insert(m, 4, \"four\")\nWRITE Map.length(m2)  ; 4\nWRITE Map.lookup(m2, 4)  ; Some(\"four\")\n\n; Original unchanged\nWRITE Map.length(m)  ; 3\n\n; Overwrite existing key\nLET m3 = Map.insert(m, 1, \"ONE\")\nWRITE Map.lookup(m3, 1)  ; Some(\"ONE\")\n\n; ============ Map.remove ============\n\nLET m4 = Map.remove(m, 2)\nWRITE Map.length(m4)  ; 2\nWRITE Map.has(m4, 2)  ; false\nWRITE Map.has(m4, 1)  ; true\nWRITE Map.has(m4, 3)  ; true\n\n; Remove non-existent key (no-op)\nLET m5 = Map.remove(m, 999)\nWRITE Map.length(m5)  ; 3\n\n; ============ Map.merge ============\n\nLET ma = { 1 => \"a\", 2 => \"b\" }\nLET mb = { 2 => \"B\", 3 => \"c\" }\nLET merged = Map.merge(ma, mb)\nWRITE Map.length(merged)  ; 3\nWRITE Map.lookup(merged, 1)  ; Some(\"a\")\nWRITE Map.lookup(merged, 2)  ; Some(\"B\") (second overwrites)\nWRITE Map.lookup(merged, 3)  ; Some(\"c\")\n\n; ============ Map.from-entries ============\n\nLET arr = [(1, \"x\"), (2, \"y\"), (3, \"z\")]\nLET from-arr = Map.from-entries(arr)\nWRITE Map.length(from-arr)  ; 3\nWRITE Map.lookup(from-arr, 1)  ; Some(\"x\")\nWRITE Map.lookup(from-arr, 2)  ; Some(\"y\")\nWRITE Map.lookup(from-arr, 3)  ; Some(\"z\")\n\n; ============ Chaining operations ============\n\nLET chain = { 1 => 10, 2 => 20, 3 => 30 }\nLET chain2 = Map.insert(chain, 4, 40)\nLET chain3 = Map.remove(chain2, 1)\nWRITE Map.length(chain3)  ; 3\nWRITE Map.keys(chain3)  ; [2, 3, 4]\n\n; ============ Float keys ============\n\nLET float-map = { 1.5 => \"half\", 2.5 => \"two-half\" }\nWRITE Map.has(float-map, 1.5)  ; true\nWRITE Map.lookup(float-map, 2.5)  ; Some(\"two-half\")\n\n; ============ Boolean keys ============\n\nLET bool-map = { true => \"yes\", false => \"no\" }\nWRITE Map.lookup(bool-map, true)  ; Some(\"yes\")\nWRITE Map.lookup(bool-map, false)  ; Some(\"no\")\n\n; ============ Index syntax (direct access) ============\n\nWRITE m[1]  ; \"one\"\nWRITE m[2]  ; \"two\"\n\nWRITE str-keys[\"a\"]  ; 1\n\n; ============ Optional index syntax (returns Option) ============\n\nWRITE m?[1]  ; Some(\"one\")\nWRITE m?[99]  ; None (key not found)\n\nWRITE str-keys?[\"a\"]  ; Some(1)\nWRITE str-keys?[\"missing\"]  ; None\n\n; Chaining with optional unwrap\nWRITE m?[1] ?? \"default\"  ; \"one\"\nWRITE m?[99] ?? \"default\"  ; \"default\"\n"
