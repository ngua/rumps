---
source: crates/rumps-query/tests/scripts.rs
description: "; Test spread operators for arrays and objects\n; Section 8 of phase-4c.md\n\n; ====== Array Spread ======\n\n; Basic array spread\nLET arr1 = [1, 2, 3]\nLET arr2 = [4, 5, 6]\nLET combined = [...arr1, ...arr2]\nOUTPUT combined\n\n; Prepend/append with spread\nLET with-zero = [0, ...arr1]\nOUTPUT with-zero\n\nLET with-four = [...arr1, 4]\nOUTPUT with-four\n\n; Mixed elements and spreads\nLET mixed = [0, ...arr1, 4, 5]\nOUTPUT mixed\n\n; Empty array spread\nLET empty: Array[Int] = []\nLET spread-empty = [...empty, 1, 2]\nOUTPUT spread-empty\n\n; Spread with single element array\nLET single = [42]\nLET spread-single = [...single, ...single]\nOUTPUT spread-single\n\n; ====== Object Spread ======\n\n; Basic object spread\nLET base = { name: \"Alice\", age: 30 }\nLET updated = { ...base, age: 31 }\nOUTPUT updated.name\nOUTPUT updated.age\n\n; Merge multiple objects\nLET defaults = { color: \"red\", size: \"medium\" }\nLET user-prefs = { size: \"large\" }\nLET config = { ...defaults, ...user-prefs }\nOUTPUT config.color\nOUTPUT config.size\n\n; Add new fields\nLET extended = { ...base, city: \"NYC\" }\nOUTPUT extended.name\nOUTPUT extended.city\n\n; Empty object spread\nLET empty-obj = { }\nLET spread-empty-obj = { ...empty-obj, x: 1 }\nOUTPUT spread-empty-obj.x\n\n; ====== Struct Spread with Preservation ======\n\n; Define a struct\nvariant Person = { name: String, age: Int }\n\n; Spread a struct value (should preserve type)\nLET alice: Person = { name: \"Alice\", age: 30 }\nLET alice-older: Person = { ...alice, age: 31 }\nOUTPUT alice-older.name\nOUTPUT alice-older.age\n\n; Adding fields to a struct (extensible record semantics)\nLET alice-with-city = { ...alice, city: \"NYC\" }\nOUTPUT alice-with-city.city\n\n; ====== Nested Spreads ======\n\n; Spread of spreads\nLET a = [1, 2]\nLET b = [3, 4]\nLET c = [5, 6]\nLET all = [...a, ...b, ...c]\nOUTPUT all\n\n; Nested object spreads\nLET o1 = { x: 1 }\nLET o2 = { y: 2 }\nLET o3 = { z: 3 }\nLET merged = { ...o1, ...o2, ...o3 }\nOUTPUT merged.x\nOUTPUT merged.y\nOUTPUT merged.z\n\nOUTPUT \"--- TESTS PASSED ---\"\n"
