; Option and Result module primitives
; Tests Option.unwrap-or, Result.unwrap-or, Result.map-err

fun safe-div(n, d) {
  if d == 0 { Option.None } else { Option.Some(n // d) }
}

fun parse-positive(x) {
  if x > 0 { Option.Some(x) } else { Option.None }
}

fun halve(x) {
  if x % 2 == 0 { Option.Some(x // 2) } else { Option.None }
}

fun safe-div-res(n, d) {
  if d == 0 { Result.Err("div by zero") } else { Result.Ok(n // d) }
}

fun validate(x) {
  if x >= 0 { Result.Ok(x) } else { Result.Err("negative") }
}

fun halve-res(x) {
  if x % 2 == 0 { Result.Ok(x // 2) } else { Result.Err("odd") }
}

fun main() {
  ; ============ Option.unwrap-or ============

  let some-val = Option.Some(42)
  let none-val = Option.None

  write Option.unwrap-or(some-val, 0)  ; 42
  write Option.unwrap-or(none-val, 0)  ; 0
  write Option.unwrap-or(Option.Some("hello"), "default")  ; "hello"
  write Option.unwrap-or(Option.None, "default")  ; "default"

  ; ============ Result.unwrap-or ============

  let ok-val = Result.Ok(100)
  let err-val = Result.Err("something went wrong")

  write Result.unwrap-or(ok-val, 0)  ; 100
  write Result.unwrap-or(err-val, 0)  ; 0
  write Result.unwrap-or(Result.Ok("success"), "fallback")  ; "success"
  write Result.unwrap-or(Result.Err("fail"), "fallback")  ; "fallback"

  ; ============ Result.map-err ============

  let add-prefix = e => "Error: {e}"

  write :display(Result.map-err(Result.Err("failed"), add-prefix))  ; Err("Error: failed")
  write :display(Result.map-err(Result.Ok(42), add-prefix))  ; Ok(42)
  write :display(Result.map-err(Result.Err("oops"), e => String.upper(e)))  ; Err("OOPS")
  write :display(Result.map-err(Result.Ok("ok"), e => String.upper(e)))  ; Ok("ok")

  ; ============ Type variants still work ============

  ; Ensure Option.None and Result.Ok etc. still work as type constructors
  let opt-none = Option.None
  let opt-some = Option.Some(1)
  write opt-none is Option.None  ; true
  write opt-some is Option.Some(_)  ; true

  let res-ok-check = Result.Ok(1)
  let res-err-check = Result.Err("x")
  write res-ok-check is Result.Ok(_)  ; true
  write res-err-check is Result.Err(_)  ; true

  ; ============ Chainable:chain (Option) ============

  ; Returns the inner Option when Some
  write :display(Chainable:chain(Option.Some(10), x => safe-div(x, 2)))  ; Some(5)
  write :display(Chainable:chain(Option.Some(10), x => safe-div(x, 0)))  ; None
  write :display(Chainable:chain(Option.None, x => safe-div(x, 2)))  ; None

  ; Chaining chain
  write :display(Chainable:chain(Chainable:chain(Option.Some(8), parse-positive), halve))  ; Some(4)
  write :display(Chainable:chain(Chainable:chain(Option.Some(-1), parse-positive), halve))  ; None
  write :display(Chainable:chain(Chainable:chain(Option.Some(7), parse-positive), halve))  ; None (7 is odd)

  ; ============ Chainable:chain (Result) ============

  ; Returns the inner Result when Ok
  write :display(Chainable:chain(Result.Ok(10), x => safe-div-res(x, 2)))  ; Ok(5)
  write :display(Chainable:chain(Result.Ok(10), x => safe-div-res(x, 0)))  ; Err("div by zero")
  write :display(Chainable:chain(Result.Err("bad input"), x => safe-div-res(x, 2)))  ; Err("bad input")

  ; Chaining chain
  write :display(Chainable:chain(Chainable:chain(Result.Ok(8), validate), halve-res))  ; Ok(4)
  write :display(Chainable:chain(Chainable:chain(Result.Ok(-1), validate), halve-res))  ; Err("negative")
  write :display(Chainable:chain(Chainable:chain(Result.Ok(7), validate), halve-res))  ; Err("odd")

  ; ============ Option.flatten ============

  ; Some(Some(v)) -> Some(v)
  write :display(Option.flatten(Option.Some(Option.Some(42))))  ; Some(42)
  write :display(Option.flatten(Option.Some(Option.Some("hello"))))  ; Some("hello")

  ; Some(None) -> None
  write :display(Option.flatten(Option.Some(Option.None)))  ; None

  ; None -> None
  write :display(Option.flatten(Option.None))  ; None

  ; ============ Result.flatten ============

  ; Ok(Ok(v)) -> Ok(v)
  write :display(Result.flatten(Result.Ok(Result.Ok(42))))  ; Ok(42)
  write :display(Result.flatten(Result.Ok(Result.Ok("success"))))  ; Ok("success")

  ; Ok(Err(e)) -> Err(e)
  write :display(Result.flatten(Result.Ok(Result.Err("inner error"))))  ; Err("inner error")

  ; Err(e) -> Err(e)
  write :display(Result.flatten(Result.Err("outer error")))  ; Err("outer error")

  ; ============ Result.hush ============

  ; Ok(v) -> Some(v)
  write :display(Result.hush(Result.Ok(42)))  ; Some(42)
  write :display(Result.hush(Result.Ok("hello")))  ; Some("hello")

  ; Err(e) -> None (discards error)
  write :display(Result.hush(Result.Err("oops")))  ; None
  write :display(Result.hush(Result.Err(123)))  ; None

  ; Practical: convert fallible operation to optional
  let res: Result[Int, String] = Result.Ok(100)
  let opt2 = Result.hush(res)
  write :display(opt2)  ; Some(100)

  let bad-res: Result[Int, String] = Result.Err("failed")
  write :display(Result.hush(bad-res))  ; None

  ; ============ Option.note ============

  ; Some(v) -> Ok(v)
  write :display(Option.note("not found", Option.Some(42)))  ; Ok(42)
  write :display(Option.note("missing", Option.Some("hello")))  ; Ok("hello")

  ; None -> Err(e) (using provided error)
  write :display(Option.note("not found", Option.None))  ; Err("not found")
  write :display(Option.note(404, Option.None))  ; Err(404)

  ; Practical: convert optional lookup to result
  let maybe: Option[Int] = Option.Some(999)
  let noted: Result[Int, String] = Option.note("value missing", maybe)
  write :display(noted)  ; Ok(999)

  let empty: Option[Int] = Option.None
  write :display(Option.note("value missing", empty))  ; Err("value missing")

  ; ============ hush/note roundtrips ============

  ; Ok -> hush -> note (preserves value)
  let start = Result.Ok(123)
  let hushed = Result.hush(start)
  let back: Result[Int, String] = Option.note("lost", hushed)
  write :display(back)  ; Ok(123)

  ; Some -> note -> hush (preserves value)
  let s = Option.Some(456)
  let noted2: Result[Int, String] = Option.note("err", s)
  let h = Result.hush(noted2)
  write :display(h)  ; Some(456)

  ; Err -> hush loses information
  let e = Result.Err("important error")
  let lost = Result.hush(e)
  write :display(lost)  ; None

  ; None -> note adds error
  let n = Option.None
  let gained: Result[Int, String] = Option.note("added error", n)
  write :display(gained)  ; Err("added error")
}
