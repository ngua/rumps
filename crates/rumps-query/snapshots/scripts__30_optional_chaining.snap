---
source: crates/rumps-query/tests/scripts.rs
description: "; Optional chaining operator (?.) tests\n; `?.` short-circuits to Option.None if base is None, otherwise wraps result in Some\n\n; === Basic optional chaining on objects ===\n\n; Regular object: wrap result in Some, then coalesce to unwrap\nLET obj = { name: \"Alice\", age: 30 }\n$OUTPUT obj?.name ?? \"N/A\"\n; Expected: Alice\n\n$OUTPUT obj?.age ?? 0\n; Expected: 30\n\n; === Optional chaining on Option.None ===\n\n; None short-circuits; field access is never attempted\nLET none = Option.None\n$OUTPUT none?.name ?? \"fallback\"\n; Expected: fallback\n\n$OUTPUT none?.anything ?? \"default\"\n; Expected: default\n\n; === Optional chaining on Option.Some ===\n\n; Some unwraps, accesses field, re-wraps in Some\nLET some = Option.Some({ x: 42, y: 99 })\n$OUTPUT some?.x ?? 0\n; Expected: 42\n\n$OUTPUT some?.y ?? 0\n; Expected: 99\n\n; === Chained optional access ===\n\n; Multiple ?. in sequence\nLET nested = { inner: { value: 123 } }\n$OUTPUT nested?.inner?.value ?? -1\n; Expected: 123\n\n; Chain through None\nLET outer = Option.None\n$OUTPUT outer?.inner?.value ?? -1\n; Expected: -1\n\n; Mixed regular and optional access\nLET obj2 = { data: { num: 55 } }\n$OUTPUT obj2.data?.num ?? 0\n; Expected: 55\n\n; === Combining with coalesce ===\n\n; Optional chaining always returns Option, coalesce unwraps\nLET person = { city: \"NYC\" }\nLET city = person?.city ?? \"Unknown\"\n$OUTPUT city\n; Expected: NYC\n\n; Missing field with coalesce fallback\nLET empty = Option.None\nLET missing = empty?.nonexistent ?? \"not found\"\n$OUTPUT missing\n; Expected: not found\n\n; === Optional chaining result is always Option ===\n\n; Without coalesce, result is Option.Some\nLET result = { value: 10 }?.value\n; result is Option.Some(10); check with IS\n$OUTPUT IF result IS Option.Some(_) { \"has value\" } ELSE { \"no value\" }\n; Expected: has value\n\n; None result\nLET result2 = Option.None?.value\n$OUTPUT IF result2 IS Option.Some(_) { \"has value\" } ELSE { \"no value\" }\n; Expected: no value\n\n$OUTPUT \"Optional chaining tests complete\"\n"
---
"Alice"
30
"fallback"
"default"
42
99
123
-1
55
"NYC"
"not found"
"has value"
"no value"
"Optional chaining tests complete"
