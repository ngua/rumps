; Test: safe indexing with `?[]` syntax
; Tests optional index access that returns `Option` instead of panicking

fun main() {
  ; Array safe indexing
  let arr = [10, 20, 30]

  ; Valid indices return Some
  write :display(arr?[0])
  ; Expected: Option.Some(10)

  write :display(arr?[1])
  ; Expected: Option.Some(20)

  write :display(arr?[2])
  ; Expected: Option.Some(30)

  ; Negative indices
  write :display(arr?[-1])
  ; Expected: Option.Some(30)

  write :display(arr?[-2])
  ; Expected: Option.Some(20)

  ; Out of bounds returns None
  write :display(arr?[3])
  ; Expected: Option.None

  write :display(arr?[100])
  ; Expected: Option.None

  write :display(arr?[-4])
  ; Expected: Option.None

  write :display(arr?[-100])
  ; Expected: Option.None

  ; String safe indexing
  let s = "hello"

  write :display(s?[0])
  ; Expected: Option.Some('h')

  write :display(s?[4])
  ; Expected: Option.Some('o')

  write :display(s?[-1])
  ; Expected: Option.Some('o')

  write :display(s?[5])
  ; Expected: Option.None

  write :display(s?[-6])
  ; Expected: Option.None

  ; Empty collections
  let empty: Array[Int] = []
  write :display(empty?[0])
  ; Expected: Option.None

  let empty-str = ""
  write :display(empty-str?[0])
  ; Expected: Option.None

  ; Map safe indexing (same as regular indexing since maps already return Option)
  let m = { "a" => 1, "b" => 2 }
  write :display(m?["a"])
  ; Expected: Option.Some(1)

  write :display(m?["z"])
  ; Expected: Option.None

  ; Chain with unwrap or coalesce
  write arr?[0] ?? -1
  ; Expected: 10

  write arr?[100] ?? -1
  ; Expected: -1

  ; Use with pattern matching
  match arr?[0] {
    Option.Some(x) => write "Got: {x}"
    Option.None => write "Nothing"
  }
  ; Expected: Got: 10

  match arr?[999] {
    Option.Some(x) => write "Got: {x}"
    Option.None => write "Nothing"
  }
  ; Expected: Nothing

  write "Safe indexing test complete"
}
