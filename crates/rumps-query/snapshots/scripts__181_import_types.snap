---
source: crates/rumps-query/tests/scripts.rs
description: "; Import types tests\n;\n; Tests that import M.{ MyType } brings type names into scope for use\n; in type annotations (let bindings).\n\n; All imports at top\nimport Shapes.{ Circle }\nimport Shapes.{ }  ; brings `Display` class instance into scope\nimport Units.{ Meters, Feet }\nimport Payload.{ Data }\nimport Geometry.{ Shape as S }\nimport Colors.{ ... }\nimport Multi.{ A, B, C }\nimport Generic.{ Box }\n\nfun main() {\n  ; ============ Named import of type ============\n\n  ; Use imported type name in annotation\n  let c1: Circle = Shapes.Circle.Circle(1.5)\n  write :display(c1)\n\n  ; ============ Named import of newtype ============\n\n  ; Use imported newtype in annotations\n  let dist: Meters = 5.0\n  let converted: Feet = Units.to-feet(dist)\n  write converted\n\n  ; ============ Named import of union ============\n\n  ; Use imported union in annotation\n  let d1: Data = 42\n  let d2: Data = \"hello\"\n  write :display(d1)\n  write :display(d2)\n\n  ; ============ Aliased import ============\n\n  ; Use alias in annotation\n  let shape: S = Geometry.Shape.Rect(10.0, 20.0)\n  write :display(shape)\n\n  ; ============ Wildcard import brings types ============\n\n  ; Types from wildcard import\n  let rgb: RGB = (255, 128, 0)\n  let color: Color = Colors.Color.Custom(rgb)\n  write :display(color)\n\n  ; ============ Multiple types from same module ============\n\n  let a: A = 1\n  let b: B = \"two\"\n  let c: C = true\n  write a\n  write b\n  write c\n\n  ; ============ Import parameterized type ============\n\n  ; Use imported parameterized type\n  let box1: Box[Int] = Generic.Box.Full(42)\n  let box2: Box[String] = Generic.Box.Empty\n  write :display(box1)\n  write :display(box2)\n}\n\nmodule Shapes {\n  +variant Circle = Circle(Float)\n\n  class Display for Circle {\n    fun display(c: Circle) -> String {\n      match c {\n        Circle.Circle(r) => { \"Circle(r={r})\" }\n      }\n    }\n  }\n}\n\nmodule Units {\n  #(transparent)\n  +newtype Meters = +Float\n  #(transparent)\n  +newtype Feet = +Float\n\n  +fun to-feet(m: Meters) -> Feet {\n    m * 3.28084\n  }\n}\n\nmodule Payload {\n  +union Data = Int | String\n}\n\nmodule Geometry {\n  #(deriving: Display)\n  +variant Shape = Rect(Float, Float) | Circle(Float)\n}\n\nmodule Colors {\n  #(transparent)\n  +newtype RGB = +(Int, Int, Int)\n  #(deriving: Display)\n  +variant Color = Red | Green | Blue | Custom(RGB)\n}\n\nmodule Multi {\n  #(transparent)\n  +newtype A = +Int\n  #(transparent)\n  +newtype B = +String\n  #(transparent)\n  +newtype C = +Bool\n}\n\nmodule Generic {\n  #(deriving: Display)\n  +variant Box[T] = Full(T) | Empty\n}\n"
---
Circle(r=1.5)
16.4042
42
"hello"
Geometry.Shape.Rect(10.0, 20.0)
Colors.Color.Custom((255, 128, 0))
1
two
true
Generic.Box.Full(42)
Generic.Box.Empty
