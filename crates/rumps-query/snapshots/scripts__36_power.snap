source: crates/rumps-query/tests/scripts.rs
description: "; Test: Power operator (**)\n; Tests exponentiation with right-associativity\n\nfun main() {\n  ; === Int ** Int ===\n\n  let sq = 2 ** 10\n  write sq\n  ; Expected: 1024\n\n  let cube = 3 ** 3\n  write cube\n  ; Expected: 27\n\n  let zero-pow = 5 ** 0\n  write zero-pow\n  ; Expected: 1\n\n  let one-pow = 7 ** 1\n  write one-pow\n  ; Expected: 7\n\n  ; === Float ** Float ===\n\n  let sqrt2 = 2.0 ** 0.5\n  write sqrt2\n  ; Expected: 1.4142135623730951 (approximately)\n\n  let cubert = 8.0 ** (1.0 / 3.0)\n  write cubert\n  ; Expected: 2.0\n\n  ; === Negative exponent (Int -> Float) ===\n\n  let half = 2 ** -1\n  write half\n  ; Expected: 0.5\n\n  let quarter = 2 ** -2\n  write quarter\n  ; Expected: 0.25\n\n  ; === Mixed Int/Float ===\n\n  let mixed1 = 4 ** 0.5\n  write mixed1\n  ; Expected: 2\n\n  let mixed2 = 2.0 ** 3\n  write mixed2\n  ; Expected: 8\n\n  ; === Right-associativity ===\n  ; 2 ** 3 ** 2 should be 2 ** (3 ** 2) = 2 ** 9 = 512\n  ; not (2 ** 3) ** 2 = 8 ** 2 = 64\n\n  let right-assoc = 2 ** 3 ** 2\n  write right-assoc\n  ; Expected: 512\n\n  ; === Precedence: higher than multiplication ===\n  ; 2 * 3 ** 2 should be 2 * (3 ** 2) = 2 * 9 = 18\n  ; not (2 * 3) ** 2 = 6 ** 2 = 36\n\n  let prec = 2 * 3 ** 2\n  write prec\n  ; Expected: 18\n\n  ; === Combinations ===\n\n  let combo = 10 ** 2 + 5\n  write combo\n  ; Expected: 105\n\n  let combo2 = (2 + 3) ** 2\n  write combo2\n  ; Expected: 25\n\n  write \"Power test complete\"\n}\n"
