---
source: crates/rumps-query/tests/scripts.rs
description: "; User-defined Indexable class with associated type Index\n;\n; Tests implementing Indexable for user types with NEWvariant Index = ...\n; to define the associated index type.\n\n; === Usage (hoisted) ===\n\n; StringMap uses String as index type (via NEWvariant Index = String)\nLET sm = StringMap.StringMap({ \"a\" => 1, \"b\" => 2, \"c\" => 3 })\n\n; Direct class method calls\nWRITE Indexable:index(sm, \"a\")\nWRITE Indexable:get(sm, \"b\")\n\n; Subscript syntax dispatches to user Indexable instance\nWRITE sm[\"a\"]\nWRITE sm[\"c\"]\n\n; Safe subscript (uses `get` method)\nWRITE sm?[\"b\"]\nWRITE sm?[\"missing\"]\n\n; === Type and Class Definitions ===\n\nvariant StringMap = StringMap(Map[String, Int])\n\nCLASS Indexable[Int] FOR StringMap {\n  NEWvariant Index = String\n\n  FUN index(sm: StringMap, i: :Index) -> Int {\n    MATCH sm {\n      StringMap.StringMap(m) => m[i]\n    }\n  }\n\n  FUN get(sm: StringMap, i: :Index) -> Option[Int] {\n    MATCH sm {\n      StringMap.StringMap(m) => m?[i]\n    }\n  }\n}\n\n; === Qualified Associated Type Syntax ===\n;\n; Associated types can also be referenced with the qualified form\n; `ClassName:AssocType` instead of the shorthand `:AssocType`.\n\nvariant IntMap = IntMap(Map[Int, String])\n\nCLASS Indexable[String] FOR IntMap {\n  NEWvariant Index = Int\n\n  ; Uses qualified `Indexable:Index` instead of shorthand `:Index`\n  FUN index(im: IntMap, i: Indexable:Index) -> String {\n    MATCH im {\n      IntMap.IntMap(m) => m[i]\n    }\n  }\n\n  FUN get(im: IntMap, i: Indexable:Index) -> Option[String] {\n    MATCH im {\n      IntMap.IntMap(m) => m?[i]\n    }\n  }\n}\n\nLET im = IntMap.IntMap({ 1 => \"one\", 2 => \"two\" })\nWRITE im[1]\nWRITE im[2]\nWRITE im?[3]\n"
---
