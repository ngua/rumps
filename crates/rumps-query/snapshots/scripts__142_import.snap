---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: import statement\n; Tests importing module members into local scope\n\n; All top-level imports must appear first\nimport Math.{ floor, ceil, sqrt as root, pi, e }\nimport Math.Trig.{ sin as sine, cos as cosine }\nimport Array.{ head, tail }\nimport Counter.{ new, inc }\nimport Forward.{ id, val }\n\nfun main() {\n  ; Basic named import\n  write floor(3.7)\n  ; Expected: 3\n\n  ; Multiple named imports\n  write :display(head([1, 2, 3]))\n  ; Expected: Some(1)\n  write :display(tail([1, 2, 3]))\n  ; Expected: [ 2, 3 ]\n\n  ; Wildcard import in nested scope (at top of scope)\n  {\n    import String.{ ... }\n    write length(\"hello\")\n    ; Expected: 5\n  }\n\n  ; User module import\n  let c = new()\n  write c\n  ; Expected: 0\n  write inc(c)\n  ; Expected: 1\n\n  ; Wildcard with exclusion in nested scope\n  {\n    import Math.{ ..., -floor }\n    write ceil(1.1)\n    ; Expected: 2\n  }\n\n  ; Import in nested scope does not leak\n  let x = 100\n  {\n    import Math.{ floor }\n    write floor(2.9)\n    ; Expected: 2\n  }\n  write x\n  ; Expected: 100\n\n  ; ceil and floor from top-level imports\n  write ceil(4.1)\n  ; Expected: 5\n  write floor(4.9)\n  ; Expected: 4\n\n  write test()\n  ; Expected: 42\n\n  ; as alias from top-level import\n  write root(16.0)\n  ; Expected: 4.0\n\n  ; Multiple aliases from top-level import\n  write sine(0.0)\n  ; Expected: 0.0\n  write cosine(0.0)\n  ; Expected: 1.0\n\n  ; Import from hoisted module\n  write id(\"hoisted\")\n  ; Expected: \"hoisted\"\n  write val\n  ; Expected: 42\n\n  ; Import builtin module constants\n  write pi\n  ; Expected: 3.141592653589793\n  write e\n  ; Expected: 2.718281828459045\n}\n\n; User module (defined after import due to hoisting)\nmodule Counter {\n  let start = 0\n  +fun new() -> Int { start }\n  +fun inc(n: Int) -> Int { n + 1 }\n}\n\n; Hoisted module (defined after import)\nmodule Forward {\n  +let val: Int = 42\n  +fun id[T](x: T) -> T { x }\n}\n\n; Import inside function body (at top of function scope)\nfun test() -> Int {\n  import Math.{ abs }\n  abs(-42)\n}\n"
