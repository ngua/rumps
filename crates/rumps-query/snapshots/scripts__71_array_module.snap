---
source: crates/rumps-query/tests/scripts.rs
description: "; Array module functions\n; Tests Iter.map, Iter.filter, Iter.reduce, Iter.foreach\n\n; Iter.map with closure\nLET nums = [1, 2, 3, 4, 5]\nLET doubled = Iter.map(x => x * 2, nums)\nWRITE doubled  ; [2, 4, 6, 8, 10]\n\n; Iter.map on empty array\nLET empty = []\nLET mapped-empty = Iter.map(x => x + 1, empty)\nWRITE mapped-empty  ; []\n\n; Iter.map with named function\nFUN square (n: Int) -> Int { n * n }\nLET squares = Iter.map(square, [1, 2, 3])\nWRITE squares  ; [1, 4, 9]\n\n; Iter.filter with closure\nLET evens = Iter.filter(x => x % 2 == 0, nums)\nWRITE evens  ; [2, 4]\n\n; Iter.filter on empty array\nLET filtered-empty = Iter.filter(x => x > 0, empty)\nWRITE filtered-empty  ; []\n\n; Iter.filter with named function\nFUN is-positive (n: Int) -> Bool { n > 0 }\nLET positives = Iter.filter(is-positive, [-1, 0, 1, 2])\nWRITE positives  ; [1, 2]\n\n; Iter.filter keeping all\nLET all-kept = Iter.filter(x => TRUE, [1, 2, 3])\nWRITE all-kept  ; [1, 2, 3]\n\n; Iter.filter keeping none\nLET none-kept = Iter.filter(x => FALSE, [1, 2, 3])\nWRITE none-kept  ; []\n\n; Iter.reduce with sum\nLET sum = Iter.reduce((acc, x) => acc + x, 0, nums)\nWRITE sum  ; 15\n\n; Iter.reduce on empty array returns initial value\nLET empty-sum = Iter.reduce((acc, x) => acc + x, 100, empty)\nWRITE empty-sum  ; 100\n\n; Iter.reduce with string concatenation\nLET words = [\"hello\", \" \", \"world\"]\nLET combined = Iter.reduce((acc, s) => \"{acc}{s}\", \"\", words)\nWRITE combined  ; \"hello world\"\n\n; Iter.reduce with named function\nFUN add (a: Int, b: Int) -> Int { a + b }\nLET total = Iter.reduce(add, 0, [1, 2, 3, 4])\nWRITE total  ; 10\n\n; Combining Array functions\nLET result = Iter.reduce(\n  (acc, x) => acc + x,\n  0,\n  Iter.map(x => x * x, Iter.filter(x => x % 2 == 1, [1, 2, 3, 4, 5]))\n)\nWRITE result  ; 1 + 9 + 25 = 35\n\n; Pipeline usage with Array functions (using wrapper closures)\nLET piped = [1, 2, 3, 4, 5]\n  |> (arr => Iter.filter(x => x > 2, arr))\n  |> (arr => Iter.map(x => x * 10, arr))\nWRITE piped  ; [30, 40, 50]\n\n; Module functions can be passed as first-class values\nLET filter-fn = Iter.filter\nLET data = [1, 2, 3, 4, 5]\nLET filtered = filter-fn(x => x > 2, data)\nWRITE filtered  ; [3, 4, 5]\n\n; Iter.map with Option results (homogeneous tagged values)\nLET with-opts = Iter.map(x => Option.Some(x), [1, 2, 3])\nWRITE with-opts  ; [Option.Some(1), Option.Some(2), Option.Some(3)]\n\n; Nested Iter.map (callback uses Array function)\nLET nested = [[1, 2], [3, 4]]\nLET doubled-nested = Iter.map(arr => Iter.map(x => x * 2, arr), nested)\nWRITE doubled-nested  ; [[2, 4], [6, 8]]\n\n; === Iter.foreach ===\n\n; Iter.foreach for side effects (outputs each element)\nWRITE \"foreach:\"\nLET fe-result = Iter.foreach(x => { WRITE x }, [10, 20, 30])\nWRITE fe-result  ; Unit\n\n; Iter.foreach on empty array (no side effects)\nLET fe-empty = Iter.foreach(x => { WRITE x }, [])\nWRITE fe-empty  ; Unit\n\n; Iter.foreach with range\nWRITE \"range foreach:\"\nLET fe-range = Iter.foreach(n => { WRITE n }, 1 .. 4)\nWRITE fe-range  ; Unit\n\n; === Array.zip ===\n\nLET a = [1, 2, 3]\nLET b = [\"a\", \"b\", \"c\"]\nLET zipped = Array.zip(a, b)\nWRITE zipped\n\n; Shorter array determines length\nLET short = [1, 2]\nLET long = [\"a\", \"b\", \"c\", \"d\"]\nWRITE Array.zip(short, long)\n\n; === Array.unzip ===\n\nLET pairs: Array[(Int, String)] = [(1, \"one\"), (2, \"two\"), (3, \"three\")]\nLET (unzip-nums, unzip-strs) = Array.unzip(pairs)\nWRITE unzip-nums\nWRITE unzip-strs\n\n; Round-trip\nLET x = [10, 20, 30]\nLET y = [true, false, true]\nLET (x2, y2) = Array.unzip(Array.zip(x, y))\nWRITE x2\nWRITE y2\n\n; === Array.intersperse ===\n\nLET inter-words = [\"hello\", \"world\", \"!\"]\nWRITE Array.intersperse(\",\", inter-words)\n\nLET inter-nums = [1, 2, 3, 4]\nWRITE Array.intersperse(0, inter-nums)\n\n; Empty array\nLET inter-empty: Array[Int] = []\nWRITE Array.intersperse(0, inter-empty)\n\n; Single element\nWRITE Array.intersperse(0, [42])\n\n; === Array.zip-with ===\n\nFUN zip-add(za: Int, zb: Int) -> Int { za + zb }\nLET xs = [1, 2, 3]\nLET ys = [10, 20, 30]\nWRITE Array.zip-with(zip-add, xs, ys)\n\n; With closure\nLET multiplied = Array.zip-with((ma, mb) => ma * mb, [2, 3, 4], [5, 6, 7])\nWRITE multiplied\n\n; With shorter array\nWRITE Array.zip-with(zip-add, [1, 2, 3, 4, 5], [10, 20])\n\n; === Array.sort-by ===\n\nFUN cmp-int(ca: Int, cb: Int) -> Ordering {\n  IF ca < cb { Ordering.Lt } ELSE {\n    IF ca == cb { Ordering.Eq } ELSE { Ordering.Gt }\n  }\n}\n\nLET unsorted = [3, 1, 4, 1, 5, 9, 2, 6]\nWRITE Array.sort-by(cmp-int, unsorted)\n\n; Sort descending (reverse comparator)\nFUN cmp-desc(da: Int, db: Int) -> Ordering {\n  IF da > db { Ordering.Lt } ELSE {\n    IF da == db { Ordering.Eq } ELSE { Ordering.Gt }\n  }\n}\nWRITE Array.sort-by(cmp-desc, unsorted)\n\n; Sort by absolute value\nFUN cmp-abs(aa: Int, ab: Int) -> Ordering {\n  LET abs-a = IF aa < 0 { 0 - aa } ELSE { aa }\n  LET abs-b = IF ab < 0 { 0 - ab } ELSE { ab }\n  cmp-int(abs-a, abs-b)\n}\nLET signed = [-5, 3, -1, 4, -2]\nWRITE Array.sort-by(cmp-abs, signed)\n\n; Sort objects by field\nNEWTYPE SortPerson = { name: String, age: Int }\n\nFUN cmp-by-age(pa: SortPerson, pb: SortPerson) -> Ordering {\n  cmp-int(pa.age, pb.age)\n}\n\nLET people = [\n  { name: \"Alice\", age: 30 },\n  { name: \"Bob\", age: 25 },\n  { name: \"Carol\", age: 35 }\n]\nLET by-age = Array.sort-by(cmp-by-age, people)\nWRITE Iter.map(p => p.name, by-age)\n\n; === Chained operations ===\n\n; zip, map, filter chain\nLET indices = [0, 1, 2, 3, 4]\nLET values = [10, 25, 30, 15, 40]\nLET indexed = Array.zip(indices, values)\nLET chain-filtered = Iter.filter(pair => pair.1 > 20, indexed)\nWRITE chain-filtered\n\n; zip-with to compute differences\nLET before = [10, 20, 30]\nLET after = [15, 18, 35]\nLET diffs = Array.zip-with((db, da) => da - db, before, after)\nWRITE diffs\n\n; === Union types with Iterable constraint ===\n\n; Union of iterable types should satisfy Iterable[T] constraint\nFUN iter-len(i: Range | Array[Int]) -> Int {\n  Iter.length(i)\n}\n\nWRITE iter-len(1 ..= 20)\nWRITE iter-len([1, 2, 3, 4, 5])\n\n; Using Iter.map with union type\nFUN iter-sum(i: Range | Array[Int]) -> Int {\n  Iter.reduce((acc, x) => acc + x, 0, i)\n}\n\nWRITE iter-sum(1 ..= 5)\nWRITE iter-sum([10, 20, 30])\n"
