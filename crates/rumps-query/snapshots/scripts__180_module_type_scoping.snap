---
source: crates/rumps-query/tests/scripts.rs
description: "; Module type scoping tests\n;\n; Tests that TYPE, NEWTYPE, and UNION declared in a module can be used\n; without full qualification from within the same module.\n\n; Import to bring class instances into scope\nIMPORT Shapes.{ }\n\n; ============ TYPE variants with unqualified type names ============\n\nMODULE Shapes {\n  +TYPE Circle = Circle(Float)\n\n  ; Use unqualified `Circle` in CLASS declaration\n  CLASS Display FOR Circle {\n    FUN display(c: Circle) -> String {\n      MATCH c {\n        Circle.Circle(r) => { \"Circle(r={r})\" }\n      }\n    }\n  }\n\n  ; Function using unqualified type in signature\n  +FUN area(c: Circle) -> Float {\n    MATCH c {\n      Circle.Circle(r) => { 3.14159 * r * r }\n    }\n  }\n}\n\nLET c = Shapes.Circle.Circle(2.0)\nWRITE Display:display(c)\nWRITE Shapes.area(c)\n\n; ============ NEWTYPE with unqualified type names ============\n\nMODULE Units {\n  +NEWTYPE Meters = Float\n  +NEWTYPE Feet = Float\n\n  ; Function using unqualified newtypes in signature\n  +FUN meters-to-feet(m: Meters) -> Feet {\n    m * 3.28084\n  }\n\n  ; Function returning unqualified newtype\n  +FUN double(m: Meters) -> Meters {\n    m * 2.0\n  }\n}\n\nLET dist: Units.Meters = 10.0\nWRITE Units.meters-to-feet(dist)\nWRITE Units.double(dist)\n\n; ============ UNION with unqualified type names ============\n\nMODULE Data {\n  +UNION Value = Int | String | Bool\n\n  ; Function using unqualified union in signature\n  +FUN describe(v: Value) -> String {\n    IF v IS Int { \"integer\" } ELSE {\n      IF v IS String { \"string\" } ELSE { \"boolean\" }\n    }\n  }\n}\n\nLET v1: Data.Value = 42\nLET v2: Data.Value = \"hello\"\nLET v3: Data.Value = TRUE\nWRITE Data.describe(v1)\nWRITE Data.describe(v2)\nWRITE Data.describe(v3)\n\n; ============ TYPE with type parameters unqualified ============\n\nMODULE Container {\n  +TYPE Box[T] = Box(T) | Empty\n\n  ; Function using unqualified parameterized type\n  +FUN unwrap-or[T](b: Box[T], default: T) -> T {\n    MATCH b {\n      Box.Box(v) => { v }\n      Box.Empty => { default }\n    }\n  }\n\n  ; Function creating unqualified variant\n  +FUN wrap[T](v: T) -> Box[T] {\n    Box.Box(v)\n  }\n}\n\nLET box1 = Container.Box.Box(42)\nLET box2: Container.Box[Int] = Container.Box.Empty\nWRITE Container.unwrap-or(box1, 0)\nWRITE Container.unwrap-or(box2, -1)\nWRITE Container.unwrap-or(Container.wrap(100), 0)\n\n; ============ Mixed types in same module ============\n\nMODULE Mixed {\n  +TYPE Status = Pending | Done\n  +NEWTYPE Id = Int\n  +UNION Payload = Int | String\n\n  ; Function using all three unqualified\n  +FUN process(id: Id, status: Status, payload: Payload) -> String {\n    LET s = MATCH status {\n      Status.Pending => { \"pending\" }\n      Status.Done => { \"done\" }\n    }\n    LET p = IF payload IS Int { \"int\" } ELSE { \"string\" }\n    \"id={id}, status={s}, payload={p}\"\n  }\n}\n\nLET id: Mixed.Id = 123\nLET status = Mixed.Status.Done\nLET payload: Mixed.Payload = \"data\"\nWRITE Mixed.process(id, status, payload)\n"
---
"Circle(r=2.0)"
12.56636
32.8084
20.0
"integer"
"string"
"boolean"
42
-1
100
"id=123, status=done, payload=string"
