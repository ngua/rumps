; Test: Transaction modifiers
; Tests ON CONFLICT, WITH TIMEOUT, WITH PRIORITY, WITH ISOLATION
;
; Modifier ordering:
;   Modifiers must appear in this fixed order (each is optional):
;     1. ON CONFLICT (ABORT | RETRY n | SKIP | OVERWRITE)
;     2. WITH TIMEOUT <expr>
;     3. WITH PRIORITY (LOW | NORMAL | HIGH)
;     4. WITH ISOLATION SNAPSHOT
;
;   Each modifier can appear at most once. Out-of-order or duplicate
;   modifiers will produce a parse error.

; === ON CONFLICT ABORT (default) ===
LET r1 = TRANSACTION {
  $SET ^data(1) = "one"
} ON CONFLICT ABORT
$OUTPUT r1 IS Result.Ok(_)

; === ON CONFLICT SKIP ===
LET r2 = TRANSACTION {
  $SET ^data(2) = "two"
} ON CONFLICT SKIP
$OUTPUT r2 IS Result.Ok(_)

; === ON CONFLICT OVERWRITE ===
LET r3 = TRANSACTION {
  $SET ^data(3) = "three"
} ON CONFLICT OVERWRITE
$OUTPUT r3 IS Result.Ok(_)

; === ON CONFLICT RETRY n ===
LET r4 = TRANSACTION {
  $SET ^data(4) = "four"
} ON CONFLICT RETRY 3
$OUTPUT r4 IS Result.Ok(_)

; === WITH TIMEOUT (milliseconds) ===
LET r5 = TRANSACTION {
  $SET ^data(5) = "five"
} WITH TIMEOUT 5000
$OUTPUT r5 IS Result.Ok(_)

; === WITH PRIORITY HIGH ===
LET r6 = TRANSACTION {
  $SET ^data(6) = "six"
} WITH PRIORITY HIGH
$OUTPUT r6 IS Result.Ok(_)

; === WITH PRIORITY LOW ===
LET r7 = TRANSACTION {
  $SET ^data(7) = "seven"
} WITH PRIORITY LOW
$OUTPUT r7 IS Result.Ok(_)

; === WITH PRIORITY NORMAL ===
LET r8 = TRANSACTION {
  $SET ^data(8) = "eight"
} WITH PRIORITY NORMAL
$OUTPUT r8 IS Result.Ok(_)

; === WITH ISOLATION SNAPSHOT ===
LET r9 = TRANSACTION {
  $SET ^data(9) = "nine"
} WITH ISOLATION SNAPSHOT
$OUTPUT r9 IS Result.Ok(_)

; === Combined modifiers ===
LET r10 = TRANSACTION {
  $SET ^data(10) = "ten"
} ON CONFLICT RETRY 3 WITH TIMEOUT 5000 WITH PRIORITY HIGH
$OUTPUT r10 IS Result.Ok(_)

; === All modifiers ===
LET r11 = TRANSACTION {
  $SET ^data(11) = "eleven"
} ON CONFLICT OVERWRITE WITH TIMEOUT 1000 WITH PRIORITY LOW WITH ISOLATION SNAPSHOT
$OUTPUT r11 IS Result.Ok(_)

; === Timeout from expression ===
LET timeout-ms = 2000
LET r12 = TRANSACTION {
  $SET ^data(12) = "twelve"
} WITH TIMEOUT timeout-ms
$OUTPUT r12 IS Result.Ok(_)

; === Case-insensitivity ===
; Contextual keywords are matched case-insensitively (like RUMPS keywords)
LET r13 = TRANSACTION {
  $SET ^data(13) = "thirteen"
} on conflict abort with timeout 1000
$OUTPUT r13 IS Result.Ok(_)

; Mixed case also works
LET r14 = TRANSACTION {
  $SET ^data(14) = "fourteen"
} On Conflict Skip With Priority High
$OUTPUT r14 IS Result.Ok(_)

; === Contextual identifiers as variables ===
LET on = "on"
LET conflict = "conflict"
LET timeout = 1000
LET with = "with"
LET priority = "priority"
LET isolation = "isolation"
$OUTPUT on ++ " " ++ conflict

; Can use these as variable names and still use modifiers
LET r15 = TRANSACTION {
  $SET ^data(15) = on ++ conflict
} WITH TIMEOUT timeout
$OUTPUT r15 IS Result.Ok(_)
$OUTPUT $GET ^data(15)

$OUTPUT "Transaction modifiers test complete"
