; Ordering type tests

; === Ordering variant construction ===

LET lt = Ordering.Lt
LET eq = Ordering.Eq
LET gt = Ordering.Gt

@OUTPUT lt
@OUTPUT eq
@OUTPUT gt

; === Pattern matching on Ordering ===

FUN describe(ord: Ordering) -> String {
  MATCH ord {
    Ordering.Lt => { "less than" }
    Ordering.Eq => { "equal" }
    Ordering.Gt => { "greater than" }
  }
}

@OUTPUT describe(Ordering.Lt)
@OUTPUT describe(Ordering.Eq)
@OUTPUT describe(Ordering.Gt)

; === Using Ordering as function result ===

FUN compare-int(a: Int, b: Int) -> Ordering {
  IF a < b { Ordering.Lt } ELSE {
    IF a == b { Ordering.Eq } ELSE { Ordering.Gt }
  }
}

@OUTPUT describe(compare-int(1, 2))
@OUTPUT describe(compare-int(2, 2))
@OUTPUT describe(compare-int(3, 2))

; === Ordering in data structures ===

LET orderings: Array[Ordering] = [Ordering.Lt, Ordering.Eq, Ordering.Gt]
@OUTPUT Array.length(orderings)

LET mapped = Array.map(describe, orderings)
@OUTPUT mapped

; === Ordering in match with guards ===

FUN classify(ord: Ordering) -> Int {
  MATCH ord {
    Ordering.Lt => { -1 }
    Ordering.Eq => { 0 }
    Ordering.Gt => { 1 }
  }
}

@OUTPUT classify(Ordering.Lt)
@OUTPUT classify(Ordering.Eq)
@OUTPUT classify(Ordering.Gt)

; === Type annotation with Ordering ===

LET typed: Ordering = Ordering.Gt
@OUTPUT describe(typed)

FUN identity(ord: Ordering) -> Ordering {
  ord
}

@OUTPUT describe(identity(Ordering.Eq))
