; Module-level mutual recursion: functions within a module calling each other

fun main() {
  ; Test mutual recursion via module path
  write Parity.is-even(0)
  write Parity.is-even(4)
  write Parity.is-even(7)
  write Parity.is-odd(0)
  write Parity.is-odd(3)
  write Parity.is-odd(6)

  write Math.Fibonacci.fib(0)
  write Math.Fibonacci.fib(1)
  write Math.Fibonacci.fib(10)
}

module Parity {
    +fun is-even(n: Int) -> Bool {
        if n == 0 { true } else { is-odd(n - 1) }
    }

    +fun is-odd(n: Int) -> Bool {
        if n == 0 { false } else { is-even(n - 1) }
    }
}

; Nested module with mutual recursion
module Math {
    module Fibonacci {
        ; Mutually recursive helper functions
        +fun fib(n: Int) -> Int {
            if n <= 1 { n } else { fib-sum(n) }
        }

        fun fib-sum(n: Int) -> Int {
            fib(n - 1) + fib(n - 2)
        }
    }
}
