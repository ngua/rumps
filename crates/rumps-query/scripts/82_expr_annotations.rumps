; Test: Expression type annotations
; Tests `(expr) : Type` syntax for inline type annotations

; === Basic expression annotations ===

; Int annotation
LET x = (42) : Int
OUTPUT x
; Expected: 42

; String annotation
LET s = ("hello") : String
OUTPUT s
; Expected: hello

; Bool annotation
LET b = (TRUE) : Bool
OUTPUT b
; Expected: TRUE

; Float annotation
LET f = (3.14) : Float
OUTPUT f
; Expected: 3.14

; === Annotating expressions ===

; Annotate arithmetic expression
LET sum = (1 + 2) : Int
OUTPUT sum
; Expected: 3

; Annotate function call result
LET len = (Array.length([1, 2, 3])) : Int
OUTPUT len
; Expected: 3

; === Parameterized type annotations ===

; Option[Int] with Some
LET opt = (Option.Some(10)) : Option[Int]
OUTPUT opt
; Expected: Option.Some(10)

; Option[String] with None
LET none = (Option.None) : Option[String]
OUTPUT none
; Expected: Option.None

; Result[Int, String] with Ok
LET res = (Result.Ok(42)) : Result[Int, String]
OUTPUT res
; Expected: Result.Ok(42)

; === Nested type annotations ===

; Array[Int]
LET arr = ([1, 2, 3]) : Array[Int]
OUTPUT arr
; Expected: [ 1, 2, 3 ]

; === Chained usage ===

; Use annotated expression in pipeline
LET piped = (5) : Int |> (n => n * 2)
OUTPUT piped
; Expected: 10

; Use in arithmetic
LET doubled = (10) : Int + (20) : Int
OUTPUT doubled
; Expected: 30

; === Tuple with type annotation (double parens) ===

; Annotate a tuple with double parentheses
LET tup = ((1, 2)) : (Int, Int)
OUTPUT tup
; Expected: ( 1, 2 )

; Tuple in arithmetic context
LET pair = ((10, 20)) : (Int, Int)
OUTPUT pair.0 + pair.1
; Expected: 30

OUTPUT "Expression annotation test complete"
