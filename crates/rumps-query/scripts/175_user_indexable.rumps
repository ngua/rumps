; User-defined Indexable class with associated type Index
;
; Tests implementing Indexable for user types with newtype Index = ...
; to define the associated index type.

fun main() {
  ; === Usage (hoisted) ===

  ; StringMap uses String as index type (via newtype Index = String)
  let sm = StringMap.StringMap({ "a" => 1, "b" => 2, "c" => 3 })

  ; Direct class method calls
  write Indexable:index(sm, "a")
  write Indexable:get(sm, "b")

  ; Subscript syntax dispatches to user Indexable instance
  write sm["a"]
  write sm["c"]

  ; Safe subscript (uses `get` method)
  write sm?["b"]
  write sm?["missing"]

  let im = ({ 1 => "one", 2 => "two" } : IntMap)
  write im[1]
  write im[2]
  write im?[3]

  ; Builtin `Map` uses `Indexable:Index = K` and `Indexable[V]`.
  let m: Map[String, Int] = { "a" => 1 }
  let map-index: Int = Indexable:index(m, "a")
  write map-index

  let map-get: Option[Int] = Indexable:get(m, "a")
  write map-get

  let map-missing: Option[Int] = m?["missing"]
  write map-missing

  let arr = [10]
  let arr-index: Int = Indexable:index(arr, 0)
  write arr-index

  let arr-get: Option[Int] = Indexable:get(arr, 0)
  write arr-get
}

; === Type and Class Definitions ===

variant StringMap = StringMap(Map[String, Int])

class Indexable[Int] for StringMap {
  newtype Index = String

  fun index(sm: StringMap, i: :Index) -> Int {
    match sm {
      StringMap.StringMap(m) => m[i]
    }
  }

  fun get(sm: StringMap, i: :Index) -> Option[Int] {
    match sm {
      StringMap.StringMap(m) => m?[i]
    }
  }
}

; === Qualified Associated Type Syntax ===
;
; Associated types can also be referenced with the qualified form
; `ClassName:AssocType` instead of the shorthand `:AssocType`.

newtype IntMap = Map[Int, String]

class Indexable[String] for IntMap {
  newtype Index = Int

  ; Uses qualified `Indexable:Index` instead of shorthand `:Index`
  fun index(im: IntMap, i: Indexable:Index) -> String {
    im[i]
  }

  fun get(im: IntMap, i: Indexable:Index) -> Option[String] {
    im?[i]
  }
}
