---
source: crates/rumps-query/tests/scripts.rs
description: "; Io.Directory module primitives\n; Tests file system operations\n;\n; NOTE: Uses a unique temp directory under /tmp that is cleaned up at the end\n\n; ============ Setup: create temp directory ============\n\n; Generate unique directory name using Random.uuid\nLET test-uuid = Random.uuid()\nLET test-dir-path = \"/tmp/rumps-test-\" ++ test-uuid\nLET test-dir = test-dir-path AS FilePath\n\n; Create the test directory\nLET _ = Io.Directory.create-dir(test-dir)\n\n; ============ FilePath coercion ============\n\n; Create FilePath via AS cast\nLET p1 = \"/tmp/rumps-test\" AS FilePath\nOUTPUT p1 IS FilePath  ; true\n\n; ============ pwd ============\n\n; Get current working directory\nLET cwd = Io.Directory.pwd()\nOUTPUT cwd IS FilePath  ; true\n\n; ============ exists / is-file / is-dir ============\n\n; Check if test directory exists and is a directory\nLET dir-exists = Io.Directory.exists(test-dir)\nOUTPUT dir-exists  ; true\n\nLET dir-is-dir = Io.Directory.is-dir(test-dir)\nOUTPUT dir-is-dir  ; true\n\nLET dir-is-file = Io.Directory.is-file(test-dir)\nOUTPUT dir-is-file  ; false\n\n; Check non-existent path\nLET fake = \"/nonexistent/path/xyz123\" AS FilePath\nLET fake-exists = Io.Directory.exists(fake)\nOUTPUT fake-exists  ; false\n\n; ============ get-env ============\n\n; PATH environment variable should exist on most systems\nLET path-env = Io.Directory.get-env(\"PATH\")\nOUTPUT path-env IS Option[String]  ; true\n\n; Non-existent env var\nLET no-such-var = Io.Directory.get-env(\"RUMPS_NONEXISTENT_VAR_12345\")\nOUTPUT no-such-var  ; Option.None\n\n; ============ write-file / read-file ============\n\n; Write a file to our temp directory\nLET test-file-path = test-dir-path ++ \"/test-file.txt\"\nLET test-file = test-file-path AS FilePath\nLET test-contents = \"Hello, RUMPS!\"\n\nLET _ = Io.Directory.write-file({ path: test-file, contents: test-contents })\n\n; Verify the file exists\nLET file-exists = Io.Directory.exists(test-file)\nOUTPUT file-exists  ; true\n\nLET file-is-file = Io.Directory.is-file(test-file)\nOUTPUT file-is-file  ; true\n\n; Read the file back\nLET read-contents = Io.Directory.read-file(test-file)\nOUTPUT read-contents  ; Hello, RUMPS!\n\n; ============ append-file ============\n\n; Append to the file\nLET append-str = \"\\nAppended line\"\nLET _ = Io.Directory.append-file({ path: test-file, contents: append-str })\n\n; Read the updated file\nLET appended-contents = Io.Directory.read-file(test-file)\nOUTPUT appended-contents  ; Hello, RUMPS!\\nAppended line\n\n; ============ create-dir / create-dir-all ============\n\n; Create a single directory\nLET subdir-path = test-dir-path ++ \"/subdir\"\nLET subdir = subdir-path AS FilePath\nLET _ = Io.Directory.create-dir(subdir)\n\nLET subdir-exists = Io.Directory.exists(subdir)\nOUTPUT subdir-exists  ; true\n\n; Create nested directories\nLET nested-path = test-dir-path ++ \"/a/b/c\"\nLET nested = nested-path AS FilePath\nLET _ = Io.Directory.create-dir-all(nested)\n\nLET nested-exists = Io.Directory.exists(nested)\nOUTPUT nested-exists  ; true\n\n; ============ list-dir ============\n\n; List contents of test directory (should have at least test-file.txt and subdir)\nLET entries = Io.Directory.list-dir(test-dir)\nOUTPUT entries IS Array[Path]  ; true\n\n; Each entry is a Path (File or Dir)\nLET first = Array.head(entries)\nOUTPUT first IS Option[Path]  ; true\n\n; Should have multiple entries\nLET entry-count = Array.length(entries)\nOUTPUT entry-count >= 2  ; true (at least test-file.txt and subdir)\n\n; ============ copy-path ============\n\n; Copy the test file\nLET copy-dest-path = test-dir-path ++ \"/test-file-copy.txt\"\nLET copy-dest = copy-dest-path AS FilePath\nLET _ = Io.Directory.copy-path({ src: test-file, dest: copy-dest })\n\nLET copy-exists = Io.Directory.exists(copy-dest)\nOUTPUT copy-exists  ; true\n\n; Verify contents are the same\nLET copy-contents = Io.Directory.read-file(copy-dest)\nOUTPUT copy-contents == appended-contents  ; true\n\n; ============ move-path ============\n\n; Move (rename) the copy\nLET move-dest-path = test-dir-path ++ \"/test-file-moved.txt\"\nLET move-dest = move-dest-path AS FilePath\nLET _ = Io.Directory.move-path({ src: copy-dest, dest: move-dest })\n\n; Original should not exist\nLET old-exists = Io.Directory.exists(copy-dest)\nOUTPUT old-exists  ; false\n\n; New location should exist\nLET new-exists = Io.Directory.exists(move-dest)\nOUTPUT new-exists  ; true\n\n; ============ remove ============\n\n; Remove the moved file\nLET _ = Io.Directory.remove(move-dest)\n\nLET removed-exists = Io.Directory.exists(move-dest)\nOUTPUT removed-exists  ; false\n\n; ============ set-pwd ============\n\n; Save current directory, change to temp dir, then restore\nLET orig-cwd = Io.Directory.pwd()\nLET _ = Io.Directory.set-pwd(test-dir)\n\nLET new-cwd = Io.Directory.pwd()\n; The new cwd should end with our test dir name\nOUTPUT Io.Directory.is-dir(new-cwd)  ; true\n\n; Restore original cwd\nLET _ = Io.Directory.set-pwd(orig-cwd)\n\n; ============ set-env ============\n\n; Set an environment variable\nLET _ = Io.Directory.set-env({ name: \"RUMPS_TEST_VAR\", value: \"test-value-123\" })\n\n; Read it back\nLET env-val = Io.Directory.get-env(\"RUMPS_TEST_VAR\")\nOUTPUT env-val  ; Option.Some(\"test-value-123\")\n\n; ============ Path AS FilePath ============\n\n; Path.File can be cast to FilePath\nLET file-path = Path.File(test-file) AS FilePath\nOUTPUT file-path IS FilePath  ; true\n\n; Path.Dir can be cast to FilePath\nLET dir-path = Path.Dir(test-dir) AS FilePath\nOUTPUT dir-path IS FilePath  ; true\n\n; ============ canonicalize ============\n\n; Canonicalize the test directory\nLET canonical = Io.Directory.canonicalize(test-dir)\nOUTPUT canonical IS FilePath  ; true\nOUTPUT Io.Directory.exists(canonical)  ; true\n\n; ============ parent ============\n\n; Get parent of test file\nLET file-parent = Io.Directory.parent(test-file)\nOUTPUT file-parent IS Option[FilePath]  ; true\n\n; The parent should exist (use unwrap-or to get the value)\nLET parent-fp = Option.unwrap-or(file-parent, \"/\" AS FilePath)\nOUTPUT Io.Directory.exists(parent-fp)  ; true\n\n; Root has no parent (or returns empty)\nLET root-parent = Io.Directory.parent(\"/\" AS FilePath)\nOUTPUT root-parent  ; Option.None\n\n; ============ file-name ============\n\n; Get file name of test file\nLET fname = Io.Directory.file-name(test-file)\nOUTPUT fname  ; Option.Some(\"test-file.txt\")\n\n; Get file name of directory\nLET dname = Io.Directory.file-name(test-dir)\nOUTPUT dname IS Option[String]  ; true\n\n; ============ extension ============\n\n; Get extension of test file\nLET ext = Io.Directory.extension(test-file)\nOUTPUT ext  ; Option.Some(\"txt\")\n\n; Get extension of file without extension\nLET no-ext-path = test-dir-path ++ \"/noext\"\nLET no-ext-file = no-ext-path AS FilePath\nLET _ = Io.Directory.write-file({ path: no-ext-file, contents: \"no extension\" })\nLET no-ext = Io.Directory.extension(no-ext-file)\nOUTPUT no-ext  ; Option.None\n\n; ============ with-extension ============\n\n; Change extension\nLET new-ext = Io.Directory.with-extension(test-file, \"md\")\nOUTPUT Io.Directory.extension(new-ext)  ; Option.Some(\"md\")\n\n; Add extension\nLET added-ext = Io.Directory.with-extension(no-ext-file, \"json\")\nOUTPUT Io.Directory.extension(added-ext)  ; Option.Some(\"json\")\n\n; ============ join ============\n\n; Join path components\nLET joined = Io.Directory.join(test-dir, [\"foo\", \"bar\", \"baz.txt\"])\nOUTPUT joined IS FilePath  ; true\nOUTPUT Io.Directory.file-name(joined)  ; Option.Some(\"baz.txt\")\n\n; ============ temp-dir ============\n\n; Get system temp directory\nLET tmp = Io.Directory.temp-dir()\nOUTPUT tmp IS FilePath  ; true\nOUTPUT Io.Directory.is-dir(tmp)  ; true\n\n; ============ Cleanup: remove-all ============\n\n; Clean up the entire test directory\nLET _ = Io.Directory.remove-all(test-dir)\n\nLET cleanup-exists = Io.Directory.exists(test-dir)\nOUTPUT cleanup-exists  ; false\n\nOUTPUT \"All Io.Directory tests passed\"\n"
