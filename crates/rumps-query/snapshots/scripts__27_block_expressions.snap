source: crates/rumps-query/tests/scripts.rs
description: "; Test: Block and if expressions in expression contexts\n; Tests that blocks and if can appear anywhere an expression is expected\n\nfun main() {\n  ; === Single-arm if returns Unit ===\n  ; Single-arm if always evaluates to Unit (for side effects only)\n  let res = if true { write \"side effect\" }\n  write :display(res)\n  ; Expected: Unit\n\n  ; === if/else expression in let binding ===\n  let a = if true { \"yes\" } else { \"no\" }\n  write a\n\n  let b = if false { \"yes\" } else { \"no\" }\n  write b\n\n  ; Nested if/else expressions\n  let nested = if true {\n    if false { 1 } else { 2 }\n  } else {\n    3\n  }\n  write nested\n\n  ; if/else in arithmetic\n  let sum = 10 + if true { 5 } else { 0 }\n  write sum\n\n  ; if/else as argument\n  write if true { \"direct if\" } else { \"nope\" }\n\n  ; === Block expressions ===\n\n  ; Block expression in let binding\n  let blk = { 1 + 2 }\n  write blk\n\n  ; Block with statements and tail\n  let computed = {\n    let tmp = 10\n    tmp * 2\n  }\n  write computed\n\n  ; Block in arithmetic\n  let expr = { 5 } + { 3 }\n  write expr\n\n  ; if/else with block that has statements\n  let complex = if true {\n    let inner = 100\n    inner + 1\n  } else {\n    0\n  }\n  write complex\n\n  ; Chained conditionals (all if/else)\n  let grade = 85\n  let letter = if grade >= 90 { \"A\" } else {\n    if grade >= 80 { \"B\" } else {\n      if grade >= 70 { \"C\" } else { \"F\" }\n    }\n  }\n  write letter\n\n  ; === Blocks without tail return Unit ===\n  let no-tail = {\n    let tmp = 42\n    write tmp\n  }\n  write :display(no-tail)\n  ; Expected: Unit\n\n  write \"Block expressions test complete\"\n}\n"
