source: crates/rumps-query/tests/scripts.rs
description: "; User-defined modules\n; Tests MODULE definition, functions, constants, and nested modules\n\n; ============ Basic module with functions ============\n\nMODULE Counter {\n  FUN new() -> Int { 0 }\n  FUN inc(x: Int) -> Int { x + 1 }\n  FUN add(x: Int, y: Int) -> Int { x + y }\n}\n\nLET c = Counter.new()\nOUTPUT c  ; 0\n\nLET c1 = Counter.inc(c)\nOUTPUT c1  ; 1\n\nLET c2 = Counter.add(c1, 10)\nOUTPUT c2  ; 11\n\n; ============ Module with constants ============\n\nMODULE Config {\n  LET max-size = 1000\n  LET default-name = \"unnamed\"\n  LET ratio = 3.14\n}\n\nOUTPUT Config.max-size  ; 1000\nOUTPUT Config.default-name  ; unnamed\nOUTPUT Config.ratio > 3  ; true\n\n; Use constants in expressions\nLET scaled = Config.max-size * 2\nOUTPUT scaled  ; 2000\n\n; ============ Module with both functions and constants ============\n\nMODULE Geometry {\n  LET pi = 3.14159\n\n  FUN area(r: Float) -> Float {\n    Geometry.pi * r * r\n  }\n\n  FUN circumference(r: Float) -> Float {\n    2.0 * Geometry.pi * r\n  }\n}\n\nOUTPUT Geometry.pi > 3  ; true\n\nLET a = Geometry.area(2.0)\nOUTPUT a > 12  ; true\n\nLET circ = Geometry.circumference(1.0)\nOUTPUT circ > 6  ; true\n\n; ============ Nested modules ============\n\nMODULE Outer {\n  LET val = 100\n\n  FUN value() -> Int { Outer.val }\n\n  MODULE Inner {\n    LET secret = 42\n\n    FUN get-secret() -> Int { Outer.Inner.secret }\n    FUN combined() -> Int { Outer.val + Outer.Inner.secret }\n  }\n}\n\nOUTPUT Outer.val  ; 100\nOUTPUT Outer.value()  ; 100\nOUTPUT Outer.Inner.secret  ; 42\nOUTPUT Outer.Inner.get-secret()  ; 42\nOUTPUT Outer.Inner.combined()  ; 142\n\n; ============ Generic functions in modules ============\n\nMODULE Utils {\n  FUN identity[T](x: T) -> T { x }\n  FUN pair[A, B](a: A, b: B) -> (A, B) { (a, b) }\n}\n\nLET id-int = Utils.identity(42)\nOUTPUT id-int  ; 42\n\nLET id-str = Utils.identity(\"hello\")\nOUTPUT id-str  ; hello\n\nLET p = Utils.pair(1, \"one\")\nOUTPUT p  ; (1, one)\n\n; ============ Module function as value ============\n\nLET inc-fn = Counter.inc\nLET result = inc-fn(5)\nOUTPUT result  ; 6\n\n; ============ Module with closures ============\n\nMODULE Adder {\n  FUN make(n: Int) -> (Int) -> Int {\n    x => x + n\n  }\n}\n\nLET add5 = Adder.make(5)\nOUTPUT add5(10)  ; 15\n\nLET add10 = Adder.make(10)\nOUTPUT add10(7)  ; 17\n\n; ============ Monomorphic higher-order functions ============\n\nMODULE MonoHof {\n  FUN apply(f: (Int) -> Int, x: Int) -> Int {\n    f(x)\n  }\n\n  FUN map-twice(f: (Int) -> Int, x: Int) -> Int {\n    f(f(x))\n  }\n}\n\nOUTPUT MonoHof.apply(n => n + 1, 5)  ; 6\nOUTPUT MonoHof.map-twice(n => n * 2, 3)  ; 12\n\n; ============ Polymorphic higher-order functions ============\n\nMODULE PolyHof {\n  FUN apply[T, U](f: (T) -> U, x: T) -> U {\n    f(x)\n  }\n\n  FUN compose[A, B, C](f: (B) -> C, g: (A) -> B, x: A) -> C {\n    f(g(x))\n  }\n}\n\n; Int -> Int\nOUTPUT PolyHof.apply(n => n + 1, 5)  ; 6\n\n; Int -> String\nOUTPUT PolyHof.apply(n => \"num: \" ++ (n as String), 42)  ; num: 42\n\n; String -> Int\nOUTPUT PolyHof.apply(s => String.length(s), \"hello\")  ; 5\n\n; Compose: Int -> Int -> String\nOUTPUT PolyHof.compose(n => \"result: \" ++ (n as String), x => x * 2, 10)  ; result: 20\n"
