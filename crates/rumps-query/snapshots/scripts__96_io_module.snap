---
source: crates/rumps-query/tests/scripts.rs
description: "; Io module primitives\n; Tests Io.print, Io.println, Io.eprint, Io.eprintln\n;\n; NOTE: Io.get-line is not tested here because it blocks waiting for stdin.\n; It can be tested manually by running an interactive RUMPS session.\n\nfun main() {\n  ; ============ Test Io.println ============\n\n  ; This will print to stdout during test execution\n  let result = Io.println(\"Hello from Io.println\")\n  write result is Unit  ; true\n\n  ; ============ Test Io.print ============\n\n  let result2 = Io.print(\"Hello from Io.print (no newline)\")\n  write result2 is Unit  ; true\n\n  ; Print a newline after the previous print\n  let _ = Io.println(\"\")\n\n  ; ============ Test Io.eprintln ============\n\n  ; This will print to stderr during test execution\n  let result3 = Io.eprintln(\"Hello from Io.eprintln\")\n  write result3 is Unit  ; true\n\n  ; ============ Test Io.eprint ============\n\n  let result4 = Io.eprint(\"Hello from Io.eprint (no newline)\")\n  write result4 is Unit  ; true\n\n  ; Print a newline to stderr after the previous eprint\n  let _ = Io.eprintln(\"\")\n\n  ; ============ Chaining Io operations ============\n\n  ; Use with pipeline\n  let msg = \"Hello world\"\n  let _ = msg |> Io.println\n\n  ; Use with semicolon sequencing\n  {\n    Io.print(\"Line 1: \");\n    Io.println(\"value\")\n  }\n\n  write \"All Io tests passed\"\n}\n"
---
