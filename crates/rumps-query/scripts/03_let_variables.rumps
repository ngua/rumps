; Test: LET and variable lookup
; Tests lexical scoping with LET bindings

FUN main() {
  ; Simple binding
  LET x = 42
  WRITE x
  ; Expected: 42

  ; Binding using another variable
  LET y = x + 8
  WRITE y
  ; Expected: 50

  ; Multiple bindings
  LET a = 1
  LET b = 2
  LET c = 3
  LET sum = a + b + c
  WRITE sum
  ; Expected: 6

  ; Shadowing in same scope
  LET val = 10
  LET val = 20
  WRITE val
  ; Expected: 20

  ; String variables
  LET name = "Alice"
  WRITE name
  ; Expected: Alice

  ; Boolean variables
  LET flag = TRUE
  WRITE flag
  ; Expected: true (or TRUE)

  ; Using variables in expressions
  LET base = 100
  LET offset = 25
  LET result = base - offset * 2
  WRITE result
  ; Expected: 50

  ; Chained variable references
  LET v1 = 5
  LET v2 = v1 * 2
  LET v3 = v2 + v1
  WRITE v3
  ; Expected: 15

  WRITE "LET variable test complete"
}
