---
source: crates/rumps-query/tests/scripts.rs
description: "; Test TryInto constraint for fallible read conversions\n\nfun main() {\n  ; ============================================================================\n  ; Basic TryInto usage\n  ; ============================================================================\n\n  write read-int(\"42\")\n  write read-int(\"abc\")\n\n  write read-bool(\"true\")\n  write read-bool(1)\n\n  ; ============================================================================\n  ; Multiple constraints including TryInto\n  ; ============================================================================\n\n  write numeric-to-bool(0)\n  write numeric-to-bool(1)\n\n  ; ============================================================================\n  ; Closure with TryInto constraint\n  ; ============================================================================\n\n  let parse-int = [T: TryInto[Int]](x: T) -> Result[Int, String] => x read Int\n\n  write parse-int(\"100\")\n  write parse-int(\"not a number\")\n}\n\n; Function that reads any type into Int\nfun read-int[T: TryInto[Int]](x: T) -> Result[Int, String] {\n  x read Int\n}\n\n; Function that reads any type into Bool\nfun read-bool[T: TryInto[Bool]](x: T) -> Result[Bool, String] {\n  x read Bool\n}\n\n; Numeric and TryInto[Bool]\nfun numeric-to-bool[T: Numeric + TryInto[Bool]](x: T) -> Result[Bool, String] {\n  x read Bool\n}\n"
---
Result.Ok(42)
Result.Err("invalid integer: abc")
Result.Err("cannot read String as Bool")
Result.Ok(true)
Result.Ok(false)
Result.Ok(true)
Result.Ok(100)
Result.Err("invalid integer: not a number")
