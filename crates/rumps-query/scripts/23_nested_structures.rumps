; Test: deeply nested structures
; Tests complex nesting of arrays, objects, and blocks

; === Deeply nested arrays ===

LET deep = [[[[1]]]]
$OUTPUT deep[0][0][0][0]
; Expected: 1

LET matrix3d = [
  [[1, 2], [3, 4]],
  [[5, 6], [7, 8]]
]
$OUTPUT matrix3d[0][0][0]
; Expected: 1

$OUTPUT matrix3d[1][1][1]
; Expected: 8

$OUTPUT matrix3d[-1][-1][-1]
; Expected: 8

; === Deeply nested objects ===

LET nested = {
  level1: {
    level2: {
      level3: {
        value: "deep"
      }
    }
  }
}
$OUTPUT nested.level1.level2.level3.value
; Expected: deep

; === Mixed nesting ===

LET complex = {
  users: [
    { name: "Alice", scores: [100, 95, 88] },
    { name: "Bob", scores: [90, 85, 92] }
  ],
  meta: {
    count: 2,
    tags: ["active", "verified"]
  }
}

$OUTPUT complex.users[0].name
; Expected: Alice

$OUTPUT complex.users[0].scores[0]
; Expected: 100

$OUTPUT complex.users[1].scores[-1]
; Expected: 92

$OUTPUT complex.meta.tags[0]
; Expected: active

$OUTPUT complex.users[1].name
; Expected: Bob

; === Nested blocks ===

LET result = {
  LET a = {
    LET b = {
      LET c = 10
      c * 2
    }
    b + 5
  }
  a * 3
}
$OUTPUT result
; Expected: 75 ((10 * 2 + 5) * 3 = 25 * 3)

; === Nested conditionals ===

LET score = 85
LET grade = IF score >= 90 {
  "A"
} ELSE {
  IF score >= 80 {
    "B"
  } ELSE {
    IF score >= 70 {
      "C"
    } ELSE {
      "F"
    }
  }
}
$OUTPUT grade
; Expected: B

; === Array of blocks ===

LET computed = [
  { LET x = 1
    x + 1
  },
  { LET x = 2
    x + 1
  },
  { LET x = 3
    x + 1
  }
]
$OUTPUT computed
; Expected: [ 2, 3, 4 ]

; === Object with computed values ===

LET base = 10
LET obj = {
  double: base * 2,
  triple: base * 3,
  square: base * base
}
$OUTPUT obj.double
; Expected: 20

$OUTPUT obj.triple
; Expected: 30

$OUTPUT obj.square
; Expected: 100

$OUTPUT "Nested structures test complete"
