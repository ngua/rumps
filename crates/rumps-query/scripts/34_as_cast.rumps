; Test: Type cast operator (AS)
; Tests infallible type conversions with the `as` keyword

; === Int -> Float (widen) ===

LET i = 42
LET f = i AS Float
$OUTPUT f
; Expected: 42

; === Float -> Int (truncate) ===

LET pi = 3.7
LET truncated = pi AS Int
$OUTPUT truncated
; Expected: 3

LET neg = -2.9
LET neg-trunc = neg AS Int
$OUTPUT neg-trunc
; Expected: -2

; === Bool -> Int ===

LET t = TRUE AS Int
$OUTPUT t
; Expected: 1

LET f = FALSE AS Int
$OUTPUT f
; Expected: 0

; === T -> String (stringify anything) ===

; Int to String
LET n = 123
LET n-str = n AS String
$OUTPUT n-str
; Expected: 123

; Float to String
LET pi-str = 3.14 AS String
$OUTPUT pi-str
; Expected: 3.14

; Bool to String
LET b-str = TRUE AS String
$OUTPUT b-str
; Expected: TRUE

LET b-str2 = FALSE AS String
$OUTPUT b-str2
; Expected: FALSE

; Array to String
LET arr = [1, 2, 3]
LET arr-str = arr AS String
$OUTPUT arr-str
; Expected: [ 1, 2, 3 ]

; Object to String
LET obj = { name: "Alice", age: 30 }
LET obj-str = obj AS String
$OUTPUT obj-str
; Expected: { name: Alice, age: 30 }

; Option to String
LET some = Option.Some(42)
LET some-str = some AS String
$OUTPUT some-str
; Expected: Option.Some(42)

LET none = Option.None
LET none-str = none AS String
$OUTPUT none-str
; Expected: Option.None

; === Identity casts ===

LET x = 42 AS Int
$OUTPUT x
; Expected: 42

LET s = "hello" AS String
$OUTPUT s
; Expected: hello

; === Chained casts ===

; Note: Chained casts like `3.7 AS Int AS Float` require parentheses
LET chain = (3.7 AS Int) AS Float
$OUTPUT chain
; Expected: 3

; === Cast with expressions ===

LET result = (10 + 5) AS Float
$OUTPUT result
; Expected: 15

$OUTPUT "Type cast test complete"
