---
source: crates/rumps-query/tests/scripts.rs
description: "fun main() {\n  write Own.run()\n}\n\nmodule Own {\n  variant Status = Pending | Done\n  newtype UserId = Int\n  union Payload = Int | String\n\n  fun status-name(s: Status) -> String {\n    match s {\n      Status.Pending => { \"pending\" }\n      Status.Done => { \"done\" }\n    }\n  }\n\n  fun id-double(id: UserId) -> UserId {\n    id * 2\n  }\n\n  fun payload-kind(p: Payload) -> String {\n    if p is Int { \"int\" } else { \"string\" }\n  }\n\n  +fun run() -> String {\n    let status: Status = Status.Done\n    let id: UserId = 21\n    let p: Payload = \"x\"\n    \"{status-name(status)}:{id-double(id)}:{payload-kind(p)}\"\n  }\n\n  module Inner {\n    +fun run-inner() -> String {\n      let status: Status = Status.Pending\n      let id: UserId = 7\n      let p: Payload = 3\n      if p is Int { \"{status-name(status)}:{id-double(id)}:int\" } else { \"err\" }\n    }\n  }\n}\n"
---
"done:42:string"
