; Test: Monoid concatenation (`++` operator)
; Tests polymorphic `++` on String, Array, and Map

; === String concatenation ===
LET s1 = "Hello"
LET s2 = "World"
@OUTPUT s1 ++ ", " ++ s2

; === Array concatenation ===
LET a1 = [1, 2, 3]
LET a2 = [4, 5, 6]
@OUTPUT a1 ++ a2

; Nested arrays
LET nested1 = [[1, 2], [3, 4]]
LET nested2 = [[5, 6]]
@OUTPUT nested1 ++ nested2

; === Map concatenation (RHS bias) ===
LET m1 = { "a" => 1, "b" => 2 }
LET m2 = { "c" => 3, "d" => 4 }
@OUTPUT m1 ++ m2

; RHS bias: right value wins for duplicate keys
LET left = { "x" => 10, "y" => 20 }
LET right = { "y" => 999, "z" => 30 }
LET merged = left ++ right
@OUTPUT Map.lookup(merged, "x")  ; Some(10)
@OUTPUT Map.lookup(merged, "y")  ; Some(999) - right wins
@OUTPUT Map.lookup(merged, "z")  ; Some(30)

; === Type constraint: Monoid ===
; This function works on any Monoid type
FUN concat3[T: Monoid](a: T, b: T, c: T) -> T { a ++ b ++ c }

@OUTPUT concat3("a", "b", "c")
@OUTPUT concat3([1], [2], [3])
@OUTPUT concat3({ 1 => "x" }, { 2 => "y" }, { 3 => "z" })

; === Option alternative (`<|>` semantics) ===
; First `Some` wins; `None` acts as identity

LET some10 = Option.Some(10)
LET some9 = Option.Some(9)
LET none: Option[Int] = Option.None

; Some ++ None = Some (left wins)
@OUTPUT some10 ++ none

; None ++ Some = Some (right wins)
@OUTPUT none ++ some9

; None ++ None = None
@OUTPUT none ++ none

; Some ++ Some = first Some (left-biased, like Haskell `<|>`)
@OUTPUT some10 ++ some9

; Chaining: first Some in chain wins
@OUTPUT none ++ none ++ some10 ++ some9

; With generic Monoid function
@OUTPUT concat3(none, some10, some9)  ; first non-None wins
@OUTPUT concat3(none, none, some9)    ; last Some wins
@OUTPUT concat3(none, none, none)     ; all None

; === Mempty: `_` (monoid identity) ===
; `_` produces the empty value for any Monoid type, inferred from context

; String mempty
@OUTPUT _ ++ "hello"      ; "" ++ "hello" = "hello"
@OUTPUT "world" ++ _      ; "world" ++ "" = "world"

; Array mempty
@OUTPUT _ ++ [1, 2, 3]    ; [] ++ [1, 2, 3] = [1, 2, 3]
@OUTPUT [4, 5] ++ _       ; [4, 5] ++ [] = [4, 5]

; Map mempty
LET m = { "x" => 10 }
@OUTPUT _ ++ m            ; {} ++ m = m
@OUTPUT m ++ _            ; m ++ {} = m

; Option mempty (None)
@OUTPUT _ ++ Option.Some(99)   ; None ++ Some(99) = Some(99)
@OUTPUT Option.Some(77) ++ _   ; Some(77) ++ None = Some(77)
@OUTPUT Option.None ++ _       ; None ++ None = None
@OUTPUT _ ++ Option.None       ; None ++ None = None

; Mempty with generic Monoid function
@OUTPUT concat3(_, "a", "b")   ; "" ++ "a" ++ "b" = "ab"
@OUTPUT concat3([0], _, [2])   ; [0] ++ [] ++ [2] = [0, 2]

; Mempty as FOREVER seed (common pattern for accumulating)
; Collect squares of 1..5 into an array starting from `_` (empty array)
LET squares = FOREVER { i: 1, acc: _ } (state, cont) => {
  IF state.i > 5 {
    state.acc
  } ELSE {
    cont({ i: state.i + 1, acc: state.acc ++ [state.i * state.i] })
  }
}
@OUTPUT squares

; Build a string using `_` as initial accumulator
LET words = FOREVER { i: 0, s: _ } (state, cont) => {
  LET items = ["hello", "world", "!"]
  IF state.i >= 3 {
    state.s
  } ELSE {
    ; Note that `?? _` works fine since `_ == ""` for `String`
    LET word = items?[state.i] ?? _
    LET sep = IF state.i == 0 { _ } ELSE { " " }
    cont({ i: state.i + 1, s: state.s ++ sep ++ word })
  }
}
@OUTPUT words

@OUTPUT "Monoid concatenation complete"
