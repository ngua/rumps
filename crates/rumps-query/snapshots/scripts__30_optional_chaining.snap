---
source: crates/rumps-query/tests/scripts.rs
description: "; Optional chaining operator (?.) tests\n; `?.` short-circuits to Option.None if base is None, otherwise wraps result in Some\n\nfun main() {\n  ; === Basic optional chaining on objects ===\n\n  ; Regular object: wrap result in Some, then coalesce to unwrap\n  let obj = { name: \"Alice\", age: 30 }\n  write obj?.name ?? \"N/A\"\n  ; Expected: Alice\n\n  write obj?.age ?? 0\n  ; Expected: 30\n\n  ; === Optional chaining on Option.None ===\n\n  ; None short-circuits; field access is never attempted\n  let none = Option.None\n  write none?.name ?? \"fallback\"\n  ; Expected: fallback\n\n  write none?.anything ?? \"default\"\n  ; Expected: default\n\n  ; === Optional chaining on Option.Some ===\n\n  ; Some unwraps, accesses field, re-wraps in Some\n  let some = Option.Some({ x: 42, y: 99 })\n  write some?.x ?? 0\n  ; Expected: 42\n\n  write some?.y ?? 0\n  ; Expected: 99\n\n  ; === Chained optional access ===\n\n  ; Multiple ?. in sequence\n  let nested = { inner: { value: 123 } }\n  write nested?.inner?.value ?? -1\n  ; Expected: 123\n\n  ; Chain through None\n  let outer = Option.None\n  write outer?.inner?.value ?? -1\n  ; Expected: -1\n\n  ; Mixed regular and optional access\n  let obj2 = { data: { num: 55 } }\n  write obj2.data?.num ?? 0\n  ; Expected: 55\n\n  ; === Combining with coalesce ===\n\n  ; Optional chaining always returns Option, coalesce unwraps\n  let person = { city: \"NYC\" }\n  let city = person?.city ?? \"Unknown\"\n  write city\n  ; Expected: NYC\n\n  ; Missing field with coalesce fallback\n  let empty = Option.None\n  let missing = empty?.nonexistent ?? \"not found\"\n  write missing\n  ; Expected: not found\n\n  ; === Optional chaining result is always Option ===\n\n  ; Without coalesce, result is Option.Some\n  let result = { value: 10 }?.value\n  ; result is Option.Some(10); check with is\n  write if result is Option.Some(_) { \"has value\" } else { \"no value\" }\n  ; Expected: has value\n\n  ; None result\n  let result2 = Option.None?.value\n  write if result2 is Option.Some(_) { \"has value\" } else { \"no value\" }\n  ; Expected: no value\n\n  write \"Optional chaining tests complete\"\n}\n"
---
Alice
30
fallback
default
