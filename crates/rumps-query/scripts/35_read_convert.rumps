; Test: Fallible type conversion operator (read)
; Tests fallible conversions that return `Result[T, String]`

fun main() {
  ; === String -> Int ===

  ; Success case
  let s1 = "42"
  let r1 = s1 read Int
  write r1
  ; Expected: Result.Ok(42)

  ; Negative number
  let s2 = "-123"
  let r2 = s2 read Int
  write r2
  ; Expected: Result.Ok(-123)

  ; Failure case (not a valid int)
  let s3 = "hello"
  let r3 = s3 read Int
  write r3
  ; Expected: Result.Err(...)

  ; Failure case (float string -> int)
  let s4 = "3.14"
  let r4 = s4 read Int
  write r4
  ; Expected: Result.Err(...)

  ; === String -> Float ===

  ; Success case
  let f1 = "3.14"
  let rf1 = f1 read Float
  write rf1
  ; Expected: Result.Ok(3.14)

  ; Integer string to float
  let f2 = "42"
  let rf2 = f2 read Float
  write rf2
  ; Expected: Result.Ok(42)

  ; Negative float
  let f3 = "-2.5"
  let rf3 = f3 read Float
  write rf3
  ; Expected: Result.Ok(-2.5)

  ; Failure case
  let f4 = "not-a-number"
  let rf4 = f4 read Float
  write rf4
  ; Expected: Result.Err(...)

  ; === Int -> Bool ===

  ; Zero -> false
  let b1 = 0 read Bool
  write b1
  ; Expected: Result.Ok(false)

  ; One -> true
  let b2 = 1 read Bool
  write b2
  ; Expected: Result.Ok(true)

  ; Invalid int (not 0 or 1)
  let b3 = 42 read Bool
  write b3
  ; Expected: Result.Err(...)

  let b4 = -1 read Bool
  write b4
  ; Expected: Result.Err(...)

  ; === Chained operations ===

  ; Chain read with as
  let chain = ("42" read Int) as String
  write chain
  ; Expected: Result.Ok(42)

  ; === Read with expressions ===

  let concat = "{"1"}{"23"}"
  let parsed = concat read Int
  write parsed
  ; Expected: Result.Ok(123)

  write "Fallible read test complete"
}
