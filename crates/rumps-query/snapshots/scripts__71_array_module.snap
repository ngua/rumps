---
source: crates/rumps-query/tests/scripts.rs
description: "; Array module functions\n; Tests Array.map, Array.filter, Array.reduce, Array.foreach\n\n; Array.map with closure\nLET nums = [1, 2, 3, 4, 5]\nLET doubled = Array.map(x => x * 2, nums)\nOUTPUT doubled  ; [2, 4, 6, 8, 10]\n\n; Array.map on empty array\nLET empty = []\nLET mapped-empty = Array.map(x => x + 1, empty)\nOUTPUT mapped-empty  ; []\n\n; Array.map with named function\nFUN square (n: Int) -> Int { n * n }\nLET squares = Array.map(square, [1, 2, 3])\nOUTPUT squares  ; [1, 4, 9]\n\n; Array.filter with closure\nLET evens = Array.filter(x => x % 2 == 0, nums)\nOUTPUT evens  ; [2, 4]\n\n; Array.filter on empty array\nLET filtered-empty = Array.filter(x => x > 0, empty)\nOUTPUT filtered-empty  ; []\n\n; Array.filter with named function\nFUN is-positive (n: Int) -> Bool { n > 0 }\nLET positives = Array.filter(is-positive, [-1, 0, 1, 2])\nOUTPUT positives  ; [1, 2]\n\n; Array.filter keeping all\nLET all-kept = Array.filter(x => TRUE, [1, 2, 3])\nOUTPUT all-kept  ; [1, 2, 3]\n\n; Array.filter keeping none\nLET none-kept = Array.filter(x => FALSE, [1, 2, 3])\nOUTPUT none-kept  ; []\n\n; Array.reduce with sum\nLET sum = Array.reduce((acc, x) => acc + x, 0, nums)\nOUTPUT sum  ; 15\n\n; Array.reduce on empty array returns initial value\nLET empty-sum = Array.reduce((acc, x) => acc + x, 100, empty)\nOUTPUT empty-sum  ; 100\n\n; Array.reduce with string concatenation\nLET words = [\"hello\", \" \", \"world\"]\nLET combined = Array.reduce((acc, s) => acc ++ s, \"\", words)\nOUTPUT combined  ; \"hello world\"\n\n; Array.reduce with named function\nFUN add (a: Int, b: Int) -> Int { a + b }\nLET total = Array.reduce(add, 0, [1, 2, 3, 4])\nOUTPUT total  ; 10\n\n; Combining Array functions\nLET result = Array.reduce(\n  (acc, x) => acc + x,\n  0,\n  Array.map(x => x * x, Array.filter(x => x % 2 == 1, [1, 2, 3, 4, 5]))\n)\nOUTPUT result  ; 1 + 9 + 25 = 35\n\n; Pipeline usage with Array functions (using wrapper closures)\nLET piped = [1, 2, 3, 4, 5]\n  |> (arr => Array.filter(x => x > 2, arr))\n  |> (arr => Array.map(x => x * 10, arr))\nOUTPUT piped  ; [30, 40, 50]\n\n; Module functions can be passed as first-class values\nLET filter-fn = Array.filter\nLET data = [1, 2, 3, 4, 5]\nLET filtered = filter-fn(x => x > 2, data)\nOUTPUT filtered  ; [3, 4, 5]\n\n; Array.map with Option results (homogeneous tagged values)\nLET with-opts = Array.map(x => Option.Some(x), [1, 2, 3])\nOUTPUT with-opts  ; [Option.Some(1), Option.Some(2), Option.Some(3)]\n\n; Nested Array.map (callback uses Array function)\nLET nested = [[1, 2], [3, 4]]\nLET doubled-nested = Array.map(arr => Array.map(x => x * 2, arr), nested)\nOUTPUT doubled-nested  ; [[2, 4], [6, 8]]\n\n; === Array.foreach ===\n\n; Array.foreach for side effects (outputs each element)\nOUTPUT \"foreach:\"\nLET fe-result = Array.foreach(x => { OUTPUT x }, [10, 20, 30])\nOUTPUT fe-result  ; Unit\n\n; Array.foreach on empty array (no side effects)\nLET fe-empty = Array.foreach(x => { OUTPUT x }, [])\nOUTPUT fe-empty  ; Unit\n\n; Array.foreach with range\nOUTPUT \"range foreach:\"\nLET fe-range = Array.foreach(n => { OUTPUT n }, 1 .. 4)\nOUTPUT fe-range  ; Unit\n\n; === Array.zip ===\n\nLET a = [1, 2, 3]\nLET b = [\"a\", \"b\", \"c\"]\nLET zipped = Array.zip(a, b)\nOUTPUT zipped\n\n; Shorter array determines length\nLET short = [1, 2]\nLET long = [\"a\", \"b\", \"c\", \"d\"]\nOUTPUT Array.zip(short, long)\n\n; === Array.unzip ===\n\nLET pairs: Array[(Int, String)] = [(1, \"one\"), (2, \"two\"), (3, \"three\")]\nLET (unzip-nums, unzip-strs) = Array.unzip(pairs)\nOUTPUT unzip-nums\nOUTPUT unzip-strs\n\n; Round-trip\nLET x = [10, 20, 30]\nLET y = [true, false, true]\nLET (x2, y2) = Array.unzip(Array.zip(x, y))\nOUTPUT x2\nOUTPUT y2\n\n; === Array.intersperse ===\n\nLET inter-words = [\"hello\", \"world\", \"!\"]\nOUTPUT Array.intersperse(\",\", inter-words)\n\nLET inter-nums = [1, 2, 3, 4]\nOUTPUT Array.intersperse(0, inter-nums)\n\n; Empty array\nLET inter-empty: Array[Int] = []\nOUTPUT Array.intersperse(0, inter-empty)\n\n; Single element\nOUTPUT Array.intersperse(0, [42])\n\n; === Array.zip-with ===\n\nFUN zip-add(za: Int, zb: Int) -> Int { za + zb }\nLET xs = [1, 2, 3]\nLET ys = [10, 20, 30]\nOUTPUT Array.zip-with(zip-add, xs, ys)\n\n; With closure\nLET multiplied = Array.zip-with((ma, mb) => ma * mb, [2, 3, 4], [5, 6, 7])\nOUTPUT multiplied\n\n; With shorter array\nOUTPUT Array.zip-with(zip-add, [1, 2, 3, 4, 5], [10, 20])\n\n; === Array.sort-by ===\n\nFUN cmp-int(ca: Int, cb: Int) -> Ordering {\n  IF ca < cb { Ordering.Lt } ELSE {\n    IF ca == cb { Ordering.Eq } ELSE { Ordering.Gt }\n  }\n}\n\nLET unsorted = [3, 1, 4, 1, 5, 9, 2, 6]\nOUTPUT Array.sort-by(cmp-int, unsorted)\n\n; Sort descending (reverse comparator)\nFUN cmp-desc(da: Int, db: Int) -> Ordering {\n  IF da > db { Ordering.Lt } ELSE {\n    IF da == db { Ordering.Eq } ELSE { Ordering.Gt }\n  }\n}\nOUTPUT Array.sort-by(cmp-desc, unsorted)\n\n; Sort by absolute value\nFUN cmp-abs(aa: Int, ab: Int) -> Ordering {\n  LET abs-a = IF aa < 0 { 0 - aa } ELSE { aa }\n  LET abs-b = IF ab < 0 { 0 - ab } ELSE { ab }\n  cmp-int(abs-a, abs-b)\n}\nLET signed = [-5, 3, -1, 4, -2]\nOUTPUT Array.sort-by(cmp-abs, signed)\n\n; Sort objects by field\nTYPE SortPerson = { name: String, age: Int }\n\nFUN cmp-by-age(pa: SortPerson, pb: SortPerson) -> Ordering {\n  cmp-int(pa.age, pb.age)\n}\n\nLET people = [\n  { name: \"Alice\", age: 30 },\n  { name: \"Bob\", age: 25 },\n  { name: \"Carol\", age: 35 }\n]\nLET by-age = Array.sort-by(cmp-by-age, people)\nOUTPUT Array.map(p => p.name, by-age)\n\n; === Chained operations ===\n\n; zip, map, filter chain\nLET indices = [0, 1, 2, 3, 4]\nLET values = [10, 25, 30, 15, 40]\nLET indexed = Array.zip(indices, values)\nLET chain-filtered = Array.filter(pair => pair.1 > 20, indexed)\nOUTPUT chain-filtered\n\n; zip-with to compute differences\nLET before = [10, 20, 30]\nLET after = [15, 18, 35]\nLET diffs = Array.zip-with((db, da) => da - db, before, after)\nOUTPUT diffs\n"
