---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: String interpolation\n; Tests `\"{expr}\"` syntax with various types and expressions\n\n; Basic variable interpolation\nLET my-name = \"World\"\n@OUTPUT \"Hello, {my-name}!\"\n\n; Multiple interpolations\nLET x = 1\nLET y = 2\n@OUTPUT \"{x} + {y} = {x + y}\"\n\n; Inline expressions\n@OUTPUT \"Result: {10 * 5 + 2}\"\n\n; Various scalar types\nLET my-int = 42\nLET my-float = 3.14\nLET my-bool = TRUE\nLET my-char = 'X'\n@OUTPUT \"Int: {my-int}, Float: {my-float}, Bool: {my-bool}, Char: {my-char}\"\n\n; Nested object field access\nLET my-obj = { x: 10, y: 20 }\n@OUTPUT \"Point: ({my-obj.x}, {my-obj.y})\"\n\n; Array elements\nLET my-arr = [1, 2, 3]\n@OUTPUT \"First: {my-arr[0]}, Second: {my-arr[1]}\"\n\n; Function call in interpolation\nFUN double(n: Int) -> Int { n * 2 }\n@OUTPUT \"Double of 5: {double(5)}\"\n\n; Closure in interpolation\nLET inc = (n: Int) => n + 1\n@OUTPUT \"Incremented: {inc(99)}\"\n\n; Tuple access\nLET my-tup = (100, \"hello\")\n@OUTPUT \"Tuple: {my-tup.0}, {my-tup.1}\"\n\n; Escaped braces: `{{` becomes `{`, `}}` becomes `}`\n@OUTPUT \"Braces: {{ and }}\"\n@OUTPUT \"Mixed: {my-int} in {{curly}} braces\"\n\n; Empty interpolation parts\nLET my-msg = \"test\"\n@OUTPUT \"{my-msg}\"\n@OUTPUT \"prefix{my-msg}\"\n@OUTPUT \"{my-msg}suffix\"\n\n; Complex expressions (if-else)\nLET cmp-result = IF x < y { \"less\" } ELSE { \"not less\" }\n@OUTPUT \"Ternary-like: {cmp-result}\"\n\n; String values pass through without extra quotes\nLET my-str = \"no quotes\"\n@OUTPUT \"Value: {my-str}\"\n\n; Array length\nLET my-nums = [1, 2, 3, 4, 5]\n@OUTPUT \"Length: {Array.length(my-nums)}\"\n\n; Map literal\nLET my-map = { 1 => \"one\", 2 => \"two\" }\nLET has-key = Map.has(my-map, 1)\n@OUTPUT \"Map has key 1: {has-key}\"\n\n; Option values\nLET some-val = ?42\nLET none-val = Option.None\n@OUTPUT \"Some: {some-val}, None: {none-val}\"\n\n; Range\nLET my-range = 1 .. 5\n@OUTPUT \"Range: {my-range}\"\n\n; With arithmetic precedence\n@OUTPUT \"Precedence: {2 + 3 * 4}\"\n\n; Boolean expressions\n@OUTPUT \"And: {TRUE AND FALSE}, Or: {TRUE OR FALSE}\"\n\n; Comparison in interpolation\n@OUTPUT \"Compare: {5 < 10}, {5 == 5}, {5 != 3}\"\n\n; Using coalesce\nLET my-maybe: Option[Int] = ?10\n@OUTPUT \"Coalesced: {my-maybe ?? 0}\"\n\n; Pipe operator\n@OUTPUT \"Piped: {5 |> double}\"\n\n; Nested string interpolation\nLET inner = 100\n@OUTPUT \"Outer: {\"Inner: {inner}\"}\"\n\n; IF expression directly in interpolation\nLET val = 7\n@OUTPUT \"Direct IF: {IF val > 5 { \"big\" } ELSE { \"small\" }}\"\n\n; DbRef in interpolation (requires the merge_dbref fix)\n@SET d(1, 2) = \"nested-key\"\n@OUTPUT \"DbRef: {@GET d(1, 2)!}\"\n\n; Complex subscript expression\nLET idx = 2\n@SET d(1, idx) = \"dynamic\"\n@OUTPUT \"Dynamic key: {@GET d(1, idx)!}\"\n\n; Block expression in interpolation (note: `{{` is escape, so `{{{ ... }}}` needed)\n@OUTPUT \"Block: {{{ 2 * 21 }}}\"\n\n; Unwrap in interpolation\nLET opt: Option[Int] = ?999\n@OUTPUT \"Unwrapped: {opt!}\"\n"
---
"Hello, World!"
"1 + 2 = 3"
"Result: 52"
"Int: 42, Float: 3.14, Bool: TRUE, Char: 'X'"
"Point: (10, 20)"
"First: 1, Second: 2"
"Double of 5: 10"
"Incremented: 100"
"Tuple: 100, hello"
"Braces: { and }"
"Mixed: 42 in {curly} braces"
"test"
"prefixtest"
"testsuffix"
"Ternary-like: less"
"Value: no quotes"
"Length: 5"
"Map has key 1: TRUE"
"Some: Option.Some(42), None: Option.None"
"Range: 1..5"
"Precedence: 14"
"And: FALSE, Or: TRUE"
"Compare: TRUE, TRUE, TRUE"
"Coalesced: 10"
"Piped: 10"
"Outer: Inner: 100"
"Direct IF: big"
"DbRef: nested-key"
"Dynamic key: dynamic"
"Block: {42}"
"Unwrapped: 999"
