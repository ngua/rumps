source: crates/rumps-query/tests/scripts.rs
description: "; Module `let` providers are ordered before import and path consumers.\n\nimport TopLater.{ v }\nimport FalseCycle.{ w }\n\nlet top-imported = v + 1\nlet seed = 1\n\nmodule UseImport {\n  import SourceImport.{ v }\n\n  +let w = () => v + 1\n}\n\nmodule UsePath {\n  +let w = () => SourcePath.v + 1\n}\n\nmodule UseNestedImport {\n  import SourceNestedImport.Inner.{ v }\n\n  +let w = () => v + 1\n}\n\nmodule UseNestedPath {\n  +let w = () => SourceNestedPath.Inner.v + 1\n}\n\nmodule ParentSib {\n  module Use {\n    import ParentSib.Source.{ v }\n\n    +let w = () => v + 1\n  }\n\n  module Source {\n    +let v = 41\n  }\n}\n\nmodule ChildParent {\n  import ChildParent.Child.{ v }\n\n  +let via-path = () => ChildParent.Child.v + 1\n  +let via-import = () => v + 2\n\n  module Child {\n    +let v = 41\n  }\n}\n\nmodule WildA {\n  import WildB.{ ..., -b }\n\n  +let a = 1\n}\n\nmodule WildB {\n  import WildA.{ ..., -a }\n\n  +let b = 2\n}\n\nmodule SourceImport {\n  +let v = 41\n}\n\nmodule SourcePath {\n  +let v = 41\n}\n\nmodule SourceNestedImport {\n  module Inner {\n    +let v = 41\n  }\n}\n\nmodule SourceNestedPath {\n  module Inner {\n    +let v = 41\n  }\n}\n\nmodule TopLater {\n  +let v = 41\n}\n\nmodule FalseCycle {\n  +let w = () => seed\n}\n\nfun main() {\n  write 0\n}\n"
