---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: Unit type and Option values\n; Tests blocks returning Unit, single-arm if returning Unit, and Option behavior\n\n; Function that expects an Option argument\nfun maybe-double(x: Option[Int]) -> Int {\n  (x ?? 0) * 2\n}\n\nfun main() {\n  ; === Block without tail returns Unit ===\n\n  let result = {\n    write \"Side effect only\"\n  }\n  write :display(result)\n  ; Expected: Unit\n\n  let result-2 = {\n    let x = 42\n    write x\n    ; No tail expression\n  }\n  write :display(result-2)\n  ; Expected: Unit\n\n  ; === Block with tail returns value ===\n\n  let result-3 = {\n    let x = 42\n    x\n  }\n  write result-3\n  ; Expected: 42\n\n  ; === Single-arm if returns Unit ===\n\n  ; Single-arm if with false condition (body not evaluated)\n  let cond-1 = if false {\n    write \"never reached\"\n  }\n  write :display(cond-1)\n  ; Expected: Unit\n\n  ; Single-arm if with true condition (body evaluated, must be Unit)\n  let cond-2 = if true {\n    write \"side effect\"\n  }\n  write :display(cond-2)\n  ; Expected: Unit\n\n  ; === Option values ===\n\n  ; Option.None\n  write :display(Option.None)\n  ; Expected: Option.None\n\n  ; Option.Some unwrapping with coalesce\n  write Option.Some(42) ?? 0\n  ; Expected: 42\n\n  ; Option.None fallback with coalesce\n  write Option.None ?? \"fallback\"\n  ; Expected: fallback\n\n  ; === Prefix `?` for Some wrapping ===\n\n  ; Basic usage: wrap a value in Some\n  let wrapped = ?42\n  write :display(wrapped)\n  ; Expected: Option.Some(42)\n\n  ; Unwrap with coalesce\n  write ?100 ?? 0\n  ; Expected: 100\n\n  ; Wrap a string\n  write :display(?\"hello\")\n  ; Expected: Option.Some(hello)\n\n  ; Nested `?` produces Option.Some(Option.Some(v))\n  ; Note: `??` is the coalesce operator, so use `?(?x)` for nesting\n  let nested = ?(?10)\n  write :display(nested)\n  ; Expected: Option.Some(Option.Some(10))\n\n  ; Unwrap outer layer\n  write :display(nested!)\n  ; Expected: Option.Some(10)\n\n  ; Fully unwrap nested\n  write nested!!\n  ; Expected: 10\n\n  ; Call with explicit Some\n  write maybe-double(Option.Some(5))\n  ; Expected: 10\n\n  ; Call with `?` wrap syntax\n  write maybe-double(?7)\n  ; Expected: 14\n\n  ; Call with None\n  write maybe-double(Option.None)\n  ; Expected: 0\n\n  ; Wrap an expression\n  let expr-result = ?(3 + 4)\n  write :display(expr-result)\n  ; Expected: Option.Some(7)\n\n  write \"Unit and Option test complete\"\n}\n"
---
