; Error: wrong field type in nested object alias

NEWTYPE Address = { street: String, city: String, zip: String }
NEWTYPE Patient = { id: Int, name: String, address: Address }

FUN main() {
  ; address.zip should be String, not Int
  LET p: Patient = {
    id: 1,
    name: "Alice",
    address: { street: "123 Main", city: "NYC", zip: 10001 }
  }
}
