---
source: crates/rumps-query/tests/scripts.rs
description: "; Object representation visibility\n\nimport ObjPub.{ Person }\n\nmodule ObjPub {\n  +newtype Person = +{ name: String, age: Int }\n  +newtype Box[T] = +{ value: T }\n  +newtype Pair[L, R] = +{ left: L, right: R }\n}\n\nmodule ObjPriv {\n  +newtype Person = { name: String, age: Int }\n\n  +fun make(name: String, age: Int) -> ObjPriv.Person {\n    { name: name, age: age }\n  }\n\n  +fun name(p: ObjPriv.Person) -> String {\n    p.name\n  }\n\n  +fun age(p: ObjPriv.Person) -> Int {\n    p.age\n  }\n}\n\nfun greet(p: ObjPub.Person) -> String {\n  \"Hello, {p.name}!\"\n}\n\nfun make-person(name: String, age: Int) -> { name: String, age: Int } {\n  { name: name, age: age }\n}\n\nfun main() {\n  let p1: ObjPub.Person = { name: \"Alice\", age: 30 }\n\n  write p1 is Person\n  write p1 is { name: String }\n  write p1 is { name: String, age: Int }\n  write p1 is { name: String, age: Int, extra: Bool }\n\n  write p1.name\n  write p1.age\n\n  let p2: ObjPub.Person = { name: \"Bob\", age: 25, job: \"Engineer\" }\n  write p2 is Person\n  write p2 is { name: String, job: String }\n  write p2 is { name: String, age: Int, job: String }\n\n  write p2.name\n  write p2.job\n\n  let int-box: ObjPub.Box[Int] = { value: 42 }\n  write int-box.value\n\n  let str-box: ObjPub.Box[String] = { value: \"hello\" }\n  write str-box.value\n\n  let pair: ObjPub.Pair[Int, String] = { left: 1, right: \"one\" }\n  write pair.left\n  write pair.right\n\n  let priv = ObjPriv.make(\"Carol\", 40)\n  write ObjPriv.name(priv)\n  write ObjPriv.age(priv)\n\n  write greet({ name: \"Diana\", age: 28 })\n\n  let p3 = make-person(\"Eve\", 35)\n  write p3.name\n  write p3.age\n}\n"
