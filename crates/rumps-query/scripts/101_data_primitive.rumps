; @DATA primitive tests
; NOTE: Uses locals only; globals require TRANSACTION blocks

; === Setup: create test data ===

@SET vars{1} = "value at 1"
@SET vars{1, "A"} = "value at 1,A"
@SET vars{2, "B", "C"} = "deep value"

; === @DATA on non-existent key ===

LET status0 = @DATA vars{999}
WRITE status0

; === @DATA on key with value only ===

; Key {1, "A"} has value but no descendants
LET status1 = @DATA vars{1, "A"}
WRITE status1

; === @DATA on key with descendants only ===

; Key {2} has no value but has descendants at {2, "B", ...}
LET status2 = @DATA vars{2}
WRITE status2

; === @DATA on key with both value and descendants ===

; Key {1} has value AND descendants at {1, "A"}
LET status3 = @DATA vars{1}
WRITE status3

; === Pattern matching on DataStatus ===

FUN describe(s: DataStatus) -> String {
  MATCH s {
    DataStatus.NoData => { "no data" }
    DataStatus.HasValue => { "has value" }
    DataStatus.HasDescendants => { "has descendants" }
    DataStatus.Both => { "both" }
  }
}

WRITE describe(@DATA vars{999})
WRITE describe(@DATA vars{1, "A"})
WRITE describe(@DATA vars{2})
WRITE describe(@DATA vars{1})

; === AS Int coercion (MUMPS $@DATA values) ===

WRITE (@DATA vars{999}) AS Int
WRITE (@DATA vars{1, "A"}) AS Int
WRITE (@DATA vars{2}) AS Int
WRITE (@DATA vars{1}) AS Int

; === DataStatus in expressions ===

FUN has-data(s: DataStatus) -> Bool {
  (s AS Int) > 0
}

WRITE has-data(@DATA vars{999})
WRITE has-data(@DATA vars{1})

; === Type annotation ===

LET typed: DataStatus = @DATA vars{1}
WRITE typed

; === DataStatus in arrays ===

LET statuses: Array[DataStatus] = [
  @DATA vars{999},
  @DATA vars{1, "A"},
  @DATA vars{2},
  @DATA vars{1}
]
WRITE Iterable:length(statuses)
WRITE Mappable:map(describe, statuses)

; === READ DataStatus from Int ===

LET from0 = 0 READ DataStatus
LET from1 = 1 READ DataStatus
LET from10 = 10 READ DataStatus
LET from11 = 11 READ DataStatus
LET invalid = 5 READ DataStatus

WRITE from0
WRITE from1
WRITE from10
WRITE from11
WRITE invalid
