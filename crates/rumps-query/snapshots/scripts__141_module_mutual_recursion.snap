description: "; Module-level mutual recursion: functions within a module calling each other\n\nfun main() {\n  ; Test mutual recursion via module path\n  write Parity.is-even(0)\n  write Parity.is-even(4)\n  write Parity.is-even(7)\n  write Parity.is-odd(0)\n  write Parity.is-odd(3)\n  write Parity.is-odd(6)\n\n  write Math.Fibonacci.fib(0)\n  write Math.Fibonacci.fib(1)\n  write Math.Fibonacci.fib(10)\n}\n\nmodule Parity {\n    +fun is-even(n: Int) -> Bool {\n        if n == 0 { true } else { is-odd(n - 1) }\n    }\n\n    +fun is-odd(n: Int) -> Bool {\n        if n == 0 { false } else { is-even(n - 1) }\n    }\n}\n\n; Nested module with mutual recursion\nmodule Math {\n    module Fibonacci {\n        ; Mutually recursive helper functions\n        +fun fib(n: Int) -> Int {\n            if n <= 1 { n } else { fib-sum(n) }\n        }\n\n        fun fib-sum(n: Int) -> Int {\n            fib(n - 1) + fib(n - 2)\n        }\n    }\n}\n"
