; Test: Unit literal
; Tests the `Unit` value literal

fun main() {
  ; Unit equals itself
  write Unit is Unit
  ; Expected: true

  ; Unit in variable
  let u = Unit
  write u
  ; Expected: Unit

  ; Unit equality via variable
  write u is Unit
  ; Expected: true

  ; Unit in tuple
  let pair = (1, Unit)
  write pair
  ; Expected: (1, Unit)

  write "Unit literal test complete"
}
