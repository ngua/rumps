; Test: Pipeline Operator (|>)
; Tests left-to-right function application

; === Pipeline with named function ===

fun double (x) { x * 2 }
fun square (x) { x * x }
fun inc (x) { x + 1 }

; === Pipeline with typed functions ===

fun typed-double (x: Int) -> Int { x * 2 }
fun typed-inc (x: Int) -> Int { x + 1 }

; === Higher-order with typed parameters ===

fun apply-twice (f, x) {
  f(f(x))
}

fun negate (x) { 0 - x }

fun add-10 (x) { x + 10 }
fun half (x) { x // 2 }

fun add (x, y) { x + y }
fun mul (a, b, c) { a * b * c }

fun main() {
  ; === Basic pipeline with closure ===

  write 5 |> (x => x * 2)
  ; Expected: 10

  write 10 |> (x => x + 5)
  ; Expected: 15

  write 5 |> double
  ; Expected: 10

  write 5 |> square
  ; Expected: 25

  ; === Pipeline chain (left-associative) ===

  write 5 |> double |> square
  ; Expected: 100 (double(5)=10, square(10)=100)

  write 5 |> square |> double
  ; Expected: 50 (square(5)=25, double(25)=50)

  write 5 |> inc |> double |> square
  ; Expected: 144 (inc(5)=6, double(6)=12, square(12)=144)

  ; === Pipeline with inline closures ===

  write 10 |> (x => x + 1) |> (x => x * 2)
  ; Expected: 22 (10+1=11, 11*2=22)

  write 3 |> (x => x * x) |> (x => x + 1)
  ; Expected: 10 (3*3=9, 9+1=10)

  ; === Pipeline precedence (lower than all other ops) ===

  write 1 + 2 |> double
  ; Expected: 6 (1+2=3, double(3)=6)

  write 10 - 4 |> square
  ; Expected: 36 ((10-4)=6, square(6)=36)

  write 2 * 3 |> inc
  ; Expected: 7 (2*3=6, inc(6)=7)

  write 5 |> typed-double
  ; Expected: 10

  write 5 |> typed-double |> typed-inc
  ; Expected: 11

  ; === Pipeline with closures capturing variables ===

  let factor = 3
  let scale = x => x * factor

  write 10 |> scale
  ; Expected: 30

  let offset = 100
  let shift = x => x + offset

  write 5 |> double |> shift
  ; Expected: 110 (double(5)=10, shift(10)=110)

  let quad = x => apply-twice(double, x)

  write 3 |> quad
  ; Expected: 12 (3*2=6, 6*2=12)

  ; === Chained pipelines with various transforms ===

  write 5 |> double |> negate
  ; Expected: -10

  write 5 |> negate |> double
  ; Expected: -10

  ; === Complex pipeline expression ===

  write 4 |> square |> add-10 |> half
  ; Expected: 13 (square(4)=16, add-10(16)=26, half(26)=13)

  ; === Pipeline with `.` placeholder (multi-arg functions) ===

  write 5 |> add(10, .)
  ; Expected: 15 (add(10, 5)=15)

  write 3 |> add(., 7)
  ; Expected: 10 (add(3, 7)=10)

  write 2 |> mul(., 3, .)
  ; Expected: 12 (mul(2, 3, 2)=12)

  ; === Chained pipelines with `.` placeholder ===

  write 1 |> add(., 2) |> mul(., 3, 4)
  ; Expected: 36 (add(1, 2)=3, mul(3, 3, 4)=36)

  ; === Pipeline placeholder with built-in functions ===

  let arr = [1, 2, 3, 4, 5]
  write :display(arr |> Array.slice(., 1, 3))
  ; Expected: [2, 3]

  write "Pipeline test complete"
}
