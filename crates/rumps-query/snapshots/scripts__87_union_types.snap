---
source: crates/rumps-query/tests/scripts.rs
description: "; Union type tests\n\n; === Builtin unions: Storable and Scalar ===\n\n; Storable contains: Bool | Int | Float | Char | String | Json\n; Scalar contains: Bool | Int | Float | String\n\n; IS checks against Storable\nLET b: Bool = true\nLET i: Int = 42\nLET f: Float = 3.14\nLET c: Char = 'x'\nLET s: String = \"hello\"\n\n$OUTPUT b IS Storable\n$OUTPUT i IS Storable\n$OUTPUT f IS Storable\n$OUTPUT c IS Storable\n$OUTPUT s IS Storable\n\n; Non-storables\nLET arr = [1, 2, 3]\nLET obj = { x: 1 }\nLET tup = (1, 2)\n$OUTPUT arr IS Storable\n$OUTPUT obj IS Storable\n$OUTPUT tup IS Storable\n\n; IS checks against Scalar\n$OUTPUT b IS Scalar\n$OUTPUT i IS Scalar\n$OUTPUT f IS Scalar\n$OUTPUT s IS Scalar\n$OUTPUT c IS Scalar  ; Char is NOT Scalar\n\n; === AS cast for Storable (infallible) ===\n\nLET int-val: Int = 100\nLET storable-int = int-val AS Storable\n$OUTPUT storable-int IS Storable\n$OUTPUT storable-int IS Int\n\nLET str-val: String = \"test\"\nLET storable-str = str-val AS Storable\n$OUTPUT storable-str IS Storable\n$OUTPUT storable-str IS String\n\n; === User-defined unions ===\n\nUNION NumericId = Int | String\n\nLET id1: Int = 123\nLET id2: String = \"abc-456\"\n\n$OUTPUT id1 IS NumericId\n$OUTPUT id2 IS NumericId\n\n; Non-member\nLET not-id: Float = 1.5\n$OUTPUT not-id IS NumericId\n\n; === Union type in function signatures ===\n\nFUN format-id(id: NumericId) -> String {\n  MATCH id {\n    n IS Int => { \"ID#\" ++ (n AS String) }\n    s IS String => { \"ID:\" ++ s }\n    _ => { \"unknown\" }\n  }\n}\n\n$OUTPUT format-id(123)\n$OUTPUT format-id(\"xyz\")\n\n; === MATCH with IS patterns ===\n\nLET val1 = 42\nLET result1 = MATCH val1 {\n  n IS Int => { \"int: \" ++ (n AS String) }\n  s IS String => { \"str: \" ++ s }\n  b IS Bool => { \"bool\" }\n  _ => { \"other\" }\n}\n$OUTPUT result1\n\nLET val2 = \"hello\"\nLET result2 = MATCH val2 {\n  n IS Int => { \"int: \" ++ (n AS String) }\n  s IS String => { \"str: \" ++ s }\n  b IS Bool => { \"bool\" }\n  _ => { \"other\" }\n}\n$OUTPUT result2\n\nLET val3 = true\nLET result3 = MATCH val3 {\n  n IS Int => { \"int\" }\n  s IS String => { \"str\" }\n  b IS Bool => { \"bool: \" ++ (b AS String) }\n  _ => { \"other\" }\n}\n$OUTPUT result3\n\n; === Inline union types ===\n\nLET mixed: Int | String = 99\n$OUTPUT mixed IS Int\n$OUTPUT mixed IS String\n\nLET mixed2: Int | String = \"foo\"\n$OUTPUT mixed2 IS Int\n$OUTPUT mixed2 IS String\n\n; === Complex match with guards ===\n\nFUN classify(v: Storable) -> String {\n  MATCH v {\n    n IS Int IF n > 100 => { \"large int\" }\n    n IS Int IF n > 0 => { \"positive int\" }\n    n IS Int => { \"non-positive int\" }\n    s IS String IF String.length(s) > 10 => { \"long string\" }\n    s IS String => { \"short string\" }\n    b IS Bool => { \"boolean\" }\n    _ => { \"other storable\" }\n  }\n}\n\n$OUTPUT classify(500)\n$OUTPUT classify(50)\n$OUTPUT classify(0)\n$OUTPUT classify(\"hello world!!!\")\n$OUTPUT classify(\"hi\")\n$OUTPUT classify(true)\n$OUTPUT classify(3.14)\n\n; === JSON scalar extraction returns Option[Scalar] ===\n\nLET data = { \"name\": \"Alice\", \"age\": 30, \"active\": true, \"score\": 3.14 }\n\n; ->> returns Option[Scalar]\nLET name-opt = data->>(\"name\")\nLET age-opt = data->>(\"age\")\nLET active-opt = data->>(\"active\")\nLET score-opt = data->>(\"score\")\nLET missing-opt = data->>(\"missing\")\n\n$OUTPUT name-opt IS Option\n$OUTPUT age-opt IS Option\n$OUTPUT missing-opt IS Option.None\n\n; Unwrapped values are Scalar (the union type)\nLET name-val = name-opt!\nLET age-val = age-opt!\nLET active-val = active-opt!\nLET score-val = score-opt!\n\n$OUTPUT name-val IS Scalar\n$OUTPUT age-val IS Scalar\n$OUTPUT active-val IS Scalar\n$OUTPUT score-val IS Scalar\n\n; Can narrow Scalar with IS\n$OUTPUT name-val IS String\n$OUTPUT age-val IS Int\n$OUTPUT active-val IS Bool\n$OUTPUT score-val IS Float\n\n; === Type narrowing with MATCH on JSON scalars ===\n\nFUN describe-scalar(opt: Option[Scalar]) -> String {\n  MATCH opt {\n    Option.None => { \"missing\" }\n    Option.Some(s) => {\n      MATCH s {\n        v IS String => { \"string: \" ++ v }\n        v IS Int => { \"int: \" ++ (v AS String) }\n        v IS Bool => { \"bool: \" ++ (v AS String) }\n        v IS Float => { \"float: \" ++ (v AS String) }\n        _ => { \"unknown scalar\" }\n      }\n    }\n  }\n}\n\n$OUTPUT describe-scalar(data->>(\"name\"))\n$OUTPUT describe-scalar(data->>(\"age\"))\n$OUTPUT describe-scalar(data->>(\"active\"))\n$OUTPUT describe-scalar(data->>(\"score\"))\n$OUTPUT describe-scalar(data->>(\"missing\"))\n\n; === Static field extraction with .. also returns Option[Scalar] ===\n\nLET static-name = data..name\nLET static-age = data..age\n\n$OUTPUT static-name IS Option\n$OUTPUT static-name! IS Scalar\n$OUTPUT static-name! IS String\n\n$OUTPUT static-age IS Option\n$OUTPUT static-age! IS Scalar\n$OUTPUT static-age! IS Int\n\n; === Returning union types from functions ===\n\nFUN get-id(use-int: Bool) -> Int | String {\n  IF use-int { 42 } ELSE { \"abc-123\" }\n}\n\nLET id-int = get-id(true)\nLET id-str = get-id(false)\n\n$OUTPUT id-int IS Int\n$OUTPUT id-int IS String\n$OUTPUT id-str IS Int\n$OUTPUT id-str IS String\n\n; Return Storable\nFUN get-storable(kind: Int) -> Storable {\n  MATCH kind {\n    0 => { true }\n    1 => { 42 }\n    2 => { 3.14 }\n    3 => { 'x' }\n    4 => { \"hello\" }\n    _ => { { \"json\": true } }\n  }\n}\n\n$OUTPUT get-storable(0) IS Bool\n$OUTPUT get-storable(1) IS Int\n$OUTPUT get-storable(2) IS Float\n$OUTPUT get-storable(3) IS Char\n$OUTPUT get-storable(4) IS String\n$OUTPUT get-storable(5) IS Json\n\n; Return Scalar\nFUN get-scalar(kind: Int) -> Scalar {\n  MATCH kind {\n    0 => { true }\n    1 => { 42 }\n    2 => { 3.14 }\n    _ => { \"default\" }\n  }\n}\n\n$OUTPUT get-scalar(0) IS Bool\n$OUTPUT get-scalar(1) IS Int\n$OUTPUT get-scalar(2) IS Float\n$OUTPUT get-scalar(3) IS String\n\n; Return user-defined union\nFUN parse-id(s: String) -> NumericId {\n  LET as-int = s READ Int\n  MATCH as-int {\n    Result.Ok(n) => { n }\n    Result.Err(_) => { s }\n  }\n}\n\n$OUTPUT parse-id(\"123\") IS Int\n$OUTPUT parse-id(\"abc\") IS String\n"
