---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: Expression type annotations\n; Tests `(expr) : Type` syntax for inline type annotations\n\n; === Basic expression annotations ===\n\n; Int annotation\nLET x = (42) : Int\nOUTPUT x\n; Expected: 42\n\n; String annotation\nLET s = (\"hello\") : String\nOUTPUT s\n; Expected: hello\n\n; Bool annotation\nLET b = (TRUE) : Bool\nOUTPUT b\n; Expected: TRUE\n\n; Float annotation\nLET f = (3.14) : Float\nOUTPUT f\n; Expected: 3.14\n\n; === Annotating expressions ===\n\n; Annotate arithmetic expression\nLET sum = (1 + 2) : Int\nOUTPUT sum\n; Expected: 3\n\n; Annotate function call result\nLET len = (Array.length([1, 2, 3])) : Int\nOUTPUT len\n; Expected: 3\n\n; === Parameterized type annotations ===\n\n; Option[Int] with Some\nLET opt = (Option.Some(10)) : Option[Int]\nOUTPUT opt\n; Expected: Option.Some(10)\n\n; Option[String] with None\nLET none = (Option.None) : Option[String]\nOUTPUT none\n; Expected: Option.None\n\n; Result[Int, String] with Ok\nLET res = (Result.Ok(42)) : Result[Int, String]\nOUTPUT res\n; Expected: Result.Ok(42)\n\n; === Nested type annotations ===\n\n; Array[Int]\nLET arr = ([1, 2, 3]) : Array[Int]\nOUTPUT arr\n; Expected: [ 1, 2, 3 ]\n\n; === Chained usage ===\n\n; Use annotated expression in pipeline\nLET piped = (5) : Int |> (n => n * 2)\nOUTPUT piped\n; Expected: 10\n\n; Use in arithmetic\nLET doubled = (10) : Int + (20) : Int\nOUTPUT doubled\n; Expected: 30\n\n; === Tuple with type annotation (double parens) ===\n\n; Annotate a tuple with double parentheses\nLET tup = ((1, 2)) : (Int, Int)\nOUTPUT tup\n; Expected: ( 1, 2 )\n\n; Tuple in arithmetic context\nLET pair = ((10, 20)) : (Int, Int)\nOUTPUT pair.0 + pair.1\n; Expected: 30\n\nOUTPUT \"Expression annotation test complete\"\n"
---
42
hello
TRUE
3.14
3
3
Option.Some(10)
Option.None
Result.Ok(42)
[ 1, 2, 3 ]
10
