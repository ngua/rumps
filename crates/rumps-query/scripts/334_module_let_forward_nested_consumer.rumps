; Nested module consumers can depend on later sibling providers.

module UseNestedImport {
  module Inner {
    import SourceImport.{ v }

    +let w = () => v + 1
  }
}

module UseNestedPath {
  module Inner {
    +let w = () => SourcePath.v + 1
  }
}

module SourceImport {
  +let v = 41
}

module SourcePath {
  +let v = 41
}

fun main() {
  write 0
}
