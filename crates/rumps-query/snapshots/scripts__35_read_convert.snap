---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: Fallible type conversion operator (READ)\n; Tests fallible conversions that return `Result[T, String]`\n\n; === String -> Int ===\n\n; Success case\nLET s1 = \"42\"\nLET r1 = s1 READ Int\nOUTPUT r1\n; Expected: Result.Ok(42)\n\n; Negative number\nLET s2 = \"-123\"\nLET r2 = s2 READ Int\nOUTPUT r2\n; Expected: Result.Ok(-123)\n\n; Failure case (not a valid int)\nLET s3 = \"hello\"\nLET r3 = s3 READ Int\nOUTPUT r3\n; Expected: Result.Err(...)\n\n; Failure case (float string -> int)\nLET s4 = \"3.14\"\nLET r4 = s4 READ Int\nOUTPUT r4\n; Expected: Result.Err(...)\n\n; === String -> Float ===\n\n; Success case\nLET f1 = \"3.14\"\nLET rf1 = f1 READ Float\nOUTPUT rf1\n; Expected: Result.Ok(3.14)\n\n; Integer string to float\nLET f2 = \"42\"\nLET rf2 = f2 READ Float\nOUTPUT rf2\n; Expected: Result.Ok(42)\n\n; Negative float\nLET f3 = \"-2.5\"\nLET rf3 = f3 READ Float\nOUTPUT rf3\n; Expected: Result.Ok(-2.5)\n\n; Failure case\nLET f4 = \"not-a-number\"\nLET rf4 = f4 READ Float\nOUTPUT rf4\n; Expected: Result.Err(...)\n\n; === Int -> Bool ===\n\n; Zero -> false\nLET b1 = 0 READ Bool\nOUTPUT b1\n; Expected: Result.Ok(FALSE)\n\n; One -> true\nLET b2 = 1 READ Bool\nOUTPUT b2\n; Expected: Result.Ok(TRUE)\n\n; Invalid int (not 0 or 1)\nLET b3 = 42 READ Bool\nOUTPUT b3\n; Expected: Result.Err(...)\n\nLET b4 = -1 READ Bool\nOUTPUT b4\n; Expected: Result.Err(...)\n\n; === Chained operations ===\n\n; Chain read with as\nLET chain = (\"42\" READ Int) AS String\nOUTPUT chain\n; Expected: Result.Ok(42)\n\n; === Read with expressions ===\n\nLET concat = \"1\" ++ \"23\"\nLET parsed = concat READ Int\nOUTPUT parsed\n; Expected: Result.Ok(123)\n\nOUTPUT \"Fallible read test complete\"\n"
---
Result.Ok(42)
Result.Ok(-123)
Result.Err(invalid integer: hello)
Result.Err(invalid integer: 3.14)
Result.Ok(3.14)
Result.Ok(42)
Result.Ok(-2.5)
Result.Err(invalid float: not-a-number)
Result.Ok(FALSE)
Result.Ok(TRUE)
Result.Err(expected 0 or 1 for Bool, got 42)
Result.Err(expected 0 or 1 for Bool, got -1)
Result.Ok(42)
Result.Ok(123)
Fallible read test complete
