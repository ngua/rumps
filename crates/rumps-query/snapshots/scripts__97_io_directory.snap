---
source: crates/rumps-query/tests/scripts.rs
description: "; Io.Directory module primitives\n; Tests file system operations\n;\n; NOTE: Uses a unique temp directory under /tmp that is cleaned up at the end\n\nfun main() {\n  ; ============ Setup: create temp directory ============\n\n  ; Generate unique directory name using Random.uuid\n  let test-uuid = Random.uuid()\n  let test-dir-path = \"/tmp/rumps-test-{test-uuid}\"\n  let test-dir = test-dir-path as FilePath\n\n  ; Create the test directory\n  let _ = Io.Directory.create-dir(test-dir)\n\n  ; ============ FilePath coercion ============\n\n  ; Create FilePath via as cast\n  let p1 = \"/tmp/rumps-test\" as FilePath\n  write p1 is FilePath  ; true\n\n  ; ============ pwd ============\n\n  ; Get current working directory\n  let cwd = Io.Directory.pwd()\n  write cwd is FilePath  ; true\n\n  ; ============ exists / is-file / is-dir ============\n\n  ; Check if test directory exists and is a directory\n  let dir-exists = Io.Directory.exists(test-dir)\n  write dir-exists  ; true\n\n  let dir-is-dir = Io.Directory.is-dir(test-dir)\n  write dir-is-dir  ; true\n\n  let dir-is-file = Io.Directory.is-file(test-dir)\n  write dir-is-file  ; false\n\n  ; Check non-existent path\n  let fake = \"/nonexistent/path/xyz123\" as FilePath\n  let fake-exists = Io.Directory.exists(fake)\n  write fake-exists  ; false\n\n  ; ============ get-env ============\n\n  ; PATH environment variable should exist on most systems\n  let path-env = Io.Directory.get-env(\"PATH\")\n  write path-env is Option[String]  ; true\n\n  ; Non-existent env var\n  let no-such-var = Io.Directory.get-env(\"RUMPS_NONEXISTENT_VAR_12345\")\n  write :display(no-such-var)  ; Option.None\n\n  ; ============ write-file / read-file ============\n\n  ; Write a file to our temp directory\n  let test-file-path = \"{test-dir-path}/test-file.txt\"\n  let test-file = test-file-path as FilePath\n  let test-contents = \"Hello, RUMPS!\"\n\n  let _ = Io.Directory.write-file({ path: test-file, contents: test-contents })\n\n  ; Verify the file exists\n  let file-exists = Io.Directory.exists(test-file)\n  write file-exists  ; true\n\n  let file-is-file = Io.Directory.is-file(test-file)\n  write file-is-file  ; true\n\n  ; Read the file back\n  let read-contents = Io.Directory.read-file(test-file)\n  write read-contents  ; Hello, RUMPS!\n\n  ; ============ append-file ============\n\n  ; Append to the file\n  let append-str = \"\\nAppended line\"\n  let _ = Io.Directory.append-file({ path: test-file, contents: append-str })\n\n  ; Read the updated file\n  let appended-contents = Io.Directory.read-file(test-file)\n  write appended-contents  ; Hello, RUMPS!\\nAppended line\n\n  ; ============ create-dir / create-dir-all ============\n\n  ; Create a single directory\n  let subdir-path = \"{test-dir-path}/subdir\"\n  let subdir = subdir-path as FilePath\n  let _ = Io.Directory.create-dir(subdir)\n\n  let subdir-exists = Io.Directory.exists(subdir)\n  write subdir-exists  ; true\n\n  ; Create nested directories\n  let nested-path = \"{test-dir-path}/a/b/c\"\n  let nested = nested-path as FilePath\n  let _ = Io.Directory.create-dir-all(nested)\n\n  let nested-exists = Io.Directory.exists(nested)\n  write nested-exists  ; true\n\n  ; ============ list-dir ============\n\n  ; List contents of test directory (should have at least test-file.txt and subdir)\n  let entries = Io.Directory.list-dir(test-dir)\n  write entries is Array[Path]  ; true\n\n  ; Each entry is a Path (File or Dir)\n  let first = Array.head(entries)\n  write first is Option[Path]  ; true\n\n  ; Should have multiple entries\n  let entry-count = Iterable:length(entries)\n  write entry-count >= 2  ; true (at least test-file.txt and subdir)\n\n  ; ============ copy-path ============\n\n  ; Copy the test file\n  let copy-dest-path = \"{test-dir-path}/test-file-copy.txt\"\n  let copy-dest = copy-dest-path as FilePath\n  let _ = Io.Directory.copy-path({ src: test-file, dest: copy-dest })\n\n  let copy-exists = Io.Directory.exists(copy-dest)\n  write copy-exists  ; true\n\n  ; Verify contents are the same\n  let copy-contents = Io.Directory.read-file(copy-dest)\n  write copy-contents == appended-contents  ; true\n\n  ; ============ move-path ============\n\n  ; Move (rename) the copy\n  let move-dest-path = \"{test-dir-path}/test-file-moved.txt\"\n  let move-dest = move-dest-path as FilePath\n  let _ = Io.Directory.move-path({ src: copy-dest, dest: move-dest })\n\n  ; Original should not exist\n  let old-exists = Io.Directory.exists(copy-dest)\n  write old-exists  ; false\n\n  ; New location should exist\n  let new-exists = Io.Directory.exists(move-dest)\n  write new-exists  ; true\n\n  ; ============ remove ============\n\n  ; Remove the moved file\n  let _ = Io.Directory.remove(move-dest)\n\n  let removed-exists = Io.Directory.exists(move-dest)\n  write removed-exists  ; false\n\n  ; ============ set-pwd ============\n\n  ; Save current directory, change to temp dir, then restore\n  let orig-cwd = Io.Directory.pwd()\n  let _ = Io.Directory.set-pwd(test-dir)\n\n  let new-cwd = Io.Directory.pwd()\n  ; The new cwd should end with our test dir name\n  write Io.Directory.is-dir(new-cwd)  ; true\n\n  ; Restore original cwd\n  let _ = Io.Directory.set-pwd(orig-cwd)\n\n  ; ============ set-env ============\n\n  ; Set an environment variable\n  let _ = Io.Directory.set-env({ name: \"RUMPS_TEST_VAR\", value: \"test-value-123\" })\n\n  ; Read it back\n  let env-val = Io.Directory.get-env(\"RUMPS_TEST_VAR\")\n  write :display(env-val)  ; Option.Some(\"test-value-123\")\n\n  ; ============ Path as FilePath ============\n\n  ; Path.File can be cast to FilePath\n  let file-path = Path.File(test-file) as FilePath\n  write file-path is FilePath  ; true\n\n  ; Path.Dir can be cast to FilePath\n  let dir-path = Path.Dir(test-dir) as FilePath\n  write dir-path is FilePath  ; true\n\n  ; ============ canonicalize ============\n\n  ; Canonicalize the test directory\n  let canonical = Io.Directory.canonicalize(test-dir)\n  write canonical is FilePath  ; true\n  write Io.Directory.exists(canonical)  ; true\n\n  ; ============ parent ============\n\n  ; Get parent of test file\n  let file-parent = Io.Directory.parent(test-file)\n  write file-parent is Option[FilePath]  ; true\n\n  ; The parent should exist (use unwrap-or to get the value)\n  let parent-fp = Option.unwrap-or(file-parent, \"/\" as FilePath)\n  write Io.Directory.exists(parent-fp)  ; true\n\n  ; Root has no parent (or returns empty)\n  let root-parent = Io.Directory.parent(\"/\" as FilePath)\n  write :display(root-parent)  ; Option.None\n\n  ; ============ file-name ============\n\n  ; Get file name of test file\n  let fname = Io.Directory.file-name(test-file)\n  write :display(fname)  ; Option.Some(\"test-file.txt\")\n\n  ; Get file name of directory\n  let dname = Io.Directory.file-name(test-dir)\n  write dname is Option[String]  ; true\n\n  ; ============ extension ============\n\n  ; Get extension of test file\n  let ext = Io.Directory.extension(test-file)\n  write :display(ext)  ; Option.Some(\"txt\")\n\n  ; Get extension of file without extension\n  let no-ext-path = \"{test-dir-path}/noext\"\n  let no-ext-file = no-ext-path as FilePath\n  let _ = Io.Directory.write-file({ path: no-ext-file, contents: \"no extension\" })\n  let no-ext = Io.Directory.extension(no-ext-file)\n  write :display(no-ext)  ; Option.None\n\n  ; ============ with-extension ============\n\n  ; Change extension\n  let new-ext = Io.Directory.with-extension(test-file, \"md\")\n  write :display(Io.Directory.extension(new-ext))  ; Option.Some(\"md\")\n\n  ; Add extension\n  let added-ext = Io.Directory.with-extension(no-ext-file, \"json\")\n  write :display(Io.Directory.extension(added-ext))  ; Option.Some(\"json\")\n\n  ; ============ join ============\n\n  ; Join path components\n  let joined = Io.Directory.join(test-dir, [\"foo\", \"bar\", \"baz.txt\"])\n  write joined is FilePath  ; true\n  write :display(Io.Directory.file-name(joined))  ; Option.Some(\"baz.txt\")\n\n  ; ============ temp-dir ============\n\n  ; Get system temp directory\n  let tmp = Io.Directory.temp-dir()\n  write tmp is FilePath  ; true\n  write Io.Directory.is-dir(tmp)  ; true\n\n  ; ============ Cleanup: remove-all ============\n\n  ; Clean up the entire test directory\n  let _ = Io.Directory.remove-all(test-dir)\n\n  let cleanup-exists = Io.Directory.exists(test-dir)\n  write cleanup-exists  ; false\n\n  write \"All Io.Directory tests passed\"\n}\n"
