source: crates/rumps-query/tests/scripts.rs
description: "; Test: expression statements\n; Tests using expressions as statements (evaluated for side effects)\n\nfun main() {\n  ; if as statement (not capturing result)\n  let x = 10\n\n  if x > 5 {\n    write \"x is big\"\n  }\n  ; Expected: x is big\n\n  if x < 5 {\n    write \"x is small\"\n  }\n  ; Expected: (no output; condition false)\n\n  ; Block as statement\n  {\n    write \"Inside block\"\n    let temp = 42\n    write temp\n  }\n  ; Expected: Inside block, 42\n\n  ; Nested if statements\n  let a = true\n  let b = false\n\n  if a {\n    if not b {\n      write \"a is true and b is false\"\n    }\n  }\n  ; Expected: a is true and b is false\n\n  ; Multiple expression statements\n  5 + 3\n  ; Evaluated but result discarded\n  \"hello\"\n  ; Evaluated but result discarded\n  true and false\n  ; Evaluated but result discarded\n\n  write \"Made it past expression statements\"\n\n  ; if/else as statement\n  let mode = \"debug\"\n\n  if mode == \"debug\" {\n    write \"Debug mode enabled\"\n  } else {\n    write \"Production mode\"\n  }\n  ; Expected: Debug mode enabled\n\n  ; Block with @set side effects\n  {\n    @set items{1} \"first\"\n    @set items{2} \"second\"\n  }\n\n  write @get items{1}\n  ; Expected: first\n\n  write @get items{2}\n  ; Expected: second\n\n  write \"Expression statements test complete\"\n}\n"
---
