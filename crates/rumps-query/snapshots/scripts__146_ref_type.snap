---
source: crates/rumps-query/tests/scripts.rs
description: "; Test Ref as first-class type\n\n; Create refs to locals and globals\nLET local-ref = data{1, 2}\nLET global-ref = ^info{\"key\"}\n\nWRITE local-ref\nWRITE global-ref\n\n; Function that takes a Ref\nFUN get-or-default(r: Ref, default: Storable) -> Storable {\n  @GET r ?? default\n}\n\n; Set up some data\n@SET data{1, 2} = \"nested\"\n@SET data{42} = \"found\"\nTRANSACTION {\n  @SET ^info{\"key\"} = \"global value\"\n}\n\n; Use refs with functions\nWRITE get-or-default(local-ref, \"missing\")\nWRITE get-or-default(global-ref, \"missing\")\nWRITE get-or-default(data{999}, \"not found\")\n\n; Direct ref usage\nLET r = data{42}\nWRITE r\nWRITE @GET r\n\n; Refs in collections\nLET refs = [data{1}, data{2}, data{3}]\nWRITE refs\n\n; Ref with spread subscripts\nLET keys = [1, 2]\nLET spread-ref = data{...keys}\nWRITE spread-ref\n@SET data{1, 2} = \"via spread\"\nWRITE @GET spread-ref\n\n; Function that returns a Ref\nFUN make-ref(key: Int) -> Ref {\n  data{key}\n}\n\nLET returned = make-ref(42)\nWRITE returned\nWRITE @GET returned\n\n; @SET and @KILL with local Ref variable (no transaction needed)\nLET set-ref = data{100}\n@SET set-ref = \"via ref\"\nWRITE @GET set-ref\n\n; KILL local ref via variable (no transaction needed)\nLET kill-ref = data{100}\n@KILL kill-ref\nWRITE @GET kill-ref ?? \"killed\"\n\n; Global ref via variable (requires transaction)\nTRANSACTION {\n  LET g-ref = ^info{\"txn-key\"}\n  @SET g-ref = \"set via ref\"\n  WRITE @GET g-ref\n  @KILL g-ref\n  WRITE @GET g-ref ?? \"global killed\"\n}\n\n; Ref equality comparison\nLET ref1 = data{1, 2}\nLET ref2 = data{1, 2}\nLET ref3 = data{1, 3}\nLET ref4 = ^info{\"key\"}\n\nWRITE ref1 == ref2\nWRITE ref1 == ref3\nWRITE ref1 == ref4\nWRITE ref1 != ref3\n"
---
data{1, 2}
^info{"key"}
"nested"
"global value"
"not found"
data{42}
Option.Some("found")
[ data{1}, data{2}, data{3} ]
data{1, 2}
Option.Some("via spread")
data{42}
Option.Some("found")
Option.Some("via ref")
"killed"
Option.Some("set via ref")
"global killed"
TRUE
FALSE
FALSE
TRUE
