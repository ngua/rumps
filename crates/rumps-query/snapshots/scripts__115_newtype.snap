source: crates/rumps-query/tests/scripts.rs
description: "; NEWTYPE edge cases\n\n; ============ Simple primitive aliases ============\n\nNEWTYPE MyInt = Int\nLET x: MyInt = 42\n@OUTPUT x\n\nNEWTYPE MyStr = String\nLET s: MyStr = \"hello\"\n@OUTPUT s\n\nNEWTYPE MyBool = Bool\nLET b: MyBool = TRUE\n@OUTPUT b\n\n; ============ Parameterized aliases ============\n\nNEWTYPE List[T] = Array[T]\nLET xs: List[Int] = [1, 2, 3]\n@OUTPUT Array.length(xs)\n\nNEWTYPE Maybe[T] = Option[T]\nLET opt: Maybe[Int] = Option.Some(42)\n@OUTPUT opt ?? 0\n\nNEWTYPE IntMap[V] = Map[Int, V]\nLET m: IntMap[String] = { 1 => \"one\" }\n@OUTPUT m\n\n; ============ Phantom type parameters ============\n\n; Unused type param (phantom type); useful for type-level tags\nNEWTYPE Tagged[Tag] = Int\nLET userId: Tagged[String] = 100\nLET postId: Tagged[Bool] = 200\n@OUTPUT userId\n@OUTPUT postId\n\n; Phantom with multiple params; only some used\nNEWTYPE Partial[A, B] = Array[A]\nLET ps: Partial[Int, String] = [1, 2, 3]\n@OUTPUT Array.length(ps)\n\n; Nested phantom\nNEWTYPE Wrapper[T] = Int\nNEWTYPE DoubleWrap[A, B] = Wrapper[A]\nLET dw: DoubleWrap[String, Bool] = 42\n@OUTPUT dw\n\n; ============ IS operator with aliases ============\n\nNEWTYPE Person = { name: String, age: Int }\nLET p1: Person = { name: \"Alice\", age: 30 }\n\n; Basic IS checks\n@OUTPUT p1 IS Person\n@OUTPUT p1 IS { name: String }\n@OUTPUT p1 IS { name: String, age: Int }\n@OUTPUT p1 IS { name: String, age: Int, extra: Bool }\n\n; IS with extra fields on value\nLET p2: Person = { name: \"Bob\", age: 25, job: \"Engineer\" }\n@OUTPUT p2 IS Person\n@OUTPUT p2 IS { name: String, job: String }\n@OUTPUT p2 IS { name: String, age: Int, job: String }\n\n; ============ Object alias features ============\n\n; Field access on object aliases\n@OUTPUT p1.name\n@OUTPUT p1.age\n\n; Extra fields are accessible (extensible-record style)\n@OUTPUT p2.name\n@OUTPUT p2.job\n\n; Nested alias types\nNEWTYPE Address = { street: String, city: String }\nNEWTYPE PatientRecord = { patient: Person, address: Address }\n\nLET rec: PatientRecord = {\n  patient: { id: 1, name: \"Charlie\", age: 40 },\n  address: { street: \"456 Oak Ave\", city: \"LA\" }\n}\n@OUTPUT rec.patient.name\n@OUTPUT rec.address.city\n\n; Function with alias type parameter\nFUN greet (p: Person) -> String {\n  \"Hello, \" ++ p.name ++ \"!\"\n}\n@OUTPUT greet({ name: \"Diana\", age: 28 })\n\n; Function returning structural object\nFUN make-person (name: String, age: Int) -> { name: String, age: Int } {\n  { name: name, age: age }\n}\nLET p3 = make-person(\"Eve\", 35)\n@OUTPUT p3.name\n@OUTPUT p3.age\n\n; ============ Parametric object aliases ============\n\n; Single type parameter\nNEWTYPE Box[T] = { value: T }\nLET int-box: Box[Int] = { value: 42 }\n@OUTPUT int-box.value\n\nLET str-box: Box[String] = { value: \"hello\" }\n@OUTPUT str-box.value\n\n; Two type parameters\nNEWTYPE Pair[L, R] = { left: L, right: R }\nLET pair: Pair[Int, String] = { left: 1, right: \"one\" }\n@OUTPUT pair.left\n@OUTPUT pair.right\n\n; Nested type parameters\nLET nested: Box[Pair[Int, Bool]] = { value: { left: 99, right: true } }\n@OUTPUT nested.value.left\n@OUTPUT nested.value.right\n\n; NEWTYPE wrapping Option\nNEWTYPE MaybeBox[T] = { inner: Option[T] }\nLET some-val: MaybeBox[Int] = { inner: Option.Some(123) }\nLET none-val: MaybeBox[Int] = { inner: Option.None }\n@OUTPUT some-val.inner!\n@OUTPUT none-val.inner ?? 0\n"
