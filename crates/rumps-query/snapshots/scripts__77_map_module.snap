---
source: crates/rumps-query/tests/scripts.rs
description: "; Map module primitives\n; Tests `Map.empty`, `Map.length`, `Map.keys`, `Map.values`, `Map.entries`,\n; `Map.has`, `Map.lookup`, `Map.insert`, `Map.remove`, `Map.merge`,\n; `Map.from-entries`, `Map.map`, `Map.map-with-key`, `Map.map-entries`,\n; `Map.foreach`, `Map.foreach-with-key`\n;\n; Note: `{}` is ambiguous and parsed as an empty object. Use Map.empty() for empty maps.\n\nnewtype Down = Int\n\nclass Ord for Down {\n  fun compare(a: Down, b: Down) -> Ordering {\n    let ai: Int = a\n    let bi: Int = b\n    if ai > bi { Ordering.Lt } else {\n      if ai == bi { Ordering.Eq } else { Ordering.Gt }\n    }\n  }\n}\n\nvariant Band = Band(Int)\n\nfun bucket(b: Band) -> Int {\n  match b {\n    Band.Band(n) => { n // 10 }\n  }\n}\n\nclass Ord for Band {\n  fun compare(a: Band, b: Band) -> Ordering {\n    let ba = bucket(a)\n    let bb = bucket(b)\n    if ba > bb { Ordering.Lt } else {\n      if ba == bb { Ordering.Eq } else { Ordering.Gt }\n    }\n  }\n}\n\nclass Eq for Band {\n  fun eq(a: Band, b: Band) -> Bool {\n    bucket(a) == bucket(b)\n  }\n}\n\nfun main() {\n  ; ============ Map literals ============\n\n  let m = { 1 => \"one\", 2 => \"two\", 3 => \"three\" }\n  write m\n\n  let str-keys = { \"a\" => 1, \"b\" => 2 }\n  write str-keys\n\n  ; ============ Map.empty ============\n\n  let e = Map.empty()\n  write e\n  write Map.length(e)  ; 0\n\n  ; ============ Map.length ============\n\n  write Map.length(m)  ; 3\n  write Map.length(str-keys)  ; 2\n\n  ; ============ Map.keys ============\n\n  let keys1 = Map.keys(m)\n  write keys1  ; [1, 2, 3]\n\n  let keys2 = Map.keys(str-keys)\n  write keys2  ; [\"a\", \"b\"]\n\n  let keys3 = Map.keys(e)\n  write keys3  ; []\n\n  ; ============ Map.values ============\n\n  let vals1 = Map.values(m)\n  write vals1  ; [\"one\", \"two\", \"three\"]\n\n  let vals2 = Map.values(str-keys)\n  write vals2  ; [1, 2]\n\n  let vals3 = Map.values(e)\n  write vals3  ; []\n\n  ; ============ Map.entries ============\n\n  let ent1 = Map.entries(m)\n  write ent1  ; [(1, \"one\"), (2, \"two\"), (3, \"three\")]\n\n  let ent2 = Map.entries(str-keys)\n  write ent2  ; [(\"a\", 1), (\"b\", 2)]\n\n  ; ============ Map.has ============\n\n  write Map.has(m, 1)  ; true\n  write Map.has(m, 2)  ; true\n  write Map.has(m, 4)  ; false\n  write Map.has(e, 1)  ; false\n\n  write Map.has(str-keys, \"a\")  ; true\n  write Map.has(str-keys, \"c\")  ; false\n\n  ; ============ Map.lookup ============\n\n  write Map.lookup(m, 1)  ; Some(\"one\")\n  write Map.lookup(m, 2)  ; Some(\"two\")\n  write Map.lookup(m, 4)  ; None\n  write Map.lookup(e, 1)  ; None\n\n  write Map.lookup(str-keys, \"a\")  ; Some(1)\n  write Map.lookup(str-keys, \"z\")  ; None\n\n  ; ============ Map.insert ============\n\n  let m2 = Map.insert(m, 4, \"four\")\n  write Map.length(m2)  ; 4\n  write Map.lookup(m2, 4)  ; Some(\"four\")\n\n  ; Original unchanged\n  write Map.length(m)  ; 3\n\n  ; Overwrite existing key\n  let m3 = Map.insert(m, 1, \"ONE\")\n  write Map.lookup(m3, 1)  ; Some(\"ONE\")\n\n  ; ============ Map.remove ============\n\n  let m4 = Map.remove(m, 2)\n  write Map.length(m4)  ; 2\n  write Map.has(m4, 2)  ; false\n  write Map.has(m4, 1)  ; true\n  write Map.has(m4, 3)  ; true\n\n  ; Remove non-existent key (no-op)\n  let m5 = Map.remove(m, 999)\n  write Map.length(m5)  ; 3\n\n  ; ============ Map.merge ============\n\n  let ma = { 1 => \"a\", 2 => \"b\" }\n  let mb = { 2 => \"B\", 3 => \"c\" }\n  let merged = Map.merge(ma, mb)\n  write Map.length(merged)  ; 3\n  write Map.lookup(merged, 1)  ; Some(\"a\")\n  write Map.lookup(merged, 2)  ; Some(\"B\") (second overwrites)\n  write Map.lookup(merged, 3)  ; Some(\"c\")\n\n  ; ============ Map.from-entries ============\n\n  let arr = [(1, \"x\"), (2, \"y\"), (3, \"z\")]\n  let from-arr = Map.from-entries(arr)\n  write Map.length(from-arr)  ; 3\n  write Map.lookup(from-arr, 1)  ; Some(\"x\")\n  write Map.lookup(from-arr, 2)  ; Some(\"y\")\n  write Map.lookup(from-arr, 3)  ; Some(\"z\")\n\n  ; ============ `Map` HoFs ============\n\n  let hof-src = Map.from-entries([(3, 30), (1, 10), (2, 20)])\n\n  let map-vals = Map.map(x => x + 1, hof-src)\n  write Map.entries(map-vals)\n\n  let map-with-keys = Map.map-with-key((k, v) => k * 100 + v, hof-src)\n  write Map.entries(map-with-keys)\n\n  write \"Map.foreach:\"\n  let fe = Map.foreach(v => { write \"v:{v}\" }, hof-src)\n  write fe\n\n  write \"Map.foreach-with-key:\"\n  let fe-key = Map.foreach-with-key((k, v) => { write \"{k}:{v}\" }, hof-src)\n  write fe-key\n\n  let entry-src = Map.from-entries([(3, 300), (1, 100), (2, 200)])\n  let str-entry-map = Map.map-entries((k, v) => {\n    let s = if k == 1 { \"c\" } else {\n      if k == 2 { \"a\" } else { \"b\" }\n    }\n    (s, v // 10)\n  }, entry-src)\n  write Map.entries(str-entry-map)\n\n  let dup-entry-map = Map.map-entries((k, v) => {\n    let s = if k == 2 { \"even\" } else { \"odd\" }\n    (s, \"{v}!\")\n  }, m)\n  write Map.entries(dup-entry-map)\n  write Map.lookup(dup-entry-map, \"odd\")\n\n  let down-entry-map = Map.map-entries((k, v) => {\n    let d: Down = k\n    (d, v + 1)\n  }, hof-src)\n  write Map.entries(down-entry-map)\n\n  let empty-int: Map[Int, Int] = Map.empty()\n  write Map.entries(Map.map(x => x + 1, empty-int))\n  write Map.entries(Map.map-with-key((k, v) => k + v, empty-int))\n  write Map.entries(Map.map-entries((k, v) => (\"empty-{k}\", v + 1), empty-int))\n  write Map.foreach(v => { write \"empty-value:{v}\" }, empty-int)\n  write Map.foreach-with-key((k, v) => { write \"empty-entry:{k}:{v}\" }, empty-int)\n\n  let down-hof-src: Array[(Down, String)] = [(1, \"one\"), (3, \"three\"), (2, \"two\")]\n  let down-hof = Map.from-entries(down-hof-src)\n\n  let down-map-vals = Map.map(v => String.upper(v), down-hof)\n  write Map.entries(down-map-vals)\n\n  let down-map-with-keys = Map.map-with-key((k, v) => \"{k}:{v}\", down-hof)\n  write Map.entries(down-map-with-keys)\n\n  ; ============ Chaining operations ============\n\n  let chain = { 1 => 10, 2 => 20, 3 => 30 }\n  let chain2 = Map.insert(chain, 4, 40)\n  let chain3 = Map.remove(chain2, 1)\n  write Map.length(chain3)  ; 3\n  write Map.keys(chain3)  ; [2, 3, 4]\n\n  ; ============ Float keys ============\n\n  let float-map = { 1.5 => \"half\", 2.5 => \"two-half\" }\n  write Map.has(float-map, 1.5)  ; true\n  write Map.lookup(float-map, 2.5)  ; Some(\"two-half\")\n\n  ; ============ Boolean keys ============\n\n  let bool-map = { true => \"yes\", false => \"no\" }\n  write Map.lookup(bool-map, true)  ; Some(\"yes\")\n  write Map.lookup(bool-map, false)  ; Some(\"no\")\n\n  ; ============ Index syntax (direct access) ============\n\n  write m[1]  ; \"one\"\n  write m[2]  ; \"two\"\n\n  write str-keys[\"a\"]  ; 1\n\n  ; ============ Optional index syntax (returns Option) ============\n\n  write m?[1]  ; Some(\"one\")\n  write m?[99]  ; None (key not found)\n\n  write str-keys?[\"a\"]  ; Some(1)\n  write str-keys?[\"missing\"]  ; None\n\n  ; Chaining with optional unwrap\n  write m?[1] ?? \"default\"  ; \"one\"\n  write m?[99] ?? \"default\"  ; \"default\"\n\n  ; ============ Canonical order and overwrite semantics ============\n\n  let unordered-a = Map.from-entries([(\"b\", 2), (\"a\", 1)])\n  let unordered-b = Map.from-entries([(\"a\", 1), (\"b\", 2)])\n  write Map.keys(unordered-a)\n  write Map.values(unordered-a)\n  write Map.entries(unordered-a)\n  write unordered-a == unordered-b\n  write unordered-a <= unordered-b\n  write unordered-b <= unordered-a\n\n  let dup = Map.from-entries([(\"a\", 1), (\"b\", 2), (\"a\", 3)])\n  write Map.length(dup)\n  write Map.entries(dup)\n  write Map.lookup(dup, \"a\")\n\n  let ml = Map.from-entries([(\"a\", 1), (\"b\", 2)])\n  let mr = Map.from-entries([(\"b\", 20), (\"c\", 30)])\n  let merged2 = Map.merge(ml, mr)\n  let removed2 = Map.remove(merged2, \"missing\")\n  write Map.entries(merged2)\n  write Map.entries(removed2)\n  write Map.lookup(merged2, \"missing\")\n\n  ; ============ Required key shapes ============\n\n  let bools = Map.from-entries([(true, \"true\"), (false, \"false\")])\n  write Map.keys(bools)\n\n  let ints = Map.from-entries([(10, \"ten\"), (1, \"one\")])\n  write Map.keys(ints)\n\n  let floats = Map.from-entries([(2.5, \"two\"), (1.5, \"one\")])\n  write Map.keys(floats)\n\n  let chars = Map.from-entries([('b', \"bee\"), ('a', \"aye\")])\n  write Map.keys(chars)\n\n  let strings = Map.from-entries([(\"b\", 2), (\"a\", 1)])\n  write Map.keys(strings)\n\n  let tuples = Map.from-entries([((2, \"b\"), 20), ((1, \"a\"), 10)])\n  write Map.keys(tuples)\n  write Map.lookup(tuples, (1, \"a\"))\n\n  let arrays = Map.from-entries([([2], \"two\"), ([1, 2], \"one-two\"), ([1], \"one\")])\n  write Map.keys(arrays)\n\n  let none: Option[Int] = Option.None\n  let some1 = Option.Some(1)\n  let some2 = Option.Some(2)\n  let opts = Map.from-entries([(some2, \"two\"), (none, \"none\"), (some1, \"one\")])\n  write Map.keys(opts)\n\n  let err-a: Result[Int, String] = Result.Err(\"a\")\n  let err-b: Result[Int, String] = Result.Err(\"b\")\n  let ok1: Result[Int, String] = Result.Ok(1)\n  let ress = Map.from-entries([(ok1, \"ok\"), (err-b, \"err-b\"), (err-a, \"err-a\")])\n  write Map.keys(ress)\n\n  let ords = Map.from-entries([\n    (Ordering.Gt, \"gt\"),\n    (Ordering.Lt, \"lt\"),\n    (Ordering.Eq, \"eq\"),\n  ])\n  write Map.keys(ords)\n\n  let key1 = Map.from-entries([(1, \"one\")])\n  let key2 = Map.from-entries([(1, \"one\"), (2, \"two\")])\n  let nested = Map.from-entries([(key2, \"long\"), (key1, \"short\")])\n  write Map.keys(nested)\n\n  ; ============ Persistent update shapes ============\n\n  let empty: Map[Int, String] = Map.empty()\n\n  let asc1 = Map.insert(empty, 1, \"one\")\n  let asc2 = Map.insert(asc1, 2, \"two\")\n  let asc3 = Map.insert(asc2, 3, \"three\")\n  let asc4 = Map.insert(asc3, 4, \"four\")\n  let asc5 = Map.insert(asc4, 5, \"five\")\n  write Map.keys(asc5)\n  write Map.lookup(asc5, 1)\n  write Map.lookup(asc5, 3)\n  write Map.lookup(asc5, 5)\n\n  let desc1 = Map.insert(empty, 5, \"five\")\n  let desc2 = Map.insert(desc1, 4, \"four\")\n  let desc3 = Map.insert(desc2, 3, \"three\")\n  let desc4 = Map.insert(desc3, 2, \"two\")\n  let desc5 = Map.insert(desc4, 1, \"one\")\n  write Map.keys(desc5)\n  write Map.lookup(desc5, 1)\n  write Map.lookup(desc5, 3)\n  write Map.lookup(desc5, 5)\n\n  let mixed1 = Map.insert(empty, 3, \"three\")\n  let mixed2 = Map.insert(mixed1, 1, \"one\")\n  let mixed3 = Map.insert(mixed2, 5, \"five\")\n  let mixed4 = Map.insert(mixed3, 2, \"two\")\n  let mixed5 = Map.insert(mixed4, 4, \"four\")\n  write Map.keys(mixed5)\n  write Map.lookup(mixed5, 1)\n  write Map.lookup(mixed5, 3)\n  write Map.lookup(mixed5, 5)\n\n  write Map.keys(empty)\n  write Map.keys(asc1)\n  write Map.keys(asc5)\n\n  let removed3 = Map.remove(asc5, 1)\n  let removed4 = Map.remove(removed3, 3)\n  write Map.keys(asc5)\n  write Map.keys(removed3)\n  write Map.keys(removed4)\n  write Map.lookup(asc5, 1)\n  write Map.lookup(removed3, 1)\n  write Map.lookup(removed4, 3)\n\n  ; ============ User-defined key ordering ============\n\n  let ds: Array[(Down, String)] = [(1, \"one\"), (3, \"three\"), (2, \"two\")]\n  let dm = Map.from-entries(ds)\n  write Map.keys(dm)\n\n  let three: Down = 3\n  let dups: Array[(Down, String)] = [(three, \"three\"), (three, \"THREE\")]\n  let dup-dm = Map.from-entries(dups)\n  write Map.keys(dup-dm)\n  write Map.lookup(dup-dm, three)\n\n  let b5 = Band.Band(5)\n  let b10 = Band.Band(10)\n  let b12 = Band.Band(12)\n  let b20 = Band.Band(20)\n\n  let bands = Map.from-entries([\n    (b10, \"ten\"),\n    (b20, \"twenty\"),\n    (b5, \"five\"),\n    (b12, \"twelve\"),\n  ])\n\n  write Map.length(bands)\n  write Map.keys(bands)\n  write Map.lookup(bands, Band.Band(11))\n  write Map.lookup(bands, b10)\n  write Map.lookup(bands, b20)\n}\n"
