source: crates/rumps-query/tests/scripts.rs
description: "; NEWTYPE edge cases\n\n; ============ Simple primitive aliases ============\n\nNEWTYPE MyInt = Int\nLET x: MyInt = 42\nWRITE x\n\nNEWTYPE MyStr = String\nLET s: MyStr = \"hello\"\nWRITE s\n\nNEWTYPE MyBool = Bool\nLET b: MyBool = TRUE\nWRITE b\n\n; ============ Parameterized aliases ============\n\nNEWTYPE List[T] = Array[T]\nLET xs: List[Int] = [1, 2, 3]\nWRITE Iterable:length(xs)\n\nNEWTYPE Maybe[T] = Option[T]\nLET opt: Maybe[Int] = Option.Some(42)\nWRITE opt ?? 0\n\nNEWTYPE IntMap[V] = Map[Int, V]\nLET m: IntMap[String] = { 1 => \"one\" }\nWRITE m\n\n; ============ Phantom type parameters ============\n\n; Unused type param (phantom type); useful for type-level tags\nNEWTYPE Tagged[Tag] = Int\nLET user-id: Tagged[String] = 100\nLET post-id: Tagged[Bool] = 200\nWRITE user-id\nWRITE post-id\n\n; Phantom with multiple params; only some used\nNEWTYPE Partial[A, B] = Array[A]\nLET ps: Partial[Int, String] = [1, 2, 3]\nWRITE Iterable:length(ps)\n\n; Nested phantom\nNEWTYPE Wrapper[T] = Int\nNEWTYPE DoubleWrap[A, B] = Wrapper[A]\nLET dw: DoubleWrap[String, Bool] = 42\nWRITE dw\n\n; ============ IS operator with aliases ============\n\nNEWTYPE Person = { name: String, age: Int }\nLET p1: Person = { name: \"Alice\", age: 30 }\n\n; Basic IS checks\nWRITE p1 IS Person\nWRITE p1 IS { name: String }\nWRITE p1 IS { name: String, age: Int }\nWRITE p1 IS { name: String, age: Int, extra: Bool }\n\n; IS with extra fields on value\nLET p2: Person = { name: \"Bob\", age: 25, job: \"Engineer\" }\nWRITE p2 IS Person\nWRITE p2 IS { name: String, job: String }\nWRITE p2 IS { name: String, age: Int, job: String }\n\n; ============ Object alias features ============\n\n; Field access on object aliases\nWRITE p1.name\nWRITE p1.age\n\n; Extra fields are accessible (extensible-record style)\nWRITE p2.name\nWRITE p2.job\n\n; Nested alias types\nNEWTYPE Address = { street: String, city: String }\nNEWTYPE PatientRecord = { patient: Person, address: Address }\n\nLET rec: PatientRecord = {\n  patient: { id: 1, name: \"Charlie\", age: 40 },\n  address: { street: \"456 Oak Ave\", city: \"LA\" }\n}\nWRITE rec.patient.name\nWRITE rec.address.city\n\n; Function with alias type parameter\nFUN greet (p: Person) -> String {\n  \"Hello, {p.name}!\"\n}\nWRITE greet({ name: \"Diana\", age: 28 })\n\n; Function returning structural object\nFUN make-person (name: String, age: Int) -> { name: String, age: Int } {\n  { name: name, age: age }\n}\nLET p3 = make-person(\"Eve\", 35)\nWRITE p3.name\nWRITE p3.age\n\n; ============ Parametric object aliases ============\n\n; Single type parameter\nNEWTYPE Box[T] = { value: T }\nLET int-box: Box[Int] = { value: 42 }\nWRITE int-box.value\n\nLET str-box: Box[String] = { value: \"hello\" }\nWRITE str-box.value\n\n; Two type parameters\nNEWTYPE Pair[L, R] = { left: L, right: R }\nLET pair: Pair[Int, String] = { left: 1, right: \"one\" }\nWRITE pair.left\nWRITE pair.right\n\n; Nested type parameters\nLET nested: Box[Pair[Int, Bool]] = { value: { left: 99, right: true } }\nWRITE nested.value.left\nWRITE nested.value.right\n\n; NEWTYPE wrapping Option\nNEWTYPE MaybeBox[T] = { inner: Option[T] }\nLET some-val: MaybeBox[Int] = { inner: Option.Some(123) }\nLET none-val: MaybeBox[Int] = { inner: Option.None }\nWRITE some-val.inner!\nWRITE none-val.inner ?? 0\n"
