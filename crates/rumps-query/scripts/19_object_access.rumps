; Test: object field access
; Tests dot notation for objects (bracket notation is for arrays/maps only)

LET obj = { name: "Alice", age: 30, active: TRUE }

; Dot notation
$OUTPUT obj.name
; Expected: Alice

$OUTPUT obj.age
; Expected: 30

$OUTPUT obj.active
; Expected: TRUE

; Nested object access (dot notation)
LET rec = {
  user: {
    profile: {
      first-name: "Bob",
      last-name: "Smith"
    },
    scores: [90, 85, 95]
  }
}

$OUTPUT rec.user.profile.first-name
; Expected: Bob

$OUTPUT rec.user.profile.last-name
; Expected: Smith

$OUTPUT rec.user.scores[0]
; Expected: 90

$OUTPUT rec.user.scores[-1]
; Expected: 95

; Object with dashed keys (valid RUMPS identifiers)
LET special = { my-key: "value1", another-key: "value2" }
$OUTPUT special.my-key
; Expected: value1

$OUTPUT special.another-key
; Expected: value2

; Optional field access (`?.`) on objects
; Returns `Some(value)` if field exists, `None` if missing

LET person = { name: "Carol", age: 25 }

$OUTPUT person?.name
; Expected: Option.Some("Carol")

$OUTPUT person?.age
; Expected: Option.Some(25)

$OUTPUT person?.email
; Expected: Option.None

$OUTPUT person?.address
; Expected: Option.None

; Chained optional access
LET nested = { user: { name: "Dan" } }
$OUTPUT nested?.user?.name
; Expected: Option.Some("Dan")

$OUTPUT nested?.user?.missing
; Expected: Option.None

$OUTPUT nested?.missing?.anything
; Expected: Option.None

; Optional field access in function with typed parameter
; The type `{ a: Int }` should allow `?.` on fields not in the type
fun get_b(x: { a: Int }) {
  x?.b
}

$OUTPUT get_b({ a: 1 })
; Expected: Option.None

$OUTPUT get_b({ a: 1, b: 2 })
; Expected: Option.Some(2)

$OUTPUT "Object access test complete"
