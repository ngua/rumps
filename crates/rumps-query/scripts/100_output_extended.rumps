; Test: Extended write statement
; Tests write with json format and to error/file targets

fun main() {
  ; === Basic write (unchanged behavior) ===
  write "Hello, World!"
  ; Expected: Hello, World!

  let my-x = 42
  write my-x
  ; Expected: 42

  let my-obj = { name: "Alice", age: 30 }
  write :display(my-obj)
  ; Expected: { name: Alice, age: 30 }

  ; === write json (format modifier) ===
  write "Test json format" json
  ; Expected: "Test json format"

  write 42 json
  ; Expected: 42

  write true json
  ; Expected: true

  let my-arr = [1, 2, 3]
  write my-arr json
  ; Expected: [1, 2, 3] (or pretty-printed)

  let my-data = { name: "Bob", scores: [90, 85, 95] }
  write my-data json
  ; Expected: pretty-printed json object

  ; === write to error (target modifier) ===
  write "This goes to stderr" to error
  ; Expected: (on stderr) This goes to stderr

  write 123 to error
  ; Expected: (on stderr) 123

  ; === write json to error (format + target) ===
  write { status: "error", code: 500 } json to error
  ; Expected: (on stderr) pretty-printed json

  ; === Contextual identifiers as variable names ===
  ; These must work as regular identifiers
  let json = "my json var"
  write json
  ; Expected: my json var

  let to = 10
  write to
  ; Expected: 10

  let error = "an error message"
  write error
  ; Expected: an error message

  let file = "/path/to/file"
  write file
  ; Expected: /path/to/file

  write "Complete!"
}
