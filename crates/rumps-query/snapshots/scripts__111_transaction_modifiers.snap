---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: Transaction modifiers\n; Tests on conflict, with timeout, with retries, with isolation\n;\n; Modifier ordering:\n;   Modifiers must appear in this fixed order (each is optional):\n;     1. on conflict (abort | overwrite)\n;     2. with timeout <expr>\n;     3. with retries n\n;     4. with isolation snapshot\n;\n;   Note that we only support snapshot isolation at the moment and that\n;   this is the default; other isolation levels are a future enhancement.\n;\n;   Retry semantics: `with retries n` retries the commit phase only, not\n;   the entire transaction block. This helps with transient errors like\n;   `TransactionTimeout`, but not with `WriteConflict`; write conflicts\n;   are permanent for a given snapshot since the conflicting write from\n;   another transaction is already recorded.\n;\n;   Each modifier can appear at most once. Out-of-order or duplicate\n;   modifiers will produce a parse error.\n\nfun main() {\n  ; === on conflict abort (default) ===\n  let r1 = transaction {\n    @set ^data{1} \"one\"\n  } on conflict abort\n  write r1 is Result.Ok(_)\n\n  ; === on conflict overwrite ===\n  let r2 = transaction {\n    @set ^data{2} \"two\"\n  } on conflict overwrite\n  write r2 is Result.Ok(_)\n\n  ; === with timeout (milliseconds) ===\n  let r3 = transaction {\n    @set ^data{3} \"three\"\n  } with timeout 5000\n  write r3 is Result.Ok(_)\n\n  ; === with retries n ===\n  let r4 = transaction {\n    @set ^data{4} \"four\"\n  } with retries 3\n  write r4 is Result.Ok(_)\n\n  ; === with isolation snapshot ===\n  let r5 = transaction {\n    @set ^data{5} \"five\"\n  } with isolation snapshot\n  write r5 is Result.Ok(_)\n\n  ; === Combined modifiers ===\n  let r6 = transaction {\n    @set ^data{6} \"six\"\n  } on conflict overwrite with timeout 5000 with retries 3\n  write r6 is Result.Ok(_)\n\n  ; === All modifiers ===\n  let r7 = transaction {\n    @set ^data{7} \"seven\"\n  } on conflict overwrite with timeout 1000 with retries 5 with isolation snapshot\n  write r7 is Result.Ok(_)\n\n  ; === Timeout from expression ===\n  let timeout-ms = 2000\n  let r8 = transaction {\n    @set ^data{8} \"eight\"\n  } with timeout timeout-ms\n  write r8 is Result.Ok(_)\n\n  let r9 = transaction {\n    @set ^data{9} \"nine\"\n  } on conflict abort with timeout 1000\n  write r9 is Result.Ok(_)\n\n  let r10 = transaction {\n    @set ^data{10} \"ten\"\n  } on conflict overwrite with retries 2\n  write r10 is Result.Ok(_)\n\n  ; === Contextual identifiers as variables ===\n  let on = \"on\"\n  let conflict = \"conflict\"\n  let timeout = 1000\n  let with = \"with\"\n  let retries = \"retries\"\n  let isolation = \"isolation\"\n  write \"{on} {conflict}\"\n\n  ; Can use these as variable names and still use modifiers\n  let r11 = transaction {\n    @set ^data{11} \"{on}{conflict}\"\n  } with timeout timeout\n  write r11 is Result.Ok(_)\n  write @get ^data{11}\n\n  ; === Timeout actually triggers ===\n  ; This tests that with timeout actually cancels long-running transactions\n  let timed-out = transaction {\n    forever 0 (next, cont) => {\n      if next > 100 {\n        next\n      } else {\n        cont({\n          @set ^d{next} \"a\"\n          Time.sleep(10 * 10000)\n          next + 1\n        })\n      }\n    }\n  } with timeout 1\n\n  write timed-out\n\n  write \"Transaction modifiers test complete\"\n}\n"
---
