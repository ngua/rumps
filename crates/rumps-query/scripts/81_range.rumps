; Range operator tests
; Tests exclusive (`..`) and inclusive (`..=`) ranges
; NOTE: Range operators require spaces around `..` and `..=`

; Basic exclusive range display
LET r1 = 1 .. 5
WRITE r1  ; 1..5

; Basic inclusive range display
LET r2 = 1 ..= 5
WRITE r2  ; 1..=5

; Range with expressions: binds looser than additive
; So `1 .. n + 1` parses as `1..(n + 1)`, not `(1..n) + 1`
LET n = 3
LET r3 = 0 .. n + 1
WRITE r3  ; 0..4

; Array.map with range (exclusive)
LET squares = Array.map(x => x * x, 1 .. 4)
WRITE squares  ; [1, 4, 9]

; Array.map with range (inclusive)
LET cubes = Array.map(x => x * x * x, 1 ..= 3)
WRITE cubes  ; [1, 8, 27]

; Array.filter with range
LET evens = Array.filter(x => x % 2 == 0, 1 .. 10)
WRITE evens  ; [2, 4, 6, 8]

; Array.filter with inclusive range
LET odd = Array.filter(x => x % 2 != 0, 1 ..= 5)
WRITE odd  ; [1, 3, 5]

; Array.reduce with range (sum 1..5 = 1+2+3+4 = 10)
LET sum1 = Array.reduce((acc, x) => acc + x, 0, 1 .. 5)
WRITE sum1  ; 10

; Array.reduce with inclusive range (sum 1..=5 = 1+2+3+4+5 = 15)
LET sum2 = Array.reduce((acc, x) => acc + x, 0, 1 ..= 5)
WRITE sum2  ; 15

; Factorial using range and reduce
LET fact5 = Array.reduce((acc, x) => acc * x, 1, 1 ..= 5)
WRITE fact5  ; 120

; Chaining operations with ranges
LET filtered = Array.filter(x => x > 2, 1 ..= 5)
LET result = Array.map(x => x * 10, filtered)
WRITE result  ; [30, 40, 50]

; Empty range (start >= end for exclusive)
LET empty = Array.map(x => x, 5 .. 5)
WRITE empty  ; []

; Negative ranges
LET negatives = Array.map(x => x, -3 .. 1)
WRITE negatives  ; [-3, -2, -1, 0]

; Range with named function
FUN double (n: Int) -> Int { n * 2 }
LET doubles = Array.map(double, 1 .. 5)
WRITE doubles  ; [2, 4, 6, 8]
