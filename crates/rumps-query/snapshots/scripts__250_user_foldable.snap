---
source: crates/rumps-query/tests/scripts.rs
description: "; User Foldable for type, newtype, and union\n\nvariant Box[T] = Full(T) | Empty\nnewtype Bag[T] = Array[T]\nunion Flex = Array[Int] | Bag[Int]\n\nclass Foldable for Box {\n  fun fold(f, init, x) {\n    match x {\n      Box.Full(v) => { f(init, v) }\n      Box.Empty => { init }\n    }\n  }\n}\n\nfun main() {\n  ; type with user instance\n  write Foldable:fold((acc, x) => acc + x, 0, Box.Full(42))\n  write Foldable:fold((acc, x) => acc + x, 100, Box.Empty)\n  write Foldable:fold-map(x => \"{x}\", Box.Full(42))\n  let box-empty: Box[Int] = Box.Empty\n  let box-empty-str: String = Foldable:fold-map(x => \"{x}\", box-empty)\n  write box-empty-str\n\n  ; newtype auto-derive\n  let b: Bag[Int] = [1, 2, 3, 4]\n  write Foldable:fold((acc, x) => acc + x, 0, b)\n  write Foldable:fold-map(x => \"{x}\", b)\n\n  ; union auto-derive\n  let a: Flex = [10, 20, 30]\n  write Foldable:fold((acc, x) => acc + x, 0, a)\n  write Foldable:fold-map(x => \"{x}\", a)\n\n  let c: Flex = b\n  write Foldable:fold((acc, x) => acc + x, 0, c)\n  write Foldable:fold-map(x => \"{x}\", c)\n}\n"
