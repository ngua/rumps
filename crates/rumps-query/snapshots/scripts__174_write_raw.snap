---
source: crates/rumps-query/tests/scripts.rs
description: "; Test write raw modifier\n; raw preserves escape sequences instead of rendering them\n\nfun main() {\n  ; =============================================================================\n  ; Newline escaping\n  ; =============================================================================\n\n  ; Default: renders actual newline\n  write \"line1\\nline2\"\n\n  ; raw: shows escape sequence\n  write \"line1\\nline2\" raw\n\n  ; =============================================================================\n  ; Tab escaping\n  ; =============================================================================\n\n  ; Default: renders actual tab\n  write \"col1\\tcol2\"\n\n  ; raw: shows escape sequence\n  write \"col1\\tcol2\" raw\n\n  ; =============================================================================\n  ; Quote escaping\n  ; =============================================================================\n\n  ; Default: renders literal quotes (invalid RUMPS syntax)\n  write \"He said \\\"Hello\\\"\"\n\n  ; raw: shows escape sequence (valid RUMPS syntax)\n  write \"He said \\\"Hello\\\"\" raw\n\n  ; =============================================================================\n  ; Backslash escaping\n  ; =============================================================================\n\n  ; Default: renders single backslash\n  write \"path\\\\to\\\\file\"\n\n  ; raw: shows escaped backslash\n  write \"path\\\\to\\\\file\" raw\n\n  ; =============================================================================\n  ; Multiple escapes\n  ; =============================================================================\n\n  write \"line1\\nline2\\nline3\" raw\n  write \"a\\tb\\tc\" raw\n\n  ; =============================================================================\n  ; Char escaping in raw mode\n  ; =============================================================================\n\n  write '\\n' raw\n  write '\\t' raw\n  write '\\\\' raw\n\n  ; =============================================================================\n  ; Arrays with strings\n  ; =============================================================================\n\n  write :display([\"a\\nb\", \"c\\td\"]) raw\n\n  ; =============================================================================\n  ; Objects with strings\n  ; =============================================================================\n\n  write :display({name: \"foo\\nbar\", value: \"x\\ty\"}) raw\n\n  ; =============================================================================\n  ; Tuples with strings\n  ; =============================================================================\n\n  write :display((\"a\\nb\", \"c\\td\")) raw\n\n  ; =============================================================================\n  ; Options with strings\n  ; =============================================================================\n\n  write :display(Option.Some(\"foo\\nbar\")) raw\n  write :display([Option.Some(1)]) raw\n  write :display({value: Option.Some(1)}) raw\n  write :display((Option.Some(1),)) raw\n\n  ; =============================================================================\n  ; String.escape function\n  ; =============================================================================\n\n  ; Direct use of String.escape\n  write String.escape(\"foo\\tbar\")\n\n  ; Mixed: escaped via function + non-escaped in same interpolation\n  write \"{String.escape(\"foo\\tbar\")} {\"foo\\tbar\"}\"\n}\n"
---
line1
line2
line1\nline2
col1	col2
col1\tcol2
He said "Hello"
He said \"Hello\"
path\to\file
path\\to\\file
line1\nline2\nline3
a\tb\tc
\n
\t
\\
[ \"a\nb\", \"c\td\" ]
{ name: \"foo\nbar\", value: \"x\ty\" }
(\"a\nb\", \"c\td\")
Option.Some(\"foo\nbar\")
[ Option.Some(1) ]
{ value: Option.Some(1) }
(Option.Some(1),)
foo\tbar
foo\tbar foo	bar
