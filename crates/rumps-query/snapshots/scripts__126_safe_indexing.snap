---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: safe indexing with `?[]` syntax\n; Tests optional index access that returns `Option` instead of panicking\n\nfun main() {\n  ; Array safe indexing\n  let arr = [10, 20, 30]\n\n  ; Valid indices return Some\n  write :display(arr?[0])\n  ; Expected: Option.Some(10)\n\n  write :display(arr?[1])\n  ; Expected: Option.Some(20)\n\n  write :display(arr?[2])\n  ; Expected: Option.Some(30)\n\n  ; Negative indices\n  write :display(arr?[-1])\n  ; Expected: Option.Some(30)\n\n  write :display(arr?[-2])\n  ; Expected: Option.Some(20)\n\n  ; Out of bounds returns None\n  write :display(arr?[3])\n  ; Expected: Option.None\n\n  write :display(arr?[100])\n  ; Expected: Option.None\n\n  write :display(arr?[-4])\n  ; Expected: Option.None\n\n  write :display(arr?[-100])\n  ; Expected: Option.None\n\n  ; String safe indexing\n  let s = \"hello\"\n\n  write :display(s?[0])\n  ; Expected: Option.Some('h')\n\n  write :display(s?[4])\n  ; Expected: Option.Some('o')\n\n  write :display(s?[-1])\n  ; Expected: Option.Some('o')\n\n  write :display(s?[5])\n  ; Expected: Option.None\n\n  write :display(s?[-6])\n  ; Expected: Option.None\n\n  ; Empty collections\n  let empty: Array[Int] = []\n  write :display(empty?[0])\n  ; Expected: Option.None\n\n  let empty-str = \"\"\n  write :display(empty-str?[0])\n  ; Expected: Option.None\n\n  ; Map safe indexing (same as regular indexing since maps already return Option)\n  let m = { \"a\" => 1, \"b\" => 2 }\n  write :display(m?[\"a\"])\n  ; Expected: Option.Some(1)\n\n  write :display(m?[\"z\"])\n  ; Expected: Option.None\n\n  ; Chain with unwrap or coalesce\n  write arr?[0] ?? -1\n  ; Expected: 10\n\n  write arr?[100] ?? -1\n  ; Expected: -1\n\n  ; Use with pattern matching\n  match arr?[0] {\n    Option.Some(x) => write \"Got: {x}\"\n    Option.None => write \"Nothing\"\n  }\n  ; Expected: Got: 10\n\n  match arr?[999] {\n    Option.Some(x) => write \"Got: {x}\"\n    Option.None => write \"Nothing\"\n  }\n  ; Expected: Nothing\n\n  write \"Safe indexing test complete\"\n}\n"
---
Option.Some(10)
Option.Some(20)
Option.Some(30)
Option.Some(30)
Option.Some(20)
Option.None
Option.None
Option.None
Option.None
Option.Some('h')
Option.Some('o')
Option.Some('o')
Option.None
Option.None
Option.None
Option.None
Option.Some(1)
Option.None
10
-1
Got: 10
Nothing
Safe indexing test complete
