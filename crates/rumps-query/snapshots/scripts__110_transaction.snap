---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: transaction expression\n; Transactions wrap global writes and return Result[T, String]\n\nfun main() {\n  ; Basic transaction with global write\n  let write-result = transaction {\n    @set ^TEST{1, \"name\"} \"Alice\"\n    @set ^TEST{1, \"age\"} 30\n    @get ^TEST{1, \"name\"}\n  }\n  write write-result\n\n  ; Verify write persisted\n  write @get ^TEST{1, \"age\"}\n\n  ; Transaction returning unit (write-only)\n  let unit-result = transaction {\n    let _ = @set ^TEST{2, \"status\"} \"active\"\n  }\n  write unit-result\n  write @get ^TEST{2, \"status\"}\n\n  ; Transaction with multiple statements and computation\n  let multi = transaction {\n    let a = 10\n    let b = 20\n    @set ^TEST{4, \"sum\"} a + b\n    a + b\n  }\n  write multi\n  write @get ^TEST{4, \"sum\"}\n\n  ; Accessing outer scope from transaction\n  let x = 100\n  let access-outer = transaction {\n    @set ^TEST{5, \"val\"} x + 1\n    x + 1\n  }\n  write access-outer\n\n  ; Transaction result matching\n  let txn-result = transaction {\n    @set ^TEST{6, \"m\"} \"success\"\n    \"success\"\n  }\n  let matched = match txn-result {\n    Result.Ok(s) => { \"got: {s}\" }\n    Result.Err(e) => { \"error: {e}\" }\n  }\n  write matched\n\n  ; Rollback on error: write then fail, verify write is not persisted\n  let rollback-test = transaction {\n    @set ^ROLLBACK{\"key\"} \"should not persist\"\n    let x = Option.None!\n    \"unreachable\"\n  }\n  write rollback-test\n  write @get ^ROLLBACK{\"key\"}\n\n  ; Bulk write/read test using loop inside transaction\n  let bulk-result = transaction {\n    ; Write 100 values to ^BULK{0} through ^BULK{99}\n    loop 0 (n, cont) => {\n      if n >= 100 {\n        n\n      } else {\n        @set ^BULK{n} n * 2\n        cont(n + 1)\n      }\n    }\n\n    ; Read them back and count how many exist\n    let count = loop { i: 0, found: 0 } (state, cont) => {\n      if state.i >= 100 {\n        state.found\n      } else {\n        let val = @get ^BULK{state.i}\n        let inc = match val {\n          Option.Some(_) => { 1 }\n          Option.None => { 0 }\n        }\n        cont({ i: state.i + 1, found: state.found + inc })\n      }\n    }\n    count\n  }\n  write bulk-result\n\n  write \"transaction test complete\"\n}\n"
---
Result.Ok(Option.Some("Alice"))
Option.Some(30)
Result.Ok(Unit)
Option.Some("active")
Result.Ok(30)
Option.Some(30)
Result.Ok(101)
"got: success"
Result.Err("runtime error at 1307..1319: cannot unwrap Option.None")
Option.None
Result.Ok(100)
"transaction test complete"
