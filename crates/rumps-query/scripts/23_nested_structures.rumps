; Test: deeply nested structures
; Tests complex nesting of arrays, objects, and blocks

fun main() {
  ; === Deeply nested arrays ===

  let deep = [[[[1]]]]
  write deep[0][0][0][0]
  ; Expected: 1

  let matrix3d = [
    [[1, 2], [3, 4]],
    [[5, 6], [7, 8]]
  ]
  write matrix3d[0][0][0]
  ; Expected: 1

  write matrix3d[1][1][1]
  ; Expected: 8

  write matrix3d[-1][-1][-1]
  ; Expected: 8

  ; === Deeply nested objects ===

  let nested = {
    level1: {
      level2: {
        level3: {
          value: "deep"
        }
      }
    }
  }
  write nested.level1.level2.level3.value
  ; Expected: deep

  ; === Mixed nesting ===

  let complex = {
    users: [
      { name: "Alice", scores: [100, 95, 88] },
      { name: "Bob", scores: [90, 85, 92] }
    ],
    meta: {
      count: 2,
      tags: ["active", "verified"]
    }
  }

  write complex.users[0].name
  ; Expected: Alice

  write complex.users[0].scores[0]
  ; Expected: 100

  write complex.users[1].scores[-1]
  ; Expected: 92

  write complex.meta.tags[0]
  ; Expected: active

  write complex.users[1].name
  ; Expected: Bob

  ; === Nested blocks ===

  let result = {
    let a = {
      let b = {
        let c = 10
        c * 2
      }
      b + 5
    }
    a * 3
  }
  write result
  ; Expected: 75 ((10 * 2 + 5) * 3 = 25 * 3)

  ; === Nested conditionals ===

  let score = 85
  let grade = if score >= 90 {
    "A"
  } else {
    if score >= 80 {
      "B"
    } else {
      if score >= 70 {
        "C"
      } else {
        "F"
      }
    }
  }
  write grade
  ; Expected: B

  ; === Array of blocks ===

  let computed = [
    { let x = 1
      x + 1
    },
    { let x = 2
      x + 1
    },
    { let x = 3
      x + 1
    }
  ]
  write :display(computed)
  ; Expected: [ 2, 3, 4 ]

  ; === Object with computed values ===

  let base = 10
  let obj = {
    double: base * 2,
    triple: base * 3,
    square: base * base
  }
  write obj.double
  ; Expected: 20

  write obj.triple
  ; Expected: 30

  write obj.square
  ; Expected: 100

  write "Nested structures test complete"
}
