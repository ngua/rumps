; Error: duplicate class instance
;
; Only one instance of a class is allowed per type.

FUN main() { }

TYPE Point = Point(Int, Int)

CLASS Display FOR Point {
  FUN display(p: Point) -> String {
    MATCH p {
      Point.Point(x, y) => { "({x}, {y})" }
    }
  }
}

; Duplicate instance - should error
CLASS Display FOR Point {
  FUN display(p: Point) -> String {
    MATCH p {
      Point.Point(x, y) => { "Point[{x},{y}]" }
    }
  }
}
