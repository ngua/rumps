---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: Empty array with annotation + polymorphic function\n; Regression test for type variable collision bug where empty arrays\n; caused subsequent polymorphic function instantiation to fail\n\n; Empty array creates a fresh type var that could collide with scheme vars\nLET nums: Array[Int] = []\nLET left = { \"x\" => 10, \"y\" => 20 }\n@OUTPUT Map.lookup(left, \"x\")\n@OUTPUT Map.lookup(left, \"y\")\n\n; Non-empty array for comparison (always worked)\nLET nums2: Array[Int] = [1, 2, 3]\nLET right = { \"a\" => 100, \"b\" => 200 }\n@OUTPUT Map.lookup(right, \"a\")\n\n; Multiple empty collections in sequence\nLET empty1: Array[String] = []\nLET empty2: Array[Bool] = []\nLET empty3: Map[Int, String] = Map.empty()\nLET m = { \"key\" => 42 }\n@OUTPUT Map.lookup(m, \"key\")\n\n; Polymorphic functions after empty arrays\nLET arr: Array[Float] = []\n@OUTPUT Array.length(arr)\n@OUTPUT Mappable:map(x => x * 2, [1, 2, 3])\n\n@OUTPUT \"empty array + polymorphic OK\"\n"
---
Option.Some(10)
Option.Some(20)
Option.Some(100)
Option.Some(42)
0
[ 2, 4, 6 ]
"empty array + polymorphic OK"
