; Test: @KILL statement
; Tests deletion of variables and subtrees

; Set up test data
@SET items(1) = "one"
@SET items(2) = "two"
@SET items(3) = "three"
@SET items(1, "a") = "nested a"
@SET items(1, "b") = "nested b"

; Verify items exists
LET v1 = @GET items(1)
WRITE v1
; Expected: one

; @KILL single node
@KILL items(2)

; Verify deleted
LET v2 = @GET items(2)
WRITE v2
; Expected: Option.None

; @KILL subtree
@KILL items(1)

; Verify subtree deleted
LET v3 = @GET items(1)
WRITE v3
; Expected: Option.None

LET v4 = @GET items(1, "a")
WRITE v4
; Expected: Option.None

; items(3) should still exist
LET v5 = @GET items(3)
WRITE v5
; Expected: three

; @KILL entire variable
@SET temp = 999
LET before = @GET temp
WRITE before
; Expected: 999

@KILL temp
LET after = @GET temp
WRITE after
; Expected: Option.None

WRITE "@KILL test complete"
