source: crates/rumps-query/tests/scripts.rs
description: "; User-defined Indexable class with associated type Index\n;\n; Tests implementing Indexable for user types with newtype Index = ...\n; to define the associated index type.\n\nfun main() {\n  ; === Usage (hoisted) ===\n\n  ; StringMap uses String as index type (via newtype Index = String)\n  let sm = StringMap.StringMap({ \"a\" => 1, \"b\" => 2, \"c\" => 3 })\n\n  ; Direct class method calls\n  write Indexable:index(sm, \"a\")\n  write Indexable:get(sm, \"b\")\n\n  ; Subscript syntax dispatches to user Indexable instance\n  write sm[\"a\"]\n  write sm[\"c\"]\n\n  ; Safe subscript (uses `get` method)\n  write sm?[\"b\"]\n  write sm?[\"missing\"]\n\n  let im = ({ 1 => \"one\", 2 => \"two\" } : IntMap)\n  write im[1]\n  write im[2]\n  write im?[3]\n\n  ; Builtin `Map` uses `Indexable:Index = K` and `Indexable[V]`.\n  let m: Map[String, Int] = { \"a\" => 1 }\n  let map-index: Int = Indexable:index(m, \"a\")\n  write map-index\n\n  let map-get: Option[Int] = Indexable:get(m, \"a\")\n  write map-get\n\n  let map-missing: Option[Int] = m?[\"missing\"]\n  write map-missing\n\n  let arr = [10]\n  let arr-index: Int = Indexable:index(arr, 0)\n  write arr-index\n\n  let arr-get: Option[Int] = Indexable:get(arr, 0)\n  write arr-get\n}\n\n; === Type and Class Definitions ===\n\nvariant StringMap = StringMap(Map[String, Int])\n\nclass Indexable[Int] for StringMap {\n  newtype Index = String\n\n  fun index(sm: StringMap, i: :Index) -> Int {\n    match sm {\n      StringMap.StringMap(m) => m[i]\n    }\n  }\n\n  fun get(sm: StringMap, i: :Index) -> Option[Int] {\n    match sm {\n      StringMap.StringMap(m) => m?[i]\n    }\n  }\n}\n\n; === Qualified Associated Type Syntax ===\n;\n; Associated types can also be referenced with the qualified form\n; `ClassName:AssocType` instead of the shorthand `:AssocType`.\n\nnewtype IntMap = Map[Int, String]\n\nclass Indexable[String] for IntMap {\n  newtype Index = Int\n\n  ; Uses qualified `Indexable:Index` instead of shorthand `:Index`\n  fun index(im: IntMap, i: Indexable:Index) -> String {\n    im[i]\n  }\n\n  fun get(im: IntMap, i: Indexable:Index) -> Option[String] {\n    im?[i]\n  }\n}\n"
