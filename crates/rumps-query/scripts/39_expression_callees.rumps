; Test: Expression-Based Callees and Type Checking
; Tests function calls where the callee is an expression (not just an identifier)

; === Chained calls (currying pattern) ===

FUN make-adder (n) {
  x => x + n
}

FUN make-multiplier (n) {
  x => x * n
}

; === Higher-order functions ===

FUN apply (f, x) {
  f(x)
}

FUN square (x) {
  x * x
}

; === Function composition ===

FUN compose (f, g) {
  x => f(g(x))
}

FUN double (x) { x * 2 }
FUN inc (x) { x + 1 }

; === Typed functions with valid calls ===

FUN add-typed (a: Int, b: Int) -> Int {
  a + b
}

FUN greet (name: String) -> String {
  "Hello, {name}!"
}

; === Higher-order with typed parameters ===

FUN apply-twice (f: (Int) -> Int, x: Int) -> Int {
  f(f(x))
}

; === Functions returning functions with types ===

FUN make-scaler (n: Int) -> (Int) -> Int {
  x => x * n
}

FUN chain-a (x) { x + 1 }
FUN chain-b (x) { x * 2 }
FUN chain-c (x) { x - 3 }

; === Factorial via currying ===

FUN make-factorial () {
  FUN fact (n) {
    IF n <= 1 { 1 } ELSE { n * fact(n - 1) }
  }
  fact
}

FUN main() {
  LET add5 = make-adder(5)
  WRITE add5(10)
  ; Expected: 15

  WRITE make-adder(100)(42)
  ; Expected: 142

  WRITE make-multiplier(2)(7)
  ; Expected: 14

  ; === IIFE (Immediately Invoked Function Expression) ===

  WRITE (x => x * 2)(21)
  ; Expected: 42

  WRITE ((a, b) => a + b)(10, 32)
  ; Expected: 42

  ; IIFE with captured variable
  LET factor = 10
  WRITE (x => x * factor)(5)
  ; Expected: 50

  WRITE apply(x => x + 1, 41)
  ; Expected: 42

  WRITE apply(square, 6)
  ; Expected: 36

  LET double-then-inc = compose(inc, double)
  WRITE double-then-inc(20)
  ; Expected: 41 (double(20)=40, inc(40)=41)

  LET inc-then-double = compose(double, inc)
  WRITE inc-then-double(20)
  ; Expected: 42 (inc(20)=21, double(21)=42)

  WRITE add-typed(10, 32)
  ; Expected: 42

  WRITE greet("World")
  ; Expected: Hello, World!

  WRITE apply-twice(x => x + 1, 40)
  ; Expected: 42

  WRITE apply-twice(x => x * 2, 5)
  ; Expected: 20

  LET triple = make-scaler(3)
  WRITE triple(14)
  ; Expected: 42

  WRITE make-scaler(7)(6)
  ; Expected: 42

  ; === Complex nested calls ===

  WRITE make-multiplier(2)(make-adder(3)(4))
  ; Expected: 14 (add3(4)=7, mult2(7)=14)

  WRITE chain-c(chain-b(chain-a(10)))
  ; Expected: 19 ((10+1)*2-3 = 22-3 = 19)

  ; === Passing named functions to higher-order functions ===

  WRITE apply(double, 21)
  ; Expected: 42

  WRITE apply(inc, 41)
  ; Expected: 42

  WRITE apply-twice(double, 3)
  ; Expected: 12 (double(3)=6, double(6)=12)

  WRITE apply-twice(inc, 40)
  ; Expected: 42

  ; === Closure capturing multiple variables ===

  LET a = 10
  LET b = 20
  LET sum-with-ab = x => x + a + b
  WRITE sum-with-ab(12)
  ; Expected: 42

  LET factorial = make-factorial()
  WRITE factorial(5)
  ; Expected: 120

  ; === Object field closures ===

  LET ops = { inc: x => x + 1, mul: x => x * 2 }
  WRITE ops.inc(5)
  ; Expected: 6

  WRITE ops.mul(21)
  ; Expected: 42

  ; Nullary closure in object
  LET counter = { value: () => 42 }
  WRITE counter.value()
  ; Expected: 42

  ; Chained object field calls
  LET math = {
    add: (a, b) => a + b,
    sq: x => x * x
  }
  WRITE math.sq(math.add(3, 4))
  ; Expected: 49 (3+4=7, 7*7=49)

  WRITE "Expression callees test complete"
}
