---
source: crates/rumps-query/tests/scripts.rs
description: "; Option and Result module primitives\n; Tests Option.unwrap-or, Option.map, Result.unwrap-or, Result.map, Result.map-err\n\n; ============ Option.unwrap-or ============\n\nLET some-val = Option.Some(42)\nLET none-val = Option.None\n\n@OUTPUT Option.unwrap-or(some-val, 0)  ; 42\n@OUTPUT Option.unwrap-or(none-val, 0)  ; 0\n@OUTPUT Option.unwrap-or(Option.Some(\"hello\"), \"default\")  ; \"hello\"\n@OUTPUT Option.unwrap-or(Option.None, \"default\")  ; \"default\"\n\n; ============ Option.map ============\n\nLET double = x => x * 2\nLET to-upper = s => String.upper(s)\n\n@OUTPUT Option.map(Option.Some(21), double)  ; Some(42)\n@OUTPUT Option.map(Option.None, double)  ; None\n@OUTPUT Option.map(Option.Some(\"hello\"), to-upper)  ; Some(\"HELLO\")\n@OUTPUT Option.map(Option.None, to-upper)  ; None\n\n; Inline closure\n@OUTPUT Option.map(Option.Some(5), x => x + 1)  ; Some(6)\n\n; Chaining map\nLET opt = Option.Some(10)\nLET mapped = Option.map(opt, x => x * 2)\n@OUTPUT mapped  ; Some(20)\n@OUTPUT Option.map(mapped, x => x + 5)  ; Some(25)\n\n; ============ Result.unwrap-or ============\n\nLET ok-val = Result.Ok(100)\nLET err-val = Result.Err(\"something went wrong\")\n\n@OUTPUT Result.unwrap-or(ok-val, 0)  ; 100\n@OUTPUT Result.unwrap-or(err-val, 0)  ; 0\n@OUTPUT Result.unwrap-or(Result.Ok(\"success\"), \"fallback\")  ; \"success\"\n@OUTPUT Result.unwrap-or(Result.Err(\"fail\"), \"fallback\")  ; \"fallback\"\n\n; ============ Result.map ============\n\n@OUTPUT Result.map(Result.Ok(21), double)  ; Ok(42)\n@OUTPUT Result.map(Result.Err(\"err\"), double)  ; Err(\"err\")\n@OUTPUT Result.map(Result.Ok(\"hello\"), to-upper)  ; Ok(\"HELLO\")\n@OUTPUT Result.map(Result.Err(\"err\"), to-upper)  ; Err(\"err\")\n\n; Inline closure\n@OUTPUT Result.map(Result.Ok(5), x => x + 1)  ; Ok(6)\n\n; ============ Result.map-err ============\n\nLET add-prefix = e => \"Error: \" ++ e\n\n@OUTPUT Result.map-err(Result.Err(\"failed\"), add-prefix)  ; Err(\"Error: failed\")\n@OUTPUT Result.map-err(Result.Ok(42), add-prefix)  ; Ok(42)\n@OUTPUT Result.map-err(Result.Err(\"oops\"), e => String.upper(e))  ; Err(\"OOPS\")\n@OUTPUT Result.map-err(Result.Ok(\"ok\"), e => String.upper(e))  ; Ok(\"ok\")\n\n; ============ Combining operations ============\n\n; Option.map then unwrap-or\nLET maybe-num = Option.Some(10)\nLET doubled-or-zero = Option.unwrap-or(Option.map(maybe-num, x => x * 2), 0)\n@OUTPUT doubled-or-zero  ; 20\n\nLET no-num = Option.None\nLET doubled-or-zero-none = Option.unwrap-or(Option.map(no-num, x => x * 2), 0)\n@OUTPUT doubled-or-zero-none  ; 0\n\n; Result.map then unwrap-or\nLET res-ok = Result.Ok(5)\nLET res-mapped = Result.unwrap-or(Result.map(res-ok, x => x * 3), 0)\n@OUTPUT res-mapped  ; 15\n\nLET res-err = Result.Err(\"bad\")\nLET res-err-mapped = Result.unwrap-or(Result.map(res-err, x => x * 3), 0)\n@OUTPUT res-err-mapped  ; 0\n\n; ============ Type variants still work ============\n\n; Ensure Option.None and Result.Ok etc. still work as type constructors\nLET opt-none = Option.None\nLET opt-some = Option.Some(1)\n@OUTPUT opt-none IS Option.None  ; true\n@OUTPUT opt-some IS Option.Some(_)  ; true\n\nLET res-ok-check = Result.Ok(1)\nLET res-err-check = Result.Err(\"x\")\n@OUTPUT res-ok-check IS Result.Ok(_)  ; true\n@OUTPUT res-err-check IS Result.Err(_)  ; true\n\n; ============ Option.flat-map ============\n\n; Returns the inner Option when Some\nFUN safe-div(n, d) {\n  IF d == 0 { Option.None } ELSE { Option.Some(n // d) }\n}\n\n@OUTPUT Option.flat-map(Option.Some(10), x => safe-div(x, 2))  ; Some(5)\n@OUTPUT Option.flat-map(Option.Some(10), x => safe-div(x, 0))  ; None\n@OUTPUT Option.flat-map(Option.None, x => safe-div(x, 2))  ; None\n\n; Chaining flat-map\nFUN parse-positive(x) {\n  IF x > 0 { Option.Some(x) } ELSE { Option.None }\n}\nFUN halve(x) {\n  IF x % 2 == 0 { Option.Some(x // 2) } ELSE { Option.None }\n}\n\n@OUTPUT Option.flat-map(Option.flat-map(Option.Some(8), parse-positive), halve)  ; Some(4)\n@OUTPUT Option.flat-map(Option.flat-map(Option.Some(-1), parse-positive), halve)  ; None\n@OUTPUT Option.flat-map(Option.flat-map(Option.Some(7), parse-positive), halve)  ; None (7 is odd)\n\n; ============ Result.flat-map ============\n\n; Returns the inner Result when Ok\nFUN safe-div-res(n, d) {\n  IF d == 0 { Result.Err(\"div by zero\") } ELSE { Result.Ok(n // d) }\n}\n\n@OUTPUT Result.flat-map(Result.Ok(10), x => safe-div-res(x, 2))  ; Ok(5)\n@OUTPUT Result.flat-map(Result.Ok(10), x => safe-div-res(x, 0))  ; Err(\"div by zero\")\n@OUTPUT Result.flat-map(Result.Err(\"bad input\"), x => safe-div-res(x, 2))  ; Err(\"bad input\")\n\n; Chaining flat-map\nFUN validate(x) {\n  IF x >= 0 { Result.Ok(x) } ELSE { Result.Err(\"negative\") }\n}\nFUN halve-res(x) {\n  IF x % 2 == 0 { Result.Ok(x // 2) } ELSE { Result.Err(\"odd\") }\n}\n\n@OUTPUT Result.flat-map(Result.flat-map(Result.Ok(8), validate), halve-res)  ; Ok(4)\n@OUTPUT Result.flat-map(Result.flat-map(Result.Ok(-1), validate), halve-res)  ; Err(\"negative\")\n@OUTPUT Result.flat-map(Result.flat-map(Result.Ok(7), validate), halve-res)  ; Err(\"odd\")\n\n; ============ Option.flatten ============\n\n; Some(Some(v)) -> Some(v)\n@OUTPUT Option.flatten(Option.Some(Option.Some(42)))  ; Some(42)\n@OUTPUT Option.flatten(Option.Some(Option.Some(\"hello\")))  ; Some(\"hello\")\n\n; Some(None) -> None\n@OUTPUT Option.flatten(Option.Some(Option.None))  ; None\n\n; None -> None\n@OUTPUT Option.flatten(Option.None)  ; None\n\n; Practical: flatten after map that returns Option\nLET maybe-find = arr => Array.head(arr)\nLET nested = Option.map(Option.Some([1, 2, 3]), maybe-find)\n@OUTPUT nested  ; Some(Some(1))\n@OUTPUT Option.flatten(nested)  ; Some(1)\n\nLET empty-nested = Option.map(Option.Some([]), maybe-find)\n@OUTPUT empty-nested  ; Some(None)\n@OUTPUT Option.flatten(empty-nested)  ; None\n\n; ============ Result.flatten ============\n\n; Ok(Ok(v)) -> Ok(v)\n@OUTPUT Result.flatten(Result.Ok(Result.Ok(42)))  ; Ok(42)\n@OUTPUT Result.flatten(Result.Ok(Result.Ok(\"success\")))  ; Ok(\"success\")\n\n; Ok(Err(e)) -> Err(e)\n@OUTPUT Result.flatten(Result.Ok(Result.Err(\"inner error\")))  ; Err(\"inner error\")\n\n; Err(e) -> Err(e)\n@OUTPUT Result.flatten(Result.Err(\"outer error\"))  ; Err(\"outer error\")\n\n; Practical: flatten after map that returns Result\nFUN try-parse(s) {\n  IF s == \"42\" { Result.Ok(42) } ELSE { Result.Err(\"parse failed\") }\n}\nLET nested-res = Result.map(Result.Ok(\"42\"), try-parse)\n@OUTPUT nested-res  ; Ok(Ok(42))\n@OUTPUT Result.flatten(nested-res)  ; Ok(42)\n\nLET nested-err = Result.map(Result.Ok(\"bad\"), try-parse)\n@OUTPUT nested-err  ; Ok(Err(\"parse failed\"))\n@OUTPUT Result.flatten(nested-err)  ; Err(\"parse failed\")\n"
