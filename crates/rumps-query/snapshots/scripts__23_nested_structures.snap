source: crates/rumps-query/tests/scripts.rs
description: "; Test: deeply nested structures\n; Tests complex nesting of arrays, objects, and blocks\n\nfun main() {\n  ; === Deeply nested arrays ===\n\n  let deep = [[[[1]]]]\n  write deep[0][0][0][0]\n  ; Expected: 1\n\n  let matrix3d = [\n    [[1, 2], [3, 4]],\n    [[5, 6], [7, 8]]\n  ]\n  write matrix3d[0][0][0]\n  ; Expected: 1\n\n  write matrix3d[1][1][1]\n  ; Expected: 8\n\n  write matrix3d[-1][-1][-1]\n  ; Expected: 8\n\n  ; === Deeply nested objects ===\n\n  let nested = {\n    level1: {\n      level2: {\n        level3: {\n          value: \"deep\"\n        }\n      }\n    }\n  }\n  write nested.level1.level2.level3.value\n  ; Expected: deep\n\n  ; === Mixed nesting ===\n\n  let complex = {\n    users: [\n      { name: \"Alice\", scores: [100, 95, 88] },\n      { name: \"Bob\", scores: [90, 85, 92] }\n    ],\n    meta: {\n      count: 2,\n      tags: [\"active\", \"verified\"]\n    }\n  }\n\n  write complex.users[0].name\n  ; Expected: Alice\n\n  write complex.users[0].scores[0]\n  ; Expected: 100\n\n  write complex.users[1].scores[-1]\n  ; Expected: 92\n\n  write complex.meta.tags[0]\n  ; Expected: active\n\n  write complex.users[1].name\n  ; Expected: Bob\n\n  ; === Nested blocks ===\n\n  let result = {\n    let a = {\n      let b = {\n        let c = 10\n        c * 2\n      }\n      b + 5\n    }\n    a * 3\n  }\n  write result\n  ; Expected: 75 ((10 * 2 + 5) * 3 = 25 * 3)\n\n  ; === Nested conditionals ===\n\n  let score = 85\n  let grade = if score >= 90 {\n    \"A\"\n  } else {\n    if score >= 80 {\n      \"B\"\n    } else {\n      if score >= 70 {\n        \"C\"\n      } else {\n        \"F\"\n      }\n    }\n  }\n  write grade\n  ; Expected: B\n\n  ; === Array of blocks ===\n\n  let computed = [\n    { let x = 1\n      x + 1\n    },\n    { let x = 2\n      x + 1\n    },\n    { let x = 3\n      x + 1\n    }\n  ]\n  write :display(computed)\n  ; Expected: [ 2, 3, 4 ]\n\n  ; === Object with computed values ===\n\n  let base = 10\n  let obj = {\n    double: base * 2,\n    triple: base * 3,\n    square: base * base\n  }\n  write obj.double\n  ; Expected: 20\n\n  write obj.triple\n  ; Expected: 30\n\n  write obj.square\n  ; Expected: 100\n\n  write \"Nested structures test complete\"\n}\n"
