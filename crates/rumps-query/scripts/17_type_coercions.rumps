; Test: type coercions
; Tests implicit numeric coercion and string coercion for concat

; === Numeric Coercion (Int + Float -> Float) ===

; Addition with mixed types
LET a = 10 + 3.5
WRITE a
; Expected: 13.5 (Float)

LET b = 3.5 + 10
WRITE b
; Expected: 13.5 (Float)

; Subtraction with mixed types
LET c = 10 - 2.5
WRITE c
; Expected: 7.5 (Float)

LET d = 10.5 - 3
WRITE d
; Expected: 7.5 (Float)

; Multiplication with mixed types
LET e = 5 * 2.5
WRITE e
; Expected: 12.5 (Float)

LET f = 2.5 * 4
WRITE f
; Expected: 10.0 (Float)

; Division with mixed types
LET g = 10 / 4.0
WRITE g
; Expected: 2.5 (Float)

LET h = 10.0 / 4
WRITE h
; Expected: 2.5 (Float)

; Int division always yields float
LET i = 10 / 5
WRITE i
; Expected: 2.0 (Float)

; Floor division with mixed types
LET j = 10 // 3.0
WRITE j
; Expected: 3 (Int)

LET k = 10.0 // 3
WRITE k
; Expected: 3 (Int)

; Modulo with mixed types
LET l = 10 % 3.5
WRITE l
; Expected: 3.0 (Float; 10 % 3.5 = 3.0)

LET m = 10.5 % 3
WRITE m
; Expected: 1.5 (Float; 10.5 % 3 = 1.5)

; === String Conversion (via interpolation) ===

; Int to string
WRITE "Number: {42}"
; Expected: Number: 42

; Float to string
WRITE "Pi: {3.14159}"
; Expected: Pi: 3.14159

; Bool to string
WRITE "Flag: {TRUE}"
; Expected: Flag: true

WRITE "Flag: {FALSE}"
; Expected: Flag: false

; === Cross-type Numeric Comparison ===

WRITE 5 == 5.0
; Expected: true (int and float compare equal)

WRITE 5.0 == 5
; Expected: true

WRITE 10 < 10.5
; Expected: true

WRITE 10.5 > 10
; Expected: true

WRITE 3 >= 3.0
; Expected: true

WRITE 3.0 <= 3
; Expected: true

WRITE "Type coercion test complete"
