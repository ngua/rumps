---
source: crates/rumps-query/tests/scripts.rs
description: "; Iter module: works on any Iterable (Array[T] or Range)\n\nFUN main() {\n  ; Iterable:length on Array\n  LET arr = [1, 2, 3, 4, 5]\n  WRITE \"Array length: {Iterable:length(arr)}\"\n\n  ; Iterable:length on Range\n  WRITE \"Range (1..=10) length: {Iterable:length(1 ..= 10)}\"\n  WRITE \"Range (1..10) length: {Iterable:length(1 .. 10)}\"\n\n  ; Iterable:contains on Array\n  WRITE \"Array contains 3: {Iterable:contains(arr, 3)}\"\n  WRITE \"Array contains 99: {Iterable:contains(arr, 99)}\"\n\n  ; Iterable:contains on Range\n  WRITE \"Range contains 5: {Iterable:contains(1 ..= 10, 5)}\"\n  WRITE \"Range contains 11: {Iterable:contains(1 ..= 10, 11)}\"\n\n  ; Mappable:map on Array (Range is not Mappable; collect first)\n  WRITE \"Doubled array: {Mappable:map(x => x * 2, arr)}\"\n  WRITE \"Doubled range: {Mappable:map(x => x * 2, Iterable:collect(1 ..= 5))}\"\n\n  ; Filterable:filter on Array and Range\n  WRITE \"Evens from array: {Filterable:filter(x => x % 2 == 0, arr)}\"\n  WRITE \"Evens from range: {Filterable:filter(x => x % 2 == 0, 1 ..= 10)}\"\n\n  ; Foldable:reduce on Array and Range\n  WRITE \"Sum of array: {Foldable:reduce((a, x) => a + x, 0, arr)}\"\n  WRITE \"Sum of range: {Foldable:reduce((a, x) => a + x, 0, 1 ..= 10)}\"\n\n  WRITE \"Generic sum (array): {sum-iter(arr)}\"\n  WRITE \"Generic sum (range): {sum-iter(1 ..= 10)}\"\n\n  WRITE \"Generic count (array): {count-iter(arr)}\"\n  WRITE \"Generic count (range): {count-iter(1 ..= 10)}\"\n\n  ; Iterable:reverse on Array and Range\n  WRITE \"Reversed array: {Iterable:reverse(arr)}\"\n  WRITE \"Reversed range: {Iterable:reverse(1 ..= 5)}\"\n\n  ; Iterable:foreach on Array and Range\n  Iterable:foreach(x => WRITE \"foreach array: {x}\", [10, 20])\n  Iterable:foreach(x => WRITE \"foreach range: {x}\", 1 ..= 3)\n}\n\n; Generic functions with Iterable constraint\nFUN sum-iter[I: Iterable](i: I[Int]) -> Int {\n  Foldable:reduce((a, x) => a + x, 0, i)\n}\n\nFUN count-iter[I: Iterable](i: I[Int]) -> Int {\n  Iterable:length(i)\n}\n"
---
