---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: Monoid concatenation (`++` operator)\n; Tests polymorphic `++` on String, Array, and Map\n\n; === String concatenation ===\nLET s1 = \"Hello\"\nLET s2 = \"World\"\n@OUTPUT s1 ++ \", \" ++ s2\n\n; === Array concatenation ===\nLET a1 = [1, 2, 3]\nLET a2 = [4, 5, 6]\n@OUTPUT a1 ++ a2\n\n; Nested arrays\nLET nested1 = [[1, 2], [3, 4]]\nLET nested2 = [[5, 6]]\n@OUTPUT nested1 ++ nested2\n\n; === Map concatenation (RHS bias) ===\nLET m1 = { \"a\" => 1, \"b\" => 2 }\nLET m2 = { \"c\" => 3, \"d\" => 4 }\n@OUTPUT m1 ++ m2\n\n; RHS bias: right value wins for duplicate keys\nLET left = { \"x\" => 10, \"y\" => 20 }\nLET right = { \"y\" => 999, \"z\" => 30 }\nLET merged = left ++ right\n@OUTPUT Map.lookup(merged, \"x\")  ; Some(10)\n@OUTPUT Map.lookup(merged, \"y\")  ; Some(999) - right wins\n@OUTPUT Map.lookup(merged, \"z\")  ; Some(30)\n\n; === Type constraint: Monoid ===\n; This function works on any Monoid type\nFUN concat3[T: Monoid](a: T, b: T, c: T) -> T { a ++ b ++ c }\n\n@OUTPUT concat3(\"a\", \"b\", \"c\")\n@OUTPUT concat3([1], [2], [3])\n@OUTPUT concat3({ 1 => \"x\" }, { 2 => \"y\" }, { 3 => \"z\" })\n\n; === Option alternative (`<|>` semantics) ===\n; First `Some` wins; `None` acts as identity\n\nLET some10 = Option.Some(10)\nLET some9 = Option.Some(9)\nLET none: Option[Int] = Option.None\n\n; Some ++ None = Some (left wins)\n@OUTPUT some10 ++ none\n\n; None ++ Some = Some (right wins)\n@OUTPUT none ++ some9\n\n; None ++ None = None\n@OUTPUT none ++ none\n\n; Some ++ Some = first Some (left-biased, like Haskell `<|>`)\n@OUTPUT some10 ++ some9\n\n; Chaining: first Some in chain wins\n@OUTPUT none ++ none ++ some10 ++ some9\n\n; With generic Monoid function\n@OUTPUT concat3(none, some10, some9)  ; first non-None wins\n@OUTPUT concat3(none, none, some9)    ; last Some wins\n@OUTPUT concat3(none, none, none)     ; all None\n\n; === Mempty: `_` (monoid identity) ===\n; `_` produces the empty value for any Monoid type, inferred from context\n\n; String mempty\n@OUTPUT _ ++ \"hello\"      ; \"\" ++ \"hello\" = \"hello\"\n@OUTPUT \"world\" ++ _      ; \"world\" ++ \"\" = \"world\"\n\n; Array mempty\n@OUTPUT _ ++ [1, 2, 3]    ; [] ++ [1, 2, 3] = [1, 2, 3]\n@OUTPUT [4, 5] ++ _       ; [4, 5] ++ [] = [4, 5]\n\n; Map mempty\nLET m = { \"x\" => 10 }\n@OUTPUT _ ++ m            ; {} ++ m = m\n@OUTPUT m ++ _            ; m ++ {} = m\n\n; Option mempty (None)\n@OUTPUT _ ++ Option.Some(99)   ; None ++ Some(99) = Some(99)\n@OUTPUT Option.Some(77) ++ _   ; Some(77) ++ None = Some(77)\n@OUTPUT Option.None ++ _       ; None ++ None = None\n@OUTPUT _ ++ Option.None       ; None ++ None = None\n\n; Mempty with generic Monoid function\n@OUTPUT concat3(_, \"a\", \"b\")   ; \"\" ++ \"a\" ++ \"b\" = \"ab\"\n@OUTPUT concat3([0], _, [2])   ; [0] ++ [] ++ [2] = [0, 2]\n\n; Mempty as FOREVER seed (common pattern for accumulating)\n; Collect squares of 1..5 into an array starting from `_` (empty array)\nLET squares = FOREVER { i: 1, acc: _ } (state, cont) => {\n  IF state.i > 5 {\n    state.acc\n  } ELSE {\n    cont({ i: state.i + 1, acc: state.acc ++ [state.i * state.i] })\n  }\n}\n@OUTPUT squares\n\n; Build a string using `_` as initial accumulator\nLET words = FOREVER { i: 0, s: _ } (state, cont) => {\n  LET items = [\"hello\", \"world\", \"!\"]\n  IF state.i >= 3 {\n    state.s\n  } ELSE {\n    LET word = items?[state.i] ?? \"\"\n    LET sep = IF state.i == 0 { _ } ELSE { \" \" }\n    cont({ i: state.i + 1, s: state.s ++ sep ++ word })\n  }\n}\n@OUTPUT words\n\n@OUTPUT \"Monoid concatenation complete\"\n"
---
"Hello, World"
[ 1, 2, 3, 4, 5, 6 ]
[ [ 1, 2 ], [ 3, 4 ], [ 5, 6 ] ]
{ "a" => 1, "b" => 2, "c" => 3, "d" => 4 }
Option.Some(10)
Option.Some(999)
Option.Some(30)
"abc"
[ 1, 2, 3 ]
{ 1 => "x", 2 => "y", 3 => "z" }
Option.Some(10)
Option.Some(9)
Option.None
Option.Some(10)
Option.Some(10)
Option.Some(10)
Option.Some(9)
Option.None
"hello"
"world"
[ 1, 2, 3 ]
[ 4, 5 ]
{ "x" => 10 }
{ "x" => 10 }
Option.Some(99)
Option.Some(77)
Option.None
Option.None
"ab"
[ 0, 2 ]
[ 1, 4, 9, 16, 25 ]
"hello world !"
"Monoid concatenation complete"
