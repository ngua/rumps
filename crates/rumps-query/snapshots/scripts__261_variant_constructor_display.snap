---
source: crates/rumps-query/tests/scripts.rs
description: "; Variants keep explicit display constructor behavior.\n\nfun main() {\n  let some = Option.Some(1)\n  let none: Option[Int] = Option.None\n\n  ; Explicit display for variants must render constructor syntax.\n  write :display(some)\n  write :display(none)\n\n  let union-err: Result[Int, String] | Option[Int] = Result.Err(\"wide\")\n\n  let ok: Result[Int, String] = Result.Ok(7)\n  let mapped-ok = Result.map-err(ok, e => String.length(e))\n  write :display(mapped-ok)\n  write :display(mapped-ok)\n\n  let union-ok: Result[Int, String] | Option[Int] = Result.Ok(8)\n  let mapped-union-ok = Result.map-err(union-ok, e => String.length(e))\n  write :display(mapped-union-ok)\n  write :display(mapped-union-ok)\n\n  let union-some: Option[Int] | Array[Int] = Option.Some(5)\n  let union-none: Option[Int] | Array[Int] = Option.None: Option[Int]\n  write Option.unwrap-or(union-some, 0)\n  write Option.unwrap-or(union-none, 0)\n  write :display(Option.flatten(Option.Some(union-some)))\n  write :display(Option.note(\"missing\", union-none))\n  write Result.unwrap-or(union-ok, 0)\n  write :display(Result.flatten(Result.Ok(union-ok)))\n  write :display(Result.hush(union-err))\n  write :display(Array.sort([union-ok, union-err]))\n\n  ; JSON serialization should keep nested Option semantics before storage.\n  @set meta{1} ({ present: some, missing: none } as Json)\n  write @get meta{1}\n}\n"
---
