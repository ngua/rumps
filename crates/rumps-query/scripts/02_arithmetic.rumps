; Test: parse and evaluate arithmetic
; Tests arithmetic operators with correct precedence

; Basic operations
LET add = 10 + 5
WRITE add
; Expected: 15

LET sub = 10 - 5
WRITE sub
; Expected: 5

LET mul = 10 * 5
WRITE mul
; Expected: 50

LET div = 10 / 4
WRITE div
; Expected: 2.5 (or 2 if integer division)

LET intdiv = 10 // 4
WRITE intdiv
; Expected: 2

LET modulo = 10 % 3
WRITE modulo
; Expected: 1

; Precedence: mul/div before add/sub
LET prec1 = 2 + 3 * 4
WRITE prec1
; Expected: 14 (not 20)

LET prec2 = 10 - 6 / 2
WRITE prec2
; Expected: 7 (not 2)

; Parentheses override precedence
LET paren1 = (2 + 3) * 4
WRITE paren1
; Expected: 20

LET paren2 = (10 - 6) / 2
WRITE paren2
; Expected: 2

; Unary minus
LET neg = -5
WRITE neg
; Expected: -5

LET neg2 = 10 + -3
WRITE neg2
; Expected: 7

; Nested operations
LET complex = ((1 + 2) * (3 + 4)) / 7
WRITE complex
; Expected: 3

; Float arithmetic
LET f1 = 3.14 * 2.0
WRITE f1
; Expected: 6.28

LET f2 = 10.0 / 4.0
WRITE f2
; Expected: 2.5

; Mixed int/float
LET mixed = 10 + 0.5
WRITE mixed
; Expected: 10.5

WRITE "Arithmetic test complete"
