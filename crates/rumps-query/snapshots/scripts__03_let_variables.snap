---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: let and variable lookup\n; Tests lexical scoping with let bindings\n\nfun main() {\n  ; Simple binding\n  let x = 42\n  write x\n  ; Expected: 42\n\n  ; Binding using another variable\n  let y = x + 8\n  write y\n  ; Expected: 50\n\n  ; Multiple bindings\n  let a = 1\n  let b = 2\n  let c = 3\n  let sum = a + b + c\n  write sum\n  ; Expected: 6\n\n  ; Shadowing in same scope\n  let val = 10\n  let val = 20\n  write val\n  ; Expected: 20\n\n  ; String variables\n  let name = \"Alice\"\n  write name\n  ; Expected: Alice\n\n  ; Boolean variables\n  let flag = true\n  write flag\n  ; Expected: true (or true)\n\n  ; Using variables in expressions\n  let base = 100\n  let offset = 25\n  let result = base - offset * 2\n  write result\n  ; Expected: 50\n\n  ; Chained variable references\n  let v1 = 5\n  let v2 = v1 * 2\n  let v3 = v2 + v1\n  write v3\n  ; Expected: 15\n\n  write \"let variable test complete\"\n}\n"
---
