source: crates/rumps-query/tests/scripts.rs
description: "; Coalesce operator (??) tests\n; `??` unwraps Option.Some/Result.Ok or falls back to right operand\n\n; === Option.None coalesces to fallback ===\n\n; IF without ELSE and false condition returns Option.None\nLET none1 = IF FALSE { \"unreachable\" }\nOUTPUT none1 ?? \"fallback1\"\n; Expected: fallback1\n\n; Block without trailing expression returns Option.None\n; (using OUTPUT statement which has no return value)\nLET none2 = {\n  OUTPUT \"side effect only\"\n}\nOUTPUT none2 ?? \"fallback2\"\n; Expected: fallback2\n\n; Another block without tail\nLET none3 = {\n  LET temp = 42\n  OUTPUT temp\n}\nOUTPUT none3 ?? \"fallback3\"\n; Expected: fallback3\n\n; === Chained coalesce ===\n\n; Chain of None values falls through to final fallback\nLET result = (IF FALSE { 1 }) ?? (IF FALSE { 2 }) ?? 3\nOUTPUT result\n; Expected: 3\n\n; First non-None wins (but with None on left)\nLET chain2 = (IF FALSE { \"a\" }) ?? \"b\"\nOUTPUT chain2\n; Expected: b\n\n; === Coalesce with nested IF ===\n\n; Nested IF returning None (outer false, inner never evaluated)\nLET nested = IF FALSE {\n  IF TRUE { \"inner\" }\n}\nOUTPUT nested ?? \"outer-fallback\"\n; Expected: outer-fallback\n\n; === Coalesce in expressions ===\n\n; Coalesce result can be used in further expressions\nLET val = ((IF FALSE { 10 }) ?? 5) + 1\nOUTPUT val\n; Expected: 6\n\n; Coalesce with string concatenation\nLET greeting = (IF FALSE { \"Hi\" }) ?? \"Hello\"\nOUTPUT greeting ++ \" World\"\n; Expected: Hello World\n\nOUTPUT \"Coalesce tests complete\"\n"
---
fallback1
side effect only
