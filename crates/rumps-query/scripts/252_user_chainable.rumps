; User Chainable for type, newtype, and union (requires Wrappable)

#(deriving: Display)
variant Box[T] = Full(T) | Empty
#(deriving: Chainable, Display)
newtype Maybe[T] = Option[T]
union Opt = Option[Int] | Option[String]

class Wrappable for Box {
  fun wrap(v) {
    Box.Full(v)
  }
}

class Unwrappable for Box {
  fun unwrap(x) {
    match x {
      Box.Full(v) => { v }
      Box.Empty => { raise "empty box" }
    }
  }
}

class Chainable for Box {
  fun chain(x, f) {
    match x {
      Box.Full(v) => { f(v) }
      Box.Empty => { Box.Empty }
    }
  }
}

fun main() {
  ; type with user instance
  write :display(Chainable:chain(Box.Full(21), x => Box.Full(x * 2)))
  write :display(Chainable:chain(Box.Empty, x => Box.Full(x * 2)))

  ; chained operations
  let r = Chainable:chain(Box.Full(10), x => {
    Chainable:chain(Box.Full(x + 5), y => Box.Full(y * 2))
  })
  write :display(r)

  ; newtype deriving
  let m: Maybe[Int] = Option.Some(5)
  write :display(Chainable:chain(m, x => Option.Some(x * 10)))

  ; union member-intersection
  let a: Opt = Option.Some(5)
  write :display(Chainable:chain(a, x => Option.Some(x * 10)))

  let b: Opt = Option.None: Option[Int]
  write :display(Chainable:chain(b, x => Option.Some(x + 1)))
}
