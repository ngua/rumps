---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: @kill statement\n; Tests deletion of variables and subtrees\n\nfun main() {\n  ; Set up test data\n  @set items{1} \"one\"\n  @set items{2} \"two\"\n  @set items{3} \"three\"\n  @set items{1, \"a\"} \"nested a\"\n  @set items{1, \"b\"} \"nested b\"\n\n  ; Verify items exists\n  let v1 = @get items{1}\n  write :display(v1)\n  ; Expected: one\n\n  ; @kill single node\n  @kill items{2}\n\n  ; Verify deleted\n  let v2 = @get items{2}\n  write :display(v2)\n  ; Expected: Option.None\n\n  ; @kill subtree\n  @kill items{1}\n\n  ; Verify subtree deleted\n  let v3 = @get items{1}\n  write :display(v3)\n  ; Expected: Option.None\n\n  let v4 = @get items{1, \"a\"}\n  write :display(v4)\n  ; Expected: Option.None\n\n  ; items{3} should still exist\n  let v5 = @get items{3}\n  write :display(v5)\n  ; Expected: three\n\n  ; @kill entire variable\n  @set temp{} 999\n  let before = @get temp{}\n  write :display(before)\n  ; Expected: 999\n\n  @kill temp{}\n  let after = @get temp{}\n  write :display(after)\n  ; Expected: Option.None\n\n  write \"@kill test complete\"\n}\n"
---
Option.Some("one")
Option.None
Option.None
Option.None
Option.Some("three")
Option.Some(999)
Option.None
@kill test complete
