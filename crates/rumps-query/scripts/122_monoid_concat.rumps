; Test: Monoid concatenation (`++` operator)
; Tests polymorphic `++` on String, Array, and Map

fun main() {
  ; === String concatenation ===
  let s1 = "Hello"
  let s2 = "World"
  write s1 ++ ", " ++ s2

  ; === Array concatenation ===
  let a1 = [1, 2, 3]
  let a2 = [4, 5, 6]
  write a1 ++ a2

  ; Nested arrays
  let nested1 = [[1, 2], [3, 4]]
  let nested2 = [[5, 6]]
  write nested1 ++ nested2

  ; === Map concatenation (RHS bias) ===
  let m1 = { "a" => 1, "b" => 2 }
  let m2 = { "c" => 3, "d" => 4 }
  write m1 ++ m2

  ; RHS bias: right value wins for duplicate keys
  let left = { "x" => 10, "y" => 20 }
  let right = { "y" => 999, "z" => 30 }
  let merged = left ++ right
  write Map.lookup(merged, "x")  ; Some(10)
  write Map.lookup(merged, "y")  ; Some(999) - right wins
  write Map.lookup(merged, "z")  ; Some(30)

  ; === Type constraint: Monoid ===
  write concat3("a", "b", "c")
  write concat3([1], [2], [3])
  write concat3({ 1 => "x" }, { 2 => "y" }, { 3 => "z" })

  ; === Option alternative (`<|>` semantics) ===
  ; First `Some` wins; `None` acts as identity

  let some10 = Option.Some(10)
  let some9 = Option.Some(9)
  let none: Option[Int] = Option.None

  ; Some ++ None = Some (left wins)
  write some10 ++ none

  ; None ++ Some = Some (right wins)
  write none ++ some9

  ; None ++ None = None
  write none ++ none

  ; Some ++ Some = first Some (left-biased, like Haskell `<|>`)
  write some10 ++ some9

  ; Chaining: first Some in chain wins
  write none ++ none ++ some10 ++ some9

  ; With generic Monoid function
  write concat3(none, some10, some9)  ; first non-None wins
  write concat3(none, none, some9)    ; last Some wins
  write concat3(none, none, none)     ; all None

  ; === Mempty: `_` (monoid identity) ===
  ; `_` produces the empty value for any Monoid type, inferred from context

  ; String mempty
  write _ ++ "hello"      ; "" ++ "hello" = "hello"
  write "world" ++ _      ; "world" ++ "" = "world"

  ; Array mempty
  write _ ++ [1, 2, 3]    ; [] ++ [1, 2, 3] = [1, 2, 3]
  write [4, 5] ++ _       ; [4, 5] ++ [] = [4, 5]

  ; Map mempty
  let m = { "x" => 10 }
  write _ ++ m            ; {} ++ m = m
  write m ++ _            ; m ++ {} = m

  ; Option mempty (None)
  write _ ++ Option.Some(99)   ; None ++ Some(99) = Some(99)
  write Option.Some(77) ++ _   ; Some(77) ++ None = Some(77)
  write Option.None ++ _       ; None ++ None = None
  write _ ++ Option.None       ; None ++ None = None

  ; Mempty with generic Monoid function
  write concat3(_, "a", "b")   ; "" ++ "a" ++ "b" = "ab"
  write concat3([0], _, [2])   ; [0] ++ [] ++ [2] = [0, 2]

  ; Mempty as forever seed (common pattern for accumulating)
  ; Collect squares of 1..5 into an array starting from `_` (empty array)
  let squares = forever { i: 1, acc: _ } (state, cont) => {
    if state.i > 5 {
      state.acc
    } else {
      cont({ i: state.i + 1, acc: state.acc ++ [state.i * state.i] })
    }
  }
  write squares

  ; Build a string using `_` as initial accumulator
  let words = forever { i: 0, s: _ } (state, cont) => {
    let items = ["hello", "world", "!"]
    if state.i >= 3 {
      state.s
    } else {
      ; Note that `?? _` works fine since `_ == ""` for `String`
      let word = items?[state.i] ?? _
      let sep = if state.i == 0 { _ } else { " " }
      cont({ i: state.i + 1, s: state.s ++ sep ++ word })
    }
  }
  write words

  write "Monoid concatenation complete"
}

; This function works on any Monoid type
fun concat3[T: Monoid](a: T, b: T, c: T) -> T { a ++ b ++ c }
