; Map module primitives
; Tests `Map.empty`, `Map.length`, `Map.keys`, `Map.values`, `Map.entries`,
; `Map.has`, `Map.lookup`, `Map.insert`, `Map.remove`, `Map.merge`,
; `Map.from-entries`, `Map.map`, `Map.map-with-key`, `Map.fold`,
; `Map.fold-with-key`, `Map.map-entries`, `Map.foreach`, `Map.foreach-with-key`
;
; Note: `{}` is ambiguous and parsed as an empty object. Use Map.empty() for empty maps.

newtype Down = Int

class Ord for Down {
  fun compare(a: Down, b: Down) -> Ordering {
    let ai: Int = a
    let bi: Int = b
    if ai > bi { Ordering.Lt } else {
      if ai == bi { Ordering.Eq } else { Ordering.Gt }
    }
  }
}

variant Band = Band(Int)

fun bucket(b: Band) -> Int {
  match b {
    Band.Band(n) => { n // 10 }
  }
}

class Ord for Band {
  fun compare(a: Band, b: Band) -> Ordering {
    let ba = bucket(a)
    let bb = bucket(b)
    if ba > bb { Ordering.Lt } else {
      if ba == bb { Ordering.Eq } else { Ordering.Gt }
    }
  }
}

class Eq for Band {
  fun eq(a: Band, b: Band) -> Bool {
    bucket(a) == bucket(b)
  }
}

fun main() {
  ; ============ Map literals ============

  let m = { 1 => "one", 2 => "two", 3 => "three" }
  write :display(m)

  let str-keys = { "a" => 1, "b" => 2 }
  write :display(str-keys)

  ; ============ Map.empty ============

  let e = Map.empty()
  write :display(e)
  write Map.length(e)  ; 0

  ; ============ Map.length ============

  write Map.length(m)  ; 3
  write Map.length(str-keys)  ; 2

  ; ============ Map.keys ============

  let keys1 = Map.keys(m)
  write :display(keys1)  ; [1, 2, 3]

  let keys2 = Map.keys(str-keys)
  write :display(keys2)  ; ["a", "b"]

  let keys3 = Map.keys(e)
  write :display(keys3)  ; []

  ; ============ Map.values ============

  let vals1 = Map.values(m)
  write :display(vals1)  ; ["one", "two", "three"]

  let vals2 = Map.values(str-keys)
  write :display(vals2)  ; [1, 2]

  let vals3 = Map.values(e)
  write :display(vals3)  ; []

  ; ============ Map.entries ============

  let ent1 = Map.entries(m)
  write :display(ent1)  ; [(1, "one"), (2, "two"), (3, "three")]

  let ent2 = Map.entries(str-keys)
  write :display(ent2)  ; [("a", 1), ("b", 2)]

  ; ============ Map.has ============

  write Map.has(m, 1)  ; true
  write Map.has(m, 2)  ; true
  write Map.has(m, 4)  ; false
  write Map.has(e, 1)  ; false

  write Map.has(str-keys, "a")  ; true
  write Map.has(str-keys, "c")  ; false

  ; ============ Map.lookup ============

  write :display(Map.lookup(m, 1))  ; Some("one")
  write :display(Map.lookup(m, 2))  ; Some("two")
  write :display(Map.lookup(m, 4))  ; None
  write :display(Map.lookup(e, 1))  ; None

  write :display(Map.lookup(str-keys, "a"))  ; Some(1)
  write :display(Map.lookup(str-keys, "z"))  ; None

  ; ============ Map.insert ============

  let m2 = Map.insert(m, 4, "four")
  write Map.length(m2)  ; 4
  write :display(Map.lookup(m2, 4))  ; Some("four")

  ; Original unchanged
  write Map.length(m)  ; 3

  ; Overwrite existing key
  let m3 = Map.insert(m, 1, "ONE")
  write :display(Map.lookup(m3, 1))  ; Some("ONE")

  ; ============ Map.remove ============

  let m4 = Map.remove(m, 2)
  write Map.length(m4)  ; 2
  write Map.has(m4, 2)  ; false
  write Map.has(m4, 1)  ; true
  write Map.has(m4, 3)  ; true

  ; Remove non-existent key (no-op)
  let m5 = Map.remove(m, 999)
  write Map.length(m5)  ; 3

  ; ============ Map.merge ============

  let ma = { 1 => "a", 2 => "b" }
  let mb = { 2 => "B", 3 => "c" }
  let merged = Map.merge(ma, mb)
  write Map.length(merged)  ; 3
  write :display(Map.lookup(merged, 1))  ; Some("a")
  write :display(Map.lookup(merged, 2))  ; Some("B") (second overwrites)
  write :display(Map.lookup(merged, 3))  ; Some("c")

  ; ============ Map.from-entries ============

  let arr = [(1, "x"), (2, "y"), (3, "z")]
  let from-arr = Map.from-entries(arr)
  write Map.length(from-arr)  ; 3
  write :display(Map.lookup(from-arr, 1))  ; Some("x")
  write :display(Map.lookup(from-arr, 2))  ; Some("y")
  write :display(Map.lookup(from-arr, 3))  ; Some("z")

  ; ============ `Map` HoFs ============

  let hof-src = Map.from-entries([(3, 30), (1, 10), (2, 20)])

  let map-vals = Map.map(x => x + 1, hof-src)
  write :display(Map.entries(map-vals))

  let map-with-keys = Map.map-with-key((k, v) => k * 100 + v, hof-src)
  write :display(Map.entries(map-with-keys))

  let fold-sum = Map.fold((acc, v) => acc + v, 0, hof-src)
  write fold-sum

  let fold-labels = Map.fold((acc, v) => "{acc}:{v}", "vals", hof-src)
  write fold-labels

  let fold-keyed = Map.fold-with-key((acc, k, v) => acc + k * v, 0, hof-src)
  write fold-keyed

  let fold-key-labels = Map.fold-with-key((acc, k, v) => "{acc}|{k}={v}", "entries", hof-src)
  write fold-key-labels

  write "Map.foreach:"
  let fe = Map.foreach(v => { write "v:{v}" }, hof-src)
  write :display(fe)

  write "Map.foreach-with-key:"
  let fe-key = Map.foreach-with-key((k, v) => { write "{k}:{v}" }, hof-src)
  write :display(fe-key)

  let entry-src = Map.from-entries([(3, 300), (1, 100), (2, 200)])
  let str-entry-map = Map.map-entries((k, v) => {
    let s = if k == 1 { "c" } else {
      if k == 2 { "a" } else { "b" }
    }
    (s, v // 10)
  }, entry-src)
  write :display(Map.entries(str-entry-map))

  let dup-entry-map = Map.map-entries((k, v) => {
    let s = if k == 2 { "even" } else { "odd" }
    (s, "{v}!")
  }, m)
  write :display(Map.entries(dup-entry-map))
  write :display(Map.lookup(dup-entry-map, "odd"))

  let down-entry-map = Map.map-entries((k, v) => {
    let d: Down = k
    (d, v + 1)
  }, hof-src)
  write :display(Map.entries(down-entry-map))

  let empty-int: Map[Int, Int] = Map.empty()
  write :display(Map.entries(Map.map(x => x + 1, empty-int)))
  write :display(Map.entries(Map.map-with-key((k, v) => k + v, empty-int)))
  write Map.fold((acc, v) => acc + v, 99, empty-int)
  write Map.fold-with-key((acc, k, v) => acc + k + v, 77, empty-int)
  write Map.fold((acc, v) => {
    write "bad-empty-fold"
    acc + v
  }, 99, empty-int)
  write Map.fold-with-key((acc, k, v) => {
    write "bad-empty-fold-key"
    acc + k + v
  }, 77, empty-int)
  write :display(Map.entries(Map.map-entries((k, v) => ("empty-{k}", v + 1), empty-int)))
  write :display(Map.foreach(v => { write "empty-value:{v}" }, empty-int))
  write :display(Map.foreach-with-key((k, v) => { write "empty-entry:{k}:{v}" }, empty-int))

  let down-hof-src: Array[(Down, String)] = [(1, "one"), (3, "three"), (2, "two")]
  let down-hof = Map.from-entries(down-hof-src)

  let down-map-vals = Map.map(v => String.upper(v), down-hof)
  write :display(Map.entries(down-map-vals))

  let down-map-with-keys = Map.map-with-key((k, v) => "{k}:{v}", down-hof)
  write :display(Map.entries(down-map-with-keys))

  let down-fold = Map.fold-with-key((acc, k, v) => "{acc}|{k}:{v}", "down", down-hof)
  write down-fold

  ; ============ Chaining operations ============

  let chain = { 1 => 10, 2 => 20, 3 => 30 }
  let chain2 = Map.insert(chain, 4, 40)
  let chain3 = Map.remove(chain2, 1)
  write Map.length(chain3)  ; 3
  write :display(Map.keys(chain3))  ; [2, 3, 4]

  ; ============ Float keys ============

  let float-map = { 1.5 => "half", 2.5 => "two-half" }
  write Map.has(float-map, 1.5)  ; true
  write :display(Map.lookup(float-map, 2.5))  ; Some("two-half")

  ; ============ Boolean keys ============

  let bool-map = { true => "yes", false => "no" }
  write :display(Map.lookup(bool-map, true))  ; Some("yes")
  write :display(Map.lookup(bool-map, false))  ; Some("no")

  ; ============ Index syntax (direct access) ============

  write m[1]  ; "one"
  write m[2]  ; "two"

  write str-keys["a"]  ; 1

  ; ============ Optional index syntax (returns Option) ============

  write :display(m?[1])  ; Some("one")
  write :display(m?[99])  ; None (key not found)

  write :display(str-keys?["a"])  ; Some(1)
  write :display(str-keys?["missing"])  ; None

  ; Chaining with optional unwrap
  write m?[1] ?? "default"  ; "one"
  write m?[99] ?? "default"  ; "default"

  ; ============ Canonical order and overwrite semantics ============

  let unordered-a = Map.from-entries([("b", 2), ("a", 1)])
  let unordered-b = Map.from-entries([("a", 1), ("b", 2)])
  write :display(Map.keys(unordered-a))
  write :display(Map.values(unordered-a))
  write :display(Map.entries(unordered-a))
  write unordered-a == unordered-b
  write unordered-a <= unordered-b
  write unordered-b <= unordered-a

  let dup = Map.from-entries([("a", 1), ("b", 2), ("a", 3)])
  write Map.length(dup)
  write :display(Map.entries(dup))
  write :display(Map.lookup(dup, "a"))

  let ml = Map.from-entries([("a", 1), ("b", 2)])
  let mr = Map.from-entries([("b", 20), ("c", 30)])
  let merged2 = Map.merge(ml, mr)
  let removed2 = Map.remove(merged2, "missing")
  write :display(Map.entries(merged2))
  write :display(Map.entries(removed2))
  write :display(Map.lookup(merged2, "missing"))

  ; ============ Required key shapes ============

  let bools = Map.from-entries([(true, "true"), (false, "false")])
  write :display(Map.keys(bools))

  let ints = Map.from-entries([(10, "ten"), (1, "one")])
  write :display(Map.keys(ints))

  let floats = Map.from-entries([(2.5, "two"), (1.5, "one")])
  write :display(Map.keys(floats))

  let chars = Map.from-entries([('b', "bee"), ('a', "aye")])
  write :display(Map.keys(chars))

  let strings = Map.from-entries([("b", 2), ("a", 1)])
  write :display(Map.keys(strings))

  let tuples = Map.from-entries([((2, "b"), 20), ((1, "a"), 10)])
  write :display(Map.keys(tuples))
  write :display(Map.lookup(tuples, (1, "a")))

  let arrays = Map.from-entries([([2], "two"), ([1, 2], "one-two"), ([1], "one")])
  write :display(Map.keys(arrays))

  let none: Option[Int] = Option.None
  let some1 = Option.Some(1)
  let some2 = Option.Some(2)
  let opts = Map.from-entries([(some2, "two"), (none, "none"), (some1, "one")])
  write :display(Map.keys(opts))

  let err-a: Result[Int, String] = Result.Err("a")
  let err-b: Result[Int, String] = Result.Err("b")
  let ok1: Result[Int, String] = Result.Ok(1)
  let ress = Map.from-entries([(ok1, "ok"), (err-b, "err-b"), (err-a, "err-a")])
  write :display(Map.keys(ress))

  let ords = Map.from-entries([
    (Ordering.Gt, "gt"),
    (Ordering.Lt, "lt"),
    (Ordering.Eq, "eq"),
  ])
  write :display(Map.keys(ords))

  let key1 = Map.from-entries([(1, "one")])
  let key2 = Map.from-entries([(1, "one"), (2, "two")])
  let nested = Map.from-entries([(key2, "long"), (key1, "short")])
  write :display(Map.keys(nested))

  ; ============ Persistent update shapes ============

  let empty: Map[Int, String] = Map.empty()

  let asc1 = Map.insert(empty, 1, "one")
  let asc2 = Map.insert(asc1, 2, "two")
  let asc3 = Map.insert(asc2, 3, "three")
  let asc4 = Map.insert(asc3, 4, "four")
  let asc5 = Map.insert(asc4, 5, "five")
  write :display(Map.keys(asc5))
  write :display(Map.lookup(asc5, 1))
  write :display(Map.lookup(asc5, 3))
  write :display(Map.lookup(asc5, 5))

  let desc1 = Map.insert(empty, 5, "five")
  let desc2 = Map.insert(desc1, 4, "four")
  let desc3 = Map.insert(desc2, 3, "three")
  let desc4 = Map.insert(desc3, 2, "two")
  let desc5 = Map.insert(desc4, 1, "one")
  write :display(Map.keys(desc5))
  write :display(Map.lookup(desc5, 1))
  write :display(Map.lookup(desc5, 3))
  write :display(Map.lookup(desc5, 5))

  let mixed1 = Map.insert(empty, 3, "three")
  let mixed2 = Map.insert(mixed1, 1, "one")
  let mixed3 = Map.insert(mixed2, 5, "five")
  let mixed4 = Map.insert(mixed3, 2, "two")
  let mixed5 = Map.insert(mixed4, 4, "four")
  write :display(Map.keys(mixed5))
  write :display(Map.lookup(mixed5, 1))
  write :display(Map.lookup(mixed5, 3))
  write :display(Map.lookup(mixed5, 5))

  write :display(Map.keys(empty))
  write :display(Map.keys(asc1))
  write :display(Map.keys(asc5))

  let removed3 = Map.remove(asc5, 1)
  let removed4 = Map.remove(removed3, 3)
  write :display(Map.keys(asc5))
  write :display(Map.keys(removed3))
  write :display(Map.keys(removed4))
  write :display(Map.lookup(asc5, 1))
  write :display(Map.lookup(removed3, 1))
  write :display(Map.lookup(removed4, 3))

  ; ============ User-defined key ordering ============

  let ds: Array[(Down, String)] = [(1, "one"), (3, "three"), (2, "two")]
  let dm = Map.from-entries(ds)
  write :display(Map.keys(dm))

  let three: Down = 3
  let dups: Array[(Down, String)] = [(three, "three"), (three, "THREE")]
  let dup-dm = Map.from-entries(dups)
  write :display(Map.keys(dup-dm))
  write :display(Map.lookup(dup-dm, three))

  let b5 = Band.Band(5)
  let b10 = Band.Band(10)
  let b12 = Band.Band(12)
  let b20 = Band.Band(20)

  let bands = Map.from-entries([
    (b10, "ten"),
    (b20, "twenty"),
    (b5, "five"),
    (b12, "twelve"),
  ])

  write Map.length(bands)
  write :display(Map.keys(bands))
  write :display(Map.lookup(bands, Band.Band(11)))
  write :display(Map.lookup(bands, b10))
  write :display(Map.lookup(bands, b20))
}
