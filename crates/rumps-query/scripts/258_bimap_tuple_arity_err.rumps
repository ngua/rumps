; Error: kind mismatch for tuple constructor instances
;
; 1. `(T,)` has 1 element position but `Bimappable` requires kind 2
; 2. `(,)` has 2 element positions but `Functor` requires kind 1

class Functor F {
  fun fmap[A, B](f: (A) -> B, x: F[A]) -> F[B]
}

class Bimappable for (T,) {
  fun bimap(f, g, x) {
    (f(x.0), g(x.1))
  }
}

class Functor for (,) {
  fun fmap(f, x) {
    (f(x.0), f(x.1))
  }
}

fun main() { }
