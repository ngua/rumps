---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: parse and evaluate arithmetic\n; Tests arithmetic operators with correct precedence\n\nfun main() {\n  ; Basic operations\n  let add = 10 + 5\n  write add\n  ; Expected: 15\n\n  let sub = 10 - 5\n  write sub\n  ; Expected: 5\n\n  let mul = 10 * 5\n  write mul\n  ; Expected: 50\n\n  ; Division requires Float operands\n  let div = 10.0 / 4.0\n  write div\n  ; Expected: 2.5\n\n  let intdiv = 10 // 4\n  write intdiv\n  ; Expected: 2\n\n  let modulo = 10 % 3\n  write modulo\n  ; Expected: 1\n\n  ; Precedence: mul/div before add/sub\n  let prec1 = 2 + 3 * 4\n  write prec1\n  ; Expected: 14 (not 20)\n\n  ; Division with floats\n  let prec2 = 10.0 - 6.0 / 2.0\n  write prec2\n  ; Expected: 7.0 (not 2.0)\n\n  ; Parentheses override precedence\n  let paren1 = (2 + 3) * 4\n  write paren1\n  ; Expected: 20\n\n  let paren2 = (10.0 - 6.0) / 2.0\n  write paren2\n  ; Expected: 2.0\n\n  ; Unary minus\n  let neg = -5\n  write neg\n  ; Expected: -5\n\n  let neg2 = 10 + -3\n  write neg2\n  ; Expected: 7\n\n  ; Nested operations (using floor division for integers)\n  let complex = ((1 + 2) * (3 + 4)) // 7\n  write complex\n  ; Expected: 3\n\n  ; Float arithmetic\n  let f1 = 3.14 * 2.0\n  write f1\n  ; Expected: 6.28\n\n  let f2 = 10.0 / 4.0\n  write f2\n  ; Expected: 2.5\n\n  ; Same-type arithmetic with explicit conversion\n  let mixed = (10 as Float) + 0.5\n  write mixed\n  ; Expected: 10.5\n\n  write \"Arithmetic test complete\"\n}\n"
