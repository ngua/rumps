---
source: crates/rumps-query/tests/scripts.rs
description: "; Test postfix `!` unwrap operator\n\n; Unwrap Option.Some\nLET some-val = Option.Some(42)\nOUTPUT some-val!\n\n; Unwrap Result.Ok\nLET ok-val = Result.Ok(\"success\")\nOUTPUT ok-val!\n\n; Chained with field access\nLET obj = { x: Option.Some(99) }\nOUTPUT obj.x!\n\n; Chained with function call\nFUN make-some (n) { Option.Some(n * 2) }\nOUTPUT make-some(25)!\n\n; Unwrap result from Object.entries (which returns Result)\nLET entries = Object.entries({ a: 1, b: 2 })!\nOUTPUT entries\n\n; Double unwrap (nested Option)\nLET nested = Option.Some(Option.Some(\"deep\"))\nOUTPUT nested!!\n\n; Combining with other postfix ops\nLET arr = [Option.Some(10), Option.Some(20)]\nOUTPUT arr[0]!\nOUTPUT arr[1]!\n\n; In arithmetic expression\nLET num = Option.Some(5)\nOUTPUT num! * 10\n\n; With pipeline\nLET doubled = { val: 3 } |> (o => Option.Some(o.val * 2))\nOUTPUT doubled!\n"
---
