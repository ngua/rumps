---
source: crates/rumps-query/tests/scripts.rs
description: "; Iter module: works on arrays and ranges\n\nfun main() {\n  ; Iterable:length on Array\n  let arr = [1, 2, 3, 4, 5]\n  write \"Array length: {Iterable:length(arr)}\"\n  write \"Array literal length: {Iterable:length([1, 2, 3])}\"\n\n  ; `Iterable:length` on `Range`\n  write \"Range (1..=10) length: {Iterable:length(1 ..= 10)}\"\n  write \"Range (1..10) length: {Iterable:length(1 .. 10)}\"\n  write \"Range (10..1) length: {Iterable:length(10 .. 1)}\"\n\n  ; `Array.contains` on `Array`\n  write \"Array contains 3: {Array.contains(arr, 3)}\"\n  write \"Array contains 99: {Array.contains(arr, 99)}\"\n\n  ; `Array.contains` on collected `Range`\n  write \"Range contains 5: {Array.contains(Range.collect(1 ..= 10), 5)}\"\n  write \"Range contains 11: {Array.contains(Range.collect(1 ..= 10), 11)}\"\n\n  ; Mappable:map on Array (Range is not Mappable; collect first)\n  write \"Doubled array: {Mappable:map(x => x * 2, arr)}\"\n  write \"Doubled range: {Mappable:map(x => x * 2, Range.collect(1 ..= 5))}\"\n\n  ; Filterable:filter on Array\n  write \"Evens from array: {Filterable:filter(x => x % 2 == 0, arr)}\"\n  write \"Evens from range: {Filterable:filter(x => x % 2 == 0, Range.collect(1 ..= 10))}\"\n\n  ; `Foldable:fold` on `Array` and collected `Range`\n  write \"Sum of array: {Foldable:fold((a, x) => a + x, 0, arr)}\"\n  write \"Sum of range: {Foldable:fold((a, x) => a + x, 0, Range.collect(1 ..= 10))}\"\n\n  write \"Generic sum (array): {sum-iter(arr)}\"\n  write \"Generic sum (range): {sum-iter(Range.collect(1 ..= 10))}\"\n\n  write \"Generic count (array): {count-iter(arr)}\"\n  write \"Generic count (range): {count-iter(1 ..= 10)}\"\n\n  ; `Iterable:reverse` on `Array` and `Range`\n  write \"Reversed array: {Iterable:reverse(arr)}\"\n  write \"Reversed array literal: {Iterable:reverse([1, 2, 3])}\"\n  write \"Reversed range: {Iterable:reverse(1 ..= 5)}\"\n  write \"Reversed range (1..10): {Iterable:reverse(1 .. 10)}\"\n  write \"Reversed range length (1..10): {Iterable:length(Iterable:reverse(1 .. 10))}\"\n  write \"Collected reversed range (1..10): {Range.collect(Iterable:reverse(1 .. 10))}\"\n  write \"Reversed range (10..1): {Iterable:reverse(10 .. 1)}\"\n  write \"Collected reversed range (10..1): {Range.collect(Iterable:reverse(10 .. 1))}\"\n  write \"Reversed range (5..5): {Iterable:reverse(5 .. 5)}\"\n  write \"Reversed range length (5..5): {Iterable:length(Iterable:reverse(5 .. 5))}\"\n  write \"Collected reversed range (5..5): {Range.collect(Iterable:reverse(5 .. 5))}\"\n\n  ; `Iterable:reverse` preserves concrete return types\n  let chars = ['a', 'b', 'c']\n  let rev-chars: Array[Char] = Iterable:reverse(chars)\n  write \"Reversed chars: {rev-chars}\"\n\n  let rev-range: Range = Iterable:reverse(1 .. 5)\n  write \"Typed reversed range: {rev-range}\"\n\n  let rev-arr = Iterable:reverse\n  write \"Stored reverse fn array: {rev-arr([1, 2, 3])}\"\n\n  let rev-r = Iterable:reverse\n  write \"Stored reverse fn range: {rev-r(1 ..= 3)}\"\n\n  write \"Keep chars: {keep-chars(chars)}\"\n  write \"Keep range: {keep-range(1 ..= 4)}\"\n\n  ; foreach on Array and Range (Range must be collected first)\n  foreach(x => write \"foreach array: {x}\", [10, 20])\n  foreach(x => write \"foreach range: {x}\", Range.collect(1 ..= 3))\n}\n\n; Generic functions with array and `Iterable` constraints\nfun sum-iter(i: Array[Int]) -> Int {\n  Foldable:fold((a, x) => a + x, 0, i)\n}\n\nfun count-iter[T: Iterable](i: T) -> Int {\n  Iterable:length(i)\n}\n\nfun keep-chars(xs: Array[Char]) -> Array[Char] {\n  Iterable:reverse(xs)\n}\n\nfun keep-range(r: Range) -> Range {\n  Iterable:reverse(r)\n}\n"
---
