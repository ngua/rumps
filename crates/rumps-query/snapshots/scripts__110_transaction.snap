---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: TRANSACTION expression\n; Transactions wrap global writes and return Result[T, String]\n\n; Basic transaction with global write\nLET write-result = TRANSACTION {\n  @SET ^TEST(1, \"name\") = \"Alice\"\n  @SET ^TEST(1, \"age\") = 30\n  @GET ^TEST(1, \"name\")\n}\n@OUTPUT write-result\n\n; Verify write persisted\n@OUTPUT @GET ^TEST(1, \"age\")\n\n; Transaction returning unit (write-only)\nLET unit-result = TRANSACTION {\n  @SET ^TEST(2, \"status\") = \"active\"\n}\n@OUTPUT unit-result\n@OUTPUT @GET ^TEST(2, \"status\")\n\n; Transaction with multiple statements and computation\nLET multi = TRANSACTION {\n  LET a = 10\n  LET b = 20\n  @SET ^TEST(4, \"sum\") = a + b\n  a + b\n}\n@OUTPUT multi\n@OUTPUT @GET ^TEST(4, \"sum\")\n\n; Accessing outer scope from transaction\nLET x = 100\nLET access-outer = TRANSACTION {\n  @SET ^TEST(5, \"val\") = x + 1\n  x + 1\n}\n@OUTPUT access-outer\n\n; Transaction result matching\nLET txn-result = TRANSACTION {\n  @SET ^TEST(6, \"m\") = \"success\"\n  \"success\"\n}\nLET matched = MATCH txn-result {\n  Result.Ok(s) => { \"got: {s}\" }\n  Result.Err(e) => { \"error: {e}\" }\n}\n@OUTPUT matched\n\n; Rollback on error: write then fail, verify write is not persisted\nLET rollback-test = TRANSACTION {\n  @SET ^ROLLBACK(\"key\") = \"should not persist\"\n  LET x = Option.None!\n  \"unreachable\"\n}\n@OUTPUT rollback-test\n@OUTPUT @GET ^ROLLBACK(\"key\")\n\n; Bulk write/read test using FOREVER inside transaction\nLET bulk-result = TRANSACTION {\n  ; Write 100 values to ^BULK(0) through ^BULK(99)\n  FOREVER 0 (n, cont) => {\n    IF n >= 100 {\n      n\n    } ELSE {\n      @SET ^BULK(n) = n * 2\n      cont(n + 1)\n    }\n  }\n\n  ; Read them back and count how many exist\n  LET count = FOREVER { i: 0, found: 0 } (state, cont) => {\n    IF state.i >= 100 {\n      state.found\n    } ELSE {\n      LET val = @GET ^BULK(state.i)\n      LET inc = MATCH val {\n        Option.Some(_) => { 1 }\n        Option.None => { 0 }\n      }\n      cont({ i: state.i + 1, found: state.found + inc })\n    }\n  }\n  count\n}\n@OUTPUT bulk-result\n\n@OUTPUT \"TRANSACTION test complete\"\n"
---
Result.Ok(Option.Some("Alice"))
Option.Some(30)
Result.Ok(Unit)
Option.Some("active")
Result.Ok(30)
Option.Some(30)
Result.Ok(101)
"got: success"
Result.Err("runtime error at 1226..1238: cannot unwrap Option.None")
Option.None
Result.Ok(100)
"TRANSACTION test complete"
