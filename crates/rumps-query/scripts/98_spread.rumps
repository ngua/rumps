; Test spread operators for arrays and objects
; Section 8 of phase-4c.md

fun main() {
  ; ====== Array Spread ======

  ; Basic array spread
  let arr1 = [1, 2, 3]
  let arr2 = [4, 5, 6]
  let combined = [...arr1, ...arr2]
  write :display(combined)

  ; Prepend/append with spread
  let with-zero = [0, ...arr1]
  write :display(with-zero)

  let with-four = [...arr1, 4]
  write :display(with-four)

  ; Mixed elements and spreads
  let mixed = [0, ...arr1, 4, 5]
  write :display(mixed)

  ; Empty array spread
  let empty: Array[Int] = []
  let spread-empty = [...empty, 1, 2]
  write :display(spread-empty)

  ; Spread with single element array
  let single = [42]
  let spread-single = [...single, ...single]
  write :display(spread-single)

  ; ====== Object Spread ======

  ; Basic object spread
  let base = { name: "Alice", age: 30 }
  let updated = { ...base, age: 31 }
  write updated.name
  write updated.age

  ; Merge multiple objects
  let defaults = { color: "red", size: "medium" }
  let user-prefs = { size: "large" }
  let config = { ...defaults, ...user-prefs }
  write config.color
  write config.size

  ; Add new fields
  let extended = { ...base, city: "NYC" }
  write extended.name
  write extended.city

  ; Empty object spread
  let empty-obj = { }
  let spread-empty-obj = { ...empty-obj, x: 1 }
  write spread-empty-obj.x

  ; ====== Struct Spread with Preservation ======

  ; Spread a struct value (should preserve type)
  let alice: Person = { name: "Alice", age: 30 }
  let alice-older: Person = { ...alice, age: 31 }
  write alice-older.name
  write alice-older.age

  ; Adding fields to a struct (extensible record semantics)
  let alice-with-city = { ...alice, city: "NYC" }
  write alice-with-city.city

  ; ====== Nested Spreads ======

  ; Spread of spreads
  let a = [1, 2]
  let b = [3, 4]
  let c = [5, 6]
  let all = [...a, ...b, ...c]
  write :display(all)

  ; Nested object spreads
  let o1 = { x: 1 }
  let o2 = { y: 2 }
  let o3 = { z: 3 }
  let merged = { ...o1, ...o2, ...o3 }
  write merged.x
  write merged.y
  write merged.z

  write "--- TESTS PASSED ---"
}

; Define a struct
newtype Person = { name: String, age: Int }
