; `F: Fallible` does not satisfy coalescing.

variant Box[T] = Full(T) | Empty

class Wrappable for Box {
  fun wrap(x: T) -> Box[T] {
    Box.Full(x)
  }
}

class Fallible for Box {
  fun unwrap(b: Box[T]) -> T {
    match b {
      Box.Full(x) => { x }
      Box.Empty => { raise "empty box" }
    }
  }
}

fun main() {
  write or-else(Box.Empty, 99)
}

fun or-else[T, F: Fallible](x: F[T], default: T) -> T {
  x ?? default
}
