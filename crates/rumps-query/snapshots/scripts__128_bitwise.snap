description: "; Test: Bitwise operators\n; Tests `&`, `|`, `<<`, `>>` for `BitLike` types (`Bool`, `Int`, `Word`)\n\nfun main() {\n  ; === Bool bitwise operations ===\n\n  ; Bool and (bitwise and logical are the same for Bool)\n  write true & true\n  ; Expected: true\n\n  write true & false\n  ; Expected: false\n\n  write false & false\n  ; Expected: false\n\n  ; Bool or\n  write true | true\n  ; Expected: true\n\n  write true | false\n  ; Expected: true\n\n  write false | false\n  ; Expected: false\n\n  ; Bool shift (always produces false; shifts out the single bit)\n  write true << true\n  ; Expected: false\n\n  write true >> true\n  ; Expected: false\n\n  ; === Int bitwise operations ===\n\n  ; Basic and: 12 & 10 = 8 (binary: 1100 & 1010 = 1000)\n  let a = 12 & 10\n  write a\n  ; Expected: 8\n\n  ; Basic or: 12 | 10 = 14 (binary: 1100 | 1010 = 1110)\n  let b = 12 | 10\n  write b\n  ; Expected: 14\n\n  ; Shift left\n  let c = 1 << 4\n  write c\n  ; Expected: 16\n\n  let d = 3 << 2\n  write d\n  ; Expected: 12\n\n  ; Shift right\n  let e = 16 >> 2\n  write e\n  ; Expected: 4\n\n  let f = 12 >> 2\n  write f\n  ; Expected: 3\n\n  ; Negative Int shift right (arithmetic shift; preserves sign)\n  let g = (-8) >> 1\n  write g\n  ; Expected: -4\n\n  ; Combined operations\n  let h = (1 << 8) | (1 << 4) | (1 << 0)\n  write h\n  ; Expected: 273\n\n  ; === Word bitwise operations ===\n\n  let w1: Word = 12\n  let w2: Word = 10\n  let w3: Word = 8\n\n  ; Word and\n  let wa: Word = w1 & w2\n  write wa\n  ; Expected: 8\n\n  ; Word or\n  let wb: Word = w1 | w2\n  write wb\n  ; Expected: 14\n\n  ; Word shift left\n  let w4: Word = 1\n  let w5: Word = 4\n  let wc: Word = w4 << w5\n  write wc\n  ; Expected: 16\n\n  ; Word shift right\n  let w16: Word = 16\n  let w2a: Word = 2\n  let we: Word = w16 >> w2a\n  write we\n  ; Expected: 4\n\n  ; === Operator precedence ===\n\n  ; `&` binds tighter than `|`\n  ; (15 & 10) | 5 = 10 | 5 = 15\n  let p1 = 15 & 10 | 5\n  write p1\n  ; Expected: 15\n\n  ; Shifts bind tighter than addition\n  ; (1 << 4) + 2 = 16 + 2 = 18\n  let p2 = 1 << 4 + 2\n  write p2\n  ; Expected: 18\n\n  ; Shift binds tighter than addition, so: 2 + (1 << 4) = 2 + 16 = 18\n  let p3 = 2 + 1 << 4\n  write p3\n  ; Expected: 18\n\n  ; === BitLike constraint on generic functions ===\n\n  write bitwise-and-int(12, 10)\n  ; Expected: 8\n\n  write bitwise-and-bool(true, false)\n  ; Expected: false\n\n  let w10: Word = 10\n  let w6: Word = 6\n  write bitwise-and-word(w10, w6)\n  ; Expected: 2\n\n  write bitwise-or-int(12, 10)\n  ; Expected: 14\n\n  write bitwise-or-bool(true, false)\n  ; Expected: true\n\n  write \"Bitwise operators test complete\"\n}\n\n; Each generic function only works with one type per call due to monomorphization\nfun bitwise-and-int[T: BitLike](a: T, b: T) -> T {\n  a & b\n}\n\nfun bitwise-and-bool[T: BitLike](a: T, b: T) -> T {\n  a & b\n}\n\nfun bitwise-and-word[T: BitLike](a: T, b: T) -> T {\n  a & b\n}\n\nfun bitwise-or-int[T: BitLike](a: T, b: T) -> T {\n  a | b\n}\n\nfun bitwise-or-bool[T: BitLike](a: T, b: T) -> T {\n  a | b\n}\n"
