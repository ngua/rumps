---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: Monoid concatenation (`++` operator)\n; Tests polymorphic `++` on String, Array, and Map\n\n; === String concatenation ===\nLET s1 = \"Hello\"\nLET s2 = \"World\"\n@OUTPUT s1 ++ \", \" ++ s2\n\n; === Array concatenation ===\nLET a1 = [1, 2, 3]\nLET a2 = [4, 5, 6]\n@OUTPUT a1 ++ a2\n\n; Nested arrays\nLET nested1 = [[1, 2], [3, 4]]\nLET nested2 = [[5, 6]]\n@OUTPUT nested1 ++ nested2\n\n; === Map concatenation (RHS bias) ===\nLET m1 = { \"a\" => 1, \"b\" => 2 }\nLET m2 = { \"c\" => 3, \"d\" => 4 }\n@OUTPUT m1 ++ m2\n\n; RHS bias: right value wins for duplicate keys\nLET left = { \"x\" => 10, \"y\" => 20 }\nLET right = { \"y\" => 999, \"z\" => 30 }\nLET merged = left ++ right\n@OUTPUT Map.lookup(merged, \"x\")  ; Some(10)\n@OUTPUT Map.lookup(merged, \"y\")  ; Some(999) - right wins\n@OUTPUT Map.lookup(merged, \"z\")  ; Some(30)\n\n; === Type constraint: Monoid ===\n; This function works on any Monoid type\nFUN concat3[T: Monoid](a: T, b: T, c: T) -> T { a ++ b ++ c }\n\n@OUTPUT concat3(\"a\", \"b\", \"c\")\n@OUTPUT concat3([1], [2], [3])\n@OUTPUT concat3({ 1 => \"x\" }, { 2 => \"y\" }, { 3 => \"z\" })\n\n@OUTPUT \"Monoid concatenation complete\"\n"
---
"Hello, World"
[ 1, 2, 3, 4, 5, 6 ]
[ [ 1, 2 ], [ 3, 4 ], [ 5, 6 ] ]
{ "a" => 1, "b" => 2, "c" => 3, "d" => 4 }
Option.Some(10)
Option.Some(999)
Option.Some(30)
"abc"
[ 1, 2, 3 ]
{ 1 => "x", 2 => "y", 3 => "z" }
"Monoid concatenation complete"
