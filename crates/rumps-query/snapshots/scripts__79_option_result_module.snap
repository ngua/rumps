source: crates/rumps-query/tests/scripts.rs
description: "; Option and Result module primitives\n; Tests Option.unwrap-or, Option.map, Result.unwrap-or, Result.map, Result.map-err\n\n; ============ Option.unwrap-or ============\n\nLET some-val = Option.Some(42)\nLET none-val = Option.None\n\nOUTPUT Option.unwrap-or(some-val, 0)  ; 42\nOUTPUT Option.unwrap-or(none-val, 0)  ; 0\nOUTPUT Option.unwrap-or(Option.Some(\"hello\"), \"default\")  ; \"hello\"\nOUTPUT Option.unwrap-or(Option.None, \"default\")  ; \"default\"\n\n; ============ Option.map ============\n\nLET double = x => x * 2\nLET to-upper = s => String.upper(s)\n\nOUTPUT Option.map(Option.Some(21), double)  ; Some(42)\nOUTPUT Option.map(Option.None, double)  ; None\nOUTPUT Option.map(Option.Some(\"hello\"), to-upper)  ; Some(\"HELLO\")\nOUTPUT Option.map(Option.None, to-upper)  ; None\n\n; Inline closure\nOUTPUT Option.map(Option.Some(5), x => x + 1)  ; Some(6)\n\n; Chaining map\nLET opt = Option.Some(10)\nLET mapped = Option.map(opt, x => x * 2)\nOUTPUT mapped  ; Some(20)\nOUTPUT Option.map(mapped, x => x + 5)  ; Some(25)\n\n; ============ Result.unwrap-or ============\n\nLET ok-val = Result.Ok(100)\nLET err-val = Result.Err(\"something went wrong\")\n\nOUTPUT Result.unwrap-or(ok-val, 0)  ; 100\nOUTPUT Result.unwrap-or(err-val, 0)  ; 0\nOUTPUT Result.unwrap-or(Result.Ok(\"success\"), \"fallback\")  ; \"success\"\nOUTPUT Result.unwrap-or(Result.Err(\"fail\"), \"fallback\")  ; \"fallback\"\n\n; ============ Result.map ============\n\nOUTPUT Result.map(Result.Ok(21), double)  ; Ok(42)\nOUTPUT Result.map(Result.Err(\"err\"), double)  ; Err(\"err\")\nOUTPUT Result.map(Result.Ok(\"hello\"), to-upper)  ; Ok(\"HELLO\")\nOUTPUT Result.map(Result.Err(\"err\"), to-upper)  ; Err(\"err\")\n\n; Inline closure\nOUTPUT Result.map(Result.Ok(5), x => x + 1)  ; Ok(6)\n\n; ============ Result.map-err ============\n\nLET add-prefix = e => \"Error: \" ++ e\n\nOUTPUT Result.map-err(Result.Err(\"failed\"), add-prefix)  ; Err(\"Error: failed\")\nOUTPUT Result.map-err(Result.Ok(42), add-prefix)  ; Ok(42)\nOUTPUT Result.map-err(Result.Err(\"oops\"), e => String.upper(e))  ; Err(\"OOPS\")\nOUTPUT Result.map-err(Result.Ok(\"ok\"), e => String.upper(e))  ; Ok(\"ok\")\n\n; ============ Combining operations ============\n\n; Option.map then unwrap-or\nLET maybe-num = Option.Some(10)\nLET doubled-or-zero = Option.unwrap-or(Option.map(maybe-num, x => x * 2), 0)\nOUTPUT doubled-or-zero  ; 20\n\nLET no-num = Option.None\nLET doubled-or-zero-none = Option.unwrap-or(Option.map(no-num, x => x * 2), 0)\nOUTPUT doubled-or-zero-none  ; 0\n\n; Result.map then unwrap-or\nLET res-ok = Result.Ok(5)\nLET res-mapped = Result.unwrap-or(Result.map(res-ok, x => x * 3), 0)\nOUTPUT res-mapped  ; 15\n\nLET res-err = Result.Err(\"bad\")\nLET res-err-mapped = Result.unwrap-or(Result.map(res-err, x => x * 3), 0)\nOUTPUT res-err-mapped  ; 0\n\n; ============ Type variants still work ============\n\n; Ensure Option.None and Result.Ok etc. still work as type constructors\nLET opt-none = Option.None\nLET opt-some = Option.Some(1)\nOUTPUT opt-none IS Option.None  ; true\nOUTPUT opt-some IS Option.Some(_)  ; true\n\nLET res-ok-check = Result.Ok(1)\nLET res-err-check = Result.Err(\"x\")\nOUTPUT res-ok-check IS Result.Ok(_)  ; true\nOUTPUT res-err-check IS Result.Err(_)  ; true\n"
