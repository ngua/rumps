---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: JSON type and access operators\n; Tests JSON literals, field access, type conversions, and heterogeneous arrays\n\n; ============================================================\n; JSON LITERALS (quoted keys)\n; ============================================================\n\nLET j = { \"name\": \"Alice\", \"age\": 30, \"active\": TRUE }\n\n; Type checking\nOUTPUT j IS Json\n; Expected: TRUE\n\n; ============================================================\n; JSON FIELD ACCESS (returns Json)\n; ============================================================\n\nLET name = j.name\nOUTPUT name IS Json\n; Expected: TRUE\n\n; Missing field returns Json null\nLET missing = j.missing\nOUTPUT missing IS Json\n; Expected: TRUE\n\n; ============================================================\n; NESTED JSON ACCESS\n; ============================================================\n\nLET nested = {\n  \"user\": {\n    \"profile\": {\n      \"firstName\": \"Bob\"\n    }\n  }\n}\n\nOUTPUT nested.user.profile.firstName IS Json\n; Expected: TRUE\n\n; ============================================================\n; NATIVE OBJECTS (unquoted keys) vs JSON\n; ============================================================\n\nLET obj = { name: \"Alice\", age: 30 }\nOUTPUT obj IS { name: String, age: Int }\n; Expected: TRUE\n\n; Native object field access returns native type\nOUTPUT obj.name IS String\n; Expected: TRUE\n\n; ============================================================\n; JSON SCALAR EXTRACTION WITH .. (returns Option)\n; ============================================================\n\nLET data = { \"a\": 1, \"b\": 2, \"c\": 3 }\nLET a-scalar = data..a\nOUTPUT a-scalar IS Option.Some(_)\n; Expected: TRUE\n\n; Unwrap scalar extraction\nOUTPUT a-scalar!\n; Expected: 1\n\n; Another scalar extraction\nLET c-val = data..c\nOUTPUT c-val!\n; Expected: 3\n\n; Missing key with .. returns Option.None\nLET miss = data..missing\nOUTPUT miss IS Option.None\n; Expected: TRUE\n\n; Scalar extraction from string field\nLET strs = { \"greeting\": \"hello\" }\nLET s = strs..greeting\nOUTPUT s!\n; Expected: hello\n\n; Scalar extraction from bool field\nLET bools = { \"flag\": TRUE }\nLET b = bools..flag\nOUTPUT b!\n; Expected: TRUE\n\n; Scalar extraction from float field\nLET floats = { \"pi\": 3.14 }\nLET f = floats..pi\nOUTPUT f!\n; Expected: 3.14\n\n; ============================================================\n; DYNAMIC JSON ACCESS WITH -> AND ->>\n; ============================================================\n\nLET key = \"b\"\nLET dyn = data->(key)\nOUTPUT dyn IS Json\n; Expected: TRUE\n\n; Dynamic scalar access with ->>(expr)\nLET key-c = \"c\"\nLET dyn-c = data->>(key-c)\nOUTPUT dyn-c!\n; Expected: 3\n\n; ============================================================\n; AS Json COERCION (native -> Json)\n; ============================================================\n\n; Native object -> Json\nLET native-obj = { x: 1, y: 2 }\nLET json-obj = native-obj AS Json\nOUTPUT json-obj IS Json\n; Expected: TRUE\n\n; Array -> Json\nLET arr = [1, 2, 3]\nLET json-arr = arr AS Json\nOUTPUT json-arr IS Json\n; Expected: TRUE\n\n; Scalar -> Json\nLET int-json = 42 AS Json\nOUTPUT int-json IS Json\n; Expected: TRUE\n\nLET str-json = \"hello\" AS Json\nOUTPUT str-json IS Json\n; Expected: TRUE\n\nLET bool-json = TRUE AS Json\nOUTPUT bool-json IS Json\n; Expected: TRUE\n\n; ============================================================\n; Json READ T CONVERSIONS (Json -> native)\n; ============================================================\n\nLET j-data = { \"name\": \"John\", \"age\": 30, \"active\": TRUE, \"score\": 3.14 }\n\n; Json -> String\nLET name-result = j-data.name READ String\nOUTPUT name-result IS Result.Ok(_)\n; Expected: TRUE\nOUTPUT name-result!\n; Expected: John\n\n; Json -> Int\nLET age-result = j-data.age READ Int\nOUTPUT age-result IS Result.Ok(_)\n; Expected: TRUE\nOUTPUT age-result!\n; Expected: 30\n\n; Json -> Bool\nLET active-result = j-data.active READ Bool\nOUTPUT active-result IS Result.Ok(_)\n; Expected: TRUE\nOUTPUT active-result!\n; Expected: TRUE\n\n; Json -> Float\nLET score-result = j-data.score READ Float\nOUTPUT score-result IS Result.Ok(_)\n; Expected: TRUE\nOUTPUT score-result!\n; Expected: 3.14\n\n; Json -> Object (structural type)\nLET obj-data = { \"nested\": { \"a\": 1, \"b\": 2 } }\nLET nested-result = obj-data.nested READ { a: Int, b: Int }\nOUTPUT nested-result IS Result.Ok(_)\n; Expected: TRUE\n\n; READ type mismatch returns Result.Err\nLET bad-int = j-data.name READ Int\nOUTPUT bad-int IS Result.Err(_)\n; Expected: TRUE\n\n; READ on missing field (JSON null) returns Result.Err for non-Option types\nLET null-data = { \"other\": 1 }\nLET null-read = null-data.missing READ Int\nOUTPUT null-read IS Result.Err(_)\n; Expected: TRUE\n\n; ============================================================\n; HETEROGENEOUS ARRAYS -> Json\n; ============================================================\n\n; Mixed types become Json\nLET hetero = [1, \"two\", TRUE, 3.14]\nOUTPUT hetero IS Json\n; Expected: TRUE\n\n; String mixed with other types\nLET str-mix = [\"a\", 1, \"hello\"]\nOUTPUT str-mix IS Json\n; Expected: TRUE\n\n; Two elements of different types\nLET two-mix = [42, \"hello\"]\nOUTPUT two-mix IS Json\n; Expected: TRUE\n\n; Homogeneous arrays stay as Array\nLET hom-int = [1, 2, 3]\nOUTPUT hom-int IS Array\n; Expected: TRUE\n\nLET hom-str = [\"a\", \"b\", \"c\"]\nOUTPUT hom-str IS Array\n; Expected: TRUE\n\n; ============================================================\n; NULL LITERAL IN JSON CONTEXTS\n; ============================================================\n\n; null in JSON object\nLET with-null = { \"name\": \"Alice\", \"middle\": null }\nOUTPUT with-null IS Json\n; Expected: TRUE\n\n; null in heterogeneous array\nLET arr-null = [1, null, \"three\"]\nOUTPUT arr-null IS Json\n; Expected: TRUE\n\n; Array with only null becomes Json\nLET null-only = [null, null]\nOUTPUT null-only IS Json\n; Expected: TRUE\n\n; Option.None -> null\nLET none-json = Option.None AS Json\nOUTPUT none-json IS Json\n; Expected: TRUE\n\n; Option.Some(v) -> v\nLET some-json = Option.Some(42) AS Json\nOUTPUT some-json IS Json\n; Expected: TRUE\n\n; Verify Option.Some unwraps to inner value (not tagged object)\nLET some-read = some-json READ Int\nOUTPUT some-read!\n; Expected: 42\n\n; ============================================================\n; CHAR LITERALS\n; ============================================================\n\nLET ch = 'a'\nOUTPUT ch IS Char\n; Expected: TRUE\n\nLET newline = '\\n'\nOUTPUT newline IS Char\n; Expected: TRUE\n\n; Char in array (homogeneous)\nLET chars = ['a', 'b', 'c']\nOUTPUT chars IS Array\n; Expected: TRUE\n\n; ============================================================\n; JSON READ INTO STRUCT TYPES\n; ============================================================\n\n; Define a struct type\nTYPE Person = { name: String, age: Int }\n\n; Read JSON into struct\nLET person-json = { \"name\": \"Alice\", \"age\": 30 }\nLET person-result = person-json READ Person\nOUTPUT person-result IS Result.Ok(_)\n; Expected: TRUE\n\n; Read NATIVE object into struct (extra fields allowed)\nLET native-obj = { name: \"Native\", age: 25, extra: \"ignored\" }\nLET native-result = native-obj READ Person\nOUTPUT native-result IS Result.Ok(_)\n; Expected: TRUE\n\nLET native-person = native-result!\nOUTPUT native-person.name\n; Expected: Native\nOUTPUT native-person.age\n; Expected: 25\n\nLET person = person-result!\nOUTPUT person.name\n; Expected: Alice\nOUTPUT person.age\n; Expected: 30\n\n; Missing field returns Result.Err\nLET incomplete = { \"name\": \"Bob\" }\nLET incomplete-result = incomplete READ Person\nOUTPUT incomplete-result IS Result.Err(_)\n; Expected: TRUE\n\n; Wrong field type returns Result.Err\nLET wrong-type = { \"name\": \"Carol\", \"age\": \"thirty\" }\nLET wrong-result = wrong-type READ Person\nOUTPUT wrong-result IS Result.Err(_)\n; Expected: TRUE\n\n; ============================================================\n; JSON READ INTO PARAMETRIC STRUCT TYPES\n; ============================================================\n\n; Define parametric struct\nTYPE Box[T] = { value: T }\n\n; Read into Box[Int]\nLET box-json = { \"value\": 42 }\nLET box-result = box-json READ Box[Int]\nOUTPUT box-result IS Result.Ok(_)\n; Expected: TRUE\n\nLET box-val = box-result!\nOUTPUT box-val.value\n; Expected: 42\n\n; Read into Box[String]\nLET str-box-json = { \"value\": \"hello\" }\nLET str-box-result = str-box-json READ Box[String]\nOUTPUT str-box-result IS Result.Ok(_)\n; Expected: TRUE\n\nOUTPUT str-box-result!.value\n; Expected: hello\n\n; Multi-param struct\nTYPE Pair[A, B] = { first: A, second: B }\n\nLET pair-json = { \"first\": 1, \"second\": \"one\" }\nLET pair-result = pair-json READ Pair[Int, String]\nOUTPUT pair-result IS Result.Ok(_)\n; Expected: TRUE\n\nLET pair-val = pair-result!\nOUTPUT pair-val.first\n; Expected: 1\nOUTPUT pair-val.second\n; Expected: one\n\n; ============================================================\n; JSON READ INTO ARRAY[T]\n; ============================================================\n\nLET arr-json = [1, 2, 3] AS Json\nLET arr-result = arr-json READ Array[Int]\nOUTPUT arr-result IS Result.Ok(_)\n; Expected: TRUE\n\nLET arr-val = arr-result!\nOUTPUT arr-val IS Array\n; Expected: TRUE\nOUTPUT Array.length(arr-val)\n; Expected: 3\n\n; Type mismatch in array element\nLET bad-arr = [1, \"two\", 3] AS Json\nLET bad-arr-result = bad-arr READ Array[Int]\nOUTPUT bad-arr-result IS Result.Err(_)\n; Expected: TRUE\n\n; ============================================================\n; JSON READ INTO OPTION[T]\n; ============================================================\n\n; Non-null -> Some\nLET opt-json = 42 AS Json\nLET opt-result = opt-json READ Option[Int]\nOUTPUT opt-result IS Result.Ok(_)\n; Expected: TRUE\n\nLET opt-val = opt-result!\nOUTPUT opt-val IS Option.Some(_)\n; Expected: TRUE\nOUTPUT opt-val!\n; Expected: 42\n\n; null -> None\nLET null-json = { \"value\": null }\nLET null-opt-result = null-json.value READ Option[Int]\nOUTPUT null-opt-result IS Result.Ok(_)\n; Expected: TRUE\n\nLET null-opt-val = null-opt-result!\nOUTPUT null-opt-val IS Option.None\n; Expected: TRUE\n\n; ============================================================\n; NESTED STRUCTS IN JSON READ\n; ============================================================\n\nTYPE Address = { city: String, zip: Int }\nTYPE Employee = { name: String, addr: Address }\n\nLET emp-json = {\n  \"name\": \"Dave\",\n  \"addr\": {\n    \"city\": \"NYC\",\n    \"zip\": 10001\n  }\n}\n\nLET emp-result = emp-json READ Employee\nOUTPUT emp-result IS Result.Ok(_)\n; Expected: TRUE\n\nLET emp = emp-result!\nOUTPUT emp.name\n; Expected: Dave\nOUTPUT emp.addr.city\n; Expected: NYC\nOUTPUT emp.addr.zip\n; Expected: 10001\n\nOUTPUT \"JSON test complete\"\n"
---
ERROR: parse error at 1532..1536: unexpected `DATA` (expected: (, [, {)
