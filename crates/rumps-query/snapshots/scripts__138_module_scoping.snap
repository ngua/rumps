---
source: crates/rumps-query/tests/scripts.rs
description: "; Module scoping test\n; Tests that functions can reference sibling constants and functions\n; in both inline and file-imported modules\n\n; ============ Inline module with sibling references ============\n\nMODULE Geometry {\n    +LET pi = 3.14159\n    +LET tau = 6.28318\n\n    ; Function referencing sibling constant\n    +FUN circle-area(r: Float) -> Float { pi * r * r }\n\n    ; Function referencing sibling constant\n    +FUN circle-circumference(r: Float) -> Float { tau * r }\n\n    ; Function referencing sibling function (mutual recursion base case)\n    +FUN double-area(r: Float) -> Float { 2.0 * circle-area(r) }\n}\n\n@OUTPUT Geometry.pi > 3  ; true\n@OUTPUT Geometry.circle-area(1.0) > 3  ; true (pi * 1 * 1 = pi)\n@OUTPUT Geometry.circle-circumference(1.0) > 6  ; true (tau * 1 = tau)\n@OUTPUT Geometry.double-area(1.0) > 6  ; true (2 * pi)\n\n; ============ File-imported module with sibling references ============\n\nMODULE MyMath FROM \"../modules/lib/mymath.rumps\"\n\n@OUTPUT MyMath.pi > 3  ; true\n@OUTPUT MyMath.area(1.0) > 3  ; true (pi * 1 * 1 = pi)\n@OUTPUT MyMath.area(2.0) > 12  ; true (pi * 4 = ~12.56)\n\n; ============ Both inline and imported in same script ============\n\nLET inline-area = Geometry.circle-area(2.0)\nLET file-area = MyMath.area(2.0)\n\n; Both should compute pi * 4 = ~12.56636\n@OUTPUT inline-area > 12\n@OUTPUT file-area > 12\n\n; They should be equal (both use pi * r * r)\nLET diff = inline-area - file-area\n@OUTPUT diff < 0.0001\n@OUTPUT diff > -0.0001\n"
---
