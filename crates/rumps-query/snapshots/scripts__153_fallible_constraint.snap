---
source: crates/rumps-query/tests/scripts.rs
description: "; Test Fallible[T] constraint for Option/Result polymorphism\n\n; ============================================================================\n; Basic Fallible constraint with inner type\n; ============================================================================\n\n; Generic unwrap function that works on any Option[T] or Result[T, E]\nFUN unwrap[T, F: Fallible[T]](x: F) -> T {\n  x!\n}\n\n; Works with Option\nLET opt = Option.Some(42)\nWRITE unwrap(opt)\n\n; Works with Result\nLET res = Result.Ok(\"hello\")\nWRITE unwrap(res)\n\n; ============================================================================\n; Fallible with coalesce\n; ============================================================================\n\n; Generic or-else function\nFUN or-else[T, F: Fallible[T]](x: F, default: T) -> T {\n  x ?? default\n}\n\nWRITE or-else(Option.Some(10), 0)\nWRITE or-else(Option.None, 99)\nWRITE or-else(Result.Ok(5), 0)\nWRITE or-else(Result.Err(\"oops\"), -1)\n\n; ============================================================================\n; Fallible with mapping\n; ============================================================================\n\n; Map over fallible, returning Option\nFUN map-fallible[T, U, F: Fallible[T]](f: (T) -> U, x: F) -> Option[U] {\n  IF x IS Option.Some(v) {\n    Option.Some(f(v))\n  } ELSE {\n    IF x IS Result.Ok(v) {\n      Option.Some(f(v))\n    } ELSE {\n      Option.None\n    }\n  }\n}\n\nWRITE map-fallible((n) => n * 2, Option.Some(21))\nWRITE map-fallible((s) => s ++ \"!\", Result.Ok(\"hi\"))\nWRITE map-fallible((n) => n * 2, Option.None)\n\n; ============================================================================\n; Closure with Fallible constraint\n; ============================================================================\n\nLET safe-get = [T, F: Fallible[T]](x: F, default: T) -> T => x ?? default\n\nWRITE safe-get(Option.Some(100), 0)\nWRITE safe-get(Option.None, 42)\n\n; ============================================================================\n; Combining Fallible with other constraints\n; ============================================================================\n\n; Fallible + Numeric inner type\nFUN unwrap-numeric[T: Numeric, F: Fallible[T]](x: F) -> T {\n  x ?? 0\n}\n\nWRITE unwrap-numeric(Option.Some(123))\nWRITE unwrap-numeric(Option.None: Option[Int])\nWRITE unwrap-numeric(Result.Ok(4.5))\n\n; ============================================================================\n; Fallible without explicit inner type (unconstrained)\n; ============================================================================\n\n; When inner type is unconstrained, it's inferred\nFUN is-present[F: Fallible](x: F) -> Bool {\n  IF x IS Option.Some(_) {\n    true\n  } ELSE {\n    IF x IS Result.Ok(_) {\n      true\n    } ELSE {\n      false\n    }\n  }\n}\n\nWRITE is-present(Option.Some(1))\nWRITE is-present(Option.None)\nWRITE is-present(Result.Ok(\"x\"))\nWRITE is-present(Result.Err(\"e\"))\n"
---
