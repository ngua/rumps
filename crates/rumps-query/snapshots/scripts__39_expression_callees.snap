source: crates/rumps-query/tests/scripts.rs
description: "; Test: Expression-Based Callees and Type Checking\n; Tests function calls where the callee is an expression (not just an identifier)\n\n; === Chained calls (currying pattern) ===\n\nfun make-adder (n) {\n  x => x + n\n}\n\nfun make-multiplier (n) {\n  x => x * n\n}\n\n; === Higher-order functions ===\n\nfun apply (f, x) {\n  f(x)\n}\n\nfun square (x) {\n  x * x\n}\n\n; === Function composition ===\n\nfun compose (f, g) {\n  x => f(g(x))\n}\n\nfun double (x) { x * 2 }\nfun inc (x) { x + 1 }\n\n; === Typed functions with valid calls ===\n\nfun add-typed (a: Int, b: Int) -> Int {\n  a + b\n}\n\nfun greet (name: String) -> String {\n  \"Hello, {name}!\"\n}\n\n; === Higher-order with typed parameters ===\n\nfun apply-twice (f: (Int) -> Int, x: Int) -> Int {\n  f(f(x))\n}\n\n; === Functions returning functions with types ===\n\nfun make-scaler (n: Int) -> (Int) -> Int {\n  x => x * n\n}\n\nfun chain-a (x) { x + 1 }\nfun chain-b (x) { x * 2 }\nfun chain-c (x) { x - 3 }\n\n; === Factorial via currying ===\n\nfun make-factorial () {\n  fun fact (n) {\n    if n <= 1 { 1 } else { n * fact(n - 1) }\n  }\n  fact\n}\n\nfun main() {\n  let add5 = make-adder(5)\n  write add5(10)\n  ; Expected: 15\n\n  write make-adder(100)(42)\n  ; Expected: 142\n\n  write make-multiplier(2)(7)\n  ; Expected: 14\n\n  ; === IIFE (Immediately Invoked Function Expression) ===\n\n  write (x => x * 2)(21)\n  ; Expected: 42\n\n  write ((a, b) => a + b)(10, 32)\n  ; Expected: 42\n\n  ; IIFE with captured variable\n  let factor = 10\n  write (x => x * factor)(5)\n  ; Expected: 50\n\n  write apply(x => x + 1, 41)\n  ; Expected: 42\n\n  write apply(square, 6)\n  ; Expected: 36\n\n  let double-then-inc = compose(inc, double)\n  write double-then-inc(20)\n  ; Expected: 41 (double(20)=40, inc(40)=41)\n\n  let inc-then-double = compose(double, inc)\n  write inc-then-double(20)\n  ; Expected: 42 (inc(20)=21, double(21)=42)\n\n  write add-typed(10, 32)\n  ; Expected: 42\n\n  write greet(\"World\")\n  ; Expected: Hello, World!\n\n  write apply-twice(x => x + 1, 40)\n  ; Expected: 42\n\n  write apply-twice(x => x * 2, 5)\n  ; Expected: 20\n\n  let triple = make-scaler(3)\n  write triple(14)\n  ; Expected: 42\n\n  write make-scaler(7)(6)\n  ; Expected: 42\n\n  ; === Complex nested calls ===\n\n  write make-multiplier(2)(make-adder(3)(4))\n  ; Expected: 14 (add3(4)=7, mult2(7)=14)\n\n  write chain-c(chain-b(chain-a(10)))\n  ; Expected: 19 ((10+1)*2-3 = 22-3 = 19)\n\n  ; === Passing named functions to higher-order functions ===\n\n  write apply(double, 21)\n  ; Expected: 42\n\n  write apply(inc, 41)\n  ; Expected: 42\n\n  write apply-twice(double, 3)\n  ; Expected: 12 (double(3)=6, double(6)=12)\n\n  write apply-twice(inc, 40)\n  ; Expected: 42\n\n  ; === Closure capturing multiple variables ===\n\n  let a = 10\n  let b = 20\n  let sum-with-ab = x => x + a + b\n  write sum-with-ab(12)\n  ; Expected: 42\n\n  let factorial = make-factorial()\n  write factorial(5)\n  ; Expected: 120\n\n  ; === Object field closures ===\n\n  let ops = { inc: x => x + 1, mul: x => x * 2 }\n  write ops.inc(5)\n  ; Expected: 6\n\n  write ops.mul(21)\n  ; Expected: 42\n\n  ; Nullary closure in object\n  let counter = { value: () => 42 }\n  write counter.value()\n  ; Expected: 42\n\n  ; Chained object field calls\n  let math = {\n    add: (a, b) => a + b,\n    sq: x => x * x\n  }\n  write math.sq(math.add(3, 4))\n  ; Expected: 49 (3+4=7, 7*7=49)\n\n  write \"Expression callees test complete\"\n}\n"
