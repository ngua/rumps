; Test: Spread subscript type errors
; Spreading non-Array[Subscript] should produce type errors

fun main() {
  ; Error: spreading a non-array
  let num = 42
  let v1 = @get data{...num}

  ; Error: spreading an array of wrong element type
  let units: Array[Unit] = [Unit, Unit]
  let v2 = @get data{...units}
}
