fun main() {
  ; Unwrappable unwrap and Coalescable fallback
  write Option.Some(42)!
  write Option.None ?? "fallback"

  ; Wrappable: wrap
  write :display(?99)
  let w = Wrappable[Option[Int]]:wrap
  write :display(w(7))

  ; Chainable: chain
  write :display(Chainable:chain(Option.Some(10), x => ?x))

  ; Generic with Chainable (implies Wrappable + Unwrappable)
  let id = [T, F: Chainable](x: F[T]) -> T => x!
  write id(Option.Some(1))
}
