source: crates/rumps-query/tests/scripts.rs
description: "fun main() {\n  ; Unwrappable unwrap and Coalescable fallback\n  write Option.Some(42)!\n  write Option.None ?? \"fallback\"\n\n  ; Wrappable: wrap\n  write :display(?99)\n  let w = Wrappable[Option[Int]]:wrap\n  write :display(w(7))\n\n  ; Chainable: chain\n  write :display(Chainable:chain(Option.Some(10), x => ?x))\n\n  ; Generic with Chainable (implies Wrappable + Unwrappable)\n  let id = [T, F: Chainable](x: F[T]) -> T => x!\n  write id(Option.Some(1))\n}\n"
---
42
fallback
Option.Some(99)
