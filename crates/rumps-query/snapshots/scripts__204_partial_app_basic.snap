---
source: crates/rumps-query/tests/scripts.rs
description: "; Transparent partial function application\n; Calling a function with fewer args than its arity produces a new\n; function that accepts the remaining args.\n\nfun add (a: Int, b: Int) -> Int {\n  a + b\n}\n\nfun add3 (a: Int, b: Int, c: Int) -> Int {\n  a + b + c\n}\n\nfun main() {\n  ; Binary function partially applied, bound to a name\n  let add5 = add(5)\n  write add5(10)\n  ; Expected: 15\n\n  write add5(0)\n  ; Expected: 5\n\n  ; Chain call syntax; `f(a)(b)` directly\n  write add(5)(10)\n  ; Expected: 15\n\n  ; 3-arg function: `f(1)(2)(3)`\n  write add3(1)(2)(3)\n  ; Expected: 6\n\n  ; 3-arg function: `f(1)(2, 3)`\n  write add3(1)(2, 3)\n  ; Expected: 6\n\n  ; 3-arg function: `f(1, 2)(3)`\n  write add3(1, 2)(3)\n  ; Expected: 6\n\n  ; Full application still works\n  write add(2, 3)\n  ; Expected: 5\n  write add3(1, 2, 3)\n  ; Expected: 6\n\n  ; Partial app produces a first-class value that can be stored\n  let p = add3(1, 2)\n  write p(100)\n  ; Expected: 103\n\n  ; Intermediate partial stored and passed along\n  let p1 = add3(1)\n  let p2 = p1(2)\n  write p2(3)\n  ; Expected: 6\n\n  ; Partial application of a closure\n  let g = (a: Int, b: Int) => a * 10 + b\n  let g5 = g(5)\n  write g5(3)\n  ; Expected: 53\n\n  write g(5)(3)\n  ; Expected: 53\n}\n"
---
15
5
