; Test: indentation-based expression continuation
; Expressions continue across newlines when indented

; === Basic continuation ===

LET x = 1
  + 2
$OUTPUT x
; Expected: 3

LET y = 10
  - 3
  - 2
$OUTPUT y
; Expected: 5

; === Multi-operator continuation ===

LET sum = 1
  + 2
  + 3
  + 4
$OUTPUT sum
; Expected: 10

; === Mixed operators with precedence ===

LET expr = 1
  + 2
  * 3
$OUTPUT expr
; Expected: 7 (1 + (2 * 3))

LET expr2 = 2
  * 3
  + 4
$OUTPUT expr2
; Expected: 10 ((2 * 3) + 4)

; === Comparison continuation ===

LET cmp = 10
  > 5
$OUTPUT cmp
; Expected: true

; === Logical continuation ===

LET logic = TRUE
  AND TRUE
  AND FALSE
$OUTPUT logic
; Expected: false

; === String concat continuation ===

LET msg = "Hello"
  ++ " "
  ++ "World"
$OUTPUT msg
; Expected: Hello World

; === Continuation does NOT apply inside delimiters ===

; Arrays can have newlines freely
LET arr = [
  1,
  2,
  3
]
$OUTPUT arr[0]
; Expected: 1

; Objects can have newlines freely
LET obj = {
  a: 1,
  b: 2
}
$OUTPUT obj.a
; Expected: 1

; Blocks use braces, not indentation
LET blk = {
  LET inner = 5
  inner * 2
}
$OUTPUT blk
; Expected: 10

; === Continuation ends at dedent ===

LET a = 1
  + 2
LET b = 3
$OUTPUT a + b
; Expected: 6

$OUTPUT "Indent continuation test complete"
