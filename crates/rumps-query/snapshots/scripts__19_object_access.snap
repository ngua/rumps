---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: object field access\n; Tests dot notation for objects (bracket notation is for arrays/maps only)\n\nLET obj = { name: \"Alice\", age: 30, active: TRUE }\n\n; Dot notation\nOUTPUT obj.name\n; Expected: Alice\n\nOUTPUT obj.age\n; Expected: 30\n\nOUTPUT obj.active\n; Expected: TRUE\n\n; Nested object access (dot notation)\nLET rec = {\n  user: {\n    profile: {\n      first-name: \"Bob\",\n      last-name: \"Smith\"\n    },\n    scores: [90, 85, 95]\n  }\n}\n\nOUTPUT rec.user.profile.first-name\n; Expected: Bob\n\nOUTPUT rec.user.profile.last-name\n; Expected: Smith\n\nOUTPUT rec.user.scores[0]\n; Expected: 90\n\nOUTPUT rec.user.scores[-1]\n; Expected: 95\n\n; Object with dashed keys (valid RUMPS identifiers)\nLET special = { my-key: \"value1\", another-key: \"value2\" }\nOUTPUT special.my-key\n; Expected: value1\n\nOUTPUT special.another-key\n; Expected: value2\n\nOUTPUT \"Object access test complete\"\n"
---
"Alice"
30
TRUE
"Bob"
"Smith"
90
95
"value1"
"value2"
"Object access test complete"
