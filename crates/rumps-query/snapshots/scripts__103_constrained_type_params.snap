---
source: crates/rumps-query/tests/scripts.rs
description: "; Test constrained type parameters\n; Syntax: [T: Constraint1 + Constraint2]\n\nfun main() {\n  write add-numeric(1, 2)       ; 3\n  write add-numeric(1.5, 2.5)   ; 4.0\n\n  write to-str(42)        ; \"42\"\n  write to-str(true)      ; \"true\"\n\n  write to-json({a: 1, b: 2}) as String   ; {\"a\":1,\"b\":2}\n\n  ; ============================================================================\n  ; Multiple constraints\n  ; ============================================================================\n\n  write numeric-to-str(21)    ; \"42\"\n  write numeric-to-str(1.5)   ; \"3\"\n\n  ; ============================================================================\n  ; Mixed constrained and unconstrained\n  ; ============================================================================\n\n  let (n, s) = pair-numeric(21, \"hello\")\n  write n    ; 42\n  write s    ; \"hello\"\n\n  ; ============================================================================\n  ; Closures with constraints\n  ; ============================================================================\n\n  ; Closure with constrained type parameter; works with ANY Numeric type\n  let double = [T: Numeric](x: T) -> T => x + x\n\n  write double(10)    ; 20\n  write double(1.5)   ; 3.0\n\n  write apply-numeric(double, 5)   ; 10\n\n  ; ============================================================================\n  ; Into[Subscript] constraint\n  ; ============================================================================\n\n  write format-key(42)        ; \"42\"\n  write format-key(\"foo\")     ; \"foo\"\n  write format-key(true)      ; \"true\"\n\n  ; ============================================================================\n  ; Into[Storable] constraint\n  ; ============================================================================\n\n  write identity-storable(42)       ; 42\n  write identity-storable(\"hello\")  ; \"hello\"\n  write identity-storable(true)     ; true\n\n  ; ============================================================================\n  ; Iterable constraint with element type\n  ; ============================================================================\n\n  write sum-all([1, 2, 3, 4, 5])     ; 15\n  write sum-all(1 .. 4)             ; 6 (1+2+3)\n}\n\n; ============================================================================\n; Basic constrained functions\n; ============================================================================\n\n; Numeric constraint: `T` must be `Int` or `Float`\nfun add-numeric[T: Numeric](a: T, b: T) -> T {\n  a + b\n}\n\n; Into constraint: `T` can be converted to `String`\nfun to-str[T: Into[String]](x: T) -> String {\n  x as String\n}\n\n; Into constraint: `T` can be serialized to `Json`\nfun to-json[T: Into[Json]](x: T) -> Json {\n  x as Json\n}\n\n; Multiple constraints with `+`\nfun numeric-to-str[T: Numeric + Into[String]](x: T) -> String {\n  (x + x) as String\n}\n\n; Mix of constrained and unconstrained type parameters\nfun pair-numeric[T: Numeric, U](x: T, y: U) -> (T, U) {\n  (x + x, y)\n}\n\n; Higher-order function taking a constrained closure\nfun apply-numeric[T: Numeric](f: (T) -> T, x: T) -> T {\n  f(x)\n}\n\n; Into[Subscript] + Into[String]: key type for DB subscripts, displayable\nfun format-key[K: Into[Subscript] + Into[String]](k: K) -> String {\n  k as String\n}\n\n; Into[Storable]: type can be stored in the database\nfun identity-storable[V: Into[Storable]](v: V) -> V {\n  v\n}\n\n; Iterable: type must be Array or Range (HKT constraint)\nfun sum-all[T: Numeric, C: Iterable](coll: C[T]) -> T {\n  Foldable:reduce((acc, x) => acc + x, 0, coll)\n}\n"
