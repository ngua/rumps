source: crates/rumps-query/tests/scripts.rs
description: "; Union-typed array tests\n;\n; Tests for bidirectional type checking of array literals with union element types.\n; When an array literal has an annotation like `Array[Subscript]`, it should not\n; fall back to json for heterogeneous elements; instead, each element is checked\n; against the union type.\n\nfun main() {\n  ; === Comparison: without vs with annotation ===\n\n  ; WITHOUT annotation: heterogeneous array becomes Json\n  let json-arr = [1, \"a\", true]\n  write json-arr is Json\n\n  ; with annotation: stays as native Array (not Json)\n  let sub-arr: Array[Subscript] = [1, \"a\", true]\n  write sub-arr is Json\n  write Iterable:length(sub-arr)\n\n  ; === Named union: Subscript ===\n\n  let subscript-arr: Array[Subscript] = [42, \"hello\", 3.14, 'x', true]\n  write Iterable:length(subscript-arr)\n\n  ; === Named union: Storable ===\n\n  let storable-arr: Array[Storable] = [true, 42, 3.14, 'x', \"str\"]\n  write Iterable:length(storable-arr)\n\n  ; === Named union: Scalar ===\n\n  let scalar-arr: Array[Scalar] = [true, 42, 3.14, \"str\"]\n  write Iterable:length(scalar-arr)\n\n  ; === Anonymous union ===\n\n  let anon-arr: Array[Int | String] = [42, \"hello\", 99, \"world\"]\n  write Iterable:length(anon-arr)\n\n  ; === User-defined union ===\n\n  let ids: Array[Id] = [1, \"abc\", 2, \"def\"]\n  write Iterable:length(ids)\n\n  ; === Empty array with union element type ===\n\n  let empty: Array[Int | String] = []\n  write Iterable:length(empty)\n\n  ; === Spread in union arrays ===\n\n  let ints = [1, 2, 3]\n  let strs: Array[String] = [\"a\", \"b\"]\n\n  ; Spread homogeneous arrays into union array\n  let combined: Array[Int | String] = [...ints, \"x\", ...strs, 4]\n  write Iterable:length(combined)\n\n  ; === Iteration over union array ===\n\n  let arr: Array[Int | String] = [1, \"two\", 3, \"four\"]\n\n  ; foreach works on union arrays\n  foreach(x => {\n    match x {\n      n is Int => { write \"int: {n}\" }\n      s is String => { write \"str: {s}\" }\n      _ => { write \"other\" }\n    }\n  }, arr)\n\n  ; Mappable:map with union elements\n  let mapped = Mappable:map(x => {\n    match x {\n      n is Int => { n * 2 }\n      s is String => { String.length(s) }\n      _ => { 0 }\n    }\n  }, arr)\n  write :display(mapped)\n\n  ; === Verify elements preserve their concrete types ===\n\n  ; Use Filterable:filter to extract Int elements\n  let ints-only = Filterable:filter(x => x is Int, arr)\n  write Iterable:length(ints-only)\n\n  ; Use Filterable:filter to extract String elements\n  let strs-only = Filterable:filter(x => x is String, arr)\n  write Iterable:length(strs-only)\n}\n\nunion Id = Int | String\n"
