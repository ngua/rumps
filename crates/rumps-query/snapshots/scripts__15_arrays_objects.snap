---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: arrays and objects\n; Tests array and object literals, indexing, and field access\n\n; Array literal\nLET arr = [1, 2, 3, 4, 5]\nOUTPUT arr\n; Expected: [1, 2, 3, 4, 5]\n\n; Empty array\nLET empty = []\nOUTPUT empty\n; Expected: []\n\n; Array indexing\nLET nums = [10, 20, 30]\nOUTPUT nums[0]\n; Expected: 10\n\nOUTPUT nums[1]\n; Expected: 20\n\nOUTPUT nums[2]\n; Expected: 30\n\n; Object literal\nLET obj = { name: \"Alice\", age: 30 }\nOUTPUT obj\n; Expected: { name: \"Alice\", age: 30 }\n\n; Empty object\nLET empty-obj = {}\nOUTPUT empty-obj\n; Expected: {}\n\n; Field access with dot notation\nLET person = { name: \"Bob\", age: 25, active: TRUE }\nOUTPUT person.name\n; Expected: Bob\n\nOUTPUT person.age\n; Expected: 25\n\nOUTPUT person.active\n; Expected: true\n\n; Nested objects\nLET nested = {\n  user: {\n    name: \"Charlie\",\n    address: {\n      city: \"NYC\",\n      zip: \"10001\"\n    }\n  }\n}\nOUTPUT nested.user.name\n; Expected: Charlie\n\nOUTPUT nested.user.address.city\n; Expected: NYC\n\n; Object with array value\nLET rec = {\n  items: [1, 2, 3],\n  count: 3\n}\nOUTPUT rec.items\n; Expected: [1, 2, 3]\n\nOUTPUT rec.items[0]\n; Expected: 1\n\n; Array of objects\nLET users = [\n  { name: \"Alice\", score: 100 },\n  { name: \"Bob\", score: 85 }\n]\nOUTPUT users[0].name\n; Expected: Alice\n\nOUTPUT users[1].score\n; Expected: 85\n\nOUTPUT \"Arrays/Objects test complete\"\n"
---
[ 1, 2, 3, 4, 5 ]
[  ]
10
20
30
{ name: "Alice", age: 30 }
{  }
"Bob"
25
TRUE
"Charlie"
"NYC"
[ 1, 2, 3 ]
1
"Alice"
85
"Arrays/Objects test complete"
