; Test: Named Functions (fun)
; Tests function definition, calls, recursion, and first-class functions

; === Simple untyped function ===

fun double (x) {
  x * 2
}

; === Function with multiple parameters ===

fun add (a, b) {
  a + b
}

; === Typed function ===

fun square (x: Int) -> Int {
  x * x
}

; === Nullary function ===

fun greeting () {
  "Hello, World!"
}

; === Function returning computed value ===

fun hypotenuse (a: Int, b: Int) -> Float {
  (a ** 2 + b ** 2) ** 0.5
}

; === Recursive function ===

fun factorial (n) {
  if n <= 1 { 1 } else { n * factorial(n - 1) }
}

; === Recursive Fibonacci ===

fun fib (n) {
  if n <= 1 { n } else { fib(n - 1) + fib(n - 2) }
}

; === Function as first-class value ===

fun triple (x) {
  x * 3
}

; === Multiple functions ===

fun inc (x) { x + 1 }
fun dec (x) { x - 1 }

; === Function with local state ===

fun compute (a, b, c) {
  let temp = a + b
  temp * c
}

; === Function shadowing parameter ===

fun shadow-test (x) {
  let x = 100
  x
}

fun main() {
  write double(21)
  ; Expected: 42

  write double(0)
  ; Expected: 0

  write add(10, 32)
  ; Expected: 42

  write square(7)
  ; Expected: 49

  write square(0)
  ; Expected: 0

  write greeting()
  ; Expected: Hello, World!

  write hypotenuse(3, 4)
  ; Expected: 5

  write factorial(0)
  ; Expected: 1

  write factorial(1)
  ; Expected: 1

  write factorial(5)
  ; Expected: 120

  write factorial(10)
  ; Expected: 3628800

  write fib(0)
  ; Expected: 0

  write fib(1)
  ; Expected: 1

  write fib(10)
  ; Expected: 55

  let f = triple
  write f(14)
  ; Expected: 42

  write inc(5)
  ; Expected: 6

  write dec(5)
  ; Expected: 4

  write compute(2, 3, 4)
  ; Expected: 20

  ; === Nested function calls ===

  write square(double(3))
  ; Expected: 36 (double(3)=6, square(6)=36)

  write double(square(3))
  ; Expected: 18 (square(3)=9, double(9)=18)

  write add(double(5), triple(3))
  ; Expected: 19 (double(5)=10, triple(3)=9)

  write shadow-test(42)
  ; Expected: 100

  write "Named functions test complete"
}
