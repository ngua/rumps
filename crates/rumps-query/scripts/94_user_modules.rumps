; User-defined modules
; Tests MODULE definition, functions, constants, and nested modules
; Uses `+` prefix for public members; members without `+` are private

; ============ Basic module with functions ============

MODULE Counter {
  +FUN new() -> Int { 0 }
  +FUN inc(x: Int) -> Int { x + 1 }
  +FUN add(x: Int, y: Int) -> Int { x + y }
}

LET c = Counter.new()
WRITE c  ; 0

LET c1 = Counter.inc(c)
WRITE c1  ; 1

LET c2 = Counter.add(c1, 10)
WRITE c2  ; 11

; ============ Module with constants ============

MODULE Config {
  +LET max-size = 1000
  +LET default-name = "unnamed"
  +LET ratio = 3.14
}

WRITE Config.max-size  ; 1000
WRITE Config.default-name  ; unnamed
WRITE Config.ratio > 3.0  ; true

; Use constants in expressions
LET scaled = Config.max-size * 2
WRITE scaled  ; 2000

; ============ Module with both functions and constants ============

MODULE Geometry {
  +LET pi = 3.14159

  +FUN area(r: Float) -> Float {
    Geometry.pi * r * r
  }

  +FUN circumference(r: Float) -> Float {
    2.0 * Geometry.pi * r
  }
}

WRITE Geometry.pi > 3.0  ; true

LET a = Geometry.area(2.0)
WRITE a > 12.0  ; true

LET circ = Geometry.circumference(1.0)
WRITE circ > 6.0  ; true

; ============ Nested modules ============

MODULE Outer {
  +LET val = 100

  +FUN value() -> Int { Outer.val }

  MODULE Inner {
    +LET secret = 42

    +FUN get-secret() -> Int { Outer.Inner.secret }
    +FUN combined() -> Int { Outer.val + Outer.Inner.secret }
  }
}

WRITE Outer.val  ; 100
WRITE Outer.value()  ; 100
WRITE Outer.Inner.secret  ; 42
WRITE Outer.Inner.get-secret()  ; 42
WRITE Outer.Inner.combined()  ; 142

; ============ Generic functions in modules ============

MODULE Utils {
  +FUN identity[T](x: T) -> T { x }
  +FUN pair[A, B](a: A, b: B) -> (A, B) { (a, b) }
}

LET id-int = Utils.identity(42)
WRITE id-int  ; 42

LET id-str = Utils.identity("hello")
WRITE id-str  ; hello

LET p = Utils.pair(1, "one")
WRITE p  ; (1, one)

; ============ Module function as value ============

LET inc-fn = Counter.inc
LET result = inc-fn(5)
WRITE result  ; 6

; ============ Module with closures ============

MODULE Adder {
  +FUN make(n: Int) -> (Int) -> Int {
    x => x + n
  }
}

LET add5 = Adder.make(5)
WRITE add5(10)  ; 15

LET add10 = Adder.make(10)
WRITE add10(7)  ; 17

; ============ Monomorphic higher-order functions ============

MODULE MonoHof {
  +FUN apply(f: (Int) -> Int, x: Int) -> Int {
    f(x)
  }

  +FUN map-twice(f: (Int) -> Int, x: Int) -> Int {
    f(f(x))
  }
}

WRITE MonoHof.apply(n => n + 1, 5)  ; 6
WRITE MonoHof.map-twice(n => n * 2, 3)  ; 12

; ============ Polymorphic higher-order functions ============

MODULE PolyHof {
  +FUN apply[T, U](f: (T) -> U, x: T) -> U {
    f(x)
  }

  +FUN compose[A, B, C](f: (B) -> C, g: (A) -> B, x: A) -> C {
    f(g(x))
  }
}

; Int -> Int
WRITE PolyHof.apply(n => n + 1, 5)  ; 6

; Int -> String
WRITE PolyHof.apply(n => "num: {n}", 42)  ; num: 42

; String -> Int
WRITE PolyHof.apply(s => String.length(s), "hello")  ; 5

; Compose: Int -> Int -> String
WRITE PolyHof.compose(n => "result: {n}", x => x * 2, 10)  ; result: 20

; ============ Module with TYPE definitions ============

MODULE Shapes {
  +TYPE Shape = Circle(Float) | Rectangle(Float, Float)

  +FUN area(s: Shapes.Shape) -> Float {
    MATCH s {
      Shapes.Shape.Circle(r) => 3.14159 * r * r
      Shapes.Shape.Rectangle(w, h) => w * h
    }
  }

  +FUN describe(s: Shapes.Shape) -> String {
    MATCH s {
      Shapes.Shape.Circle(_) => "circle"
      Shapes.Shape.Rectangle(_, _) => "rectangle"
    }
  }
}

LET c = Shapes.Shape.Circle(2.0)
LET r = Shapes.Shape.Rectangle(3.0, 4.0)

WRITE Shapes.describe(c)  ; circle
WRITE Shapes.describe(r)  ; rectangle
WRITE Shapes.area(c) > 12.0  ; true (approx 12.56)
WRITE Shapes.area(r) > 11.0  ; true (12.0)

; ============ Module with NEWTYPE ============

MODULE Users {
  +NEWTYPE User = { name: String, age: Int }

  +FUN greet(u: Users.User) -> String {
    "Hello, {u.name}"
  }

  +FUN is-adult(u: Users.User) -> Bool {
    u.age >= 18
  }
}

LET u: Users.User = { name: "Alice", age: 30 }
WRITE Users.greet(u)  ; Hello, Alice
WRITE Users.is-adult(u)  ; true

LET child: Users.User = { name: "Bob", age: 10 }
WRITE Users.is-adult(child)  ; false

; ============ Module with UNION definition ============

MODULE Data {
  +UNION Primitive = Bool | Int | Float | String

  +FUN stringify(p: Data.Primitive) -> String {
    p as String
  }
}

LET i: Data.Primitive = 42
LET s: Data.Primitive = "hello"
WRITE Data.stringify(i)  ; 42
WRITE Data.stringify(s)  ; hello

; ============ Nested module with types ============

MODULE Outer2 {
  MODULE Inner2 {
    +TYPE Status = Active | Inactive

    +FUN is-active(s: Outer2.Inner2.Status) -> Bool {
      MATCH s {
        Outer2.Inner2.Status.Active => true
        Outer2.Inner2.Status.Inactive => false
      }
    }
  }
}

LET active = Outer2.Inner2.Status.Active
LET inactive = Outer2.Inner2.Status.Inactive
WRITE Outer2.Inner2.is-active(active)  ; true
WRITE Outer2.Inner2.is-active(inactive)  ; false

; ============ Generic type in module ============

MODULE Container {
  +TYPE Box[T] = Wrapped(T) | Empty

  +FUN unwrap-or[T](b: Container.Box[T], default: T) -> T {
    MATCH b {
      Container.Box.Wrapped(v) => v
      Container.Box.Empty => default
    }
  }
}

LET box-int = Container.Box.Wrapped(42)
LET empty-box = Container.Box.Empty
WRITE Container.unwrap-or(box-int, 0)  ; 42
WRITE Container.unwrap-or(empty-box, 99)  ; 99
