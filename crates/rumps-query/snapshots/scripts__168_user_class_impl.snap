---
source: crates/rumps-query/tests/scripts.rs
description: "; User-defined class instance tests\n;\n; Tests class ... for ... syntax for implementing builtin classes\n; on user-defined types (type, newtype, union).\n;\n; All types and class instances are defined at the BOTTOM to test hoisting.\n\nfun main() {\n  ; === Usage (hoisted) ===\n\n  ; type with Display\n  let p1 = Point.Point(10, 20)\n  let p2 = Point.Origin\n  write Display:display(p1)\n  write Display:display(p2)\n\n  ; type with Into[String]\n  let uid = UserId.UserId(42)\n  write Into:into(uid)\n\n  ; Builtin Int with Into[UserId] (convert builtin to user type)\n  let id-from-int = Into:into(99)\n  write id-from-int\n\n  ; newtype with Display\n  let my-age: Age = 30\n  write Display:display(my-age)\n\n  ; newtype with Numeric (delegates to underlying Int)\n  let a: MyInt = 10\n  let b: MyInt = 3\n  write \"add: {Numeric:add(a, b)}\"\n  write \"sub: {Numeric:sub(a, b)}\"\n  write \"mul: {Numeric:mul(a, b)}\"\n  write \"floor-div: {Numeric:floor-div(a, b)}\"\n  write \"mod: {Numeric:mod(a, b)}\"\n  write \"pow: {Numeric:pow(a, b)}\"\n\n  ; newtype with Ord (reversed comparison)\n  let low: Priority = 10\n  let high: Priority = 1\n  write \"compare(10, 1) = {Ord:compare(low, high)}\"\n  write \"compare(1, 10) = {Ord:compare(high, low)}\"\n  let same1: Priority = 5\n  let same2: Priority = 5\n  write \"compare(5, 5) = {Ord:compare(same1, same2)}\"\n\n  ; union with Display\n  let soi1: StrOrInt = \"hello\"\n  let soi2: StrOrInt = 42\n  write Display:display(soi1)\n  write Display:display(soi2)\n\n  ; type with constrained Display\n  let pair1 = Pair.Pair(1, 2)\n  let pair2 = Pair.Pair(\"hello\", \"world\")\n  let pair3 = Pair.Pair(true, false)\n  write Display:display(pair1)\n  write Display:display(pair2)\n  write Display:display(pair3)\n}\n\n; === Type and Class Definitions ===\n\nvariant Point = Point(Int, Int) | Origin\n\nclass Display for Point {\n  fun display(p: Point) -> String {\n    match p {\n      Point.Point(x, y) => { \"Point({x}, {y})\" }\n      Point.Origin => { \"Origin\" }\n    }\n  }\n}\n\nvariant UserId = UserId(Int)\n\nclass Into[String] for UserId {\n  fun into(u: UserId) -> String {\n    match u {\n      UserId.UserId(id) => { \"user:{id}\" }\n    }\n  }\n}\n\n; Into[UserId] for builtin Int: convert Int to UserId\nclass Into[UserId] for Int {\n  fun into(n: Int) -> UserId {\n    UserId.UserId(n)\n  }\n}\n\nnewtype Age = Int\n\nclass Display for Age {\n  fun display(a: Age) -> String {\n    \"{a} years old\"\n  }\n}\n\nnewtype MyInt = Int\n\nclass Numeric for MyInt {\n  fun add(a: MyInt, b: MyInt) -> MyInt { a + b }\n  fun sub(a: MyInt, b: MyInt) -> MyInt { a - b }\n  fun mul(a: MyInt, b: MyInt) -> MyInt { a * b }\n  fun floor-div(a: MyInt, b: MyInt) -> MyInt { a // b }\n  fun mod(a: MyInt, b: MyInt) -> MyInt { a % b }\n  fun pow(a: MyInt, b: MyInt) -> MyInt { a ** b }\n}\n\nnewtype Priority = Int\n\nclass Ord for Priority {\n  fun compare(a: Priority, b: Priority) -> Ordering {\n    ; Reversed: higher number = lower priority\n    if a > b { Ordering.Lt } else {\n      if a == b { Ordering.Eq } else { Ordering.Gt }\n    }\n  }\n}\n\nunion StrOrInt = String | Int\n\nclass Display for StrOrInt {\n  fun display(v: StrOrInt) -> String {\n    match v {\n      s is String => { \"str({s})\" }\n      n is Int => { \"int({n})\" }\n      _ => { \"unknown\" }\n    }\n  }\n}\n\nvariant Pair[L, R] = Pair(L, R)\n\nclass Display for Pair[L, R] where L: Display, R: Display {\n  fun display(p: Pair[L, R]) -> String {\n    match p {\n      Pair.Pair(l, r) => {\n        let ls = Display:display(l)\n        let rs = Display:display(r)\n        \"Pair({ls}, {rs})\"\n      }\n    }\n  }\n}\n"
---
"Point(10, 20)"
"Origin"
"user:42"
UserId.UserId(99)
"30 years old"
"add: 13"
"sub: 7"
"mul: 30"
"floor-div: 3"
"mod: 1"
"pow: 1000"
"compare(10, 1) = Ordering.Lt"
"compare(1, 10) = Ordering.Gt"
"compare(5, 5) = Ordering.Eq"
"str(hello)"
"int(42)"
"Pair(1, 2)"
"Pair("hello", "world")"
"Pair(true, false)"
