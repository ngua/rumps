; Module scoping test
; Tests that functions can reference sibling constants and functions
; in both inline and file-imported modules

; Import module from file (path relative to script directory)
module MyMath from "../modules/lib/mymath.rumps"

fun main() {
  write Geometry.pi > 3.0  ; true
  write Geometry.circle-area(1.0) > 3.0  ; true (pi * 1 * 1 = pi)
  write Geometry.circle-circumference(1.0) > 6.0  ; true (tau * 1 = tau)
  write Geometry.double-area(1.0) > 6.0  ; true (2 * pi)

  ; ============ File-imported module with sibling references ============

  write MyMath.pi > 3.0  ; true
  write MyMath.area(1.0) > 3.0  ; true (pi * 1 * 1 = pi)
  write MyMath.area(2.0) > 12.0  ; true (pi * 4 = ~12.56)

  ; ============ Both inline and imported in same script ============

  let inline-area = Geometry.circle-area(2.0)
  let file-area = MyMath.area(2.0)

  ; Both should compute pi * 4 = ~12.56636
  write inline-area > 12.0
  write file-area > 12.0

  ; They should be equal (both use pi * r * r)
  let diff = inline-area - file-area
  write diff < 0.0001
  write diff > -0.0001
}

; ============ Inline module with sibling references ============

module Geometry {
  +let pi = 3.14159
  +let tau = 6.28318

  ; Function referencing sibling constant
  +fun circle-area(r: Float) -> Float { pi * r * r }

  ; Function referencing sibling constant
  +fun circle-circumference(r: Float) -> Float { tau * r }

  ; Function referencing sibling function (mutual recursion base case)
  +fun double-area(r: Float) -> Float { 2.0 * circle-area(r) }
}
