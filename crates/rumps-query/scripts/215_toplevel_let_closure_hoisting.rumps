; Top-level LET closure hoisting: forward references to closures
; bound via LET should behave like forward references to FUNs,
; including independent instantiation at multiple types.

fun main() {
  write id(42)
  write id("hello")

  write twice(3)

  write inc(10)
}

let id = [T](x: T) -> T => x
let twice = [T: Additive](x: T) -> T => x + x
let inc = (x: Int) -> Int => x + 1
