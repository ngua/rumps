source: crates/rumps-query/tests/scripts.rs
description: "; Nested module types tests\n;\n; Tests that types in nested modules can be accessed without full qualification\n; from child modules (looking up the module chain).\n;\n; Also tests that imported types work in function signatures.\n\nimport Outer.{ Id }\nimport Outer.Inner.{ }\n\nfun main() {\n  ; ============ Child module accesses parent module types ============\n\n  let id: Outer.Id = Outer.Inner.make-id(42)\n  write Outer.Inner.id-value(id)\n\n  ; ============ Imported type in function signature ============\n\n  write double-id(21)\n\n  ; ============ Deeply nested modules ============\n\n  let s1 = A.Status.Active\n  write A.B.is-active(s1)\n  let s2 = A.B.C.toggle(s1)\n  write A.B.is-active(s2)\n\n  ; ============ newtype lookup through module chain ============\n\n  let score: Root.Score = 100\n  let mult: Root.Level1.Multiplier = 1.5\n  write Root.Level1.Level2.compute(score, mult)\n\n  ; ============ union lookup through module chain ============\n\n  let v1: Config.Value = 42\n  let v2: Config.Value = \"hello\"\n  write Config.Parser.is-int(v1)\n  write Config.Parser.is-int(v2)\n\n  ; ============ type with variants in nested module ============\n\n  let box1 = Container.Box.Full(10)\n  let box2: Container.Box[Int] = Container.Box.Empty\n  write Container.Ops.is-full(box1)\n  write Container.Ops.is-full(box2)\n  let mapped = Container.Ops.map(box1, (x: Int) => x * 2)\n  write :display(mapped)\n\n  ; ============ Multiple types at different levels ============\n\n  let a: Multi.A = 123\n  let b: Multi.Sub1.B = \"test\"\n  write Multi.Sub1.Sub2.combine(a, b)\n}\n\nmodule Outer {\n  #(transparent)\n  +newtype Id = +Int\n\n  ; Inner module can use `Id` without `Outer.` prefix\n  module Inner {\n    +fun make-id(n: Int) -> Id { n }\n    +fun id-value(i: Id) -> Int { i }\n  }\n}\n\n; Function using imported type `Id` (imported from Outer.{ Id })\nfun double-id(i: Id) -> Id { i * 2 }\n\nmodule A {\n  +variant Status = Active | Inactive\n\n  module B {\n    ; Can access A.Status as just `Status`\n    +fun is-active(s: Status) -> Bool {\n      match s {\n        Status.Active => { true }\n        Status.Inactive => { false }\n      }\n    }\n\n    module C {\n      ; Can still access A.Status as just `Status`\n      +fun toggle(s: Status) -> Status {\n        match s {\n          Status.Active => { Status.Inactive }\n          Status.Inactive => { Status.Active }\n        }\n      }\n    }\n  }\n}\n\nmodule Root {\n  #(transparent)\n  +newtype Score = +Int\n\n  module Level1 {\n    #(transparent)\n    +newtype Multiplier = +Float\n\n    module Level2 {\n      ; Can access both Score and Multiplier without full qualification\n      ; Newtypes are the underlying type, so direct arithmetic works\n      +fun compute(s: Score, m: Multiplier) -> Float {\n        (s: Int as Float) * m\n      }\n    }\n  }\n}\n\nmodule Config {\n  +union Value = Int | String | Bool\n\n  module Parser {\n    +fun is-int(v: Value) -> Bool {\n      v is Int\n    }\n  }\n}\n\nmodule Container {\n  #(deriving: Display)\n  +variant Box[T] = Full(T) | Empty\n\n  module Ops {\n    ; Can use `Box` without `Container.` prefix\n    +fun is-full[T](b: Box[T]) -> Bool {\n      match b {\n        Box.Full(_) => { true }\n        Box.Empty => { false }\n      }\n    }\n\n    +fun map[A, B](b: Box[A], f: (A) -> B) -> Box[B] {\n      match b {\n        Box.Full(v) => { Box.Full(f(v)) }\n        Box.Empty => { Box.Empty }\n      }\n    }\n  }\n}\n\nmodule Multi {\n  #(transparent)\n  +newtype A = +Int\n\n  module Sub1 {\n    #(transparent)\n    +newtype B = +String\n\n    module Sub2 {\n      ; Can access both A and B\n      +fun combine(a: A, b: B) -> String {\n        \"{a}: {b}\"\n      }\n    }\n  }\n}\n"
