variant Box[T] = Full(T) | Empty
newtype Bag[T] = Array[T]
union Flex = Array[Int] | Bag[Int]
newtype Join = String

class Foldable for Box {
  fun fold(f, init, x) {
    match x {
      Box.Full(v) => { f(init, v) }
      Box.Empty => { init }
    }
  }

  fun fold-map[T, U: Default + Concatable](f: (T) -> U, x: Box[T]) -> U {
    Foldable:fold(
      (acc, v) => Concatable:concat(acc, f(v)),
      Default:default(),
      x,
    )
  }
}

class Default for Join {
  fun default() -> Join {
    ""
  }
}

class Concatable for Join {
  fun concat(a: Join, b: Join) -> Join {
    let sa: String = a
    let sb: String = b
    if sa == "" { b } else {
      if sb == "" { a } else { "{sa},{sb}" as Join }
    }
  }
}

fun main() {
  write Foldable:fold-map(x => "{x}", [1, 2, 3])

  let empty: Array[Int] = []
  let empty-str: String = Foldable:fold-map(x => "{x}", empty)
  write empty-str

  write Foldable:fold-map(x => [x, x * 10], [1, 2, 3])
  write [1, 2, 3] |> Foldable:fold-map(x => [x])
  write :fold-map(x => "{x}", [4, 5])

  write Foldable:fold-map(x => "{x}", Box.Full(42))
  let box-empty: Box[Int] = Box.Empty
  let box-empty-str: String = Foldable:fold-map(x => "{x}", box-empty)
  write box-empty-str

  let b: Bag[Int] = [1, 2, 3]
  write Foldable:fold-map(x => "{x}", b)

  let fa: Flex = [4, 5]
  write Foldable:fold-map(x => "{x}", fa)

  let fb: Flex = b
  write Foldable:fold-map(x => "{x}", fb)

  let joined: Join = Foldable:fold-map(x => "{x}" as Join, [1, 2, 3])
  write joined as String
}
