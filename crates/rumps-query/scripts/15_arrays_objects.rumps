; Test: arrays and objects
; Tests array and object literals, indexing, and field access

fun main() {
  ; Array literal
  let arr = [1, 2, 3, 4, 5]
  write arr
  ; Expected: [1, 2, 3, 4, 5]

  ; Empty array
  let empty = []
  write empty
  ; Expected: []

  ; Array indexing
  let nums = [10, 20, 30]
  write nums[0]
  ; Expected: 10

  write nums[1]
  ; Expected: 20

  write nums[2]
  ; Expected: 30

  ; Object literal
  let obj = { name: "Alice", age: 30 }
  write obj
  ; Expected: { name: "Alice", age: 30 }

  ; Empty object
  let empty-obj = {}
  write empty-obj
  ; Expected: {}

  ; Field access with dot notation
  let person = { name: "Bob", age: 25, active: true }
  write person.name
  ; Expected: Bob

  write person.age
  ; Expected: 25

  write person.active
  ; Expected: true

  ; Nested objects
  let nested = {
    user: {
      name: "Charlie",
      address: {
        city: "NYC",
        zip: "10001"
      }
    }
  }
  write nested.user.name
  ; Expected: Charlie

  write nested.user.address.city
  ; Expected: NYC

  ; Object with array value
  let rec = {
    items: [1, 2, 3],
    count: 3
  }
  write rec.items
  ; Expected: [1, 2, 3]

  write rec.items[0]
  ; Expected: 1

  ; Array of objects
  let users = [
    { name: "Alice", score: 100 },
    { name: "Bob", score: 85 }
  ]
  write users[0].name
  ; Expected: Alice

  write users[1].score
  ; Expected: 85

  write "Arrays/Objects test complete"
}
