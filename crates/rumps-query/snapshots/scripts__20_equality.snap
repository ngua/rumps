source: crates/rumps-query/tests/scripts.rs
description: "; Test: equality for complex types\n; Tests structural equality for arrays, objects, and tagged values\n\n; === Array Equality ===\n\nLET a1 = [1, 2, 3]\nLET a2 = [1, 2, 3]\nLET a3 = [1, 2, 4]\nLET a4 = [1, 2]\n\nWRITE a1 == a2\n; Expected: true (same elements)\n\nWRITE a1 == a3\n; Expected: false (different last element)\n\nWRITE a1 == a4\n; Expected: false (different length)\n\nWRITE a1 != a3\n; Expected: true\n\n; Empty arrays\nLET empty1 = []\nLET empty2 = []\nWRITE empty1 == empty2\n; Expected: true\n\n; Nested arrays\nLET nested1 = [[1, 2], [3, 4]]\nLET nested2 = [[1, 2], [3, 4]]\nLET nested3 = [[1, 2], [3, 5]]\n\nWRITE nested1 == nested2\n; Expected: true\n\nWRITE nested1 == nested3\n; Expected: false\n\n; === Object Equality ===\n\nLET o1 = { a: 1, b: 2 }\nLET o2 = { a: 1, b: 2 }\nLET o3 = { a: 1, b: 3 }\nLET o4 = { a: 1 }\n\nWRITE o1 == o2\n; Expected: true (same keys and values)\n\nWRITE o1 == o3\n; Expected: false (different value)\n\nWRITE o1 == o4\n; Expected: false (different keys)\n\nWRITE o1 != o3\n; Expected: true\n\n; Empty objects\nLET empty-obj-a = {}\nLET empty-obj-b = {}\nWRITE empty-obj-a == empty-obj-b\n; Expected: true\n\n; Nested objects\nLET no1 = { outer: { inner: 42 } }\nLET no2 = { outer: { inner: 42 } }\nLET no3 = { outer: { inner: 99 } }\n\nWRITE no1 == no2\n; Expected: true\n\nWRITE no1 == no3\n; Expected: false\n\n; Objects with arrays\nLET oa1 = { items: [1, 2, 3] }\nLET oa2 = { items: [1, 2, 3] }\nLET oa3 = { items: [1, 2, 4] }\n\nWRITE oa1 == oa2\n; Expected: true\n\nWRITE oa1 == oa3\n; Expected: false\n\n; === Same-type Equality ===\n\nWRITE 5 == 5\n; Expected: true (same type comparison)\n\nWRITE 5.0 == 5.0\n; Expected: true (same type comparison)\n\nWRITE [1, 2, 3] == [1, 2, 3]\n; Expected: true\n\nWRITE { x: 5 } == { x: 5 }\n; Expected: true\n\nWRITE \"Equality test complete\"\n"
