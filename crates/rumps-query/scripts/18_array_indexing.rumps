; Test: array indexing (including negative)
; Tests array index access with positive and negative indices

fun main() {
  let arr = [10, 20, 30, 40, 50]

  ; Positive indexing (0-based)
  write arr[0]
  ; Expected: 10

  write arr[1]
  ; Expected: 20

  write arr[2]
  ; Expected: 30

  write arr[3]
  ; Expected: 40

  write arr[4]
  ; Expected: 50

  ; Negative indexing (from end)
  write arr[-1]
  ; Expected: 50 (last element)

  write arr[-2]
  ; Expected: 40 (second to last)

  write arr[-3]
  ; Expected: 30

  write arr[-4]
  ; Expected: 20

  write arr[-5]
  ; Expected: 10 (first element via negative)

  ; Index with expression
  let idx = 2
  write arr[idx]
  ; Expected: 30

  let neg-idx = -1
  write arr[neg-idx]
  ; Expected: 50

  ; Index with arithmetic
  write arr[1 + 1]
  ; Expected: 30 (arr[2])

  write arr[5 - 3]
  ; Expected: 30 (arr[2])

  ; Nested array indexing
  let matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
  write matrix[0][0]
  ; Expected: 1

  write matrix[1][1]
  ; Expected: 5

  write matrix[2][2]
  ; Expected: 9

  write matrix[-1][-1]
  ; Expected: 9 (last row, last col)

  write matrix[0][-1]
  ; Expected: 3 (first row, last col)

  ; Single element array
  let single = [42]
  write single[0]
  ; Expected: 42

  write single[-1]
  ; Expected: 42

  write "Array indexing test complete"
}
