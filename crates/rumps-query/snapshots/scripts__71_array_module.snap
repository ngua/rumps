---
source: crates/rumps-query/tests/scripts.rs
description: "; Array module functions\n; Tests Array.map, Array.filter, Array.reduce, Array.foreach\n\n; Array.map with closure\nLET nums = [1, 2, 3, 4, 5]\nLET doubled = Array.map(x => x * 2, nums)\n@OUTPUT doubled  ; [2, 4, 6, 8, 10]\n\n; Array.map on empty array\nLET empty = []\nLET mapped-empty = Array.map(x => x + 1, empty)\n@OUTPUT mapped-empty  ; []\n\n; Array.map with named function\nFUN square (n: Int) -> Int { n * n }\nLET squares = Array.map(square, [1, 2, 3])\n@OUTPUT squares  ; [1, 4, 9]\n\n; Array.filter with closure\nLET evens = Array.filter(x => x % 2 == 0, nums)\n@OUTPUT evens  ; [2, 4]\n\n; Array.filter on empty array\nLET filtered-empty = Array.filter(x => x > 0, empty)\n@OUTPUT filtered-empty  ; []\n\n; Array.filter with named function\nFUN is-positive (n: Int) -> Bool { n > 0 }\nLET positives = Array.filter(is-positive, [-1, 0, 1, 2])\n@OUTPUT positives  ; [1, 2]\n\n; Array.filter keeping all\nLET all-kept = Array.filter(x => TRUE, [1, 2, 3])\n@OUTPUT all-kept  ; [1, 2, 3]\n\n; Array.filter keeping none\nLET none-kept = Array.filter(x => FALSE, [1, 2, 3])\n@OUTPUT none-kept  ; []\n\n; Array.reduce with sum\nLET sum = Array.reduce((acc, x) => acc + x, 0, nums)\n@OUTPUT sum  ; 15\n\n; Array.reduce on empty array returns initial value\nLET empty-sum = Array.reduce((acc, x) => acc + x, 100, empty)\n@OUTPUT empty-sum  ; 100\n\n; Array.reduce with string concatenation\nLET words = [\"hello\", \" \", \"world\"]\nLET combined = Array.reduce((acc, s) => acc ++ s, \"\", words)\n@OUTPUT combined  ; \"hello world\"\n\n; Array.reduce with named function\nFUN add (a: Int, b: Int) -> Int { a + b }\nLET total = Array.reduce(add, 0, [1, 2, 3, 4])\n@OUTPUT total  ; 10\n\n; Combining Array functions\nLET result = Array.reduce(\n  (acc, x) => acc + x,\n  0,\n  Array.map(x => x * x, Array.filter(x => x % 2 == 1, [1, 2, 3, 4, 5]))\n)\n@OUTPUT result  ; 1 + 9 + 25 = 35\n\n; Pipeline usage with Array functions (using wrapper closures)\nLET piped = [1, 2, 3, 4, 5]\n  |> (arr => Array.filter(x => x > 2, arr))\n  |> (arr => Array.map(x => x * 10, arr))\n@OUTPUT piped  ; [30, 40, 50]\n\n; Module functions can be passed as first-class values\nLET filter-fn = Array.filter\nLET data = [1, 2, 3, 4, 5]\nLET filtered = filter-fn(x => x > 2, data)\n@OUTPUT filtered  ; [3, 4, 5]\n\n; Array.map with Option results (homogeneous tagged values)\nLET with-opts = Array.map(x => Option.Some(x), [1, 2, 3])\n@OUTPUT with-opts  ; [Option.Some(1), Option.Some(2), Option.Some(3)]\n\n; Nested Array.map (callback uses Array function)\nLET nested = [[1, 2], [3, 4]]\nLET doubled-nested = Array.map(arr => Array.map(x => x * 2, arr), nested)\n@OUTPUT doubled-nested  ; [[2, 4], [6, 8]]\n\n; === Array.foreach ===\n\n; Array.foreach for side effects (outputs each element)\n@OUTPUT \"foreach:\"\nLET fe-result = Array.foreach(x => { @OUTPUT x }, [10, 20, 30])\n@OUTPUT fe-result  ; Unit\n\n; Array.foreach on empty array (no side effects)\nLET fe-empty = Array.foreach(x => { @OUTPUT x }, [])\n@OUTPUT fe-empty  ; Unit\n\n; Array.foreach with range\n@OUTPUT \"range foreach:\"\nLET fe-range = Array.foreach(n => { @OUTPUT n }, 1 .. 4)\n@OUTPUT fe-range  ; Unit\n\n; === Array.zip ===\n\nLET a = [1, 2, 3]\nLET b = [\"a\", \"b\", \"c\"]\nLET zipped = Array.zip(a, b)\n@OUTPUT zipped\n\n; Shorter array determines length\nLET short = [1, 2]\nLET long = [\"a\", \"b\", \"c\", \"d\"]\n@OUTPUT Array.zip(short, long)\n\n; === Array.unzip ===\n\nLET pairs: Array[(Int, String)] = [(1, \"one\"), (2, \"two\"), (3, \"three\")]\nLET (unzip-nums, unzip-strs) = Array.unzip(pairs)\n@OUTPUT unzip-nums\n@OUTPUT unzip-strs\n\n; Round-trip\nLET x = [10, 20, 30]\nLET y = [true, false, true]\nLET (x2, y2) = Array.unzip(Array.zip(x, y))\n@OUTPUT x2\n@OUTPUT y2\n\n; === Array.intersperse ===\n\nLET inter-words = [\"hello\", \"world\", \"!\"]\n@OUTPUT Array.intersperse(\",\", inter-words)\n\nLET inter-nums = [1, 2, 3, 4]\n@OUTPUT Array.intersperse(0, inter-nums)\n\n; Empty array\nLET inter-empty: Array[Int] = []\n@OUTPUT Array.intersperse(0, inter-empty)\n\n; Single element\n@OUTPUT Array.intersperse(0, [42])\n\n; === Array.zip-with ===\n\nFUN zip-add(za: Int, zb: Int) -> Int { za + zb }\nLET xs = [1, 2, 3]\nLET ys = [10, 20, 30]\n@OUTPUT Array.zip-with(zip-add, xs, ys)\n\n; With closure\nLET multiplied = Array.zip-with((ma, mb) => ma * mb, [2, 3, 4], [5, 6, 7])\n@OUTPUT multiplied\n\n; With shorter array\n@OUTPUT Array.zip-with(zip-add, [1, 2, 3, 4, 5], [10, 20])\n\n; === Array.sort-by ===\n\nFUN cmp-int(ca: Int, cb: Int) -> Ordering {\n  IF ca < cb { Ordering.Lt } ELSE {\n    IF ca == cb { Ordering.Eq } ELSE { Ordering.Gt }\n  }\n}\n\nLET unsorted = [3, 1, 4, 1, 5, 9, 2, 6]\n@OUTPUT Array.sort-by(cmp-int, unsorted)\n\n; Sort descending (reverse comparator)\nFUN cmp-desc(da: Int, db: Int) -> Ordering {\n  IF da > db { Ordering.Lt } ELSE {\n    IF da == db { Ordering.Eq } ELSE { Ordering.Gt }\n  }\n}\n@OUTPUT Array.sort-by(cmp-desc, unsorted)\n\n; Sort by absolute value\nFUN cmp-abs(aa: Int, ab: Int) -> Ordering {\n  LET abs-a = IF aa < 0 { 0 - aa } ELSE { aa }\n  LET abs-b = IF ab < 0 { 0 - ab } ELSE { ab }\n  cmp-int(abs-a, abs-b)\n}\nLET signed = [-5, 3, -1, 4, -2]\n@OUTPUT Array.sort-by(cmp-abs, signed)\n\n; Sort objects by field\nTYPE SortPerson = { name: String, age: Int }\n\nFUN cmp-by-age(pa: SortPerson, pb: SortPerson) -> Ordering {\n  cmp-int(pa.age, pb.age)\n}\n\nLET people = [\n  { name: \"Alice\", age: 30 },\n  { name: \"Bob\", age: 25 },\n  { name: \"Carol\", age: 35 }\n]\nLET by-age = Array.sort-by(cmp-by-age, people)\n@OUTPUT Array.map(p => p.name, by-age)\n\n; === Chained operations ===\n\n; zip, map, filter chain\nLET indices = [0, 1, 2, 3, 4]\nLET values = [10, 25, 30, 15, 40]\nLET indexed = Array.zip(indices, values)\nLET chain-filtered = Array.filter(pair => pair.1 > 20, indexed)\n@OUTPUT chain-filtered\n\n; zip-with to compute differences\nLET before = [10, 20, 30]\nLET after = [15, 18, 35]\nLET diffs = Array.zip-with((db, da) => da - db, before, after)\n@OUTPUT diffs\n"
