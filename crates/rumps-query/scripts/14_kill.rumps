; Test: @kill statement
; Tests deletion of variables and subtrees

fun main() {
  ; Set up test data
  @set items{1} "one"
  @set items{2} "two"
  @set items{3} "three"
  @set items{1, "a"} "nested a"
  @set items{1, "b"} "nested b"

  ; Verify items exists
  let v1 = @get items{1}
  write :display(v1)
  ; Expected: one

  ; @kill single node
  @kill items{2}

  ; Verify deleted
  let v2 = @get items{2}
  write :display(v2)
  ; Expected: Option.None

  ; @kill subtree
  @kill items{1}

  ; Verify subtree deleted
  let v3 = @get items{1}
  write :display(v3)
  ; Expected: Option.None

  let v4 = @get items{1, "a"}
  write :display(v4)
  ; Expected: Option.None

  ; items{3} should still exist
  let v5 = @get items{3}
  write :display(v5)
  ; Expected: three

  ; @kill entire variable
  @set temp{} 999
  let before = @get temp{}
  write :display(before)
  ; Expected: 999

  @kill temp{}
  let after = @get temp{}
  write :display(after)
  ; Expected: Option.None

  write "@kill test complete"
}
