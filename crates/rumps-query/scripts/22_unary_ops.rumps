; Test: unary operators
; Tests negation and logical not

fun main() {
  ; === Numeric Negation ===

  ; Negate integer
  write -5
  ; Expected: -5

  write -0
  ; Expected: 0

  write -(-5)
  ; Expected: 5

  ; Negate float
  write -3.14
  ; Expected: -3.14

  write -0.0
  ; Expected: -0.0 (or 0.0)

  write -(-2.5)
  ; Expected: 2.5

  ; Negate variable
  let x = 42
  write -x
  ; Expected: -42

  let y = -10
  write -y
  ; Expected: 10

  ; Negate expression
  write -(5 + 3)
  ; Expected: -8

  write -(10 - 15)
  ; Expected: 5

  ; Negate in larger expression
  write 10 + -3
  ; Expected: 7

  write 10 - -5
  ; Expected: 15

  write -5 * 2
  ; Expected: -10

  write -5 * -2
  ; Expected: 10

  ; === Logical not ===

  write not true
  ; Expected: false

  write not false
  ; Expected: true

  write !true
  ; Expected: false

  write !false
  ; Expected: true

  ; not with variable
  let flag = true
  write not flag
  ; Expected: false

  write !flag
  ; Expected: false

  ; Double not
  write not not true
  ; Expected: true

  write !!false
  ; Expected: false

  ; not in expression
  write not (5 > 10)
  ; Expected: true

  write !(3 == 4)
  ; Expected: true

  ; not with and/or
  write not true and false
  ; Expected: false (not binds tighter: (not true) and false = false and false)

  write not (true and false)
  ; Expected: true (not applied to result: not false = true)

  write not false or true
  ; Expected: true ((not false) or true = true or true)

  write "Unary ops test complete"
}
