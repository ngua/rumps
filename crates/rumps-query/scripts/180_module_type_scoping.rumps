; Module type scoping tests
;
; Tests that type, newtype, and union declared in a module can be used
; without full qualification from within the same module.

; Import to bring class instances into scope
import Shapes.{ }

fun main() {
  ; ============ type variants with unqualified type names ============

  let c = Shapes.Circle.Circle(2.0)
  write Display:display(c)
  write Shapes.area(c)

  ; ============ newtype with unqualified type names ============

  let dist: Units.Meters = 10.0
  write Units.meters-to-feet(dist)
  write Units.double(dist)

  ; ============ union with unqualified type names ============

  let v1: Data.Value = 42
  let v2: Data.Value = "hello"
  let v3: Data.Value = true
  write Data.describe(v1)
  write Data.describe(v2)
  write Data.describe(v3)

  ; ============ type with type parameters unqualified ============

  let box1 = Container.Box.Box(42)
  let box2: Container.Box[Int] = Container.Box.Empty
  write Container.unwrap-or(box1, 0)
  write Container.unwrap-or(box2, -1)
  write Container.unwrap-or(Container.wrap(100), 0)

  ; ============ Mixed types in same module ============

  let id: Mixed.Id = 123
  let status = Mixed.Status.Done
  let payload: Mixed.Payload = "data"
  write Mixed.process(id, status, payload)
}

module Shapes {
  +variant Circle = Circle(Float)

  ; Use unqualified `Circle` in class declaration
  class Display for Circle {
    fun display(c: Circle) -> String {
      match c {
        Circle.Circle(r) => { "Circle(r={r})" }
      }
    }
  }

  ; Function using unqualified type in signature
  +fun area(c: Circle) -> Float {
    match c {
      Circle.Circle(r) => { 3.14159 * r * r }
    }
  }
}

module Units {
  +newtype Meters = +Float
  +newtype Feet = +Float

  ; Function using unqualified newtypes in signature
  +fun meters-to-feet(m: Meters) -> Feet {
    m * 3.28084
  }

  ; Function returning unqualified newtype
  +fun double(m: Meters) -> Meters {
    m * 2.0
  }
}

module Data {
  +union Value = Int | String | Bool

  ; Function using unqualified union in signature
  +fun describe(v: Value) -> String {
    if v is Int { "integer" } else {
      if v is String { "string" } else { "boolean" }
    }
  }
}

module Container {
  +variant Box[T] = Box(T) | Empty

  ; Function using unqualified parameterized type
  +fun unwrap-or[T](b: Box[T], default: T) -> T {
    match b {
      Box.Box(v) => { v }
      Box.Empty => { default }
    }
  }

  ; Function creating unqualified variant
  +fun wrap[T](v: T) -> Box[T] {
    Box.Box(v)
  }
}

module Mixed {
  +variant Status = Pending | Done
  +newtype Id = +Int
  +union Payload = Int | String

  ; Function using all three unqualified
  +fun process(id: Id, status: Status, payload: Payload) -> String {
    let s = match status {
      Status.Pending => { "pending" }
      Status.Done => { "done" }
    }
    let p = if payload is Int { "int" } else { "string" }
    "id={id}, status={s}, payload={p}"
  }
}
