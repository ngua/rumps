---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: Named Functions (fun)\n; Tests function definition, calls, recursion, and first-class functions\n\n; === Simple untyped function ===\n\nfun double (x) {\n  x * 2\n}\n\n; === Function with multiple parameters ===\n\nfun add (a, b) {\n  a + b\n}\n\n; === Typed function ===\n\nfun square (x: Int) -> Int {\n  x * x\n}\n\n; === Nullary function ===\n\nfun greeting () {\n  \"Hello, World!\"\n}\n\n; === Function returning computed value ===\n\nfun hypotenuse (a: Int, b: Int) -> Float {\n  (a ** 2 + b ** 2) ** 0.5\n}\n\n; === Recursive function ===\n\nfun factorial (n) {\n  if n <= 1 { 1 } else { n * factorial(n - 1) }\n}\n\n; === Recursive Fibonacci ===\n\nfun fib (n) {\n  if n <= 1 { n } else { fib(n - 1) + fib(n - 2) }\n}\n\n; === Function as first-class value ===\n\nfun triple (x) {\n  x * 3\n}\n\n; === Multiple functions ===\n\nfun inc (x) { x + 1 }\nfun dec (x) { x - 1 }\n\n; === Function with local state ===\n\nfun compute (a, b, c) {\n  let temp = a + b\n  temp * c\n}\n\n; === Function shadowing parameter ===\n\nfun shadow-test (x) {\n  let x = 100\n  x\n}\n\nfun main() {\n  write double(21)\n  ; Expected: 42\n\n  write double(0)\n  ; Expected: 0\n\n  write add(10, 32)\n  ; Expected: 42\n\n  write square(7)\n  ; Expected: 49\n\n  write square(0)\n  ; Expected: 0\n\n  write greeting()\n  ; Expected: Hello, World!\n\n  write hypotenuse(3, 4)\n  ; Expected: 5\n\n  write factorial(0)\n  ; Expected: 1\n\n  write factorial(1)\n  ; Expected: 1\n\n  write factorial(5)\n  ; Expected: 120\n\n  write factorial(10)\n  ; Expected: 3628800\n\n  write fib(0)\n  ; Expected: 0\n\n  write fib(1)\n  ; Expected: 1\n\n  write fib(10)\n  ; Expected: 55\n\n  let f = triple\n  write f(14)\n  ; Expected: 42\n\n  write inc(5)\n  ; Expected: 6\n\n  write dec(5)\n  ; Expected: 4\n\n  write compute(2, 3, 4)\n  ; Expected: 20\n\n  ; === Nested function calls ===\n\n  write square(double(3))\n  ; Expected: 36 (double(3)=6, square(6)=36)\n\n  write double(square(3))\n  ; Expected: 18 (square(3)=9, double(9)=18)\n\n  write add(double(5), triple(3))\n  ; Expected: 19 (double(5)=10, triple(3)=9)\n\n  write shadow-test(42)\n  ; Expected: 100\n\n  write \"Named functions test complete\"\n}\n"
---
