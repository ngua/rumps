---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: forever loop construct\n; Continuation-passing style loop with explicit state\n\nfun main() {\n  ; Basic: count to 5\n  let count = forever 1 (n, cont) => {\n    if n > 5 {\n      n - 1  ; return last valid value\n    } else {\n      cont(n + 1)\n    }\n  }\n  write count\n\n  ; Sum from 1 to 10\n  let sum = forever { acc: 0, i: 1 } (state, cont) => {\n    if state.i > 10 {\n      state.acc\n    } else {\n      cont({ acc: state.acc + state.i, i: state.i + 1 })\n    }\n  }\n  write sum\n\n  ; Factorial of 5\n  let factorial = forever { result: 1, n: 5 } (state, cont) => {\n    if state.n <= 1 {\n      state.result\n    } else {\n      cont({ result: state.result * state.n, n: state.n - 1 })\n    }\n  }\n  write factorial\n\n  ; Early exit based on condition\n  let early = forever 0 (n, cont) => {\n    if n == 3 {\n      \"stopped at 3\"\n    } else {\n      cont(n + 1)\n    }\n  }\n  write early\n\n  ; Collect even numbers from 0 to 10\n  let evens = forever { i: 0, acc: [] } (state, cont) => {\n    if state.i > 10 {\n      state.acc\n    } else {\n      if state.i % 2 == 0 {\n        cont({ i: state.i + 1, acc: Array.concat(state.acc, [state.i]) })\n      } else {\n        cont({ i: state.i + 1, acc: state.acc })\n      }\n    }\n  }\n  write evens\n\n  ; Using @order to iterate through subscripts\n  @set data{1} \"one\"\n  @set data{2} \"two\"\n  @set data{3} \"three\"\n  @set data{4} \"four\"\n\n  ; Collect keys using @order and forever\n  let keys = forever { key: @order data{}, acc: [] } (state, cont) => {\n    match state.key {\n      Option.None => state.acc\n      Option.Some(s) => {\n        let s = (s read Int)!\n        cont({\n          key: @order data{s},\n          acc: Array.concat(state.acc, [s])\n        })\n      }\n    }\n  }\n  write keys\n\n  ; Collect all values using @order\n  let vals = forever { key: @order data{}, acc: \"\" } (state, cont) => {\n    match state.key {\n      Option.None => state.acc\n      Option.Some(k) => {\n        let ki = (k read Int)!\n        let v = @get data{ki}!\n        cont({\n          key: @order data{ki},\n          acc: \"{state.acc}{v} \"\n        })\n      }\n    }\n  }\n  write vals\n\n  ; Large iteration count (previously caused stack overflow at ~100k)\n  let big = forever 0 (n, cont) => {\n    if n >= 200000 {\n      n\n    } else {\n      cont(n + 1)\n    }\n  }\n  write big\n\n  write \"forever test complete\"\n}\n"
