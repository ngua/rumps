---
source: crates/rumps-query/tests/scripts.rs
description: "; Union type tests\n\nUNION NumericId = Int | String\n\nFUN format-id(id: NumericId) -> String {\n  MATCH id {\n    n IS Int => { \"ID#{n}\" }\n    s IS String => { \"ID:{s}\" }\n    _ => { \"unknown\" }\n  }\n}\n\nFUN classify(v: Storable) -> String {\n  MATCH v {\n    n IS Int IF n > 100 => { \"large int\" }\n    n IS Int IF n > 0 => { \"positive int\" }\n    n IS Int => { \"non-positive int\" }\n    s IS String IF String.length(s) > 10 => { \"long string\" }\n    s IS String => { \"short string\" }\n    b IS Bool => { \"boolean\" }\n    _ => { \"other storable\" }\n  }\n}\n\nFUN describe-scalar(opt: Option[Scalar]) -> String {\n  MATCH opt {\n    Option.None => { \"missing\" }\n    Option.Some(s) => {\n      MATCH s {\n        v IS String => { \"string: {v}\" }\n        v IS Int => { \"int: {v}\" }\n        v IS Bool => { \"bool: {v}\" }\n        v IS Float => { \"float: {v}\" }\n        _ => { \"unknown scalar\" }\n      }\n    }\n  }\n}\n\nFUN get-id(use-int: Bool) -> Int | String {\n  IF use-int { 42 } ELSE { \"abc-123\" }\n}\n\nFUN get-storable(kind: Int) -> Storable {\n  MATCH kind {\n    0 => { true }\n    1 => { 42 }\n    2 => { 3.14 }\n    3 => { 'x' }\n    4 => { \"hello\" }\n    _ => { { \"json\": true } }\n  }\n}\n\nFUN get-scalar(kind: Int) -> Scalar {\n  MATCH kind {\n    0 => { true }\n    1 => { 42 }\n    2 => { 3.14 }\n    _ => { \"default\" }\n  }\n}\n\nFUN parse-id(s: String) -> NumericId {\n  LET as-int = s READ Int\n  MATCH as-int {\n    Result.Ok(n) => { n }\n    Result.Err(_) => { s }\n  }\n}\n\nFUN main() {\n  ; === Builtin unions: Storable and Scalar ===\n\n  ; Storable contains: Bool | Int | Float | Char | String | Json\n  ; Scalar contains: Bool | Int | Float | String\n\n  ; IS checks against Storable\n  LET b: Bool = true\n  LET i: Int = 42\n  LET f: Float = 3.14\n  LET c: Char = 'x'\n  LET s: String = \"hello\"\n\n  WRITE b IS Storable\n  WRITE i IS Storable\n  WRITE f IS Storable\n  WRITE c IS Storable\n  WRITE s IS Storable\n\n  ; Non-storables\n  LET arr = [1, 2, 3]\n  LET obj = { x: 1 }\n  LET tup = (1, 2)\n  WRITE arr IS Storable\n  WRITE obj IS Storable\n  WRITE tup IS Storable\n\n  ; IS checks against Scalar\n  WRITE b IS Scalar\n  WRITE i IS Scalar\n  WRITE f IS Scalar\n  WRITE s IS Scalar\n  WRITE c IS Scalar  ; Char is NOT Scalar\n\n  ; === AS cast for Storable (infallible) ===\n\n  LET int-val: Int = 100\n  LET storable-int = int-val AS Storable\n  WRITE storable-int IS Storable\n  WRITE storable-int IS Int\n\n  LET str-val: String = \"test\"\n  LET storable-str = str-val AS Storable\n  WRITE storable-str IS Storable\n  WRITE storable-str IS String\n\n  ; === User-defined unions ===\n\n  LET id1: Int = 123\n  LET id2: String = \"abc-456\"\n\n  WRITE id1 IS NumericId\n  WRITE id2 IS NumericId\n\n  ; Non-member\n  LET not-id: Float = 1.5\n  WRITE not-id IS NumericId\n\n  ; === Union type in function signatures ===\n\n  WRITE format-id(123)\n  WRITE format-id(\"xyz\")\n\n  ; === MATCH with IS patterns ===\n\n  LET val1 = 42\n  LET result1 = MATCH val1 {\n    n IS Int => { \"int: {n}\" }\n    s IS String => { \"str: {s}\" }\n    b IS Bool => { \"bool\" }\n    _ => { \"other\" }\n  }\n  WRITE result1\n\n  LET val2 = \"hello\"\n  LET result2 = MATCH val2 {\n    n IS Int => { \"int: {n}\" }\n    s IS String => { \"str: {s}\" }\n    b IS Bool => { \"bool\" }\n    _ => { \"other\" }\n  }\n  WRITE result2\n\n  LET val3 = true\n  LET result3 = MATCH val3 {\n    n IS Int => { \"int\" }\n    s IS String => { \"str\" }\n    b IS Bool => { \"bool: {b}\" }\n    _ => { \"other\" }\n  }\n  WRITE result3\n\n  ; === Inline union types ===\n\n  LET mixed: Int | String = 99\n  WRITE mixed IS Int\n  WRITE mixed IS String\n\n  LET mixed2: Int | String = \"foo\"\n  WRITE mixed2 IS Int\n  WRITE mixed2 IS String\n\n  ; === Complex match with guards ===\n\n  WRITE classify(500)\n  WRITE classify(50)\n  WRITE classify(0)\n  WRITE classify(\"hello world!!!\")\n  WRITE classify(\"hi\")\n  WRITE classify(true)\n  WRITE classify(3.14)\n\n  ; === JSON scalar extraction returns Option[Scalar] ===\n\n  LET data = { \"name\": \"Alice\", \"age\": 30, \"active\": true, \"score\": 3.14 }\n\n  ; ->> returns Option[Scalar]\n  LET name-opt = data->>(\"name\")\n  LET age-opt = data->>(\"age\")\n  LET active-opt = data->>(\"active\")\n  LET score-opt = data->>(\"score\")\n  LET missing-opt = data->>(\"missing\")\n\n  WRITE name-opt IS Option[_]\n  WRITE age-opt IS Option[_]\n  WRITE missing-opt IS Option.None\n\n  ; Unwrapped values are Scalar (the union type)\n  LET name-val = name-opt!\n  LET age-val = age-opt!\n  LET active-val = active-opt!\n  LET score-val = score-opt!\n\n  WRITE name-val IS Scalar\n  WRITE age-val IS Scalar\n  WRITE active-val IS Scalar\n  WRITE score-val IS Scalar\n\n  ; Can narrow Scalar with IS\n  WRITE name-val IS String\n  WRITE age-val IS Int\n  WRITE active-val IS Bool\n  WRITE score-val IS Float\n\n  ; === Type narrowing with MATCH on JSON scalars ===\n\n  WRITE describe-scalar(data->>(\"name\"))\n  WRITE describe-scalar(data->>(\"age\"))\n  WRITE describe-scalar(data->>(\"active\"))\n  WRITE describe-scalar(data->>(\"score\"))\n  WRITE describe-scalar(data->>(\"missing\"))\n\n  ; === Static field extraction with .. also returns Option[Scalar] ===\n\n  LET static-name = data..name\n  LET static-age = data..age\n\n  WRITE static-name IS Option[_]\n  WRITE static-name! IS Scalar\n  WRITE static-name! IS String\n\n  WRITE static-age IS Option[_]\n  WRITE static-age! IS Scalar\n  WRITE static-age! IS Int\n\n  ; === Returning union types from functions ===\n\n  LET id-int = get-id(true)\n  LET id-str = get-id(false)\n\n  WRITE id-int IS Int\n  WRITE id-int IS String\n  WRITE id-str IS Int\n  WRITE id-str IS String\n\n  ; Return Storable\n  WRITE get-storable(0) IS Bool\n  WRITE get-storable(1) IS Int\n  WRITE get-storable(2) IS Float\n  WRITE get-storable(3) IS Char\n  WRITE get-storable(4) IS String\n  WRITE get-storable(5) IS Json\n\n  ; Return Scalar\n  WRITE get-scalar(0) IS Bool\n  WRITE get-scalar(1) IS Int\n  WRITE get-scalar(2) IS Float\n  WRITE get-scalar(3) IS String\n\n  ; Return user-defined union\n  WRITE parse-id(\"123\") IS Int\n  WRITE parse-id(\"abc\") IS String\n}\n"
