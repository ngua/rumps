---
source: crates/rumps-query/tests/scripts.rs
description: "; Class method references with type arguments (turbofish syntax)\n\n; Monoid:identity with type parameter\nLET id-opt = Monoid[Option[Int]]:identity\nWRITE \"id-opt() = {id-opt()}\"\nWRITE \"direct call = {Monoid[Option[Int]]:identity()}\"\n\n; Monoid:identity reference without type arg (inferred from context)\nLET id-inferred = Monoid:identity\nWRITE \"inferred = {id-inferred() : Option[Int]}\"\n\n; Numeric with type parameter\nLET add-int = Numeric[Int]:add\nWRITE \"add-int(1, 2) = {add-int(1, 2)}\"\nWRITE \"direct = {Numeric[Float]:add(1.5, 2.5)}\"\n\n; Fallible:wrap with type parameter\nLET wrap-opt = Fallible[Option[Int]]:wrap\nWRITE \"wrap-opt(42) = {wrap-opt(42)}\"\n\nLET wrap-res = Fallible[Result[Int, String]]:wrap\nWRITE \"wrap-res(99) = {wrap-res(99)}\"\n\n; Use in higher-order functions\nLET nums = [1, 2, 3]\nLET opts = Mappable:map(wrap-opt, nums)\nWRITE \"mapped: {opts}\"\n\n; Into:into with type parameter\nLET to-string = Into[String]:into\nWRITE \"to-string(123) = {to-string(123)}\"\nWRITE \"to-string(3.14) = {to-string(3.14)}\"\n\n; TryInto:try-into with type parameter\nLET try-int = TryInto[Int]:try-into\nLET good = \"42\"\nLET bad = \"bad\"\nWRITE \"try-int(good) = {try-int(good)}\"\nWRITE \"try-int(bad) = {try-int(bad)}\"\n"
---
"id-opt() = Option.None"
"direct call = Option.None"
"inferred = Option.None"
"add-int(1, 2) = 3"
"direct = 4.0"
"wrap-opt(42) = Option.Some(42)"
"wrap-res(99) = Result.Ok(99)"
"mapped: [ Option.Some(1), Option.Some(2), Option.Some(3) ]"
"to-string(123) = 123"
"to-string(3.14) = 3.14"
"try-int(good) = Result.Ok(42)"
"try-int(bad) = Result.Err("invalid integer: bad")"
