; Math module for testing file imports
; This file contains functions and constants to be imported via MODULE M FROM "path"

+let pi = 3.14159
+let e = 2.71828

+fun square(x: Int) -> Int { x * x }

+fun double(x: Int) -> Int { x * 2 }

+fun is-positive(n: Int) -> Bool { n > 0 }

+fun area(r: Float) -> Float { pi * r * r }
