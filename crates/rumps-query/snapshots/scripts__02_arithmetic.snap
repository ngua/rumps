---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: parse and evaluate arithmetic\n; Tests arithmetic operators with correct precedence\n\n; Basic operations\nLET add = 10 + 5\nOUTPUT add\n; Expected: 15\n\nLET sub = 10 - 5\nOUTPUT sub\n; Expected: 5\n\nLET mul = 10 * 5\nOUTPUT mul\n; Expected: 50\n\nLET div = 10 / 4\nOUTPUT div\n; Expected: 2.5 (or 2 if integer division)\n\nLET intdiv = 10 // 4\nOUTPUT intdiv\n; Expected: 2\n\nLET modulo = 10 % 3\nOUTPUT modulo\n; Expected: 1\n\n; Precedence: mul/div before add/sub\nLET prec1 = 2 + 3 * 4\nOUTPUT prec1\n; Expected: 14 (not 20)\n\nLET prec2 = 10 - 6 / 2\nOUTPUT prec2\n; Expected: 7 (not 2)\n\n; Parentheses override precedence\nLET paren1 = (2 + 3) * 4\nOUTPUT paren1\n; Expected: 20\n\nLET paren2 = (10 - 6) / 2\nOUTPUT paren2\n; Expected: 2\n\n; Unary minus\nLET neg = -5\nOUTPUT neg\n; Expected: -5\n\nLET neg2 = 10 + -3\nOUTPUT neg2\n; Expected: 7\n\n; Nested operations\nLET complex = ((1 + 2) * (3 + 4)) / 7\nOUTPUT complex\n; Expected: 3\n\n; Float arithmetic\nLET f1 = 3.14 * 2.0\nOUTPUT f1\n; Expected: 6.28\n\nLET f2 = 10.0 / 4.0\nOUTPUT f2\n; Expected: 2.5\n\n; Mixed int/float\nLET mixed = 10 + 0.5\nOUTPUT mixed\n; Expected: 10.5\n\nOUTPUT \"Arithmetic test complete\"\n"
---
