; Three-function cycle where `c` has a body-derived `Additive`
; constraint. The constraint must propagate transitively through
; `b` to reach `a` via virtual edges in `enrich_finalized_schemes`.
; Calling `a("hello")` should be rejected.

fun a(x) {
  b(x)
}

fun b(x) {
  c(x)
}

fun c(x) {
  x + 1
}

fun main() {
  write a("hello")
}
