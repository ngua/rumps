; Destructuring bindings

; === Tuple destructuring ===

LET pair = (1, 2)
LET (a, b) = pair
OUTPUT a
OUTPUT b

; Nested tuple
LET nested = ((1, 2), (3, 4))
LET ((x1, y1), (x2, y2)) = nested
OUTPUT x1
OUTPUT y1
OUTPUT x2
OUTPUT y2

; === Object destructuring ===

LET person = { name: "Alice", age: 30 }
LET { name, age } = person
OUTPUT name
OUTPUT age

; Object with rename
LET point = { x: 10, y: 20 }
LET { x: px, y: py } = point
OUTPUT px
OUTPUT py

; === Array destructuring ===

LET arr = [1, 2, 3]
LET [first, second, third] = arr
OUTPUT first
OUTPUT second
OUTPUT third

; Array with rest (bind)
LET nums = [1, 2, 3, 4, 5]
LET [head, ...tail] = nums
OUTPUT head
OUTPUT tail

; Array with rest (ignore)
LET long = [10, 20, 30, 40, 50]
LET [first2, second2, ..] = long
OUTPUT first2
OUTPUT second2

; === Wildcard ===

LET triple = (100, 200, 300)
LET (keep, _, last) = triple
OUTPUT keep
OUTPUT last

; Wildcard discards entire value
LET _ = "discarded"
OUTPUT "wildcard works"

; === Mixed nesting ===

LET data = { coords: (10, 20), name: "origin" }
LET { coords: (cx, cy), name: label } = data
OUTPUT cx
OUTPUT cy
OUTPUT label

; === In expressions ===

LET result = {
  LET (x, y) = (5, 10)
  x + y
}
OUTPUT result

OUTPUT "Destructuring test complete"
