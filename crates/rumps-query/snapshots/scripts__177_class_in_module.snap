---
source: crates/rumps-query/tests/scripts.rs
description: "; CLASS implementations inside MODULE blocks\n;\n; Tests CLASS ... FOR ... syntax within user-defined modules.\n; Instances become available after importing the module.\n\n; All imports at top\nIMPORT Shapes.{ ... }\nIMPORT Prio.{ ... }\nIMPORT Nums.{ ... }\nIMPORT Container.{ ... }\nIMPORT Collections.{ ... }\nIMPORT EmptyImport.{ }\n\n; ============ Display CLASS in MODULE ============\n\nMODULE Shapes {\n  +TYPE Circle = Circle(Float)\n\n  CLASS Display FOR Shapes.Circle {\n    FUN display(c: Shapes.Circle) -> String {\n      MATCH c {\n        Shapes.Circle.Circle(r) => { \"Circle(r={r})\" }\n      }\n    }\n  }\n}\n\nLET c = Shapes.Circle.Circle(3.14)\nWRITE Display:display(c)\n\n; ============ Ord CLASS in MODULE ============\n\nMODULE Prio {\n  +NEWTYPE Priority = Int\n\n  ; Reversed ordering: higher number = lower priority\n  CLASS Ord FOR Prio.Priority {\n    FUN compare(a: Prio.Priority, b: Prio.Priority) -> Ordering {\n      IF a > b { Ordering.Lt } ELSE {\n        IF a == b { Ordering.Eq } ELSE { Ordering.Gt }\n      }\n    }\n  }\n}\n\nLET low: Prio.Priority = 10\nLET high: Prio.Priority = 1\nWRITE Ord:compare(low, high)\nWRITE Ord:compare(high, low)\nWRITE Ord:compare(low, low)\n\n; ============ Numeric CLASS in MODULE ============\n\nMODULE Nums {\n  +NEWTYPE MyInt = Int\n\n  CLASS Numeric FOR Nums.MyInt {\n    FUN add(a: Nums.MyInt, b: Nums.MyInt) -> Nums.MyInt { a + b }\n    FUN sub(a: Nums.MyInt, b: Nums.MyInt) -> Nums.MyInt { a - b }\n    FUN mul(a: Nums.MyInt, b: Nums.MyInt) -> Nums.MyInt { a * b }\n    FUN floor-div(a: Nums.MyInt, b: Nums.MyInt) -> Nums.MyInt { a // b }\n    FUN mod(a: Nums.MyInt, b: Nums.MyInt) -> Nums.MyInt { a % b }\n    FUN pow(a: Nums.MyInt, b: Nums.MyInt) -> Nums.MyInt { a ** b }\n  }\n}\n\nLET a: Nums.MyInt = 10\nLET b: Nums.MyInt = 3\nWRITE Numeric:add(a, b)\nWRITE Numeric:mul(a, b)\n\n; ============ Constrained type params in MODULE ============\n\nMODULE Container {\n  +TYPE Pair[L, R] = Pair(L, R)\n\n  CLASS Display FOR Container.Pair[L, R] WHERE L: Display, R: Display {\n    FUN display(p: Container.Pair[L, R]) -> String {\n      MATCH p {\n        Container.Pair.Pair(l, r) => {\n          LET ls = Display:display(l)\n          LET rs = Display:display(r)\n          \"Pair({ls}, {rs})\"\n        }\n      }\n    }\n  }\n}\n\nLET p1 = Container.Pair.Pair(1, 2)\nLET p2 = Container.Pair.Pair(\"hello\", \"world\")\nWRITE Display:display(p1)\nWRITE Display:display(p2)\n\n; ============ Indexable with associated type in MODULE ============\n\nMODULE Collections {\n  +TYPE IntArray = IntArray(Array[Int])\n\n  CLASS Indexable[Int] FOR Collections.IntArray {\n    NEWTYPE Index = Int\n\n    FUN index(arr: Collections.IntArray, i: Int) -> Int {\n      MATCH arr {\n        Collections.IntArray.IntArray(inner) => inner[i]\n      }\n    }\n\n    FUN get(arr: Collections.IntArray, i: Int) -> Option[Int] {\n      MATCH arr {\n        Collections.IntArray.IntArray(inner) => inner?[i]\n      }\n    }\n  }\n}\n\nLET arr = Collections.IntArray.IntArray([10, 20, 30])\nWRITE Indexable:get(arr, 1)\nWRITE Indexable:index(arr, 2)\n\n; ============ Empty import brings instance into scope ============\n\nMODULE EmptyImport {\n  +TYPE Thing = Thing(Int)\n\n  CLASS Display FOR EmptyImport.Thing {\n    FUN display(t: EmptyImport.Thing) -> String {\n      MATCH t {\n        EmptyImport.Thing.Thing(n) => { \"Thing({n})\" }\n      }\n    }\n  }\n}\n\nLET thing = EmptyImport.Thing.Thing(42)\nWRITE Display:display(thing)\n"
---
"Circle(r=3.14)"
Ordering.Lt
Ordering.Gt
Ordering.Eq
13
30
"Pair(1, 2)"
"Pair("hello", "world")"
Option.Some(20)
30
"Thing(42)"
