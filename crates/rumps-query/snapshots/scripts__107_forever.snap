---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: FOREVER loop construct\n; Continuation-passing style loop with explicit state\n\n; Basic: count to 5\nLET count = FOREVER 1 (n, cont) => {\n  IF n > 5 {\n    n - 1  ; return last valid value\n  } ELSE {\n    cont(n + 1)\n  }\n}\n@OUTPUT count\n\n; Sum from 1 to 10\nLET sum = FOREVER { acc: 0, i: 1 } (state, cont) => {\n  IF state.i > 10 {\n    state.acc\n  } ELSE {\n    cont({ acc: state.acc + state.i, i: state.i + 1 })\n  }\n}\n@OUTPUT sum\n\n; Factorial of 5\nLET factorial = FOREVER { result: 1, n: 5 } (state, cont) => {\n  IF state.n <= 1 {\n    state.result\n  } ELSE {\n    cont({ result: state.result * state.n, n: state.n - 1 })\n  }\n}\n@OUTPUT factorial\n\n; Early exit based on condition\nLET early = FOREVER 0 (n, cont) => {\n  IF n == 3 {\n    \"stopped at 3\"\n  } ELSE {\n    cont(n + 1)\n  }\n}\n@OUTPUT early\n\n; Collect even numbers from 0 to 10\nLET evens = FOREVER { i: 0, acc: [] } (state, cont) => {\n  IF state.i > 10 {\n    state.acc\n  } ELSE {\n    IF state.i % 2 == 0 {\n      cont({ i: state.i + 1, acc: Array.concat(state.acc, [state.i]) })\n    } ELSE {\n      cont({ i: state.i + 1, acc: state.acc })\n    }\n  }\n}\n@OUTPUT evens\n\n; Using @ORDER to iterate through subscripts\n@SET data(1) = \"one\"\n@SET data(2) = \"two\"\n@SET data(3) = \"three\"\n@SET data(4) = \"four\"\n\n; Collect keys using @ORDER and FOREVER\nLET keys = FOREVER { key: @ORDER data, acc: [] } (state, cont) => {\n  MATCH state.key {\n    Option.None => state.acc\n    Option.Some(s) => {\n      LET s = (s READ Int)!\n      cont({\n        key: @ORDER data(s),\n        acc: Array.concat(state.acc, [s])\n      })\n    }\n  }\n}\n@OUTPUT keys\n\n; Collect all values using @ORDER\nLET vals = FOREVER { key: @ORDER data, acc: \"\" } (state, cont) => {\n  MATCH state.key {\n    Option.None => state.acc\n    Option.Some(k) => {\n      LET ki = (k READ Int)!\n      LET v = (@GET data(ki))!\n      cont({\n        key: @ORDER data(ki),\n        acc: state.acc ++ v ++ \" \"\n      })\n    }\n  }\n}\n@OUTPUT vals\n\n; Large iteration count (previously caused stack overflow at ~100k)\nLET big = FOREVER 0 (n, cont) => {\n  IF n >= 200000 {\n    n\n  } ELSE {\n    cont(n + 1)\n  }\n}\n@OUTPUT big\n\n@OUTPUT \"FOREVER test complete\"\n"
---
