; Test: Nested structural types in various contexts
; Verifies that anonymous records with nested fields work everywhere

NEWTYPE Inner = { value: Int }
NEWTYPE Outer = { child: Inner }

FUN get-inner(obj: { inner: { val: Int } }) -> Int {
  obj.inner.val
}

FUN get-deep(obj: { a: { b: { c: String } } }) -> String {
  obj.a.b.c
}

FUN make-nested(x: Int) -> { outer: { inner: Int } } {
  { outer: { inner: x } }
}

FUN main() {
  ; ============================================================
  ; NESTED STRUCTURAL TYPES IN LET BINDINGS
  ; ============================================================

  LET simple: { a: Int } = { a: 1 }
  WRITE simple.a
  ; Expected: 1

  LET nested: { a: { b: Int } } = { a: { b: 10 } }
  WRITE nested.a.b
  ; Expected: 10

  LET deep: { x: { y: { z: String } } } = { x: { y: { z: "hello" } } }
  WRITE deep.x.y.z
  ; Expected: hello

  LET multi: { a: { b: Int }, c: { d: String } } = { a: { b: 1 }, c: { d: "two" } }
  WRITE multi.a.b
  ; Expected: 1
  WRITE multi.c.d
  ; Expected: two

  ; ============================================================
  ; NESTED STRUCTURAL TYPES IN IS PATTERNS
  ; ============================================================

  WRITE { a: 1 } IS { a: Int }
  ; Expected: TRUE

  WRITE { a: { b: 1 } } IS { a: { b: Int } }
  ; Expected: TRUE

  WRITE { a: { b: { c: 1 } } } IS { a: { b: { c: Int } } }
  ; Expected: TRUE

  ; Wrong inner type
  WRITE { a: { b: "hello" } } IS { a: { b: Int } }
  ; Expected: FALSE

  ; Missing inner field
  WRITE { a: { c: 1 } } IS { a: { b: Int } }
  ; Expected: FALSE

  ; Extra fields are OK (extensible records)
  WRITE { a: { b: 1, c: 2 } } IS { a: { b: Int } }
  ; Expected: TRUE

  ; ============================================================
  ; MIXED NESTED TYPES
  ; ============================================================

  LET mixed: { arr: Array[Int], nested: { x: Int } } = { arr: [1, 2, 3], nested: { x: 42 } }
  WRITE mixed.arr IS Array[_]
  ; Expected: TRUE
  WRITE mixed.nested.x
  ; Expected: 42

  ; ============================================================
  ; NESTED STRUCTURAL TYPES WITH OPTION
  ; ============================================================

  LET opt: Option[{ a: { b: Int } }] = Option.Some({ a: { b: 99 } })
  WRITE opt IS Option.Some(_)
  ; Expected: TRUE

  IF opt IS Option.Some(val) {
    WRITE val.a.b
  }
  ; Expected: 99

  ; ============================================================
  ; NESTED IN FUNCTION PARAMETERS
  ; ============================================================

  WRITE get-inner({ inner: { val: 777 } })
  ; Expected: 777

  WRITE get-deep({ a: { b: { c: "deep" } } })
  ; Expected: deep

  ; ============================================================
  ; NESTED IN FUNCTION RETURN TYPES
  ; ============================================================

  LET made = make-nested(123)
  WRITE made.outer.inner
  ; Expected: 123

  ; ============================================================
  ; COMBINED WITH NAMED STRUCT TYPES
  ; ============================================================

  LET named: Outer = { child: { value: 42 } }
  WRITE named.child.value
  ; Expected: 42

  ; Anonymous nested inside named
  LET hybrid: { wrapper: Inner } = { wrapper: { value: 55 } }
  WRITE hybrid.wrapper.value
  ; Expected: 55

  WRITE "Nested structural types test complete"
}
