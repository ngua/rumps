---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: Transaction modifiers\n; Tests ON CONFLICT, WITH TIMEOUT, WITH PRIORITY, WITH ISOLATION\n\n; === ON CONFLICT ABORT (default) ===\nLET r1 = TRANSACTION {\n    $SET ^data(1) = \"one\"\n} ON CONFLICT ABORT\n$OUTPUT r1 IS Result.Ok(_)\n\n; === ON CONFLICT SKIP ===\nLET r2 = TRANSACTION {\n    $SET ^data(2) = \"two\"\n} ON CONFLICT SKIP\n$OUTPUT r2 IS Result.Ok(_)\n\n; === ON CONFLICT OVERWRITE ===\nLET r3 = TRANSACTION {\n    $SET ^data(3) = \"three\"\n} ON CONFLICT OVERWRITE\n$OUTPUT r3 IS Result.Ok(_)\n\n; === ON CONFLICT RETRY n ===\nLET r4 = TRANSACTION {\n    $SET ^data(4) = \"four\"\n} ON CONFLICT RETRY 3\n$OUTPUT r4 IS Result.Ok(_)\n\n; === WITH TIMEOUT ===\nLET r5 = TRANSACTION {\n    $SET ^data(5) = \"five\"\n} WITH TIMEOUT 5000\n$OUTPUT r5 IS Result.Ok(_)\n\n; === WITH PRIORITY HIGH ===\nLET r6 = TRANSACTION {\n    $SET ^data(6) = \"six\"\n} WITH PRIORITY HIGH\n$OUTPUT r6 IS Result.Ok(_)\n\n; === WITH PRIORITY LOW ===\nLET r7 = TRANSACTION {\n    $SET ^data(7) = \"seven\"\n} WITH PRIORITY LOW\n$OUTPUT r7 IS Result.Ok(_)\n\n; === WITH PRIORITY NORMAL ===\nLET r8 = TRANSACTION {\n    $SET ^data(8) = \"eight\"\n} WITH PRIORITY NORMAL\n$OUTPUT r8 IS Result.Ok(_)\n\n; === WITH ISOLATION SNAPSHOT ===\nLET r9 = TRANSACTION {\n    $SET ^data(9) = \"nine\"\n} WITH ISOLATION SNAPSHOT\n$OUTPUT r9 IS Result.Ok(_)\n\n; === Combined modifiers ===\nLET r10 = TRANSACTION {\n    $SET ^data(10) = \"ten\"\n} ON CONFLICT RETRY 3 WITH TIMEOUT 5000 WITH PRIORITY HIGH\n$OUTPUT r10 IS Result.Ok(_)\n\n; === All modifiers ===\nLET r11 = TRANSACTION {\n    $SET ^data(11) = \"eleven\"\n} ON CONFLICT OVERWRITE WITH TIMEOUT 1000 WITH PRIORITY LOW WITH ISOLATION SNAPSHOT\n$OUTPUT r11 IS Result.Ok(_)\n\n; === Timeout from expression ===\nLET timeout-ms = 2000\nLET r12 = TRANSACTION {\n    $SET ^data(12) = \"twelve\"\n} WITH TIMEOUT timeout-ms\n$OUTPUT r12 IS Result.Ok(_)\n\n; === Case-insensitivity ===\nLET r13 = TRANSACTION {\n    $SET ^data(13) = \"thirteen\"\n} on conflict abort with timeout 1000\n$OUTPUT r13 IS Result.Ok(_)\n\nLET r14 = TRANSACTION {\n    $SET ^data(14) = \"fourteen\"\n} On Conflict Skip With Priority High\n$OUTPUT r14 IS Result.Ok(_)\n\n; === Contextual identifiers as variables ===\nLET on = \"on\"\nLET conflict = \"conflict\"\nLET timeout = 1000\nLET with = \"with\"\nLET priority = \"priority\"\nLET isolation = \"isolation\"\n$OUTPUT on ++ \" \" ++ conflict\n\n; Can use these as variable names and still use modifiers\nLET r15 = TRANSACTION {\n    $SET ^data(15) = on ++ conflict\n} WITH TIMEOUT timeout\n$OUTPUT r15 IS Result.Ok(_)\n$OUTPUT $GET ^data(15)\n\n$OUTPUT \"Transaction modifiers test complete\"\n"
---
