---
source: crates/rumps-query/tests/scripts.rs
description: "; Range operator tests\n; Tests exclusive (`..`) and inclusive (`..=`) ranges\n; NOTE: Range operators require spaces around `..` and `..=`\n\nFUN double(n: Int) -> Int { n * 2 }\n\nFUN main() {\n  ; Basic exclusive range display\n  LET r1 = 1 .. 5\n  WRITE r1  ; 1..5\n\n  ; Basic inclusive range display\n  LET r2 = 1 ..= 5\n  WRITE r2  ; 1..=5\n\n  ; Range with expressions: binds looser than additive\n  ; So `1 .. n + 1` parses as `1..(n + 1)`, not `(1..n) + 1`\n  LET n = 3\n  LET r3 = 0 .. n + 1\n  WRITE r3  ; 0..4\n\n  ; Collect range to array then map (Range is not Mappable)\n  LET squares = Mappable:map(x => x * x, Filterable:filter(x => true, 1 .. 4))\n  WRITE squares  ; [1, 4, 9]\n\n  ; Collect inclusive range to array then map\n  LET cubes = Mappable:map(x => x * x * x, Filterable:filter(x => true, 1 ..= 3))\n  WRITE cubes  ; [1, 8, 27]\n\n  ; Filterable:filter with range\n  LET evens = Filterable:filter(x => x % 2 == 0, 1 .. 10)\n  WRITE evens  ; [2, 4, 6, 8]\n\n  ; Filterable:filter with inclusive range\n  LET odd = Filterable:filter(x => x % 2 != 0, 1 ..= 5)\n  WRITE odd  ; [1, 3, 5]\n\n  ; Foldable:reduce with range (sum 1..5 = 1+2+3+4 = 10)\n  LET sum1 = Foldable:reduce((acc, x) => acc + x, 0, 1 .. 5)\n  WRITE sum1  ; 10\n\n  ; Foldable:reduce with inclusive range (sum 1..=5 = 1+2+3+4+5 = 15)\n  LET sum2 = Foldable:reduce((acc, x) => acc + x, 0, 1 ..= 5)\n  WRITE sum2  ; 15\n\n  ; Factorial using range and reduce\n  LET fact5 = Foldable:reduce((acc, x) => acc * x, 1, 1 ..= 5)\n  WRITE fact5  ; 120\n\n  ; Chaining operations with ranges\n  LET filtered = Filterable:filter(x => x > 2, 1 ..= 5)\n  LET result = Mappable:map(x => x * 10, filtered)\n  WRITE result  ; [30, 40, 50]\n\n  ; Empty range (start >= end for exclusive)\n  LET empty = Filterable:filter(x => true, 5 .. 5)\n  WRITE empty  ; []\n\n  ; Negative ranges\n  LET negatives = Filterable:filter(x => true, -3 .. 1)\n  WRITE negatives  ; [-3, -2, -1, 0]\n\n  ; Range with named function (collect first)\n  LET doubles = Mappable:map(double, Filterable:filter(x => true, 1 .. 5))\n  WRITE doubles  ; [2, 4, 6, 8]\n}\n"
---
1 .. 5
1 ..= 5
0 .. 4
[ 1, 4, 9 ]
[ 1, 8, 27 ]
[ 2, 4, 6, 8 ]
[ 1, 3, 5 ]
10
15
120
[ 30, 40, 50 ]
[  ]
[ -3, -2, -1, 0 ]
[ 2, 4, 6, 8 ]
