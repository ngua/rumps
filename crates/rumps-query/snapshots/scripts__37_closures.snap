---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: Closures\n; Tests closure definition, binding, and display\n\n; === Single parameter closure ===\n\nLET double = x => x * 2\nOUTPUT double\n; Expected: <closure(1)>\n\nLET identity = x => x\nOUTPUT identity\n; Expected: <closure(1)>\n\n; === Multi-parameter closure ===\n\nLET add = (a, b) => a + b\nOUTPUT add\n; Expected: <closure(2)>\n\nLET triple = (a, b, c) => a + b + c\nOUTPUT triple\n; Expected: <closure(3)>\n\n; === Nullary closure ===\n\nLET const = () => 42\nOUTPUT const\n; Expected: <closure(0)>\n\n; === Typed parameter closure ===\n\nLET typed = (x: Int) => x + 1\nOUTPUT typed\n; Expected: <closure(1)>\n\nLET multi-typed = (x: Int, y: String) => y\nOUTPUT multi-typed\n; Expected: <closure(2)>\n\n; === Closure with return type ===\n\nLET with-ret = (x: Int) -> Int => x * x\nOUTPUT with-ret\n; Expected: <closure(1)>\n\n; === Nested closure in expression ===\n\nLET nested = (x => x + 1)\nOUTPUT nested\n; Expected: <closure(1)>\n\n; === Closure with complex body ===\n\nLET complex = (a, b) => { a * b + 1 }\nOUTPUT complex\n; Expected: <closure(2)>\n\nOUTPUT \"Closure test complete\"\n"
---
<closure(1)>
<closure(1)>
<closure(2)>
<closure(3)>
<closure(0)>
<closure(1)>
<closure(2)>
<closure(1)>
<closure(1)>
<closure(2)>
"Closure test complete"
