source: crates/rumps-query/tests/scripts.rs
description: "; Test: Word type (unsigned machine word)\n; Tests `Word` type creation, operations, and conversions\n;\n; `Word` uses SATURATING arithmetic:\n;   - Overflow clamps to `Word.MAX` (e.g., large `Word ** Word`)\n;   - Underflow clamps to `0` (e.g., `5w - 10w` => `0`)\n; This differs from `Int`, which uses WRAPPING arithmetic.\n;\n; NOTE: Mixed operations (`Word` + `Int`, `Word` - `Float`, etc.) are not allowed;\n; explicit conversion is required (use `as` or `read`).\n\nfun main() {\n  ; === Basic Word Literals ===\n\n  ; Word annotation with positive integer\n  let w1: Word = 42\n  write w1\n  ; Expected: 42\n\n  ; Word with zero\n  let w2: Word = 0\n  write w2\n  ; Expected: 0\n\n  ; === Arithmetic Operations (same-type) ===\n\n  ; Word + Word -> Word (saturating)\n  let w10: Word = 10\n  let w5: Word = 5\n  let a: Word = w10 + w5\n  write a\n  ; Expected: 15\n\n  ; Word * Word -> Word (saturating)\n  let w3: Word = 3\n  let w4: Word = 4\n  let d: Word = w3 * w4\n  write d\n  ; Expected: 12\n\n  ; === Saturating Subtraction (Word - Word) ===\n\n  ; Word - Word with positive result\n  let e = w10 - w3\n  write e\n  ; Expected: 7 (Word, stays Word)\n\n  ; Word - Word at boundary (saturates to 0)\n  let f = w5 - w10\n  write f\n  ; Expected: 0 (saturating subtraction)\n\n  let wz: Word = 0\n  let w1a: Word = 1\n  let g = wz - w1a\n  write g\n  ; Expected: 0 (saturating subtraction)\n\n  ; === Comparisons (same-type) ===\n\n  let w20: Word = 20\n  write w10 == w10\n  ; Expected: true\n\n  let w10i: Word = 10\n  write w10 == w10i\n  ; Expected: true\n\n  write w10 < w20\n  ; Expected: true\n\n  write w10 > w5\n  ; Expected: true\n\n  ; === Conversion: Word as Int (infallible) ===\n\n  let w100: Word = 100\n  let as-int = w100 as Int\n  write as-int\n  ; Expected: 100\n\n  ; === Conversion: Word as Float (infallible) ===\n\n  let as-float = w100 as Float\n  write as-float\n  ; Expected: 100.0\n\n  ; === Conversion: Int read Word (fallible) ===\n\n  ; Positive Int -> Word (success)\n  let res1 = 42 read Word\n  write :display(res1)\n  ; Expected: Result.Ok(42)\n\n  ; Zero -> Word (success)\n  let res2 = 0 read Word\n  write :display(res2)\n  ; Expected: Result.Ok(0)\n\n  ; Negative Int -> Word (failure)\n  let res3 = (-5) read Word\n  write :display(res3)\n  ; Expected: Result.Err(\"expected non-negative Int for Word, got -5\")\n\n  ; === String read Word ===\n\n  let res4 = \"123\" read Word\n  write :display(res4)\n  ; Expected: Result.Ok(123)\n\n  let res5 = \"abc\" read Word\n  write :display(res5)\n  ; Expected: Result.Err(\"invalid unsigned integer: abc\")\n\n  let res6 = \"-42\" read Word\n  write :display(res6)\n  ; Expected: Result.Err(\"invalid unsigned integer: -42\")\n\n  ; === Division (Float operands required) ===\n\n  let f10 = w10 as Float\n  let f4 = w4 as Float\n  let div = f10 / f4\n  write div\n  ; Expected: 2.5\n\n  ; === Floor division (Word // Word -> Word) ===\n\n  let fdiv: Word = w10 // w3\n  write fdiv\n  ; Expected: 3\n\n  ; === Modulo (Word % Word -> Word) ===\n\n  let m: Word = w10 % w3\n  write m\n  ; Expected: 1\n\n  ; === Power (Word ** Word -> Word, saturating) ===\n\n  let w2p: Word = 2\n  let w10p: Word = 10\n  let p: Word = w2p ** w10p\n  write p\n  ; Expected: 1024\n\n  write \"Word type test complete\"\n}\n"
---
