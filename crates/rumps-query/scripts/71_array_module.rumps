; Array module functions
; Tests Iter.map, Iter.filter, Iter.reduce, Iter.foreach

; Iter.map with closure
LET nums = [1, 2, 3, 4, 5]
LET doubled = Iter.map(x => x * 2, nums)
WRITE doubled  ; [2, 4, 6, 8, 10]

; Iter.map on empty array
LET empty = []
LET mapped-empty = Iter.map(x => x + 1, empty)
WRITE mapped-empty  ; []

; Iter.map with named function
FUN square (n: Int) -> Int { n * n }
LET squares = Iter.map(square, [1, 2, 3])
WRITE squares  ; [1, 4, 9]

; Iter.filter with closure
LET evens = Iter.filter(x => x % 2 == 0, nums)
WRITE evens  ; [2, 4]

; Iter.filter on empty array
LET filtered-empty = Iter.filter(x => x > 0, empty)
WRITE filtered-empty  ; []

; Iter.filter with named function
FUN is-positive (n: Int) -> Bool { n > 0 }
LET positives = Iter.filter(is-positive, [-1, 0, 1, 2])
WRITE positives  ; [1, 2]

; Iter.filter keeping all
LET all-kept = Iter.filter(x => TRUE, [1, 2, 3])
WRITE all-kept  ; [1, 2, 3]

; Iter.filter keeping none
LET none-kept = Iter.filter(x => FALSE, [1, 2, 3])
WRITE none-kept  ; []

; Iter.reduce with sum
LET sum = Iter.reduce((acc, x) => acc + x, 0, nums)
WRITE sum  ; 15

; Iter.reduce on empty array returns initial value
LET empty-sum = Iter.reduce((acc, x) => acc + x, 100, empty)
WRITE empty-sum  ; 100

; Iter.reduce with string concatenation
LET words = ["hello", " ", "world"]
LET combined = Iter.reduce((acc, s) => "{acc}{s}", "", words)
WRITE combined  ; "hello world"

; Iter.reduce with named function
FUN add (a: Int, b: Int) -> Int { a + b }
LET total = Iter.reduce(add, 0, [1, 2, 3, 4])
WRITE total  ; 10

; Combining Array functions
LET result = Iter.reduce(
  (acc, x) => acc + x,
  0,
  Iter.map(x => x * x, Iter.filter(x => x % 2 == 1, [1, 2, 3, 4, 5]))
)
WRITE result  ; 1 + 9 + 25 = 35

; Pipeline usage with Array functions (using wrapper closures)
LET piped = [1, 2, 3, 4, 5]
  |> (arr => Iter.filter(x => x > 2, arr))
  |> (arr => Iter.map(x => x * 10, arr))
WRITE piped  ; [30, 40, 50]

; Module functions can be passed as first-class values
LET filter-fn = Iter.filter
LET data = [1, 2, 3, 4, 5]
LET filtered = filter-fn(x => x > 2, data)
WRITE filtered  ; [3, 4, 5]

; Iter.map with Option results (homogeneous tagged values)
LET with-opts = Iter.map(x => Option.Some(x), [1, 2, 3])
WRITE with-opts  ; [Option.Some(1), Option.Some(2), Option.Some(3)]

; Nested Iter.map (callback uses Array function)
LET nested = [[1, 2], [3, 4]]
LET doubled-nested = Iter.map(arr => Iter.map(x => x * 2, arr), nested)
WRITE doubled-nested  ; [[2, 4], [6, 8]]

; === Iter.foreach ===

; Iter.foreach for side effects (outputs each element)
WRITE "foreach:"
LET fe-result = Iter.foreach(x => { WRITE x }, [10, 20, 30])
WRITE fe-result  ; Unit

; Iter.foreach on empty array (no side effects)
LET fe-empty = Iter.foreach(x => { WRITE x }, [])
WRITE fe-empty  ; Unit

; Iter.foreach with range
WRITE "range foreach:"
LET fe-range = Iter.foreach(n => { WRITE n }, 1 .. 4)
WRITE fe-range  ; Unit

; === Array.zip ===

LET a = [1, 2, 3]
LET b = ["a", "b", "c"]
LET zipped = Array.zip(a, b)
WRITE zipped

; Shorter array determines length
LET short = [1, 2]
LET long = ["a", "b", "c", "d"]
WRITE Array.zip(short, long)

; === Array.unzip ===

LET pairs: Array[(Int, String)] = [(1, "one"), (2, "two"), (3, "three")]
LET (unzip-nums, unzip-strs) = Array.unzip(pairs)
WRITE unzip-nums
WRITE unzip-strs

; Round-trip
LET x = [10, 20, 30]
LET y = [true, false, true]
LET (x2, y2) = Array.unzip(Array.zip(x, y))
WRITE x2
WRITE y2

; === Array.intersperse ===

LET inter-words = ["hello", "world", "!"]
WRITE Array.intersperse(",", inter-words)

LET inter-nums = [1, 2, 3, 4]
WRITE Array.intersperse(0, inter-nums)

; Empty array
LET inter-empty: Array[Int] = []
WRITE Array.intersperse(0, inter-empty)

; Single element
WRITE Array.intersperse(0, [42])

; === Array.zip-with ===

FUN zip-add(za: Int, zb: Int) -> Int { za + zb }
LET xs = [1, 2, 3]
LET ys = [10, 20, 30]
WRITE Array.zip-with(zip-add, xs, ys)

; With closure
LET multiplied = Array.zip-with((ma, mb) => ma * mb, [2, 3, 4], [5, 6, 7])
WRITE multiplied

; With shorter array
WRITE Array.zip-with(zip-add, [1, 2, 3, 4, 5], [10, 20])

; === Array.sort-by ===

FUN cmp-int(ca: Int, cb: Int) -> Ordering {
  IF ca < cb { Ordering.Lt } ELSE {
    IF ca == cb { Ordering.Eq } ELSE { Ordering.Gt }
  }
}

LET unsorted = [3, 1, 4, 1, 5, 9, 2, 6]
WRITE Array.sort-by(cmp-int, unsorted)

; Sort descending (reverse comparator)
FUN cmp-desc(da: Int, db: Int) -> Ordering {
  IF da > db { Ordering.Lt } ELSE {
    IF da == db { Ordering.Eq } ELSE { Ordering.Gt }
  }
}
WRITE Array.sort-by(cmp-desc, unsorted)

; Sort by absolute value
FUN cmp-abs(aa: Int, ab: Int) -> Ordering {
  LET abs-a = IF aa < 0 { 0 - aa } ELSE { aa }
  LET abs-b = IF ab < 0 { 0 - ab } ELSE { ab }
  cmp-int(abs-a, abs-b)
}
LET signed = [-5, 3, -1, 4, -2]
WRITE Array.sort-by(cmp-abs, signed)

; Sort objects by field
NEWTYPE SortPerson = { name: String, age: Int }

FUN cmp-by-age(pa: SortPerson, pb: SortPerson) -> Ordering {
  cmp-int(pa.age, pb.age)
}

LET people = [
  { name: "Alice", age: 30 },
  { name: "Bob", age: 25 },
  { name: "Carol", age: 35 }
]
LET by-age = Array.sort-by(cmp-by-age, people)
WRITE Iter.map(p => p.name, by-age)

; === Chained operations ===

; zip, map, filter chain
LET indices = [0, 1, 2, 3, 4]
LET values = [10, 25, 30, 15, 40]
LET indexed = Array.zip(indices, values)
LET chain-filtered = Iter.filter(pair => pair.1 > 20, indexed)
WRITE chain-filtered

; zip-with to compute differences
LET before = [10, 20, 30]
LET after = [15, 18, 35]
LET diffs = Array.zip-with((db, da) => da - db, before, after)
WRITE diffs

; === Union types with Iterable constraint ===

; Union of iterable types should satisfy Iterable[T] constraint
FUN iter-len(i: Range | Array[Int]) -> Int {
  Iter.length(i)
}

WRITE iter-len(1 ..= 20)
WRITE iter-len([1, 2, 3, 4, 5])

; Using Iter.map with union type
FUN iter-sum(i: Range | Array[Int]) -> Int {
  Iter.reduce((acc, x) => acc + x, 0, i)
}

WRITE iter-sum(1 ..= 5)
WRITE iter-sum([10, 20, 30])
