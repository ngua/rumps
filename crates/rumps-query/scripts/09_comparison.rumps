; Test: comparison operators
; Tests all comparison operators

; Equality
OUTPUT 5 == 5
; Expected: true

OUTPUT 5 == 6
; Expected: false

OUTPUT "abc" == "abc"
; Expected: true

OUTPUT "abc" == "def"
; Expected: false

OUTPUT TRUE == TRUE
; Expected: true

OUTPUT TRUE == FALSE
; Expected: false

; Inequality
OUTPUT 5 != 6
; Expected: true

OUTPUT 5 != 5
; Expected: false

; Less than
OUTPUT 5 < 10
; Expected: true

OUTPUT 10 < 5
; Expected: false

OUTPUT 5 < 5
; Expected: false

; Greater than
OUTPUT 10 > 5
; Expected: true

OUTPUT 5 > 10
; Expected: false

OUTPUT 5 > 5
; Expected: false

; Less than or equal
OUTPUT 5 <= 10
; Expected: true

OUTPUT 5 <= 5
; Expected: true

OUTPUT 10 <= 5
; Expected: false

; Greater than or equal
OUTPUT 10 >= 5
; Expected: true

OUTPUT 5 >= 5
; Expected: true

OUTPUT 5 >= 10
; Expected: false

; Float comparisons
OUTPUT 3.14 < 3.15
; Expected: true

OUTPUT 2.5 >= 2.5
; Expected: true

; Mixed int/float comparison
OUTPUT 5 < 5.5
; Expected: true

OUTPUT 5.0 == 5
; Expected: true (or false if strict typing)

; String comparisons (lexicographic)
OUTPUT "abc" < "abd"
; Expected: true

OUTPUT "abc" < "ab"
; Expected: false

OUTPUT "apple" < "banana"
; Expected: true

; Chained comparisons via variables
LET a = 5
LET b = 10
LET c = 15
OUTPUT a < b
; Expected: true

OUTPUT b < c
; Expected: true

OUTPUT a < c
; Expected: true

OUTPUT "Comparison test complete"
