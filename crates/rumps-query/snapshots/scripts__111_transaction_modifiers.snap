---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: Transaction modifiers\n; Tests ON CONFLICT, WITH TIMEOUT, WITH RETRIES, WITH ISOLATION\n;\n; Modifier ordering:\n;   Modifiers must appear in this fixed order (each is optional):\n;     1. ON CONFLICT (ABORT | OVERWRITE)\n;     2. WITH TIMEOUT <expr>\n;     3. WITH RETRIES n\n;     4. WITH ISOLATION SNAPSHOT\n;\n;   Each modifier can appear at most once. Out-of-order or duplicate\n;   modifiers will produce a parse error.\n\n; === ON CONFLICT ABORT (default) ===\nLET r1 = TRANSACTION {\n  @SET ^data(1) = \"one\"\n} ON CONFLICT ABORT\n@OUTPUT r1 IS Result.Ok(_)\n\n; === ON CONFLICT OVERWRITE ===\nLET r2 = TRANSACTION {\n  @SET ^data(2) = \"two\"\n} ON CONFLICT OVERWRITE\n@OUTPUT r2 IS Result.Ok(_)\n\n; === WITH TIMEOUT (milliseconds) ===\nLET r3 = TRANSACTION {\n  @SET ^data(3) = \"three\"\n} WITH TIMEOUT 5000\n@OUTPUT r3 IS Result.Ok(_)\n\n; === WITH RETRIES n ===\nLET r4 = TRANSACTION {\n  @SET ^data(4) = \"four\"\n} WITH RETRIES 3\n@OUTPUT r4 IS Result.Ok(_)\n\n; === WITH ISOLATION SNAPSHOT ===\nLET r5 = TRANSACTION {\n  @SET ^data(5) = \"five\"\n} WITH ISOLATION SNAPSHOT\n@OUTPUT r5 IS Result.Ok(_)\n\n; === Combined modifiers ===\nLET r6 = TRANSACTION {\n  @SET ^data(6) = \"six\"\n} ON CONFLICT OVERWRITE WITH TIMEOUT 5000 WITH RETRIES 3\n@OUTPUT r6 IS Result.Ok(_)\n\n; === All modifiers ===\nLET r7 = TRANSACTION {\n  @SET ^data(7) = \"seven\"\n} ON CONFLICT OVERWRITE WITH TIMEOUT 1000 WITH RETRIES 5 WITH ISOLATION SNAPSHOT\n@OUTPUT r7 IS Result.Ok(_)\n\n; === Timeout from expression ===\nLET timeout-ms = 2000\nLET r8 = TRANSACTION {\n  @SET ^data(8) = \"eight\"\n} WITH TIMEOUT timeout-ms\n@OUTPUT r8 IS Result.Ok(_)\n\n; === Case-insensitivity ===\n; Contextual keywords are matched case-insensitively (like RUMPS keywords)\nLET r9 = TRANSACTION {\n  @SET ^data(9) = \"nine\"\n} on conflict abort with timeout 1000\n@OUTPUT r9 IS Result.Ok(_)\n\n; Mixed case also works\nLET r10 = TRANSACTION {\n  @SET ^data(10) = \"ten\"\n} On Conflict Overwrite With Retries 2\n@OUTPUT r10 IS Result.Ok(_)\n\n; === Contextual identifiers as variables ===\nLET on = \"on\"\nLET conflict = \"conflict\"\nLET timeout = 1000\nLET with = \"with\"\nLET retries = \"retries\"\nLET isolation = \"isolation\"\n@OUTPUT on ++ \" \" ++ conflict\n\n; Can use these as variable names and still use modifiers\nLET r11 = TRANSACTION {\n  @SET ^data(11) = on ++ conflict\n} WITH TIMEOUT timeout\n@OUTPUT r11 IS Result.Ok(_)\n@OUTPUT @GET ^data(11)\n\n; === Timeout actually triggers ===\n; This tests that WITH TIMEOUT actually cancels long-running transactions\nLET timed-out = TRANSACTION {\n  FOREVER 0 (next, cont) => {\n    IF next > 100 {\n      next\n    } ELSE {\n      cont({\n        @SET ^d(next) = \"a\"\n        Time.sleep(10 * 10000)\n        next + 1\n      })\n    }\n  }\n} WITH TIMEOUT 1\n\n@OUTPUT timed-out\n\n@OUTPUT \"Transaction modifiers test complete\"\n"
---
