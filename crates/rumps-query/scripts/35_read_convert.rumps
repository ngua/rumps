; Test: Fallible type conversion operator (READ)
; Tests fallible conversions that return `Result[T, String]`

FUN main() {
  ; === String -> Int ===

  ; Success case
  LET s1 = "42"
  LET r1 = s1 READ Int
  WRITE r1
  ; Expected: Result.Ok(42)

  ; Negative number
  LET s2 = "-123"
  LET r2 = s2 READ Int
  WRITE r2
  ; Expected: Result.Ok(-123)

  ; Failure case (not a valid int)
  LET s3 = "hello"
  LET r3 = s3 READ Int
  WRITE r3
  ; Expected: Result.Err(...)

  ; Failure case (float string -> int)
  LET s4 = "3.14"
  LET r4 = s4 READ Int
  WRITE r4
  ; Expected: Result.Err(...)

  ; === String -> Float ===

  ; Success case
  LET f1 = "3.14"
  LET rf1 = f1 READ Float
  WRITE rf1
  ; Expected: Result.Ok(3.14)

  ; Integer string to float
  LET f2 = "42"
  LET rf2 = f2 READ Float
  WRITE rf2
  ; Expected: Result.Ok(42)

  ; Negative float
  LET f3 = "-2.5"
  LET rf3 = f3 READ Float
  WRITE rf3
  ; Expected: Result.Ok(-2.5)

  ; Failure case
  LET f4 = "not-a-number"
  LET rf4 = f4 READ Float
  WRITE rf4
  ; Expected: Result.Err(...)

  ; === Int -> Bool ===

  ; Zero -> false
  LET b1 = 0 READ Bool
  WRITE b1
  ; Expected: Result.Ok(FALSE)

  ; One -> true
  LET b2 = 1 READ Bool
  WRITE b2
  ; Expected: Result.Ok(TRUE)

  ; Invalid int (not 0 or 1)
  LET b3 = 42 READ Bool
  WRITE b3
  ; Expected: Result.Err(...)

  LET b4 = -1 READ Bool
  WRITE b4
  ; Expected: Result.Err(...)

  ; === Chained operations ===

  ; Chain read with as
  LET chain = ("42" READ Int) AS String
  WRITE chain
  ; Expected: Result.Ok(42)

  ; === Read with expressions ===

  LET concat = "{"1"}{"23"}"
  LET parsed = concat READ Int
  WRITE parsed
  ; Expected: Result.Ok(123)

  WRITE "Fallible read test complete"
}
