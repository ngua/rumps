---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: @ORDER primitive\n; Returns next subscript at a given level\n; NOTE: Uses locals only; globals require TRANSACTION blocks\n\n; Set up test data\n@SET items(1) = \"one\"\n@SET items(2) = \"two\"\n@SET items(10) = \"ten\"\n@SET items(\"A\") = \"alpha\"\n@SET items(\"B\") = \"beta\"\n\n@SET nested(1, \"A\") = \"nested 1A\"\n@SET nested(1, \"B\") = \"nested 1B\"\n@SET nested(2, \"X\") = \"nested 2X\"\n\n; First subscript at root (no after value)\nLET first = @ORDER items\n@OUTPUT first\n\n; Next subscript after 1\nLET after-1 = @ORDER items(1)\n@OUTPUT after-1\n\n; Next subscript after 2\nLET after-2 = @ORDER items(2)\n@OUTPUT after-2\n\n; Next subscript after 10\nLET after-10 = @ORDER items(10)\n@OUTPUT after-10\n\n; Past the last numeric key\nLET after-a = @ORDER items(\"A\")\n@OUTPUT after-a\n\n; Past the last key entirely\nLET after-b = @ORDER items(\"B\")\n@OUTPUT after-b\n\n; Next subscript at root after 1 (which is 2)\nLET nested-after-1 = @ORDER nested(1)\n@OUTPUT nested-after-1\n\n; Next subscript under nested(1) after \"A\"\nLET nested-1-after-a = @ORDER nested(1, \"A\")\n@OUTPUT nested-1-after-a\n\n; Past last key under nested(1)\nLET nested-1-after-b = @ORDER nested(1, \"B\")\n@OUTPUT nested-1-after-b\n\n; Next subscript at root after 2 (none)\nLET nested-after-2 = @ORDER nested(2)\n@OUTPUT nested-after-2\n\n; @ORDER on non-existent variable\nLET no-keys = @ORDER empty\n@OUTPUT no-keys\n\n; @ORDER with different subscript types\n@SET mixed(true) = \"bool key\"\n@SET mixed(42) = \"int key\"\n@SET mixed(3.14) = \"float key\"\n@SET mixed(\"str\") = \"string key\"\n\n; Bool comes first, then numbers, then strings\nLET mixed-first = @ORDER mixed\n@OUTPUT mixed-first\n\nLET mixed-after-true = @ORDER mixed(true)\n@OUTPUT mixed-after-true\n\n; Type annotation\nLET typed: Option[Subscript] = @ORDER items\n@OUTPUT typed\n\n@OUTPUT \"@ORDER test complete\"\n"
---
Option.Some(1)
Option.Some(2)
Option.Some(10)
Option.Some("A")
Option.Some("B")
Option.None
Option.Some(2)
Option.Some("B")
Option.None
Option.None
Option.None
Option.Some(TRUE)
Option.Some(3.14)
Option.Some(1)
"@ORDER test complete"
