; Test: write statement
; Tests various write scenarios

fun main() {
  ; Output literal integer
  write 42
  ; Expected: 42

  ; Output literal float
  write 3.14159
  ; Expected: 3.14159

  ; Output literal string
  write "Hello, World!"
  ; Expected: Hello, World!

  ; Output literal boolean
  write true
  write false
  ; Expected: true, false

  ; Output variable
  let x = 123
  write x
  ; Expected: 123

  ; Output expression result
  write 10 + 20 * 3
  ; Expected: 70

  ; Output string interpolation
  write "{"Hello"} {"RUMPS"}"
  ; Expected: Hello RUMPS

  ; Output comparison result
  write 5 < 10
  ; Expected: true

  ; Output logical result
  write true and false
  ; Expected: false

  write not false
  ; Expected: true

  ; Output from block result
  let result = {
    let a = 5
    let b = 10
    a + b
  }
  write result
  ; Expected: 15

  ; Multiple outputs in sequence
  write "Line 1"
  write "Line 2"
  write "Line 3"

  write "write test complete"
}
