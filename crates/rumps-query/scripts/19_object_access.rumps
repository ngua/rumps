; Test: object field and bracket access
; Tests dot notation and bracket notation for objects

LET obj = { name: "Alice", age: 30, active: TRUE }

; Dot notation
OUTPUT obj.name
; Expected: Alice

OUTPUT obj.age
; Expected: 30

OUTPUT obj.active
; Expected: TRUE

; Bracket notation with string literal
OUTPUT obj["name"]
; Expected: Alice

OUTPUT obj["age"]
; Expected: 30

OUTPUT obj["active"]
; Expected: TRUE

; Bracket notation with string variable
LET key = "name"
OUTPUT obj[key]
; Expected: Alice

LET key2 = "age"
OUTPUT obj[key2]
; Expected: 30

; Dynamic key lookup
LET keys = ["name", "age", "active"]
OUTPUT obj[keys[0]]
; Expected: Alice

OUTPUT obj[keys[1]]
; Expected: 30

; Nested object access (mixed notation)
LET data = {
  user: {
    profile: {
      firstName: "Bob",
      lastName: "Smith"
    },
    scores: [90, 85, 95]
  }
}

OUTPUT data.user.profile.firstName
; Expected: Bob

OUTPUT data["user"]["profile"]["lastName"]
; Expected: Smith

OUTPUT data.user["profile"].firstName
; Expected: Bob

OUTPUT data["user"].profile["lastName"]
; Expected: Smith

OUTPUT data.user.scores[0]
; Expected: 90

OUTPUT data.user.scores[-1]
; Expected: 95

; Object with numeric string keys
LET nums = { "1": "one", "2": "two", "3": "three" }
OUTPUT nums["1"]
; Expected: one

OUTPUT nums["2"]
; Expected: two

; Object with special characters in keys (via bracket)
LET special = { "my-key": "value1", "another.key": "value2" }
OUTPUT special["my-key"]
; Expected: value1

OUTPUT special["another.key"]
; Expected: value2

OUTPUT "Object access test complete"
