---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: Word type (unsigned machine word)\n; Tests `Word` type creation, operations, and conversions\n;\n; `Word` uses SATURATING arithmetic:\n;   - Overflow clamps to `Word.MAX` (e.g., large `Word ** Word`)\n;   - Underflow clamps to `0` (e.g., `5w - 10w` => `0`)\n; This differs from `Int`, which uses WRAPPING arithmetic.\n;\n; NOTE: Mixed operations (`Word` + `Int`, `Word` - `Float`, etc.) are NOT allowed;\n; explicit conversion is required (use `AS` or `READ`).\n\n; === Basic Word Literals ===\n\n; Word annotation with positive integer\nLET w1: Word = 42\nWRITE w1\n; Expected: 42\n\n; Word with zero\nLET w2: Word = 0\nWRITE w2\n; Expected: 0\n\n; === Arithmetic Operations (same-type) ===\n\n; Word + Word -> Word (saturating)\nLET w10: Word = 10\nLET w5: Word = 5\nLET a: Word = w10 + w5\nWRITE a\n; Expected: 15\n\n; Word * Word -> Word (saturating)\nLET w3: Word = 3\nLET w4: Word = 4\nLET d: Word = w3 * w4\nWRITE d\n; Expected: 12\n\n; === Saturating Subtraction (Word - Word) ===\n\n; Word - Word with positive result\nLET e = w10 - w3\nWRITE e\n; Expected: 7 (Word, stays Word)\n\n; Word - Word at boundary (saturates to 0)\nLET f = w5 - w10\nWRITE f\n; Expected: 0 (saturating subtraction)\n\nLET wz: Word = 0\nLET w1a: Word = 1\nLET g = wz - w1a\nWRITE g\n; Expected: 0 (saturating subtraction)\n\n; === Comparisons (same-type) ===\n\nLET w20: Word = 20\nWRITE w10 == w10\n; Expected: TRUE\n\nLET w10i: Word = 10\nWRITE w10 == w10i\n; Expected: TRUE\n\nWRITE w10 < w20\n; Expected: TRUE\n\nWRITE w10 > w5\n; Expected: TRUE\n\n; === Conversion: Word AS Int (infallible) ===\n\nLET w100: Word = 100\nLET as_int = w100 AS Int\nWRITE as_int\n; Expected: 100\n\n; === Conversion: Word AS Float (infallible) ===\n\nLET as_float = w100 AS Float\nWRITE as_float\n; Expected: 100.0\n\n; === Conversion: Int READ Word (fallible) ===\n\n; Positive Int -> Word (success)\nLET res1 = 42 READ Word\nWRITE res1\n; Expected: Result.Ok(42)\n\n; Zero -> Word (success)\nLET res2 = 0 READ Word\nWRITE res2\n; Expected: Result.Ok(0)\n\n; Negative Int -> Word (failure)\nLET res3 = (-5) READ Word\nWRITE res3\n; Expected: Result.Err(\"expected non-negative Int for Word, got -5\")\n\n; === String READ Word ===\n\nLET res4 = \"123\" READ Word\nWRITE res4\n; Expected: Result.Ok(123)\n\nLET res5 = \"abc\" READ Word\nWRITE res5\n; Expected: Result.Err(\"invalid unsigned integer: abc\")\n\nLET res6 = \"-42\" READ Word\nWRITE res6\n; Expected: Result.Err(\"invalid unsigned integer: -42\")\n\n; === Division (Float operands required) ===\n\nLET f10 = w10 AS Float\nLET f4 = w4 AS Float\nLET div = f10 / f4\nWRITE div\n; Expected: 2.5\n\n; === Floor division (Word // Word -> Word) ===\n\nLET fdiv: Word = w10 // w3\nWRITE fdiv\n; Expected: 3\n\n; === Modulo (Word % Word -> Word) ===\n\nLET m: Word = w10 % w3\nWRITE m\n; Expected: 1\n\n; === Power (Word ** Word -> Word, saturating) ===\n\nLET w2p: Word = 2\nLET w10p: Word = 10\nLET p: Word = w2p ** w10p\nWRITE p\n; Expected: 1024\n\nWRITE \"Word type test complete\"\n"
---
