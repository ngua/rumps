; Test: SET and GET globals
; Tests global variable operations (require transaction)
; NOTE: Globals require TRANSACTION blocks

; This should work inside a transaction
TRANSACTION {
  SET ^PATIENT(1, "name") = "Alice"
  SET ^PATIENT(1, "age") = 25
  SET ^PATIENT(2, "name") = "Bob"
  SET ^PATIENT(2, "age") = 30

  ; GET within same transaction
  LET n = GET ^PATIENT(1, "name")
  OUTPUT n
  ; Expected: Alice

  LET a = GET ^PATIENT(1, "age")
  OUTPUT a
  ; Expected: 25
}

; Read committed data in new transaction
TRANSACTION {
  LET name1 = GET ^PATIENT(1, "name")
  OUTPUT name1
  ; Expected: Alice

  LET name2 = GET ^PATIENT(2, "name")
  OUTPUT name2
  ; Expected: Bob
}

; Multiple globals
TRANSACTION {
  SET ^CONFIG("version") = "1.0.0"
  SET ^CONFIG("debug") = FALSE
  SET ^COUNTER = 0
  SET ^COUNTER = 1
}

TRANSACTION {
  LET ver = GET ^CONFIG("version")
  OUTPUT ver
  ; Expected: 1.0.0

  LET cnt = GET ^COUNTER
  OUTPUT cnt
  ; Expected: 1
}

OUTPUT "Globals test complete"
