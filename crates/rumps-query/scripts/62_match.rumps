; match expression tests

variant Status = Pending | Active(String) | Completed

fun describe(opt: Option[Int]) -> String {
  match opt {
    Option.Some(n) => { "got {n}" }
    Option.None => { "nothing" }
  }
}

fun main() {
  ; === Simple matching ===

  ; Literal matching
  let n = 2
  let result = match n {
    1 => { "one" }
    2 => { "two" }
    3 => { "three" }
    _ => { "other" }
  }
  write result

  ; Variable binding
  let x = 42
  let doubled = match x {
    n => { n * 2 }
  }
  write doubled

  ; Wildcard
  let ignored = match "anything" {
    _ => { "matched wildcard" }
  }
  write ignored

  ; === Sum type matching ===

  ; Option.Some
  let opt = Option.Some(10)
  let unwrapped = match opt {
    Option.Some(v) => { v }
    Option.None => { 0 }
  }
  write unwrapped

  ; Option.None
  let none-opt = Option.None
  let default = match none-opt {
    Option.Some(v) => { v }
    Option.None => { -1 }
  }
  write default

  ; Nested Option
  let nested-opt = Option.Some(Option.Some(5))
  let deep = match nested-opt {
    Option.Some(Option.Some(v)) => { v }
    Option.Some(Option.None) => { -1 }
    Option.None => { -2 }
  }
  write deep

  ; Result type
  let ok = Result.Ok(100)
  let ok-val = match ok {
    Result.Ok(v) => { v }
    Result.Err(e) => { 0 }
  }
  write ok-val

  let err = Result.Err("oops")
  let err-val = match err {
    Result.Ok(v) => { v }
    Result.Err(e) => { -1 }
  }
  write err-val

  ; === User-defined sum types ===

  let s1 = Status.Pending
  let s1-label = match s1 {
    Status.Pending => { "waiting" }
    Status.Active(msg) => { "active: {msg}" }
    Status.Completed => { "done" }
  }
  write s1-label

  let s2 = Status.Active("step 1")
  let s2-label = match s2 {
    Status.Pending => { "waiting" }
    Status.Active(msg) => { "active: {msg}" }
    Status.Completed => { "done" }
  }
  write s2-label

  let s3 = Status.Completed
  let s3-label = match s3 {
    Status.Pending => { "waiting" }
    Status.Active(msg) => { "active: {msg}" }
    Status.Completed => { "done" }
  }
  write s3-label

  ; === Tuple matching ===

  let pair = (1, 2)
  let pair-sum = match pair {
    (a, b) => { a + b }
  }
  write pair-sum

  ; With literal in tuple
  let point = (0, 5)
  let axis = match point {
    (0, y) => { "on y-axis at {y}" }
    (x, 0) => { "on x-axis at {x}" }
    (x, y) => { "at ({x}, {y})" }
  }
  write axis

  let point2 = (3, 0)
  let axis2 = match point2 {
    (0, y) => { "on y-axis" }
    (x, 0) => { "on x-axis" }
    _ => { "elsewhere" }
  }
  write axis2

  let point3 = (3, 4)
  let axis3 = match point3 {
    (0, _) => { "on y-axis" }
    (_, 0) => { "on x-axis" }
    _ => { "elsewhere" }
  }
  write axis3

  ; === Object matching ===

  let user = { name: "Alice", age: 30, role: "admin" }
  let greeting = match user {
    { name, role: "admin" } => { "{name} is an admin" }
    { name } => { "{name} is a user" }
  }
  write greeting

  let user2 = { name: "Bob", age: 25, role: "user" }
  let greeting2 = match user2 {
    { name, role: "admin" } => { "{name} is an admin" }
    { name } => { "{name} is a user" }
  }
  write greeting2

  ; === Pattern guards ===

  let val = 50
  let size = match val {
    x if x > 100 => { "large" }
    x if x > 10 => { "medium" }
    x if x > 0 => { "small" }
    0 => { "zero" }
    _ => { "negative" }
  }
  write size

  let val2 = 150
  let size2 = match val2 {
    x if x > 100 => { "large" }
    x if x > 10 => { "medium" }
    _ => { "other" }
  }
  write size2

  ; Guard with Option
  let maybe-num = Option.Some(42)
  let check = match maybe-num {
    Option.Some(n) if n > 50 => { "large some" }
    Option.Some(n) if n > 0 => { "small some" }
    Option.Some(_) => { "non-positive some" }
    Option.None => { "none" }
  }
  write check

  ; === match as expression ===

  ; Use in larger expression
  let base = 10
  let computed = base + match Option.Some(5) {
    Option.Some(n) => { n * 2 }
    Option.None => { 0 }
  }
  write computed

  ; Return from function
  write describe(Option.Some(7))
  write describe(Option.None)

  ; === Array matching ===

  ; Exact length match
  let arr = [1, 2, 3]
  let arr-sum = match arr {
    [a, b, c] => { a + b + c }
    [..] => { 0 }
  }
  write arr-sum

  ; Single element
  let single = [42]
  let single-val = match single {
    [x] => { x }
    [..] => { -1 }
  }
  write single-val

  ; With rest (ignore)
  let long = [10, 20, 30, 40, 50]
  let first-two-sum = match long {
    [a, b, ..] => { a + b }
    [..] => { 0 }
  }
  write first-two-sum

  ; With rest (bind)
  let nums = [1, 2, 3, 4, 5]
  let head-tail = match nums {
    [h, ...t] => {
      let strs = Mappable:map((x: Int) => x as String, t)
      "{h}:{String.join(strs, ",")}"
    }
    [..] => { "empty" }
  }
  write head-tail

  ; Empty array with rest
  let empty: Array[Int] = []
  let empty-result = match empty {
    [x, ..] => { "has elements" }
    [..] => { "empty" }
  }
  write empty-result

  ; Nested patterns in array
  let pairs = [(1, 2), (3, 4)]
  let first-pair-sum = match pairs {
    [(a, b), ..] => { a + b }
    [..] => { 0 }
  }
  write first-pair-sum

  ; Array of Options
  let opts = [Option.Some(1), Option.None, Option.Some(2)]
  let first-opt = match opts {
    [Option.Some(x), ..] => { "first is Some({x})" }
    [Option.None, ..] => { "first is None" }
    [..] => { "empty" }
  }
  write first-opt

  ; Wildcard in array
  let mixed = [1, 2, 3]
  let second-elem = match mixed {
    [_, x, ..] => { x }
    [..] => { 0 }
  }
  write second-elem

  ; Multiple exact lengths
  let len2 = [10, 20]
  let len-check = match len2 {
    [] => { "zero" }
    [_] => { "one" }
    [_, _] => { "two" }
    [..] => { "many" }
  }
  write len-check

  ; Guard with array
  let arr2 = [5, 10, 15]
  let arr-guard = match arr2 {
    [a, ..] if a > 10 => { "first > 10" }
    [a, ..] if a > 0 => { "first positive" }
    [..] => { "other" }
  }
  write arr-guard

  ; Rest binding produces correct array
  let rest-test = [100, 200, 300, 400]
  let rest-len = match rest-test {
    [_, ...rest] => { Iterable:length(rest) }
    [..] => { 0 }
  }
  write rest-len
}
