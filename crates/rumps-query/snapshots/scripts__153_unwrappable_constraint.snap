source: crates/rumps-query/tests/scripts.rs
description: "; Test Unwrappable and Coalescable constraints for Option/Result polymorphism\n\nfun main() {\n  ; ============================================================================\n  ; Basic Unwrappable constraint with inner type\n  ; ============================================================================\n\n  ; Works with Option\n  let opt = Option.Some(42)\n  write unwrap(opt)\n\n  ; Works with Result\n  let res = Result.Ok(\"hello\")\n  write unwrap(res)\n\n  ; ============================================================================\n  ; Coalescable with fallback\n  ; ============================================================================\n\n  write or-else(Option.Some(10), 0)\n  write or-else(Option.None, 99)\n  write or-else(Result.Ok(5), 0)\n  write or-else(Result.Err(\"oops\"), -1)\n\n  ; ============================================================================\n  ; Closure with Coalescable constraint\n  ; ============================================================================\n\n  let safe-get = [T, F: Coalescable[T]](x: F, default: T) -> T => x ?? default\n\n  write safe-get(Option.Some(100), 0)\n  write safe-get(Option.None, 42)\n\n  ; ============================================================================\n  ; Combining Coalescable with other constraints\n  ; ============================================================================\n\n  write numeric-or-zero(Option.Some(123))\n  write numeric-or-zero(Option.None: Option[Int])\n  write numeric-or-zero(Result.Ok(4.5))\n\n  ; ============================================================================\n  ; Union types with Unwrappable constraint\n  ; ============================================================================\n\n  write unwrappable-unwrap(Option.Some(42))\n  write unwrappable-unwrap(Result.Ok(99))\n\n  write union-or-default(Option.Some(10), 0)\n  write union-or-default(Option.None, 77)\n  write union-or-default(Result.Ok(5), 0)\n  write union-or-default(Result.Err(\"oops\"), -1)\n}\n\n; Generic unwrap function that works on any Option[T] or Result[T, E]\nfun unwrap[T, F: Unwrappable](x: F[T]) -> T {\n  x!\n}\n\n; Generic or-else function\nfun or-else[T, F: Coalescable[T]](x: F, default: T) -> T {\n  x ?? default\n}\n\n; Coalescable + Numeric fallback type\nfun numeric-or-zero[T: Numeric, F: Coalescable[T]](x: F) -> T {\n  x ?? 0\n}\n\n; Union of fallible types should satisfy Unwrappable constraint\nfun unwrappable-unwrap(x: Option[Int] | Result[Int, String]) -> Int {\n  x!\n}\n\n; Union with coalesce\nfun union-or-default(x: Option[Int] | Result[Int, String], default: Int) -> Int {\n  x ?? default\n}\n"
