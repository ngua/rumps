; Nested module types tests
;
; Tests that types in nested modules can be accessed without full qualification
; from child modules (looking up the module chain).
;
; Also tests that imported types work in function signatures.

import Outer.{ Id }
import Outer.Inner.{ }

fun main() {
  ; ============ Child module accesses parent module types ============

  let id: Outer.Id = Outer.Inner.make-id(42)
  write Outer.Inner.id-value(id)

  ; ============ Imported type in function signature ============

  write double-id(21)

  ; ============ Deeply nested modules ============

  let s1 = A.Status.Active
  write A.B.is-active(s1)
  let s2 = A.B.C.toggle(s1)
  write A.B.is-active(s2)

  ; ============ newtype lookup through module chain ============

  let score: Root.Score = 100
  let mult: Root.Level1.Multiplier = 1.5
  write Root.Level1.Level2.compute(score, mult)

  ; ============ union lookup through module chain ============

  let v1: Config.Value = 42
  let v2: Config.Value = "hello"
  write Config.Parser.is-int(v1)
  write Config.Parser.is-int(v2)

  ; ============ type with variants in nested module ============

  let box1 = Container.Box.Full(10)
  let box2: Container.Box[Int] = Container.Box.Empty
  write Container.Ops.is-full(box1)
  write Container.Ops.is-full(box2)
  let mapped = Container.Ops.map(box1, (x: Int) => x * 2)
  write mapped

  ; ============ Multiple types at different levels ============

  let a: Multi.A = 123
  let b: Multi.Sub1.B = "test"
  write Multi.Sub1.Sub2.combine(a, b)
}

module Outer {
  +newtype Id = +Int

  ; Inner module can use `Id` without `Outer.` prefix
  module Inner {
    +fun make-id(n: Int) -> Id { n }
    +fun id-value(i: Id) -> Int { i }
  }
}

; Function using imported type `Id` (imported from Outer.{ Id })
fun double-id(i: Id) -> Id { i * 2 }

module A {
  +variant Status = Active | Inactive

  module B {
    ; Can access A.Status as just `Status`
    +fun is-active(s: Status) -> Bool {
      match s {
        Status.Active => { true }
        Status.Inactive => { false }
      }
    }

    module C {
      ; Can still access A.Status as just `Status`
      +fun toggle(s: Status) -> Status {
        match s {
          Status.Active => { Status.Inactive }
          Status.Inactive => { Status.Active }
        }
      }
    }
  }
}

module Root {
  +newtype Score = +Int

  module Level1 {
    +newtype Multiplier = +Float

    module Level2 {
      ; Can access both Score and Multiplier without full qualification
      ; Newtypes are the underlying type, so direct arithmetic works
      +fun compute(s: Score, m: Multiplier) -> Float {
        (s: Int as Float) * m
      }
    }
  }
}

module Config {
  +union Value = Int | String | Bool

  module Parser {
    +fun is-int(v: Value) -> Bool {
      v is Int
    }
  }
}

module Container {
  +variant Box[T] = Full(T) | Empty

  module Ops {
    ; Can use `Box` without `Container.` prefix
    +fun is-full[T](b: Box[T]) -> Bool {
      match b {
        Box.Full(_) => { true }
        Box.Empty => { false }
      }
    }

    +fun map[A, B](b: Box[A], f: (A) -> B) -> Box[B] {
      match b {
        Box.Full(v) => { Box.Full(f(v)) }
        Box.Empty => { Box.Empty }
      }
    }
  }
}

module Multi {
  +newtype A = +Int

  module Sub1 {
    +newtype B = +String

    module Sub2 {
      ; Can access both A and B
      +fun combine(a: A, b: B) -> String {
        "{a}: {b}"
      }
    }
  }
}
