source: crates/rumps-query/tests/scripts.rs
description: "; is operator with parameterized types (Array[T], Map[K, V])\n; Tests that element/key/value types are checked, not just the container type\n\nfun main() {\n  ; === Array element type checks ===\n\n  let floats = [1.0, 2.0, 3.0]\n  write floats is Array[Float]\n  ; true\n\n  write floats is Array[Int]\n  ; false - floats are not ints\n\n  write floats is Array[Char]\n  ; false\n\n  let ints = [1, 2, 3]\n  write ints is Array[Int]\n  ; true\n\n  write ints is Array[Float]\n  ; false\n\n  write ints is Array[String]\n  ; false\n\n  ; === Empty array with annotation ===\n\n  ; Empty array without annotation is polymorphic (UNKNOWN element type)\n  let empty = []\n  write empty is Array[Int]\n  ; true - UNKNOWN matches anything\n\n  write empty is Array[String]\n  ; true - UNKNOWN matches anything\n\n  ; Empty array with annotation has concrete element type\n  let empty-bool: Array[Bool] = []\n  write empty-bool is Array[Bool]\n  ; true\n\n  write empty-bool is Array[Int]\n  ; false - annotated as Bool, not Int\n\n  write empty-bool is Array[String]\n  ; false\n\n  ; === Map key/value type checks ===\n\n  let str-to-int = { \"a\" => 1, \"b\" => 2 }\n  write str-to-int is Map[String, Int]\n  ; true\n\n  write str-to-int is Map[String, String]\n  ; false - values are Int, not String\n\n  write str-to-int is Map[Int, Int]\n  ; false - keys are String, not Int\n\n  ; Empty map with annotation\n  let empty-map: Map[Int, Bool] = Map.empty()\n  write empty-map is Map[Int, Bool]\n  ; true\n\n  write empty-map is Map[String, Int]\n  ; false - annotated as Map[Int, Bool]\n\n  ; === Inline annotation syntax ===\n\n  ; Verify inline annotations also refine types\n  let inline-arr = ([]) : Array[Char]\n  write inline-arr is Array[Char]\n  ; true\n\n  write inline-arr is Array[Int]\n  ; false - inline annotation makes it concrete\n\n  let box-int = { inner: 42 }\n  write box-int is Box[Int]\n  ; true\n\n  write box-int is Box[String]\n  ; false\n\n  write box-int is Box[Float]\n  ; false\n\n  ; === Tuple type checks ===\n\n  write (1, 'a') is (Int, Char)\n  ; true\n\n  write (1, 'a') is (Char, Int)\n  ; false - order matters\n\n  write (1, 2) is (Int, Int)\n  ; true\n\n  write (1, 2, 3) is (Int, Int, Int)\n  ; true\n\n  ; Single-element tuples\n  let single: (Int,) = (42,)\n  write single is (Int,)\n  ; true\n\n  ; Single-element tuple in closure annotations\n  let f = (x: (Int,)) -> (Int,) => x\n  write f((1,))\n  ; (1,)\n\n  ; Empty tuple\n  write () is ()\n  ; true\n\n  write \"parameterized is tests complete\"\n}\n\n; === User-defined parameterized types ===\n\nnewtype Box[T] = { inner: T }\n"
