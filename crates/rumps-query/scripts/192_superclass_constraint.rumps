; Test that [F: Chainable] implies Wrappable and Unwrappable

fun test[F: Chainable](x: F[Int]) -> Int {
  ; Uses ! (Unwrappable) and ? (Wrappable) inside a Chainable-constrained context
  let v = x!
  let wrapped = ?v
  Chainable:chain(wrapped, n => ?n)!
}

fun main() {
  write test(Option.Some(42))
}
