---
source: crates/rumps-query/tests/scripts.rs
description: "; Option and Result module primitives\n; Tests Option.unwrap-or, Option.map, Result.unwrap-or, Result.map, Result.map-err\n\n; ============ Option.unwrap-or ============\n\nLET some-val = Option.Some(42)\nLET none-val = Option.None\n\nWRITE Option.unwrap-or(some-val, 0)  ; 42\nWRITE Option.unwrap-or(none-val, 0)  ; 0\nWRITE Option.unwrap-or(Option.Some(\"hello\"), \"default\")  ; \"hello\"\nWRITE Option.unwrap-or(Option.None, \"default\")  ; \"default\"\n\n; ============ Option.map ============\n\nLET double = x => x * 2\nLET to-upper = s => String.upper(s)\n\nWRITE Option.map(Option.Some(21), double)  ; Some(42)\nWRITE Option.map(Option.None, double)  ; None\nWRITE Option.map(Option.Some(\"hello\"), to-upper)  ; Some(\"HELLO\")\nWRITE Option.map(Option.None, to-upper)  ; None\n\n; Inline closure\nWRITE Option.map(Option.Some(5), x => x + 1)  ; Some(6)\n\n; Chaining map\nLET opt = Option.Some(10)\nLET mapped = Option.map(opt, x => x * 2)\nWRITE mapped  ; Some(20)\nWRITE Option.map(mapped, x => x + 5)  ; Some(25)\n\n; ============ Result.unwrap-or ============\n\nLET ok-val = Result.Ok(100)\nLET err-val = Result.Err(\"something went wrong\")\n\nWRITE Result.unwrap-or(ok-val, 0)  ; 100\nWRITE Result.unwrap-or(err-val, 0)  ; 0\nWRITE Result.unwrap-or(Result.Ok(\"success\"), \"fallback\")  ; \"success\"\nWRITE Result.unwrap-or(Result.Err(\"fail\"), \"fallback\")  ; \"fallback\"\n\n; ============ Result.map ============\n\nWRITE Result.map(Result.Ok(21), double)  ; Ok(42)\nWRITE Result.map(Result.Err(\"err\"), double)  ; Err(\"err\")\nWRITE Result.map(Result.Ok(\"hello\"), to-upper)  ; Ok(\"HELLO\")\nWRITE Result.map(Result.Err(\"err\"), to-upper)  ; Err(\"err\")\n\n; Inline closure\nWRITE Result.map(Result.Ok(5), x => x + 1)  ; Ok(6)\n\n; ============ Result.map-err ============\n\nLET add-prefix = e => \"Error: {e}\"\n\nWRITE Result.map-err(Result.Err(\"failed\"), add-prefix)  ; Err(\"Error: failed\")\nWRITE Result.map-err(Result.Ok(42), add-prefix)  ; Ok(42)\nWRITE Result.map-err(Result.Err(\"oops\"), e => String.upper(e))  ; Err(\"OOPS\")\nWRITE Result.map-err(Result.Ok(\"ok\"), e => String.upper(e))  ; Ok(\"ok\")\n\n; ============ Combining operations ============\n\n; Option.map then unwrap-or\nLET maybe-num = Option.Some(10)\nLET doubled-or-zero = Option.unwrap-or(Option.map(maybe-num, x => x * 2), 0)\nWRITE doubled-or-zero  ; 20\n\nLET no-num = Option.None\nLET doubled-or-zero-none = Option.unwrap-or(Option.map(no-num, x => x * 2), 0)\nWRITE doubled-or-zero-none  ; 0\n\n; Result.map then unwrap-or\nLET res-ok = Result.Ok(5)\nLET res-mapped = Result.unwrap-or(Result.map(res-ok, x => x * 3), 0)\nWRITE res-mapped  ; 15\n\nLET res-err = Result.Err(\"bad\")\nLET res-err-mapped = Result.unwrap-or(Result.map(res-err, x => x * 3), 0)\nWRITE res-err-mapped  ; 0\n\n; ============ Type variants still work ============\n\n; Ensure Option.None and Result.Ok etc. still work as type constructors\nLET opt-none = Option.None\nLET opt-some = Option.Some(1)\nWRITE opt-none IS Option.None  ; true\nWRITE opt-some IS Option.Some(_)  ; true\n\nLET res-ok-check = Result.Ok(1)\nLET res-err-check = Result.Err(\"x\")\nWRITE res-ok-check IS Result.Ok(_)  ; true\nWRITE res-err-check IS Result.Err(_)  ; true\n\n; ============ Option.flat-map ============\n\n; Returns the inner Option when Some\nFUN safe-div(n, d) {\n  IF d == 0 { Option.None } ELSE { Option.Some(n // d) }\n}\n\nWRITE Option.flat-map(Option.Some(10), x => safe-div(x, 2))  ; Some(5)\nWRITE Option.flat-map(Option.Some(10), x => safe-div(x, 0))  ; None\nWRITE Option.flat-map(Option.None, x => safe-div(x, 2))  ; None\n\n; Chaining flat-map\nFUN parse-positive(x) {\n  IF x > 0 { Option.Some(x) } ELSE { Option.None }\n}\nFUN halve(x) {\n  IF x % 2 == 0 { Option.Some(x // 2) } ELSE { Option.None }\n}\n\nWRITE Option.flat-map(Option.flat-map(Option.Some(8), parse-positive), halve)  ; Some(4)\nWRITE Option.flat-map(Option.flat-map(Option.Some(-1), parse-positive), halve)  ; None\nWRITE Option.flat-map(Option.flat-map(Option.Some(7), parse-positive), halve)  ; None (7 is odd)\n\n; ============ Result.flat-map ============\n\n; Returns the inner Result when Ok\nFUN safe-div-res(n, d) {\n  IF d == 0 { Result.Err(\"div by zero\") } ELSE { Result.Ok(n // d) }\n}\n\nWRITE Result.flat-map(Result.Ok(10), x => safe-div-res(x, 2))  ; Ok(5)\nWRITE Result.flat-map(Result.Ok(10), x => safe-div-res(x, 0))  ; Err(\"div by zero\")\nWRITE Result.flat-map(Result.Err(\"bad input\"), x => safe-div-res(x, 2))  ; Err(\"bad input\")\n\n; Chaining flat-map\nFUN validate(x) {\n  IF x >= 0 { Result.Ok(x) } ELSE { Result.Err(\"negative\") }\n}\nFUN halve-res(x) {\n  IF x % 2 == 0 { Result.Ok(x // 2) } ELSE { Result.Err(\"odd\") }\n}\n\nWRITE Result.flat-map(Result.flat-map(Result.Ok(8), validate), halve-res)  ; Ok(4)\nWRITE Result.flat-map(Result.flat-map(Result.Ok(-1), validate), halve-res)  ; Err(\"negative\")\nWRITE Result.flat-map(Result.flat-map(Result.Ok(7), validate), halve-res)  ; Err(\"odd\")\n\n; ============ Option.flatten ============\n\n; Some(Some(v)) -> Some(v)\nWRITE Option.flatten(Option.Some(Option.Some(42)))  ; Some(42)\nWRITE Option.flatten(Option.Some(Option.Some(\"hello\")))  ; Some(\"hello\")\n\n; Some(None) -> None\nWRITE Option.flatten(Option.Some(Option.None))  ; None\n\n; None -> None\nWRITE Option.flatten(Option.None)  ; None\n\n; Practical: flatten after map that returns Option\nLET maybe-find = arr => Array.head(arr)\nLET nested = Option.map(Option.Some([1, 2, 3]), maybe-find)\nWRITE nested  ; Some(Some(1))\nWRITE Option.flatten(nested)  ; Some(1)\n\nLET empty-nested = Option.map(Option.Some([]), maybe-find)\nWRITE empty-nested  ; Some(None)\nWRITE Option.flatten(empty-nested)  ; None\n\n; ============ Result.flatten ============\n\n; Ok(Ok(v)) -> Ok(v)\nWRITE Result.flatten(Result.Ok(Result.Ok(42)))  ; Ok(42)\nWRITE Result.flatten(Result.Ok(Result.Ok(\"success\")))  ; Ok(\"success\")\n\n; Ok(Err(e)) -> Err(e)\nWRITE Result.flatten(Result.Ok(Result.Err(\"inner error\")))  ; Err(\"inner error\")\n\n; Err(e) -> Err(e)\nWRITE Result.flatten(Result.Err(\"outer error\"))  ; Err(\"outer error\")\n\n; Practical: flatten after map that returns Result\nFUN try-parse(s) {\n  IF s == \"42\" { Result.Ok(42) } ELSE { Result.Err(\"parse failed\") }\n}\nLET nested-res = Result.map(Result.Ok(\"42\"), try-parse)\nWRITE nested-res  ; Ok(Ok(42))\nWRITE Result.flatten(nested-res)  ; Ok(42)\n\nLET nested-err = Result.map(Result.Ok(\"bad\"), try-parse)\nWRITE nested-err  ; Ok(Err(\"parse failed\"))\nWRITE Result.flatten(nested-err)  ; Err(\"parse failed\")\n\n; ============ Result.hush ============\n\n; Ok(v) -> Some(v)\nWRITE Result.hush(Result.Ok(42))  ; Some(42)\nWRITE Result.hush(Result.Ok(\"hello\"))  ; Some(\"hello\")\n\n; Err(e) -> None (discards error)\nWRITE Result.hush(Result.Err(\"oops\"))  ; None\nWRITE Result.hush(Result.Err(123))  ; None\n\n; Practical: convert fallible operation to optional\nLET res: Result[Int, String] = Result.Ok(100)\nLET opt = Result.hush(res)\nWRITE opt  ; Some(100)\n\nLET bad-res: Result[Int, String] = Result.Err(\"failed\")\nWRITE Result.hush(bad-res)  ; None\n\n; ============ Option.note ============\n\n; Some(v) -> Ok(v)\nWRITE Option.note(\"not found\", Option.Some(42))  ; Ok(42)\nWRITE Option.note(\"missing\", Option.Some(\"hello\"))  ; Ok(\"hello\")\n\n; None -> Err(e) (using provided error)\nWRITE Option.note(\"not found\", Option.None)  ; Err(\"not found\")\nWRITE Option.note(404, Option.None)  ; Err(404)\n\n; Practical: convert optional lookup to result\nLET maybe: Option[Int] = Option.Some(999)\nLET noted: Result[Int, String] = Option.note(\"value missing\", maybe)\nWRITE noted  ; Ok(999)\n\nLET empty: Option[Int] = Option.None\nWRITE Option.note(\"value missing\", empty)  ; Err(\"value missing\")\n\n; ============ hush/note roundtrips ============\n\n; Ok -> hush -> note (preserves value)\nLET start = Result.Ok(123)\nLET hushed = Result.hush(start)\nLET back: Result[Int, String] = Option.note(\"lost\", hushed)\nWRITE back  ; Ok(123)\n\n; Some -> note -> hush (preserves value)\nLET s = Option.Some(456)\nLET noted2: Result[Int, String] = Option.note(\"err\", s)\nLET h = Result.hush(noted2)\nWRITE h  ; Some(456)\n\n; Err -> hush loses information\nLET e = Result.Err(\"important error\")\nLET lost = Result.hush(e)\nWRITE lost  ; None\n\n; None -> note adds error\nLET n = Option.None\nLET gained: Result[Int, String] = Option.note(\"added error\", n)\nWRITE gained  ; Err(\"added error\")\n"
