; Test: equality for complex types
; Tests structural equality for arrays, objects, and tagged values

fun main() {
  ; === Array Equality ===

  let a1 = [1, 2, 3]
  let a2 = [1, 2, 3]
  let a3 = [1, 2, 4]
  let a4 = [1, 2]

  write a1 == a2
  ; Expected: true (same elements)

  write a1 == a3
  ; Expected: false (different last element)

  write a1 == a4
  ; Expected: false (different length)

  write a1 != a3
  ; Expected: true

  ; Empty arrays
  let empty1 = []
  let empty2 = []
  write empty1 == empty2
  ; Expected: true

  ; Nested arrays
  let nested1 = [[1, 2], [3, 4]]
  let nested2 = [[1, 2], [3, 4]]
  let nested3 = [[1, 2], [3, 5]]

  write nested1 == nested2
  ; Expected: true

  write nested1 == nested3
  ; Expected: false

  ; === Object Equality ===

  let o1 = { a: 1, b: 2 }
  let o2 = { a: 1, b: 2 }
  let o3 = { a: 1, b: 3 }
  let o4 = { a: 1 }

  write o1 == o2
  ; Expected: true (same keys and values)

  write o1 == o3
  ; Expected: false (different value)

  write o1 == o4
  ; Expected: false (different keys)

  write o1 != o3
  ; Expected: true

  ; Empty objects
  let empty-obj-a = {}
  let empty-obj-b = {}
  write empty-obj-a == empty-obj-b
  ; Expected: true

  ; Nested objects
  let no1 = { outer: { inner: 42 } }
  let no2 = { outer: { inner: 42 } }
  let no3 = { outer: { inner: 99 } }

  write no1 == no2
  ; Expected: true

  write no1 == no3
  ; Expected: false

  ; Objects with arrays
  let oa1 = { items: [1, 2, 3] }
  let oa2 = { items: [1, 2, 3] }
  let oa3 = { items: [1, 2, 4] }

  write oa1 == oa2
  ; Expected: true

  write oa1 == oa3
  ; Expected: false

  ; === Same-type Equality ===

  write 5 == 5
  ; Expected: true (same type comparison)

  write 5.0 == 5.0
  ; Expected: true (same type comparison)

  write [1, 2, 3] == [1, 2, 3]
  ; Expected: true

  write { x: 5 } == { x: 5 }
  ; Expected: true

  write "Equality test complete"
}
