; Test Ref as first-class type

fun main() {
  ; Create refs to locals and globals
  let local-ref = data{1, 2}
  let global-ref = ^info{"key"}

  write :display(local-ref)
  write :display(global-ref)

  ; Set up some data
  @set data{1, 2} "nested"
  @set data{42} "found"
  transaction {
    @set ^info{"key"} "global value"
  }

  ; Use refs with functions
  write :display(get-or-default(local-ref, "missing"))
  write :display(get-or-default(global-ref, "missing"))
  write :display(get-or-default(data{999}, "not found"))

  ; Direct ref usage
  let r = data{42}
  write :display(r)
  write :display(@get r)

  ; Refs in collections
  let refs = [data{1}, data{2}, data{3}]
  write :display(refs)

  ; Ref with spread subscripts
  let keys = [1, 2]
  let spread-ref = data{...keys}
  write :display(spread-ref)
  @set data{1, 2} "via spread"
  write :display(@get spread-ref)

  let returned = make-ref(42)
  write :display(returned)
  write :display(@get returned)

  ; @set and @kill with local Ref variable (no transaction needed)
  let set-ref = data{100}
  @set set-ref "via ref"
  write :display(@get set-ref)

  ; KILL local ref via variable (no transaction needed)
  let kill-ref = data{100}
  @kill kill-ref
  write :display(@get kill-ref ?? "killed")

  ; Global ref via variable (requires transaction)
  transaction {
    let g-ref = ^info{"txn-key"}
    @set g-ref "set via ref"
    write :display(@get g-ref)
    @kill g-ref
    write :display(@get g-ref ?? "global killed")
  }

  ; Ref equality comparison
  let ref1 = data{1, 2}
  let ref2 = data{1, 2}
  let ref3 = data{1, 3}
  let ref4 = ^info{"key"}

  write ref1 == ref2
  write ref1 == ref3
  write ref1 == ref4
  write ref1 != ref3
}

; Function that takes a Ref
fun get-or-default(r: Ref, default: Storable) -> Storable {
  @get r ?? default
}

; Function that returns a Ref
fun make-ref(key: Int) -> Ref {
  data{key}
}
