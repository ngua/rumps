; Test: type conversions
; Tests explicit type conversion with as and string interpolation

fun main() {
  ; === Explicit Type Conversion with as ===

  ; Addition with explicit conversion to Float
  let a = (10 as Float) + 3.5
  write a
  ; Expected: 13.5 (Float)

  let b = 3.5 + (10 as Float)
  write b
  ; Expected: 13.5 (Float)

  ; Subtraction with explicit conversion
  let c = (10 as Float) - 2.5
  write c
  ; Expected: 7.5 (Float)

  let d = 10.5 - (3 as Float)
  write d
  ; Expected: 7.5 (Float)

  ; Multiplication with explicit conversion
  let e = (5 as Float) * 2.5
  write e
  ; Expected: 12.5 (Float)

  let f = 2.5 * (4 as Float)
  write f
  ; Expected: 10.0 (Float)

  ; Division (requires Float operands)
  let g = (10 as Float) / 4.0
  write g
  ; Expected: 2.5 (Float)

  let h = 10.0 / (4 as Float)
  write h
  ; Expected: 2.5 (Float)

  ; Float division
  let i = 10.0 / 5.0
  write i
  ; Expected: 2.0 (Float)

  ; Floor division (same-type operands)
  let j = 10.0 // 3.0
  write j
  ; Expected: 3.0 (Float)

  let k = 10 // 3
  write k
  ; Expected: 3 (Int)

  ; Modulo (same-type operands)
  let l = 10.0 % 3.5
  write l
  ; Expected: 3.0 (Float; 10.0 % 3.5 = 3.0)

  let m = 10.5 % 3.0
  write m
  ; Expected: 1.5 (Float; 10.5 % 3.0 = 1.5)

  ; === String Conversion (via interpolation) ===

  ; Int to string
  write "Number: {42}"
  ; Expected: Number: 42

  ; Float to string
  write "Pi: {3.14159}"
  ; Expected: Pi: 3.14159

  ; Bool to string
  write "Flag: {true}"
  ; Expected: Flag: true

  write "Flag: {false}"
  ; Expected: Flag: false

  ; === Same-type Numeric Comparison ===

  write 5 == 5
  ; Expected: true

  write 5.0 == 5.0
  ; Expected: true

  write 10 < 11
  ; Expected: true

  write 10.5 > 10.0
  ; Expected: true

  write 3 >= 3
  ; Expected: true

  write 3.0 <= 3.0
  ; Expected: true

  write "Type conversion test complete"
}
