; Binary operator dispatch through user-defined class instances
;
; Tests that operators like `==`, `+`, `<`, etc... dispatch to
; user-defined class implementations on newtypes, rather than
; falling through to the underlying type's builtin instance.

fun main() {
  ; === Eq: custom `==` raises ===

  let a: X[Unit] = 1
  let b: X[Unit] = 1
  write (a == b) catch e => false

  ; === Eq: custom `!=` also dispatches through `eq` ===

  write (a != b) catch e => false

  ; === Numeric: custom `+` on newtype (doubles result) ===

  let x: MyInt = 10
  let y: MyInt = 3
  write x + y
  write x - y
  write x * y
  write x // y
  write x % y
  write x ** y

  ; === Ord: custom `<`, `>`, `<=`, `>=` on newtype ===
  ; Priority has reversed ordering (higher number = lower priority)

  let lo: Priority = 10
  let hi: Priority = 1
  write lo < hi
  write lo > hi
  write lo <= hi
  write lo >= hi
  write lo == hi

  ; Same values
  let s1: Priority = 5
  let s2: Priority = 5
  write s1 <= s2
  write s1 >= s2
  write s1 == s2

  ; === Auto-derive inside class body ===
  ; Operators inside `class Numeric for MyInt` should use the
  ; underlying `Int` arithmetic, not recurse infinitely.

  let p: MyInt = 2
  let q: MyInt = 3
  write p + q
}

; Newtype whose `Eq` always raises
newtype X[T] = Int

class Eq for X[T] {
  fun eq(a: X[T], b: X[T]) -> Bool {
    raise "no eq for X"
  }
}

; Newtype with custom `Numeric` that doubles every result
newtype MyInt = Int

class Numeric for MyInt {
  fun add(a: MyInt, b: MyInt) -> MyInt {
    let x: Int = a
    let y: Int = b
    (x + y) * 2
  }
  fun sub(a: MyInt, b: MyInt) -> MyInt {
    let x: Int = a
    let y: Int = b
    (x - y) * 2
  }
  fun mul(a: MyInt, b: MyInt) -> MyInt {
    let x: Int = a
    let y: Int = b
    (x * y) * 2
  }
  fun floor-div(a: MyInt, b: MyInt) -> MyInt {
    let x: Int = a
    let y: Int = b
    (x // y) * 2
  }
  fun mod(a: MyInt, b: MyInt) -> MyInt {
    let x: Int = a
    let y: Int = b
    (x % y) * 2
  }
  fun pow(a: MyInt, b: MyInt) -> MyInt {
    let x: Int = a
    let y: Int = b
    (x ** y) * 2
  }
}

; Newtype with reversed ordering
newtype Priority = Int

class Ord for Priority {
  fun compare(a: Priority, b: Priority) -> Ordering {
    let x: Int = a
    let y: Int = b
    ; Reversed: higher number = lower priority
    if x > y { Ordering.Lt } else {
      if x == y { Ordering.Eq } else { Ordering.Gt }
    }
  }
}

class Eq for Priority {
  fun eq(a: Priority, b: Priority) -> Bool {
    let x: Int = a
    let y: Int = b
    x == y
  }
}
