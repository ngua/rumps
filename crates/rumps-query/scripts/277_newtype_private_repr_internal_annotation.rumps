module CoercePrivInternal {
  +newtype A[T] = Array[T]

  +fun wrap-ann(xs: Array[Int]) -> CoercePrivInternal.A[Int] {
    let ys: CoercePrivInternal.A[Int] = xs
    ys
  }

  +fun unwrap-ann(xs: CoercePrivInternal.A[Int]) -> Array[Int] {
    let ys: Array[Int] = xs
    ys
  }

  +fun wrap-as(xs: Array[Int]) -> CoercePrivInternal.A[Int] {
    xs as CoercePrivInternal.A[Int]
  }

  +fun unwrap-as(xs: CoercePrivInternal.A[Int]) -> Array[Int] {
    xs as Array[Int]
  }
}

fun main() {
  let ann = CoercePrivInternal.wrap-ann([1, 2, 3, 4])
  let ann-xs = CoercePrivInternal.unwrap-ann(ann)
  write Iterable:length(ann-xs)

  let as-val = CoercePrivInternal.wrap-as([5, 6, 7])
  let as-xs = CoercePrivInternal.unwrap-as(as-val)
  write Iterable:length(as-xs)
}
