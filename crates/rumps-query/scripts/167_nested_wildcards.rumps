; Nested wildcards in IS checks

FUN main() {
  ; Simple wildcard
  LET x: Option[Int] = Option.Some(42)
  WRITE x IS Option[_]

  ; 2 levels: Array[Option[_]]
  LET arr: Array[Option[Int]] = [Option.Some(1), Option.None]
  WRITE arr IS Array[_]
  WRITE arr IS Array[Option[_]]

  ; 2 levels: Option[Array[_]]
  LET opt: Option[Array[Int]] = Option.Some([1, 2, 3])
  WRITE opt IS Option[_]
  WRITE opt IS Option[Array[_]]

  ; 3 levels
  LET v3: Array[Option[Result[Int, String]]] = [Option.Some(Result.Ok(42))]
  WRITE v3 IS Array[Option[Result[_, _]]]

  ; 4 levels
  LET v4: Array[Option[Result[Array[Int], String]]] = [Option.Some(Result.Ok([1]))]
  WRITE v4 IS Array[Option[Result[Array[_], _]]]

  ; 5 levels
  LET v5: Array[Option[Result[Array[Option[Int]], String]]] = [Option.Some(Result.Ok([Option.Some(1)]))]
  WRITE v5 IS Array[Option[Result[Array[Option[_]], _]]]

  ; 6 levels (maximum supported)
  LET v6: Array[Option[Result[Array[Option[Result[Int, String]]], String]]] = [Option.Some(Result.Ok([Option.Some(Result.Ok(1))]))]
  WRITE v6 IS Array[Option[Result[Array[Option[Result[_, _]]], _]]]

  ; Negative cases: mismatched nested types
  LET arr2: Array[Option[Int]] = [Option.Some(1)]
  WRITE arr2 IS Array[Result[_, _]]

  LET opt2: Option[Int] = Option.Some(42)
  WRITE opt2 IS Option[Array[_]]
}
