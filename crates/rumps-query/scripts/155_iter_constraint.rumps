; Iter module: works on arrays and ranges

fun main() {
  ; Iterable:length on Array
  let arr = [1, 2, 3, 4, 5]
  write "Array length: {Iterable:length(arr)}"
  write "Array literal length: {Iterable:length([1, 2, 3])}"

  ; `Iterable:length` on `Range`
  write "Range (1..=10) length: {Iterable:length(1 ..= 10)}"
  write "Range (1..10) length: {Iterable:length(1 .. 10)}"
  write "Range (10..1) length: {Iterable:length(10 .. 1)}"

  ; `Array.contains` on `Array`
  write "Array contains 3: {Array.contains(arr, 3)}"
  write "Array contains 99: {Array.contains(arr, 99)}"

  ; `Array.contains` on collected `Range`
  write "Range contains 5: {Array.contains(Range.collect(1 ..= 10), 5)}"
  write "Range contains 11: {Array.contains(Range.collect(1 ..= 10), 11)}"

  ; Mappable:map on Array (Range is not Mappable; collect first)
  write "Doubled array: {:display(Mappable:map(x => x * 2, arr))}"
  write "Doubled range: {:display(Mappable:map(x => x * 2, Range.collect(1 ..= 5)))}"

  ; Filterable:filter on Array
  write "Evens from array: {:display(Filterable:filter(x => x % 2 == 0, arr))}"
  write "Evens from range: {:display(Filterable:filter(x => x % 2 == 0, Range.collect(1 ..= 10)))}"

  ; `Foldable:fold` on `Array` and collected `Range`
  write "Sum of array: {Foldable:fold((a, x) => a + x, 0, arr)}"
  write "Sum of range: {Foldable:fold((a, x) => a + x, 0, Range.collect(1 ..= 10))}"

  write "Generic sum (array): {sum-iter(arr)}"
  write "Generic sum (range): {sum-iter(Range.collect(1 ..= 10))}"

  write "Generic count (array): {count-iter(arr)}"
  write "Generic count (range): {count-iter(1 ..= 10)}"

  ; `Iterable:reverse` on `Array` and `Range`
  write "Reversed array: {:display(Iterable:reverse(arr))}"
  write "Reversed array literal: {:display(Iterable:reverse([1, 2, 3]))}"
  write "Reversed range: {:display(Iterable:reverse(1 ..= 5))}"
  write "Reversed range (1..10): {:display(Iterable:reverse(1 .. 10))}"
  write "Reversed range length (1..10): {Iterable:length(Iterable:reverse(1 .. 10))}"
  write "Collected reversed range (1..10): {:display(Range.collect(Iterable:reverse(1 .. 10)))}"
  write "Reversed range (10..1): {:display(Iterable:reverse(10 .. 1))}"
  write "Collected reversed range (10..1): {:display(Range.collect(Iterable:reverse(10 .. 1)))}"
  write "Reversed range (5..5): {:display(Iterable:reverse(5 .. 5))}"
  write "Reversed range length (5..5): {Iterable:length(Iterable:reverse(5 .. 5))}"
  write "Collected reversed range (5..5): {:display(Range.collect(Iterable:reverse(5 .. 5)))}"

  ; `Iterable:reverse` preserves concrete return types
  let chars = ['a', 'b', 'c']
  let rev-chars: Array[Char] = Iterable:reverse(chars)
  write "Reversed chars: {:display(rev-chars)}"

  let rev-range: Range = Iterable:reverse(1 .. 5)
  write "Typed reversed range: {:display(rev-range)}"

  let rev-arr = Iterable:reverse
  write "Stored reverse fn array: {:display(rev-arr([1, 2, 3]))}"

  let rev-r = Iterable:reverse
  write "Stored reverse fn range: {:display(rev-r(1 ..= 3))}"

  write "Keep chars: {:display(keep-chars(chars))}"
  write "Keep range: {:display(keep-range(1 ..= 4))}"

  ; foreach on Array and Range (Range must be collected first)
  foreach(x => write "foreach array: {x}", [10, 20])
  foreach(x => write "foreach range: {x}", Range.collect(1 ..= 3))
}

; Generic functions with array and `Iterable` constraints
fun sum-iter(i: Array[Int]) -> Int {
  Foldable:fold((a, x) => a + x, 0, i)
}

fun count-iter[T: Iterable](i: T) -> Int {
  Iterable:length(i)
}

fun keep-chars(xs: Array[Char]) -> Array[Char] {
  Iterable:reverse(xs)
}

fun keep-range(r: Range) -> Range {
  Iterable:reverse(r)
}
