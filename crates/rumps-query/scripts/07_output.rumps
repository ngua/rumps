; Test: @OUTPUT statement
; Tests various @OUTPUT scenarios

; Output literal integer
@OUTPUT 42
; Expected: 42

; Output literal float
@OUTPUT 3.14159
; Expected: 3.14159

; Output literal string
@OUTPUT "Hello, World!"
; Expected: Hello, World!

; Output literal boolean
@OUTPUT TRUE
@OUTPUT FALSE
; Expected: true, false

; Output variable
LET x = 123
@OUTPUT x
; Expected: 123

; Output expression result
@OUTPUT 10 + 20 * 3
; Expected: 70

; Output string interpolation
@OUTPUT "{"Hello"} {"RUMPS"}"
; Expected: Hello RUMPS

; Output comparison result
@OUTPUT 5 < 10
; Expected: true

; Output logical result
@OUTPUT TRUE AND FALSE
; Expected: false

@OUTPUT NOT FALSE
; Expected: true

; Output from block result
LET result = {
  LET a = 5
  LET b = 10
  a + b
}
@OUTPUT result
; Expected: 15

; Multiple outputs in sequence
@OUTPUT "Line 1"
@OUTPUT "Line 2"
@OUTPUT "Line 3"

@OUTPUT "@OUTPUT test complete"
