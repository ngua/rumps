; Union-typed array tests
;
; Tests for bidirectional type checking of array literals with union element types.
; When an array literal has an annotation like `Array[Subscript]`, it should not
; fall back to json for heterogeneous elements; instead, each element is checked
; against the union type.

fun main() {
  ; === Comparison: without vs with annotation ===

  ; WITHOUT annotation: heterogeneous array becomes Json
  let json-arr = [1, "a", true]
  write json-arr is Json

  ; with annotation: stays as native Array (not Json)
  let sub-arr: Array[Subscript] = [1, "a", true]
  write sub-arr is Json
  write Iterable:length(sub-arr)

  ; === Named union: Subscript ===

  let subscript-arr: Array[Subscript] = [42, "hello", 3.14, 'x', true]
  write Iterable:length(subscript-arr)

  ; === Named union: Storable ===

  let storable-arr: Array[Storable] = [true, 42, 3.14, 'x', "str"]
  write Iterable:length(storable-arr)

  ; === Named union: Scalar ===

  let scalar-arr: Array[Scalar] = [true, 42, 3.14, "str"]
  write Iterable:length(scalar-arr)

  ; === Anonymous union ===

  let anon-arr: Array[Int | String] = [42, "hello", 99, "world"]
  write Iterable:length(anon-arr)

  ; === User-defined union ===

  let ids: Array[Id] = [1, "abc", 2, "def"]
  write Iterable:length(ids)

  ; === Empty array with union element type ===

  let empty: Array[Int | String] = []
  write Iterable:length(empty)

  ; === Spread in union arrays ===

  let ints = [1, 2, 3]
  let strs: Array[String] = ["a", "b"]

  ; Spread homogeneous arrays into union array
  let combined: Array[Int | String] = [...ints, "x", ...strs, 4]
  write Iterable:length(combined)

  ; === Iteration over union array ===

  let arr: Array[Int | String] = [1, "two", 3, "four"]

  ; Iterable:foreach works on union arrays
  Iterable:foreach(x => {
    match x {
      n is Int => { write "int: {n}" }
      s is String => { write "str: {s}" }
      _ => { write "other" }
    }
  }, arr)

  ; Mappable:map with union elements
  let mapped = Mappable:map(x => {
    match x {
      n is Int => { n * 2 }
      s is String => { String.length(s) }
      _ => { 0 }
    }
  }, arr)
  write mapped

  ; === Verify elements preserve their concrete types ===

  ; Use Filterable:filter to extract Int elements
  let ints-only = Filterable:filter(x => x is Int, arr)
  write Iterable:length(ints-only)

  ; Use Filterable:filter to extract String elements
  let strs-only = Filterable:filter(x => x is String, arr)
  write Iterable:length(strs-only)
}

union Id = Int | String
