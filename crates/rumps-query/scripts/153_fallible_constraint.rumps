; Test Fallible and Coalescable constraints for Option/Result polymorphism

fun main() {
  ; ============================================================================
  ; Basic Fallible constraint with inner type
  ; ============================================================================

  ; Works with Option
  let opt = Option.Some(42)
  write unwrap(opt)

  ; Works with Result
  let res = Result.Ok("hello")
  write unwrap(res)

  ; ============================================================================
  ; Coalescable with fallback
  ; ============================================================================

  write or-else(Option.Some(10), 0)
  write or-else(Option.None, 99)
  write or-else(Result.Ok(5), 0)
  write or-else(Result.Err("oops"), -1)

  ; ============================================================================
  ; Closure with Coalescable constraint
  ; ============================================================================

  let safe-get = [T, F: Coalescable[T]](x: F, default: T) -> T => x ?? default

  write safe-get(Option.Some(100), 0)
  write safe-get(Option.None, 42)

  ; ============================================================================
  ; Combining Coalescable with other constraints
  ; ============================================================================

  write numeric-or-zero(Option.Some(123))
  write numeric-or-zero(Option.None: Option[Int])
  write numeric-or-zero(Result.Ok(4.5))

  ; ============================================================================
  ; Union types with Fallible constraint
  ; ============================================================================

  write fallible-unwrap(Option.Some(42))
  write fallible-unwrap(Result.Ok(99))

  write union-or-default(Option.Some(10), 0)
  write union-or-default(Option.None, 77)
  write union-or-default(Result.Ok(5), 0)
  write union-or-default(Result.Err("oops"), -1)
}

; Generic unwrap function that works on any Option[T] or Result[T, E]
fun unwrap[T, F: Fallible](x: F[T]) -> T {
  x!
}

; Generic or-else function
fun or-else[T, F: Coalescable[T]](x: F, default: T) -> T {
  x ?? default
}

; Coalescable + Numeric fallback type
fun numeric-or-zero[T: Numeric, F: Coalescable[T]](x: F) -> T {
  x ?? 0
}

; Union of fallible types should satisfy Fallible constraint
fun fallible-unwrap(x: Option[Int] | Result[Int, String]) -> Int {
  x!
}

; Union with coalesce
fun union-or-default(x: Option[Int] | Result[Int, String], default: Int) -> Int {
  x ?? default
}
