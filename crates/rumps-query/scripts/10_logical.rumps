; Test: logical operators
; Tests AND, OR, NOT with both keyword and symbol forms

; AND operator (keyword)
$OUTPUT TRUE AND TRUE
; Expected: true

$OUTPUT TRUE AND FALSE
; Expected: false

$OUTPUT FALSE AND TRUE
; Expected: false

$OUTPUT FALSE AND FALSE
; Expected: false

; AND operator (symbol)
$OUTPUT TRUE && TRUE
; Expected: true

$OUTPUT TRUE && FALSE
; Expected: false

; OR operator (keyword)
$OUTPUT TRUE OR TRUE
; Expected: true

$OUTPUT TRUE OR FALSE
; Expected: true

$OUTPUT FALSE OR TRUE
; Expected: true

$OUTPUT FALSE OR FALSE
; Expected: false

; OR operator (symbol)
$OUTPUT TRUE || FALSE
; Expected: true

$OUTPUT FALSE || FALSE
; Expected: false

; NOT operator (keyword)
$OUTPUT NOT TRUE
; Expected: false

$OUTPUT NOT FALSE
; Expected: true

; NOT operator (symbol)
$OUTPUT !TRUE
; Expected: false

$OUTPUT !FALSE
; Expected: true

; Precedence: NOT before AND before OR
$OUTPUT NOT FALSE AND TRUE
; Expected: true (NOT binds tighter)

$OUTPUT TRUE OR FALSE AND FALSE
; Expected: true (AND binds tighter than OR)

$OUTPUT FALSE OR TRUE AND TRUE
; Expected: true

; Parentheses override precedence
$OUTPUT (TRUE OR FALSE) AND FALSE
; Expected: false

$OUTPUT NOT (TRUE AND FALSE)
; Expected: true

; Complex expressions
$OUTPUT (TRUE AND FALSE) OR (FALSE OR TRUE)
; Expected: true

$OUTPUT NOT (FALSE OR FALSE)
; Expected: true

$OUTPUT (NOT FALSE) AND (NOT FALSE)
; Expected: true

; With variables
LET a = TRUE
LET b = FALSE
$OUTPUT a AND NOT b
; Expected: true

$OUTPUT NOT a OR b
; Expected: false

$OUTPUT (a OR b) AND (NOT b)
; Expected: true

$OUTPUT "Logical operators test complete"
