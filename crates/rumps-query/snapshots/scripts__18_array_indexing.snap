source: crates/rumps-query/tests/scripts.rs
description: "; Test: array indexing (including negative)\n; Tests array index access with positive and negative indices\n\nfun main() {\n  let arr = [10, 20, 30, 40, 50]\n\n  ; Positive indexing (0-based)\n  write arr[0]\n  ; Expected: 10\n\n  write arr[1]\n  ; Expected: 20\n\n  write arr[2]\n  ; Expected: 30\n\n  write arr[3]\n  ; Expected: 40\n\n  write arr[4]\n  ; Expected: 50\n\n  ; Negative indexing (from end)\n  write arr[-1]\n  ; Expected: 50 (last element)\n\n  write arr[-2]\n  ; Expected: 40 (second to last)\n\n  write arr[-3]\n  ; Expected: 30\n\n  write arr[-4]\n  ; Expected: 20\n\n  write arr[-5]\n  ; Expected: 10 (first element via negative)\n\n  ; Index with expression\n  let idx = 2\n  write arr[idx]\n  ; Expected: 30\n\n  let neg-idx = -1\n  write arr[neg-idx]\n  ; Expected: 50\n\n  ; Index with arithmetic\n  write arr[1 + 1]\n  ; Expected: 30 (arr[2])\n\n  write arr[5 - 3]\n  ; Expected: 30 (arr[2])\n\n  ; Nested array indexing\n  let matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]\n  write matrix[0][0]\n  ; Expected: 1\n\n  write matrix[1][1]\n  ; Expected: 5\n\n  write matrix[2][2]\n  ; Expected: 9\n\n  write matrix[-1][-1]\n  ; Expected: 9 (last row, last col)\n\n  write matrix[0][-1]\n  ; Expected: 3 (first row, last col)\n\n  ; Single element array\n  let single = [42]\n  write single[0]\n  ; Expected: 42\n\n  write single[-1]\n  ; Expected: 42\n\n  write \"Array indexing test complete\"\n}\n"
