---
source: crates/rumps-query/tests/scripts.rs
description: "; User-defined modules\n; Tests MODULE definition, functions, constants, and nested modules\n\n; ============ Basic module with functions ============\n\nMODULE Counter {\n  FUN new() -> Int { 0 }\n  FUN inc(x: Int) -> Int { x + 1 }\n  FUN add(x: Int, y: Int) -> Int { x + y }\n}\n\nLET c = Counter.new()\nOUTPUT c  ; 0\n\nLET c1 = Counter.inc(c)\nOUTPUT c1  ; 1\n\nLET c2 = Counter.add(c1, 10)\nOUTPUT c2  ; 11\n\n; ============ Module with constants ============\n\nMODULE Config {\n  LET max-size = 1000\n  LET default-name = \"unnamed\"\n  LET ratio = 3.14\n}\n\nOUTPUT Config.max-size  ; 1000\nOUTPUT Config.default-name  ; unnamed\nOUTPUT Config.ratio > 3  ; true\n\n; Use constants in expressions\nLET scaled = Config.max-size * 2\nOUTPUT scaled  ; 2000\n\n; ============ Module with both functions and constants ============\n\nMODULE Geometry {\n  LET pi = 3.14159\n\n  FUN area(r: Float) -> Float {\n    Geometry.pi * r * r\n  }\n\n  FUN circumference(r: Float) -> Float {\n    2.0 * Geometry.pi * r\n  }\n}\n\nOUTPUT Geometry.pi > 3  ; true\n\nLET a = Geometry.area(2.0)\nOUTPUT a > 12  ; true\n\nLET circ = Geometry.circumference(1.0)\nOUTPUT circ > 6  ; true\n\n; ============ Nested modules ============\n\nMODULE Outer {\n  LET val = 100\n\n  FUN value() -> Int { Outer.val }\n\n  MODULE Inner {\n    LET secret = 42\n\n    FUN get-secret() -> Int { Outer.Inner.secret }\n    FUN combined() -> Int { Outer.val + Outer.Inner.secret }\n  }\n}\n\nOUTPUT Outer.val  ; 100\nOUTPUT Outer.value()  ; 100\nOUTPUT Outer.Inner.secret  ; 42\nOUTPUT Outer.Inner.get-secret()  ; 42\nOUTPUT Outer.Inner.combined()  ; 142\n\n; ============ Generic functions in modules ============\n\nMODULE Utils {\n  FUN identity[T](x: T) -> T { x }\n  FUN pair[A, B](a: A, b: B) -> (A, B) { (a, b) }\n}\n\nLET id-int = Utils.identity(42)\nOUTPUT id-int  ; 42\n\nLET id-str = Utils.identity(\"hello\")\nOUTPUT id-str  ; hello\n\nLET p = Utils.pair(1, \"one\")\nOUTPUT p  ; (1, one)\n\n; ============ Module function as value ============\n\nLET inc-fn = Counter.inc\nLET result = inc-fn(5)\nOUTPUT result  ; 6\n\n; ============ Module with closures ============\n\nMODULE Adder {\n  FUN make(n: Int) -> (Int) -> Int {\n    x => x + n\n  }\n}\n\nLET add5 = Adder.make(5)\nOUTPUT add5(10)  ; 15\n\nLET add10 = Adder.make(10)\nOUTPUT add10(7)  ; 17\n\n; ============ Monomorphic higher-order functions ============\n\nMODULE MonoHof {\n  FUN apply(f: (Int) -> Int, x: Int) -> Int {\n    f(x)\n  }\n\n  FUN map-twice(f: (Int) -> Int, x: Int) -> Int {\n    f(f(x))\n  }\n}\n\nOUTPUT MonoHof.apply(n => n + 1, 5)  ; 6\nOUTPUT MonoHof.map-twice(n => n * 2, 3)  ; 12\n\n; ============ Polymorphic higher-order functions ============\n\nMODULE PolyHof {\n  FUN apply[T, U](f: (T) -> U, x: T) -> U {\n    f(x)\n  }\n\n  FUN compose[A, B, C](f: (B) -> C, g: (A) -> B, x: A) -> C {\n    f(g(x))\n  }\n}\n\n; Int -> Int\nOUTPUT PolyHof.apply(n => n + 1, 5)  ; 6\n\n; Int -> String\nOUTPUT PolyHof.apply(n => \"num: \" ++ (n as String), 42)  ; num: 42\n\n; String -> Int\nOUTPUT PolyHof.apply(s => String.length(s), \"hello\")  ; 5\n\n; Compose: Int -> Int -> String\nOUTPUT PolyHof.compose(n => \"result: \" ++ (n as String), x => x * 2, 10)  ; result: 20\n\n; ============ Module with TYPE definitions ============\n\nMODULE Shapes {\n  TYPE Shape = Circle(Float) | Rectangle(Float, Float)\n\n  FUN area(s: Shapes.Shape) -> Float {\n    MATCH s {\n      Shapes.Shape.Circle(r) => 3.14159 * r * r\n      Shapes.Shape.Rectangle(w, h) => w * h\n    }\n  }\n\n  FUN describe(s: Shapes.Shape) -> String {\n    MATCH s {\n      Shapes.Shape.Circle(_) => \"circle\"\n      Shapes.Shape.Rectangle(_, _) => \"rectangle\"\n    }\n  }\n}\n\nLET c = Shapes.Shape.Circle(2.0)\nLET r = Shapes.Shape.Rectangle(3.0, 4.0)\n\nOUTPUT Shapes.describe(c)  ; circle\nOUTPUT Shapes.describe(r)  ; rectangle\nOUTPUT Shapes.area(c) > 12  ; true (approx 12.56)\nOUTPUT Shapes.area(r) > 11  ; true (12.0)\n\n; ============ Module with struct TYPE ============\n\nMODULE Users {\n  TYPE User = { name: String, age: Int }\n\n  FUN greet(u: Users.User) -> String {\n    \"Hello, \" ++ u.name\n  }\n\n  FUN is-adult(u: Users.User) -> Bool {\n    u.age >= 18\n  }\n}\n\nLET u: Users.User = { name: \"Alice\", age: 30 }\nOUTPUT Users.greet(u)  ; Hello, Alice\nOUTPUT Users.is-adult(u)  ; true\n\nLET child: Users.User = { name: \"Bob\", age: 10 }\nOUTPUT Users.is-adult(child)  ; false\n\n; ============ Module with UNION definition ============\n\nMODULE Data {\n  UNION Primitive = Bool | Int | Float | String\n\n  FUN stringify(p: Data.Primitive) -> String {\n    p as String\n  }\n}\n\nLET i: Data.Primitive = 42\nLET s: Data.Primitive = \"hello\"\nOUTPUT Data.stringify(i)  ; 42\nOUTPUT Data.stringify(s)  ; hello\n\n; ============ Nested module with types ============\n\nMODULE Outer2 {\n  MODULE Inner2 {\n    TYPE Status = Active | Inactive\n\n    FUN is-active(s: Outer2.Inner2.Status) -> Bool {\n      MATCH s {\n        Outer2.Inner2.Status.Active => true\n        Outer2.Inner2.Status.Inactive => false\n      }\n    }\n  }\n}\n\nLET active = Outer2.Inner2.Status.Active\nLET inactive = Outer2.Inner2.Status.Inactive\nOUTPUT Outer2.Inner2.is-active(active)  ; true\nOUTPUT Outer2.Inner2.is-active(inactive)  ; false\n\n; ============ Generic type in module ============\n\nMODULE Container {\n  TYPE Box[T] = Wrapped(T) | Empty\n\n  FUN unwrap-or[T](b: Container.Box[T], default: T) -> T {\n    MATCH b {\n      Container.Box.Wrapped(v) => v\n      Container.Box.Empty => default\n    }\n  }\n}\n\nLET box-int = Container.Box.Wrapped(42)\nLET empty-box = Container.Box.Empty\nOUTPUT Container.unwrap-or(box-int, 0)  ; 42\nOUTPUT Container.unwrap-or(empty-box, 99)  ; 99\n"
