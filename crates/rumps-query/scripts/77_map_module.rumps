; Map module primitives
; Tests Map.empty, Map.length, Map.keys, Map.values, Map.entries,
; Map.has, Map.lookup, Map.insert, Map.remove, Map.merge, Map.from-entries
;
; Note: `{}` is ambiguous and parsed as an empty object. Use Map.empty() for empty maps.

newtype Down = Int

class Ord for Down {
  fun compare(a: Down, b: Down) -> Ordering {
    if a > b { Ordering.Lt } else {
      if a == b { Ordering.Eq } else { Ordering.Gt }
    }
  }
}

variant Band = Band(Int)

fun bucket(b: Band) -> Int {
  match b {
    Band.Band(n) => { n // 10 }
  }
}

class Ord for Band {
  fun compare(a: Band, b: Band) -> Ordering {
    let ba = bucket(a)
    let bb = bucket(b)
    if ba > bb { Ordering.Lt } else {
      if ba == bb { Ordering.Eq } else { Ordering.Gt }
    }
  }
}

class Eq for Band {
  fun eq(a: Band, b: Band) -> Bool {
    bucket(a) == bucket(b)
  }
}

fun main() {
  ; ============ Map literals ============

  let m = { 1 => "one", 2 => "two", 3 => "three" }
  write m

  let str-keys = { "a" => 1, "b" => 2 }
  write str-keys

  ; ============ Map.empty ============

  let e = Map.empty()
  write e
  write Map.length(e)  ; 0

  ; ============ Map.length ============

  write Map.length(m)  ; 3
  write Map.length(str-keys)  ; 2

  ; ============ Map.keys ============

  let keys1 = Map.keys(m)
  write keys1  ; [1, 2, 3]

  let keys2 = Map.keys(str-keys)
  write keys2  ; ["a", "b"]

  let keys3 = Map.keys(e)
  write keys3  ; []

  ; ============ Map.values ============

  let vals1 = Map.values(m)
  write vals1  ; ["one", "two", "three"]

  let vals2 = Map.values(str-keys)
  write vals2  ; [1, 2]

  let vals3 = Map.values(e)
  write vals3  ; []

  ; ============ Map.entries ============

  let ent1 = Map.entries(m)
  write ent1  ; [(1, "one"), (2, "two"), (3, "three")]

  let ent2 = Map.entries(str-keys)
  write ent2  ; [("a", 1), ("b", 2)]

  ; ============ Map.has ============

  write Map.has(m, 1)  ; true
  write Map.has(m, 2)  ; true
  write Map.has(m, 4)  ; false
  write Map.has(e, 1)  ; false

  write Map.has(str-keys, "a")  ; true
  write Map.has(str-keys, "c")  ; false

  ; ============ Map.lookup ============

  write Map.lookup(m, 1)  ; Some("one")
  write Map.lookup(m, 2)  ; Some("two")
  write Map.lookup(m, 4)  ; None
  write Map.lookup(e, 1)  ; None

  write Map.lookup(str-keys, "a")  ; Some(1)
  write Map.lookup(str-keys, "z")  ; None

  ; ============ Map.insert ============

  let m2 = Map.insert(m, 4, "four")
  write Map.length(m2)  ; 4
  write Map.lookup(m2, 4)  ; Some("four")

  ; Original unchanged
  write Map.length(m)  ; 3

  ; Overwrite existing key
  let m3 = Map.insert(m, 1, "ONE")
  write Map.lookup(m3, 1)  ; Some("ONE")

  ; ============ Map.remove ============

  let m4 = Map.remove(m, 2)
  write Map.length(m4)  ; 2
  write Map.has(m4, 2)  ; false
  write Map.has(m4, 1)  ; true
  write Map.has(m4, 3)  ; true

  ; Remove non-existent key (no-op)
  let m5 = Map.remove(m, 999)
  write Map.length(m5)  ; 3

  ; ============ Map.merge ============

  let ma = { 1 => "a", 2 => "b" }
  let mb = { 2 => "B", 3 => "c" }
  let merged = Map.merge(ma, mb)
  write Map.length(merged)  ; 3
  write Map.lookup(merged, 1)  ; Some("a")
  write Map.lookup(merged, 2)  ; Some("B") (second overwrites)
  write Map.lookup(merged, 3)  ; Some("c")

  ; ============ Map.from-entries ============

  let arr = [(1, "x"), (2, "y"), (3, "z")]
  let from-arr = Map.from-entries(arr)
  write Map.length(from-arr)  ; 3
  write Map.lookup(from-arr, 1)  ; Some("x")
  write Map.lookup(from-arr, 2)  ; Some("y")
  write Map.lookup(from-arr, 3)  ; Some("z")

  ; ============ Chaining operations ============

  let chain = { 1 => 10, 2 => 20, 3 => 30 }
  let chain2 = Map.insert(chain, 4, 40)
  let chain3 = Map.remove(chain2, 1)
  write Map.length(chain3)  ; 3
  write Map.keys(chain3)  ; [2, 3, 4]

  ; ============ Float keys ============

  let float-map = { 1.5 => "half", 2.5 => "two-half" }
  write Map.has(float-map, 1.5)  ; true
  write Map.lookup(float-map, 2.5)  ; Some("two-half")

  ; ============ Boolean keys ============

  let bool-map = { true => "yes", false => "no" }
  write Map.lookup(bool-map, true)  ; Some("yes")
  write Map.lookup(bool-map, false)  ; Some("no")

  ; ============ Index syntax (direct access) ============

  write m[1]  ; "one"
  write m[2]  ; "two"

  write str-keys["a"]  ; 1

  ; ============ Optional index syntax (returns Option) ============

  write m?[1]  ; Some("one")
  write m?[99]  ; None (key not found)

  write str-keys?["a"]  ; Some(1)
  write str-keys?["missing"]  ; None

  ; Chaining with optional unwrap
  write m?[1] ?? "default"  ; "one"
  write m?[99] ?? "default"  ; "default"

  ; ============ Canonical order and overwrite semantics ============

  let unordered-a = Map.from-entries([("b", 2), ("a", 1)])
  let unordered-b = Map.from-entries([("a", 1), ("b", 2)])
  write Map.keys(unordered-a)
  write Map.values(unordered-a)
  write Map.entries(unordered-a)
  write unordered-a == unordered-b
  write unordered-a <= unordered-b
  write unordered-b <= unordered-a

  let dup = Map.from-entries([("a", 1), ("b", 2), ("a", 3)])
  write Map.length(dup)
  write Map.entries(dup)
  write Map.lookup(dup, "a")

  let ml = Map.from-entries([("a", 1), ("b", 2)])
  let mr = Map.from-entries([("b", 20), ("c", 30)])
  let merged2 = Map.merge(ml, mr)
  let removed2 = Map.remove(merged2, "missing")
  write Map.entries(merged2)
  write Map.entries(removed2)
  write Map.lookup(merged2, "missing")

  ; ============ Required key shapes ============

  let bools = Map.from-entries([(true, "true"), (false, "false")])
  write Map.keys(bools)

  let ints = Map.from-entries([(10, "ten"), (1, "one")])
  write Map.keys(ints)

  let floats = Map.from-entries([(2.5, "two"), (1.5, "one")])
  write Map.keys(floats)

  let chars = Map.from-entries([('b', "bee"), ('a', "aye")])
  write Map.keys(chars)

  let strings = Map.from-entries([("b", 2), ("a", 1)])
  write Map.keys(strings)

  let tuples = Map.from-entries([((2, "b"), 20), ((1, "a"), 10)])
  write Map.keys(tuples)
  write Map.lookup(tuples, (1, "a"))

  let arrays = Map.from-entries([([2], "two"), ([1, 2], "one-two"), ([1], "one")])
  write Map.keys(arrays)

  let none: Option[Int] = Option.None
  let some1 = Option.Some(1)
  let some2 = Option.Some(2)
  let opts = Map.from-entries([(some2, "two"), (none, "none"), (some1, "one")])
  write Map.keys(opts)

  let err-a: Result[Int, String] = Result.Err("a")
  let err-b: Result[Int, String] = Result.Err("b")
  let ok1: Result[Int, String] = Result.Ok(1)
  let ress = Map.from-entries([(ok1, "ok"), (err-b, "err-b"), (err-a, "err-a")])
  write Map.keys(ress)

  let ords = Map.from-entries([
    (Ordering.Gt, "gt"),
    (Ordering.Lt, "lt"),
    (Ordering.Eq, "eq"),
  ])
  write Map.keys(ords)

  let key1 = Map.from-entries([(1, "one")])
  let key2 = Map.from-entries([(1, "one"), (2, "two")])
  let nested = Map.from-entries([(key2, "long"), (key1, "short")])
  write Map.keys(nested)

  ; ============ Persistent update shapes ============

  let empty: Map[Int, String] = Map.empty()

  let asc1 = Map.insert(empty, 1, "one")
  let asc2 = Map.insert(asc1, 2, "two")
  let asc3 = Map.insert(asc2, 3, "three")
  let asc4 = Map.insert(asc3, 4, "four")
  let asc5 = Map.insert(asc4, 5, "five")
  write Map.keys(asc5)
  write Map.lookup(asc5, 1)
  write Map.lookup(asc5, 3)
  write Map.lookup(asc5, 5)

  let desc1 = Map.insert(empty, 5, "five")
  let desc2 = Map.insert(desc1, 4, "four")
  let desc3 = Map.insert(desc2, 3, "three")
  let desc4 = Map.insert(desc3, 2, "two")
  let desc5 = Map.insert(desc4, 1, "one")
  write Map.keys(desc5)
  write Map.lookup(desc5, 1)
  write Map.lookup(desc5, 3)
  write Map.lookup(desc5, 5)

  let mixed1 = Map.insert(empty, 3, "three")
  let mixed2 = Map.insert(mixed1, 1, "one")
  let mixed3 = Map.insert(mixed2, 5, "five")
  let mixed4 = Map.insert(mixed3, 2, "two")
  let mixed5 = Map.insert(mixed4, 4, "four")
  write Map.keys(mixed5)
  write Map.lookup(mixed5, 1)
  write Map.lookup(mixed5, 3)
  write Map.lookup(mixed5, 5)

  write Map.keys(empty)
  write Map.keys(asc1)
  write Map.keys(asc5)

  let removed3 = Map.remove(asc5, 1)
  let removed4 = Map.remove(removed3, 3)
  write Map.keys(asc5)
  write Map.keys(removed3)
  write Map.keys(removed4)
  write Map.lookup(asc5, 1)
  write Map.lookup(removed3, 1)
  write Map.lookup(removed4, 3)

  ; ============ User-defined key ordering ============

  let ds: Array[(Down, String)] = [(1, "one"), (3, "three"), (2, "two")]
  let dm = Map.from-entries(ds)
  write Map.keys(dm)

  let three: Down = 3
  let dups: Array[(Down, String)] = [(three, "three"), (three, "THREE")]
  let dup-dm = Map.from-entries(dups)
  write Map.keys(dup-dm)
  write Map.lookup(dup-dm, three)

  let b5 = Band.Band(5)
  let b10 = Band.Band(10)
  let b12 = Band.Band(12)
  let b20 = Band.Band(20)

  let bands = Map.from-entries([
    (b10, "ten"),
    (b20, "twenty"),
    (b5, "five"),
    (b12, "twelve"),
  ])

  write Map.length(bands)
  write Map.keys(bands)
  write Map.lookup(bands, Band.Band(11))
  write Map.lookup(bands, b10)
  write Map.lookup(bands, b20)
}
