---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: json type and access operators\n; Tests json literals, field access, type conversions, and heterogeneous arrays\n\nnewtype Person = { name: String, age: Int }\nnewtype Box[T] = { value: T }\nnewtype Pair[A, B] = { first: A, second: B }\nnewtype Address = { city: String, zip: Int }\nnewtype Employee = { name: String, addr: Address }\n\nfun main() {\n  ; ============================================================\n  ; json LITERALS (quoted keys)\n  ; ============================================================\n\n  let j = { \"name\": \"Alice\", \"age\": 30, \"active\": true }\n\n  ; Type checking\n  write j is Json\n  ; Expected: true\n\n  ; ============================================================\n  ; json FIELD ACCESS (returns Json)\n  ; ============================================================\n\n  let name = j.name\n  write name is Json\n  ; Expected: true\n\n  ; Missing field returns Json null\n  let missing = j.missing\n  write missing is Json\n  ; Expected: true\n\n  ; ============================================================\n  ; NESTED json ACCESS\n  ; ============================================================\n\n  let nested = {\n    \"user\": {\n      \"profile\": {\n        \"firstName\": \"Bob\"\n      }\n    }\n  }\n\n  write nested.user.profile.firstName is Json\n  ; Expected: true\n\n  ; ============================================================\n  ; NATIVE OBJECTS (unquoted keys) vs json\n  ; ============================================================\n\n  let obj = { name: \"Alice\", age: 30 }\n  write obj is { name: String, age: Int }\n  ; Expected: true\n\n  ; Native object field access returns native type\n  write obj.name is String\n  ; Expected: true\n\n  ; ============================================================\n  ; json SCALAR EXTRACTION with .. (returns Option)\n  ; ============================================================\n\n  let data = { \"a\": 1, \"b\": 2, \"c\": 3 }\n  let a-scalar = data..a\n  write a-scalar is Option.Some(_)\n  ; Expected: true\n\n  ; Unwrap scalar extraction\n  write a-scalar!\n  ; Expected: 1\n\n  ; Another scalar extraction\n  let c-val = data..c\n  write c-val!\n  ; Expected: 3\n\n  ; Missing key with .. returns Option.None\n  let miss = data..missing\n  write miss is Option.None\n  ; Expected: true\n\n  ; Scalar extraction from string field\n  let strs = { \"greeting\": \"hello\" }\n  let s = strs..greeting\n  write s!\n  ; Expected: hello\n\n  ; Scalar extraction from bool field\n  let bools = { \"flag\": true }\n  let b = bools..flag\n  write b!\n  ; Expected: true\n\n  ; Scalar extraction from float field\n  let floats = { \"pi\": 3.14 }\n  let f = floats..pi\n  write f!\n  ; Expected: 3.14\n\n  ; ============================================================\n  ; DYNAMIC json ACCESS with -> and ->>\n  ; ============================================================\n\n  let key = \"b\"\n  let dyn = data->(key)\n  write dyn is Json\n  ; Expected: true\n\n  ; Dynamic scalar access with ->>(expr)\n  let key-c = \"c\"\n  let dyn-c = data->>(key-c)\n  write dyn-c!\n  ; Expected: 3\n\n  ; ============================================================\n  ; as Json COERCION (native -> Json)\n  ; ============================================================\n\n  ; Native object -> Json\n  let native-obj = { x: 1, y: 2 }\n  let json-obj = native-obj as Json\n  write json-obj is Json\n  ; Expected: true\n\n  ; Array -> Json\n  let arr = [1, 2, 3]\n  let json-arr = arr as Json\n  write json-arr is Json\n  ; Expected: true\n\n  ; Scalar -> Json\n  let int-json = 42 as Json\n  write int-json is Json\n  ; Expected: true\n\n  let str-json = \"hello\" as Json\n  write str-json is Json\n  ; Expected: true\n\n  let bool-json = true as Json\n  write bool-json is Json\n  ; Expected: true\n\n  ; ============================================================\n  ; Json read T CONVERSIONS (Json -> native)\n  ; ============================================================\n\n  let j-data = { \"name\": \"John\", \"age\": 30, \"active\": true, \"score\": 3.14 }\n\n  ; Json -> String\n  let name-result = j-data.name read String\n  write name-result is Result.Ok(_)\n  ; Expected: true\n  write name-result!\n  ; Expected: John\n\n  ; Json -> Int\n  let age-result = j-data.age read Int\n  write age-result is Result.Ok(_)\n  ; Expected: true\n  write age-result!\n  ; Expected: 30\n\n  ; Json -> Bool\n  let active-result = j-data.active read Bool\n  write active-result is Result.Ok(_)\n  ; Expected: true\n  write active-result!\n  ; Expected: true\n\n  ; Json -> Float\n  let score-result = j-data.score read Float\n  write score-result is Result.Ok(_)\n  ; Expected: true\n  write score-result!\n  ; Expected: 3.14\n\n  ; Json -> Object (structural type)\n  let obj-data = { \"nested\": { \"a\": 1, \"b\": 2 } }\n  let nested-result = obj-data.nested read { a: Int, b: Int }\n  write nested-result is Result.Ok(_)\n  ; Expected: true\n\n  ; read type mismatch returns Result.Err\n  let bad-int = j-data.name read Int\n  write bad-int is Result.Err(_)\n  ; Expected: true\n\n  ; read on missing field (json null) returns Result.Err for non-Option types\n  let null-data = { \"other\": 1 }\n  let null-read = null-data.missing read Int\n  write null-read is Result.Err(_)\n  ; Expected: true\n\n  ; ============================================================\n  ; HETEROGENEOUS ARRAYS -> Json\n  ; ============================================================\n\n  ; Mixed types become Json\n  let hetero = [1, \"two\", true, 3.14]\n  write hetero is Json\n  ; Expected: true\n\n  ; String mixed with other types\n  let str-mix = [\"a\", 1, \"hello\"]\n  write str-mix is Json\n  ; Expected: true\n\n  ; Two elements of different types\n  let two-mix = [42, \"hello\"]\n  write two-mix is Json\n  ; Expected: true\n\n  ; Homogeneous arrays stay as Array\n  let hom-int = [1, 2, 3]\n  write hom-int is Array[_]\n  ; Expected: true\n\n  let hom-str = [\"a\", \"b\", \"c\"]\n  write hom-str is Array[_]\n  ; Expected: true\n\n  ; ============================================================\n  ; NULL LITERAL IN json CONTEXTS\n  ; ============================================================\n\n  ; null in json object\n  let with-null = { \"name\": \"Alice\", \"middle\": null }\n  write with-null is Json\n  ; Expected: true\n\n  ; null in heterogeneous array\n  let arr-null = [1, null, \"three\"]\n  write arr-null is Json\n  ; Expected: true\n\n  ; Array with only null becomes Json\n  let null-only = [null, null]\n  write null-only is Json\n  ; Expected: true\n\n  ; Option.None -> null\n  let none-json = Option.None as Json\n  write none-json is Json\n  ; Expected: true\n\n  ; Option.Some(v) -> v\n  let some-json = Option.Some(42) as Json\n  write some-json is Json\n  ; Expected: true\n\n  ; Verify Option.Some unwraps to inner value (not tagged object)\n  let some-read = some-json read Int\n  write some-read!\n  ; Expected: 42\n\n  ; ============================================================\n  ; CHAR LITERALS\n  ; ============================================================\n\n  let ch = 'a'\n  write ch is Char\n  ; Expected: true\n\n  let newline = '\\n'\n  write newline is Char\n  ; Expected: true\n\n  ; Char in array (homogeneous)\n  let chars = ['a', 'b', 'c']\n  write chars is Array[_]\n  ; Expected: true\n\n  ; ============================================================\n  ; json read INTO STRUCT TYPES\n  ; ============================================================\n\n  ; Read json into struct\n  let person-json = { \"name\": \"Alice\", \"age\": 30 }\n  let person-result = person-json read Person\n  write person-result is Result.Ok(_)\n  ; Expected: true\n\n  ; Read NATIVE object into structural type\n  let native-obj2 = { name: \"Native\", age: 25, extra: \"ignored\" }\n  let native-result = native-obj2 read { name: String, age: Int, extra: String }\n  write native-result is Result.Ok(_)\n  ; Expected: true\n\n  let native-person = native-result!\n  write native-person.name\n  ; Expected: Native\n  write native-person.age\n  ; Expected: 25\n\n  let person = person-result!\n  write person.name\n  ; Expected: Alice\n  write person.age\n  ; Expected: 30\n\n  ; Missing field returns Result.Err\n  let incomplete = { \"name\": \"Bob\" }\n  let incomplete-result = incomplete read Person\n  write incomplete-result is Result.Err(_)\n  ; Expected: true\n\n  ; Wrong field type returns Result.Err\n  let wrong-type = { \"name\": \"Carol\", \"age\": \"thirty\" }\n  let wrong-result = wrong-type read Person\n  write wrong-result is Result.Err(_)\n  ; Expected: true\n\n  ; ============================================================\n  ; json read INTO PARAMETRIC STRUCT TYPES\n  ; ============================================================\n\n  ; Read into Box[Int]\n  let box-json = { \"value\": 42 }\n  let box-result = box-json read Box[Int]\n  write box-result is Result.Ok(_)\n  ; Expected: true\n\n  let box-val = box-result!\n  write box-val.value\n  ; Expected: 42\n\n  ; Read into Box[String]\n  let str-box-json = { \"value\": \"hello\" }\n  let str-box-result = str-box-json read Box[String]\n  write str-box-result is Result.Ok(_)\n  ; Expected: true\n\n  write str-box-result!.value\n  ; Expected: hello\n\n  ; Multi-param struct\n  let pair-json = { \"first\": 1, \"second\": \"one\" }\n  let pair-result = pair-json read Pair[Int, String]\n  write pair-result is Result.Ok(_)\n  ; Expected: true\n\n  let pair-val = pair-result!\n  write pair-val.first\n  ; Expected: 1\n  write pair-val.second\n  ; Expected: one\n\n  ; ============================================================\n  ; json read INTO ARRAY[T]\n  ; ============================================================\n\n  let arr-json = [1, 2, 3] as Json\n  let arr-result = arr-json read Array[Int]\n  write arr-result is Result.Ok(_)\n  ; Expected: true\n\n  let arr-val = arr-result!\n  write arr-val is Array[_]\n  ; Expected: true\n  write Iterable:length(arr-val)\n  ; Expected: 3\n\n  ; Type mismatch in array element\n  let bad-arr = [1, \"two\", 3] as Json\n  let bad-arr-result = bad-arr read Array[Int]\n  write bad-arr-result is Result.Err(_)\n  ; Expected: true\n\n  ; ============================================================\n  ; json read INTO OPTION[T]\n  ; ============================================================\n\n  ; Non-null -> Some\n  let opt-json = 42 as Json\n  let opt-result = opt-json read Option[Int]\n  write opt-result is Result.Ok(_)\n  ; Expected: true\n\n  let opt-val = opt-result!\n  write opt-val is Option.Some(_)\n  ; Expected: true\n  write opt-val!\n  ; Expected: 42\n\n  ; null -> None\n  let null-json = { \"value\": null }\n  let null-opt-result = null-json.value read Option[Int]\n  write null-opt-result is Result.Ok(_)\n  ; Expected: true\n\n  let null-opt-val = null-opt-result!\n  write null-opt-val is Option.None\n  ; Expected: true\n\n  ; ============================================================\n  ; NESTED STRUCTS IN json read\n  ; ============================================================\n\n  let emp-json = {\n    \"name\": \"Dave\",\n    \"addr\": {\n      \"city\": \"NYC\",\n      \"zip\": 10001\n    }\n  }\n\n  let emp-result = emp-json read Employee\n  write emp-result is Result.Ok(_)\n  ; Expected: true\n\n  let emp = emp-result!\n  write emp.name\n  ; Expected: Dave\n  write emp.addr.city\n  ; Expected: NYC\n  write emp.addr.zip\n  ; Expected: 10001\n\n  write \"json test complete\"\n}\n"
