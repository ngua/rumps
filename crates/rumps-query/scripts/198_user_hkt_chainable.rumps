; User Wrappable + Chainable (requires Fallible superclass)
;
; Tests `?` (wrap) and `Chainable:chain` on user-defined `Box[T]`.

type Box[T] = Full(T) | Empty

class Fallible for Box {
  fun unwrap(b: Box[T]) -> T {
    match b {
      Box.Full(x) => { x }
      Box.Empty => { raise "empty box" }
    }
  }
}

class Wrappable for Box {
  fun wrap(x: T) -> Box[T] {
    Box.Full(x)
  }
}

class Chainable for Box {
  fun chain(b: Box[T], f: (T) -> Box[U]) -> Box[U] {
    match b {
      Box.Full(x) => { f(x) }
      Box.Empty => { Box.Empty }
    }
  }
}

fun main() {
  let b = ?42
  let c = Chainable:chain(b, x => Box.Full(x + 1))
  write c!
}
