; Module file imports
; Tests importing modules from files using `MODULE Name FROM "path"` syntax

; Import module from file (path relative to script directory)
MODULE MyMath FROM "../modules/lib/mymath.rumps"

; ============ Test constants from imported module ============

WRITE MyMath.pi > 3.0  ; true
WRITE MyMath.e > 2.0  ; true

; ============ Test functions from imported module ============

WRITE MyMath.square(5)  ; 25
WRITE MyMath.double(7)  ; 14
WRITE MyMath.is-positive(10)  ; true
WRITE MyMath.is-positive(-5)  ; false

; ============ Use imported functions in expressions ============

LET sq = MyMath.square(4)
LET dbl = MyMath.double(sq)
WRITE dbl  ; 32

; ============ Pass imported function as value ============

LET f = MyMath.double
WRITE f(100)  ; 200

; ============ Test function referencing sibling constant ============

WRITE MyMath.area(2.0)  ; pi * 4 = 12.56636
