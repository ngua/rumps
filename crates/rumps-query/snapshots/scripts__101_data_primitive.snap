---
source: crates/rumps-query/tests/scripts.rs
description: "; DATA primitive tests\n; NOTE: Uses locals only; globals require TRANSACTION blocks\n\n; === Setup: create test data ===\n\nSET vars(1) = \"value at 1\"\nSET vars(1, \"A\") = \"value at 1,A\"\nSET vars(2, \"B\", \"C\") = \"deep value\"\n\n; === DATA on non-existent key ===\n\nLET status0 = DATA vars(999)\nOUTPUT status0\n\n; === DATA on key with value only ===\n\n; Key (1, \"A\") has value but no descendants\nLET status1 = DATA vars(1, \"A\")\nOUTPUT status1\n\n; === DATA on key with descendants only ===\n\n; Key (2) has no value but has descendants at (2, \"B\", ...)\nLET status2 = DATA vars(2)\nOUTPUT status2\n\n; === DATA on key with both value and descendants ===\n\n; Key (1) has value AND descendants at (1, \"A\")\nLET status3 = DATA vars(1)\nOUTPUT status3\n\n; === Pattern matching on DataStatus ===\n\nFUN describe(s: DataStatus) -> String {\n  MATCH s {\n    DataStatus.NoData => { \"no data\" }\n    DataStatus.HasValue => { \"has value\" }\n    DataStatus.HasDescendants => { \"has descendants\" }\n    DataStatus.Both => { \"both\" }\n  }\n}\n\nOUTPUT describe(DATA vars(999))\nOUTPUT describe(DATA vars(1, \"A\"))\nOUTPUT describe(DATA vars(2))\nOUTPUT describe(DATA vars(1))\n\n; === AS Int coercion (MUMPS @DATA values) ===\n\nOUTPUT (DATA vars(999)) AS Int\nOUTPUT (DATA vars(1, \"A\")) AS Int\nOUTPUT (DATA vars(2)) AS Int\nOUTPUT (DATA vars(1)) AS Int\n\n; === DataStatus in expressions ===\n\nFUN has-data(s: DataStatus) -> Bool {\n  (s AS Int) > 0\n}\n\nOUTPUT has-data(DATA vars(999))\nOUTPUT has-data(DATA vars(1))\n\n; === Type annotation ===\n\nLET typed: DataStatus = DATA vars(1)\nOUTPUT typed\n\n; === DataStatus in arrays ===\n\nLET statuses: Array[DataStatus] = [\n  DATA vars(999),\n  DATA vars(1, \"A\"),\n  DATA vars(2),\n  DATA vars(1)\n]\nOUTPUT Array.length(statuses)\nOUTPUT Array.map(describe, statuses)\n\n; === READ DataStatus from Int ===\n\nLET from0 = 0 READ DataStatus\nLET from1 = 1 READ DataStatus\nLET from10 = 10 READ DataStatus\nLET from11 = 11 READ DataStatus\nLET invalid = 5 READ DataStatus\n\nOUTPUT from0\nOUTPUT from1\nOUTPUT from10\nOUTPUT from11\nOUTPUT invalid\n"
---
DataStatus.NoData
DataStatus.HasValue
DataStatus.HasDescendants
DataStatus.Both
"no data"
"has value"
"has descendants"
"both"
0
1
10
11
FALSE
TRUE
DataStatus.Both
4
[ "no data", "has value", "has descendants", "both" ]
Result.Ok(DataStatus.NoData)
Result.Ok(DataStatus.HasValue)
Result.Ok(DataStatus.HasDescendants)
Result.Ok(DataStatus.Both)
Result.Err("invalid DataStatus value: 5 (expected 0, 1, 10, or 11)")
