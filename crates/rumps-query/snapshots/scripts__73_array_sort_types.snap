---
source: crates/rumps-query/tests/scripts.rs
description: "; Test Array.sort with various types\n\nvariant Priority = Low | Medium | High\n\nvariant Event = Click(Int, Int) | Scroll(Int) | Resize(Int, Int)\n\nfun main() {\n  ; --- Scalars ---\n  write Array.sort([3, 1, 4, 1, 5, 9, 2, 6])\n  write Array.sort([\"banana\", \"apple\", \"cherry\"])\n  write Array.sort([true, false, true, false])\n  write Array.sort([3.14, 1.0, 2.71])\n\n  ; --- Option ---\n  ; None < Some, then by payload\n  write Array.sort([Option.Some(3), Option.None, Option.Some(1), Option.None, Option.Some(2)])\n\n  ; --- Result ---\n  ; Err < Ok, then by payload\n  write Array.sort([Result.Ok(2), Result.Err(\"b\"), Result.Ok(1), Result.Err(\"a\")])\n\n  ; --- Tuples ---\n  ; Lexicographic ordering\n  write Array.sort([(2, \"b\"), (1, \"z\"), (2, \"a\"), (1, \"a\")])\n  write Array.sort([(1, 2, 3), (1, 1, 9), (1, 2, 1)])\n\n  ; --- Nested Options ---\n  write Array.sort([Option.Some(Option.Some(2)), Option.Some(Option.None), Option.None, Option.Some(Option.Some(1))])\n\n  ; --- User-defined sum type ---\n  let tasks = [Priority.High, Priority.Low, Priority.Medium, Priority.Low, Priority.High]\n  write Array.sort(tasks)\n\n  ; --- Sum type with payloads ---\n  let events = [Event.Resize(100, 200), Event.Click(5, 5), Event.Scroll(10), Event.Click(1, 1), Event.Scroll(5)]\n  write Array.sort(events)\n\n  ; --- Objects ---\n  write Array.sort([{ a: 2 }, { a: 1 }, { a: 3 }])\n  write Array.sort([{ x: 1, y: 2 }, { x: 1, y: 1 }, { x: 0, y: 9 }])\n\n  ; --- Arrays of arrays ---\n  write Array.sort([[3, 1], [1, 2], [1, 1], [2, 0]])\n\n  ; --- Mixed with pipeline ---\n  let sorted-options = [Option.Some(5), Option.None, Option.Some(3)] |> Array.sort\n  write sorted-options\n}\n"
---
[ 1, 1, 2, 3, 4, 5, 6, 9 ]
[ "apple", "banana", "cherry" ]
[ false, false, true, true ]
[ 1.0, 2.71, 3.14 ]
[ Option.None, Option.None, Option.Some(1), Option.Some(2), Option.Some(3) ]
[ Result.Err("a"), Result.Err("b"), Result.Ok(1), Result.Ok(2) ]
[ (1, "a"), (1, "z"), (2, "a"), (2, "b") ]
[ (1, 1, 9), (1, 2, 1), (1, 2, 3) ]
[ Option.None, Option.Some(Option.None), Option.Some(Option.Some(1)), Option.Some(Option.Some(2)) ]
[ Priority.Low, Priority.Low, Priority.Medium, Priority.High, Priority.High ]
[ Event.Click(1, 1), Event.Click(5, 5), Event.Scroll(5), Event.Scroll(10), Event.Resize(100, 200) ]
[ { a: 1 }, { a: 2 }, { a: 3 } ]
[ { x: 0, y: 9 }, { x: 1, y: 1 }, { x: 1, y: 2 } ]
[ [ 1, 1 ], [ 1, 2 ], [ 2, 0 ], [ 3, 1 ] ]
[ Option.None, Option.Some(3), Option.Some(5) ]
