---
source: crates/rumps-query/tests/scripts.rs
description: "; User-defined modules\n; Tests module definition, functions, constants, and nested modules\n; Uses `+` prefix for public members; members without `+` are private\n\nfun main() {\n  let c = Counter.new()\n  write c  ; 0\n\n  let c1 = Counter.inc(c)\n  write c1  ; 1\n\n  let c2 = Counter.add(c1, 10)\n  write c2  ; 11\n\n  write Config.max-size  ; 1000\n  write Config.default-name  ; unnamed\n  write Config.ratio > 3.0  ; true\n\n  ; Use constants in expressions\n  let scaled = Config.max-size * 2\n  write scaled  ; 2000\n\n  write Geometry.pi > 3.0  ; true\n\n  let a = Geometry.area(2.0)\n  write a > 12.0  ; true\n\n  let circ = Geometry.circumference(1.0)\n  write circ > 6.0  ; true\n\n  write Outer.val  ; 100\n  write Outer.value()  ; 100\n  write Outer.Inner.secret  ; 42\n  write Outer.Inner.get-secret()  ; 42\n  write Outer.Inner.combined()  ; 142\n\n  let id-int = Utils.identity(42)\n  write id-int  ; 42\n\n  let id-str = Utils.identity(\"hello\")\n  write id-str  ; hello\n\n  let p = Utils.pair(1, \"one\")\n  write p  ; (1, one)\n\n  ; ============ Module function as value ============\n\n  let inc-fn = Counter.inc\n  let result = inc-fn(5)\n  write result  ; 6\n\n  let add5 = Adder.make(5)\n  write add5(10)  ; 15\n\n  let add10 = Adder.make(10)\n  write add10(7)  ; 17\n\n  write MonoHof.apply(n => n + 1, 5)  ; 6\n  write MonoHof.map-twice(n => n * 2, 3)  ; 12\n\n  ; Int -> Int\n  write PolyHof.apply(n => n + 1, 5)  ; 6\n\n  ; Int -> String\n  write PolyHof.apply(n => \"num: {n}\", 42)  ; num: 42\n\n  ; String -> Int\n  write PolyHof.apply(s => String.length(s), \"hello\")  ; 5\n\n  ; Compose: Int -> Int -> String\n  write PolyHof.compose(n => \"result: {n}\", x => x * 2, 10)  ; result: 20\n\n  let c = Shapes.Shape.Circle(2.0)\n  let r = Shapes.Shape.Rectangle(3.0, 4.0)\n\n  write Shapes.describe(c)  ; circle\n  write Shapes.describe(r)  ; rectangle\n  write Shapes.area(c) > 12.0  ; true (approx 12.56)\n  write Shapes.area(r) > 11.0  ; true (12.0)\n\n  let u: Users.User = { name: \"Alice\", age: 30 }\n  write Users.greet(u)  ; Hello, Alice\n  write Users.is-adult(u)  ; true\n\n  let child: Users.User = { name: \"Bob\", age: 10 }\n  write Users.is-adult(child)  ; false\n\n  let i: Data.Primitive = 42\n  let s: Data.Primitive = \"hello\"\n  write Data.stringify(i)  ; 42\n  write Data.stringify(s)  ; hello\n\n  let active = Outer2.Inner2.Status.Active\n  let inactive = Outer2.Inner2.Status.Inactive\n  write Outer2.Inner2.is-active(active)  ; true\n  write Outer2.Inner2.is-active(inactive)  ; false\n\n  let box-int = Container.Box.Wrapped(42)\n  let empty-box = Container.Box.Empty\n  write Container.unwrap-or(box-int, 0)  ; 42\n  write Container.unwrap-or(empty-box, 99)  ; 99\n}\n\n; ============ Basic module with functions ============\n\nmodule Counter {\n  +fun new() -> Int { 0 }\n  +fun inc(x: Int) -> Int { x + 1 }\n  +fun add(x: Int, y: Int) -> Int { x + y }\n}\n\n; ============ Module with constants ============\n\nmodule Config {\n  +let max-size = 1000\n  +let default-name = \"unnamed\"\n  +let ratio = 3.14\n}\n\n; ============ Module with both functions and constants ============\n\nmodule Geometry {\n  +let pi = 3.14159\n\n  +fun area(r: Float) -> Float {\n    Geometry.pi * r * r\n  }\n\n  +fun circumference(r: Float) -> Float {\n    2.0 * Geometry.pi * r\n  }\n}\n\n; ============ Nested modules ============\n\nmodule Outer {\n  +let val = 100\n\n  +fun value() -> Int { Outer.val }\n\n  module Inner {\n    +let secret = 42\n\n    +fun get-secret() -> Int { Outer.Inner.secret }\n    +fun combined() -> Int { Outer.val + Outer.Inner.secret }\n  }\n}\n\n; ============ Generic functions in modules ============\n\nmodule Utils {\n  +fun identity[T](x: T) -> T { x }\n  +fun pair[A, B](a: A, b: B) -> (A, B) { (a, b) }\n}\n\n; ============ Module with closures ============\n\nmodule Adder {\n  +fun make(n: Int) -> (Int) -> Int {\n    x => x + n\n  }\n}\n\n; ============ Monomorphic higher-order functions ============\n\nmodule MonoHof {\n  +fun apply(f: (Int) -> Int, x: Int) -> Int {\n    f(x)\n  }\n\n  +fun map-twice(f: (Int) -> Int, x: Int) -> Int {\n    f(f(x))\n  }\n}\n\n; ============ Polymorphic higher-order functions ============\n\nmodule PolyHof {\n  +fun apply[T, U](f: (T) -> U, x: T) -> U {\n    f(x)\n  }\n\n  +fun compose[A, B, C](f: (B) -> C, g: (A) -> B, x: A) -> C {\n    f(g(x))\n  }\n}\n\n; ============ Module with type definitions ============\n\nmodule Shapes {\n  +variant Shape = Circle(Float) | Rectangle(Float, Float)\n\n  +fun area(s: Shapes.Shape) -> Float {\n    match s {\n      Shapes.Shape.Circle(r) => 3.14159 * r * r\n      Shapes.Shape.Rectangle(w, h) => w * h\n    }\n  }\n\n  +fun describe(s: Shapes.Shape) -> String {\n    match s {\n      Shapes.Shape.Circle(_) => \"circle\"\n      Shapes.Shape.Rectangle(_, _) => \"rectangle\"\n    }\n  }\n}\n\n; ============ Module with newtype ============\n\nmodule Users {\n  +newtype User = { name: String, age: Int }\n\n  +fun greet(u: Users.User) -> String {\n    \"Hello, {u.name}\"\n  }\n\n  +fun is-adult(u: Users.User) -> Bool {\n    u.age >= 18\n  }\n}\n\n; ============ Module with union definition ============\n\nmodule Data {\n  +union Primitive = Bool | Int | Float | String\n\n  +fun stringify(p: Data.Primitive) -> String {\n    p as String\n  }\n}\n\n; ============ Nested module with types ============\n\nmodule Outer2 {\n  module Inner2 {\n    +variant Status = Active | Inactive\n\n    +fun is-active(s: Outer2.Inner2.Status) -> Bool {\n      match s {\n        Outer2.Inner2.Status.Active => true\n        Outer2.Inner2.Status.Inactive => false\n      }\n    }\n  }\n}\n\n; ============ Generic type in module ============\n\nmodule Container {\n  +variant Box[T] = Wrapped(T) | Empty\n\n  +fun unwrap-or[T](b: Container.Box[T], default: T) -> T {\n    match b {\n      Container.Box.Wrapped(v) => v\n      Container.Box.Empty => default\n    }\n  }\n}\n"
