---
source: crates/rumps-query/tests/scripts.rs
description: "; MATCH expression tests\n\n; === Simple matching ===\n\n; Literal matching\nLET n = 2\nLET result = MATCH n {\n  1 => { \"one\" }\n  2 => { \"two\" }\n  3 => { \"three\" }\n  _ => { \"other\" }\n}\n@OUTPUT result\n\n; Variable binding\nLET x = 42\nLET doubled = MATCH x {\n  n => { n * 2 }\n}\n@OUTPUT doubled\n\n; Wildcard\nLET ignored = MATCH \"anything\" {\n  _ => { \"matched wildcard\" }\n}\n@OUTPUT ignored\n\n; === Sum type matching ===\n\n; Option.Some\nLET opt = Option.Some(10)\nLET unwrapped = MATCH opt {\n  Option.Some(v) => { v }\n  Option.None => { 0 }\n}\n@OUTPUT unwrapped\n\n; Option.None\nLET none-opt = Option.None\nLET default = MATCH none-opt {\n  Option.Some(v) => { v }\n  Option.None => { -1 }\n}\n@OUTPUT default\n\n; Nested Option\nLET nested-opt = Option.Some(Option.Some(5))\nLET deep = MATCH nested-opt {\n  Option.Some(Option.Some(v)) => { v }\n  Option.Some(Option.None) => { -1 }\n  Option.None => { -2 }\n}\n@OUTPUT deep\n\n; Result type\nLET ok = Result.Ok(100)\nLET ok-val = MATCH ok {\n  Result.Ok(v) => { v }\n  Result.Err(e) => { 0 }\n}\n@OUTPUT ok-val\n\nLET err = Result.Err(\"oops\")\nLET err-val = MATCH err {\n  Result.Ok(v) => { v }\n  Result.Err(e) => { -1 }\n}\n@OUTPUT err-val\n\n; === User-defined sum types ===\n\nvariant Status = Pending | Active(String) | Completed\n\nLET s1 = Status.Pending\nLET s1-label = MATCH s1 {\n  Status.Pending => { \"waiting\" }\n  Status.Active(msg) => { \"active: \" ++ msg }\n  Status.Completed => { \"done\" }\n}\n@OUTPUT s1-label\n\nLET s2 = Status.Active(\"step 1\")\nLET s2-label = MATCH s2 {\n  Status.Pending => { \"waiting\" }\n  Status.Active(msg) => { \"active: \" ++ msg }\n  Status.Completed => { \"done\" }\n}\n@OUTPUT s2-label\n\nLET s3 = Status.Completed\nLET s3-label = MATCH s3 {\n  Status.Pending => { \"waiting\" }\n  Status.Active(msg) => { \"active: \" ++ msg }\n  Status.Completed => { \"done\" }\n}\n@OUTPUT s3-label\n\n; === Tuple matching ===\n\nLET pair = (1, 2)\nLET pair-sum = MATCH pair {\n  (a, b) => { a + b }\n}\n@OUTPUT pair-sum\n\n; With literal in tuple\nLET point = (0, 5)\nLET axis = MATCH point {\n  (0, y) => { \"on y-axis at \" ++ (y as String) }\n  (x, 0) => { \"on x-axis at \" ++ (x as String) }\n  (x, y) => { \"at (\" ++ (x as String) ++ \", \" ++ (y as String) ++ \")\" }\n}\n@OUTPUT axis\n\nLET point2 = (3, 0)\nLET axis2 = MATCH point2 {\n  (0, y) => { \"on y-axis\" }\n  (x, 0) => { \"on x-axis\" }\n  _ => { \"elsewhere\" }\n}\n@OUTPUT axis2\n\nLET point3 = (3, 4)\nLET axis3 = MATCH point3 {\n  (0, _) => { \"on y-axis\" }\n  (_, 0) => { \"on x-axis\" }\n  _ => { \"elsewhere\" }\n}\n@OUTPUT axis3\n\n; === Object matching ===\n\nLET user = { name: \"Alice\", age: 30, role: \"admin\" }\nLET greeting = MATCH user {\n  { name, role: \"admin\" } => { name ++ \" is an admin\" }\n  { name } => { name ++ \" is a user\" }\n}\n@OUTPUT greeting\n\nLET user2 = { name: \"Bob\", age: 25, role: \"user\" }\nLET greeting2 = MATCH user2 {\n  { name, role: \"admin\" } => { name ++ \" is an admin\" }\n  { name } => { name ++ \" is a user\" }\n}\n@OUTPUT greeting2\n\n; === Pattern guards ===\n\nLET val = 50\nLET size = MATCH val {\n  x IF x > 100 => { \"large\" }\n  x IF x > 10 => { \"medium\" }\n  x IF x > 0 => { \"small\" }\n  0 => { \"zero\" }\n  _ => { \"negative\" }\n}\n@OUTPUT size\n\nLET val2 = 150\nLET size2 = MATCH val2 {\n  x IF x > 100 => { \"large\" }\n  x IF x > 10 => { \"medium\" }\n  _ => { \"other\" }\n}\n@OUTPUT size2\n\n; Guard with Option\nLET maybe-num = Option.Some(42)\nLET check = MATCH maybe-num {\n  Option.Some(n) IF n > 50 => { \"large some\" }\n  Option.Some(n) IF n > 0 => { \"small some\" }\n  Option.Some(_) => { \"non-positive some\" }\n  Option.None => { \"none\" }\n}\n@OUTPUT check\n\n; === MATCH as expression ===\n\n; Bind to variable (already tested above)\n\n; Use in larger expression\nLET base = 10\nLET computed = base + MATCH Option.Some(5) {\n  Option.Some(n) => { n * 2 }\n  Option.None => { 0 }\n}\n@OUTPUT computed\n\n; Return from function\nFUN describe(opt: Option[Int]) -> String {\n  MATCH opt {\n    Option.Some(n) => { \"got \" ++ (n as String) }\n    Option.None => { \"nothing\" }\n  }\n}\n@OUTPUT describe(Option.Some(7))\n@OUTPUT describe(Option.None)\n\n; === Array matching ===\n\n; Exact length match\nLET arr = [1, 2, 3]\nLET arr-sum = MATCH arr {\n  [a, b, c] => { a + b + c }\n  [..] => { 0 }\n}\n@OUTPUT arr-sum\n\n; Single element\nLET single = [42]\nLET single-val = MATCH single {\n  [x] => { x }\n  [..] => { -1 }\n}\n@OUTPUT single-val\n\n; With rest (ignore)\nLET long = [10, 20, 30, 40, 50]\nLET first-two-sum = MATCH long {\n  [a, b, ..] => { a + b }\n  [..] => { 0 }\n}\n@OUTPUT first-two-sum\n\n; With rest (bind)\nLET nums = [1, 2, 3, 4, 5]\nLET head-tail = MATCH nums {\n  [h, ...t] => {\n    LET strs = Array.map((x: Int) => x as String, t)\n    (h as String) ++ \":\" ++ String.join(strs, \",\")\n  }\n  [..] => { \"empty\" }\n}\n@OUTPUT head-tail\n\n; Empty array with rest\nLET empty: Array[Int] = []\nLET empty-result = MATCH empty {\n  [x, ..] => { \"has elements\" }\n  [..] => { \"empty\" }\n}\n@OUTPUT empty-result\n\n; Nested patterns in array\nLET pairs = [(1, 2), (3, 4)]\nLET first-pair-sum = MATCH pairs {\n  [(a, b), ..] => { a + b }\n  [..] => { 0 }\n}\n@OUTPUT first-pair-sum\n\n; Array of Options\nLET opts = [Option.Some(1), Option.None, Option.Some(2)]\nLET first-opt = MATCH opts {\n  [Option.Some(x), ..] => { \"first is Some(\" ++ (x as String) ++ \")\" }\n  [Option.None, ..] => { \"first is None\" }\n  [..] => { \"empty\" }\n}\n@OUTPUT first-opt\n\n; Wildcard in array\nLET mixed = [1, 2, 3]\nLET second-elem = MATCH mixed {\n  [_, x, ..] => { x }\n  [..] => { 0 }\n}\n@OUTPUT second-elem\n\n; Multiple exact lengths\nLET len2 = [10, 20]\nLET len-check = MATCH len2 {\n  [] => { \"zero\" }\n  [_] => { \"one\" }\n  [_, _] => { \"two\" }\n  [..] => { \"many\" }\n}\n@OUTPUT len-check\n\n; Guard with array\nLET arr2 = [5, 10, 15]\nLET arr-guard = MATCH arr2 {\n  [a, ..] IF a > 10 => { \"first > 10\" }\n  [a, ..] IF a > 0 => { \"first positive\" }\n  [..] => { \"other\" }\n}\n@OUTPUT arr-guard\n\n; Rest binding produces correct array\nLET rest-test = [100, 200, 300, 400]\nLET rest-len = MATCH rest-test {\n  [_, ...rest] => { Array.length(rest) }\n  [..] => { 0 }\n}\n@OUTPUT rest-len\n"
