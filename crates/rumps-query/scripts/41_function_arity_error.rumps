; Test: Function Arity Error
; With transparent partial application, supplying fewer args than the
; arity is valid (it produces a partial application). Supplying more
; args than the arity, or supplying zero args to a multi-arg function,
; is still an error.

fun add (a: Int, b: Int) -> Int {
  a + b
}

fun main() {
  ; Too many arguments
  let x = add(1, 2, 3)
  ; Zero arguments on a multi-arg function
  let y = add()
}
