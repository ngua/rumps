---
source: crates/rumps-query/tests/scripts.rs
description: "; Array module functions\n; Tests Mappable:map, Filterable:filter, Foldable:reduce, foreach\n\nfun square(n: Int) -> Int { n * n }\n\nfun is-positive(n: Int) -> Bool { n > 0 }\n\nfun add(a: Int, b: Int) -> Int { a + b }\n\nfun zip-add(za: Int, zb: Int) -> Int { za + zb }\n\nfun cmp-int(ca: Int, cb: Int) -> Ordering {\n  if ca < cb { Ordering.Lt } else {\n    if ca == cb { Ordering.Eq } else { Ordering.Gt }\n  }\n}\n\nfun cmp-desc(da: Int, db: Int) -> Ordering {\n  if da > db { Ordering.Lt } else {\n    if da == db { Ordering.Eq } else { Ordering.Gt }\n  }\n}\n\nfun cmp-abs(aa: Int, ab: Int) -> Ordering {\n  let abs-a = if aa < 0 { 0 - aa } else { aa }\n  let abs-b = if ab < 0 { 0 - ab } else { ab }\n  cmp-int(abs-a, abs-b)\n}\n\nnewtype SortPerson = { name: String, age: Int }\n\nfun cmp-by-age(pa: SortPerson, pb: SortPerson) -> Ordering {\n  cmp-int(pa.age, pb.age)\n}\n\nfun iter-len(i: Array[Int]) -> Int {\n  Iterable:length(i)\n}\n\nfun iter-sum(i: Array[Int]) -> Int {\n  Foldable:reduce((acc, x) => acc + x, 0, i)\n}\n\nfun main() {\n  ; Mappable:map with closure\n  let nums = [1, 2, 3, 4, 5]\n  let doubled = Mappable:map(x => x * 2, nums)\n  write doubled  ; [2, 4, 6, 8, 10]\n\n  ; Mappable:map on empty array\n  let empty = []\n  let mapped-empty = Mappable:map(x => x + 1, empty)\n  write mapped-empty  ; []\n\n  ; Mappable:map with named function\n  let squares = Mappable:map(square, [1, 2, 3])\n  write squares  ; [1, 4, 9]\n\n  ; Filterable:filter with closure\n  let evens = Filterable:filter(x => x % 2 == 0, nums)\n  write evens  ; [2, 4]\n\n  ; Filterable:filter on empty array\n  let filtered-empty = Filterable:filter(x => x > 0, empty)\n  write filtered-empty  ; []\n\n  ; Filterable:filter with named function\n  let positives = Filterable:filter(is-positive, [-1, 0, 1, 2])\n  write positives  ; [1, 2]\n\n  ; Filterable:filter keeping all\n  let all-kept = Filterable:filter(x => true, [1, 2, 3])\n  write all-kept  ; [1, 2, 3]\n\n  ; Filterable:filter keeping none\n  let none-kept = Filterable:filter(x => false, [1, 2, 3])\n  write none-kept  ; []\n\n  ; Foldable:reduce with sum\n  let sum = Foldable:reduce((acc, x) => acc + x, 0, nums)\n  write sum  ; 15\n\n  ; Foldable:reduce on empty array returns initial value\n  let empty-sum = Foldable:reduce((acc, x) => acc + x, 100, empty)\n  write empty-sum  ; 100\n\n  ; Foldable:reduce with string concatenation\n  let words = [\"hello\", \" \", \"world\"]\n  let combined = Foldable:reduce((acc, s) => \"{acc}{s}\", \"\", words)\n  write combined  ; \"hello world\"\n\n  ; Foldable:reduce with named function\n  let total = Foldable:reduce(add, 0, [1, 2, 3, 4])\n  write total  ; 10\n\n  ; Combining Array functions\n  let result = Foldable:reduce(\n    (acc, x) => acc + x,\n    0,\n    Mappable:map(x => x * x, Filterable:filter(x => x % 2 == 1, [1, 2, 3, 4, 5]))\n  )\n  write result  ; 1 + 9 + 25 = 35\n\n  ; Pipeline usage with Array functions (using wrapper closures)\n  let piped = [1, 2, 3, 4, 5]\n    |> (arr => Filterable:filter(x => x > 2, arr))\n    |> (arr => Mappable:map(x => x * 10, arr))\n  write piped  ; [30, 40, 50]\n\n  ; Module functions can be passed as first-class values\n  let filter-fn = Filterable:filter\n  let data = [1, 2, 3, 4, 5]\n  let filtered = filter-fn(x => x > 2, data)\n  write filtered  ; [3, 4, 5]\n\n  ; Mappable:map with Option results (homogeneous tagged values)\n  let with-opts = Mappable:map(x => Option.Some(x), [1, 2, 3])\n  write with-opts  ; [Option.Some(1), Option.Some(2), Option.Some(3)]\n\n  ; Nested Mappable:map (callback uses Array function)\n  let nested = [[1, 2], [3, 4]]\n  let doubled-nested = Mappable:map(arr => Mappable:map(x => x * 2, arr), nested)\n  write doubled-nested  ; [[2, 4], [6, 8]]\n\n  ; === foreach ===\n\n  ; foreach for side effects (outputs each element)\n  write \"foreach:\"\n  let fe-result = foreach(x => { write x }, [10, 20, 30])\n  write fe-result  ; Unit\n\n  ; foreach on empty array (no side effects)\n  let fe-empty = foreach(x => { write x }, [])\n  write fe-empty  ; Unit\n\n  ; `foreach` with collected `Range`\n  write \"range foreach:\"\n  let fe-range = foreach(n => { write n }, Range.collect(1 .. 4))\n  write fe-range  ; Unit\n\n  ; === Array.zip ===\n\n  let a = [1, 2, 3]\n  let b = [\"a\", \"b\", \"c\"]\n  let zipped = Array.zip(a, b)\n  write zipped\n\n  ; Shorter array determines length\n  let short = [1, 2]\n  let long = [\"a\", \"b\", \"c\", \"d\"]\n  write Array.zip(short, long)\n\n  ; === Array.unzip ===\n\n  let pairs: Array[(Int, String)] = [(1, \"one\"), (2, \"two\"), (3, \"three\")]\n  let (unzip-nums, unzip-strs) = Array.unzip(pairs)\n  write unzip-nums\n  write unzip-strs\n\n  ; Round-trip\n  let x = [10, 20, 30]\n  let y = [true, false, true]\n  let (x2, y2) = Array.unzip(Array.zip(x, y))\n  write x2\n  write y2\n\n  ; === Array.intersperse ===\n\n  let inter-words = [\"hello\", \"world\", \"!\"]\n  write Array.intersperse(\",\", inter-words)\n\n  let inter-nums = [1, 2, 3, 4]\n  write Array.intersperse(0, inter-nums)\n\n  ; Empty array\n  let inter-empty: Array[Int] = []\n  write Array.intersperse(0, inter-empty)\n\n  ; Single element\n  write Array.intersperse(0, [42])\n\n  ; === Array.zip-with ===\n\n  let xs = [1, 2, 3]\n  let ys = [10, 20, 30]\n  write Array.zip-with(zip-add, xs, ys)\n\n  ; With closure\n  let multiplied = Array.zip-with((ma, mb) => ma * mb, [2, 3, 4], [5, 6, 7])\n  write multiplied\n\n  ; With shorter array\n  write Array.zip-with(zip-add, [1, 2, 3, 4, 5], [10, 20])\n\n  ; === Array.sort-by ===\n\n  let unsorted = [3, 1, 4, 1, 5, 9, 2, 6]\n  write Array.sort-by(cmp-int, unsorted)\n  write Array.sort-by(Ord:compare, unsorted)\n\n  ; Sort descending (reverse comparator)\n  write Array.sort-by(cmp-desc, unsorted)\n\n  ; Sort by absolute value\n  let signed = [-5, 3, -1, 4, -2]\n  write Array.sort-by(cmp-abs, signed)\n\n  ; Sort objects by field\n  let people = [\n    { name: \"Alice\", age: 30 },\n    { name: \"Bob\", age: 25 },\n    { name: \"Carol\", age: 35 }\n  ]\n  let by-age = Array.sort-by(cmp-by-age, people)\n  write Mappable:map(p => p.name, by-age)\n\n  ; === Chained operations ===\n\n  ; zip, map, filter chain\n  let indices = [0, 1, 2, 3, 4]\n  let values = [10, 25, 30, 15, 40]\n  let indexed = Array.zip(indices, values)\n  let chain-filtered = Filterable:filter(pair => pair.1 > 20, indexed)\n  write chain-filtered\n\n  ; zip-with to compute differences\n  let before = [10, 20, 30]\n  let after = [15, 18, 35]\n  let diffs = Array.zip-with((db, da) => da - db, before, after)\n  write diffs\n\n  ; === Collected ranges with array constraints ===\n\n  ; Collected ranges should satisfy `Iterable` constraints\n  write iter-len(Range.collect(1 ..= 20))\n  write iter-len([1, 2, 3, 4, 5])\n\n  ; Collected ranges should satisfy `Foldable` constraints\n  write iter-sum(Range.collect(1 ..= 5))\n  write iter-sum([10, 20, 30])\n}\n"
