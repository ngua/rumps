---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: String interpolation\n; Tests `\"{expr}\"` syntax with various types and expressions\n\nfun main() {\n  ; Basic variable interpolation\n  let my-name = \"World\"\n  write \"Hello, {my-name}!\"\n\n  ; Multiple interpolations\n  let x = 1\n  let y = 2\n  write \"{x} + {y} = {x + y}\"\n\n  ; Inline expressions\n  write \"Result: {10 * 5 + 2}\"\n\n  ; Various scalar types\n  let my-int = 42\n  let my-float = 3.14\n  let my-bool = true\n  let my-char = 'X'\n  write \"Int: {my-int}, Float: {my-float}, Bool: {my-bool}, Char: {my-char}\"\n\n  ; Nested object field access\n  let my-obj = { x: 10, y: 20 }\n  write \"Point: ({my-obj.x}, {my-obj.y})\"\n\n  ; Array elements\n  let my-arr = [1, 2, 3]\n  write \"First: {my-arr[0]}, Second: {my-arr[1]}\"\n\n  ; Function call in interpolation\n  write \"Double of 5: {double(5)}\"\n\n  ; Closure in interpolation\n  let inc = (n: Int) => n + 1\n  write \"Incremented: {inc(99)}\"\n\n  ; Tuple access\n  let my-tup = (100, \"hello\")\n  write \"Tuple: {my-tup.0}, {my-tup.1}\"\n\n  ; Escaped braces: `{{` becomes `{`, `}}` becomes `}`\n  write \"Braces: {{ and }}\"\n  write \"Mixed: {my-int} in {{curly}} braces\"\n\n  ; Empty interpolation parts\n  let my-msg = \"test\"\n  write \"{my-msg}\"\n  write \"prefix{my-msg}\"\n  write \"{my-msg}suffix\"\n\n  ; Complex expressions (if-else)\n  let cmp-result = if x < y { \"less\" } else { \"not less\" }\n  write \"Ternary-like: {cmp-result}\"\n\n  ; String values pass through without extra quotes\n  let my-str = \"no quotes\"\n  write \"Value: {my-str}\"\n\n  ; Array length\n  let my-nums = [1, 2, 3, 4, 5]\n  write \"Length: {Iterable:length(my-nums)}\"\n\n  ; Map literal\n  let my-map = { 1 => \"one\", 2 => \"two\" }\n  let has-key = Map.has(my-map, 1)\n  write \"Map has key 1: {has-key}\"\n\n  ; Option values\n  let some-val = ?42\n  let none-val = Option.None\n  write \"Some: {some-val}, None: {none-val}\"\n\n  ; Range\n  let my-range = 1 .. 5\n  write \"Range: {my-range}\"\n\n  ; With arithmetic precedence\n  write \"Precedence: {2 + 3 * 4}\"\n\n  ; Boolean expressions\n  write \"And: {true and false}, Or: {true or false}\"\n\n  ; Comparison in interpolation\n  write \"Compare: {5 < 10}, {5 == 5}, {5 != 3}\"\n\n  ; Using coalesce\n  let my-maybe: Option[Int] = ?10\n  write \"Coalesced: {my-maybe ?? 0}\"\n\n  ; Pipe operator\n  write \"Piped: {5 |> double}\"\n\n  ; Nested string interpolation\n  let inner = 100\n  write \"Outer: {\"Inner: {inner}\"}\"\n\n  ; if expression directly in interpolation\n  let val = 7\n  write \"Direct if: {if val > 5 { \"big\" } else { \"small\" }}\"\n\n  ; DbRef in interpolation (requires the merge_dbref fix)\n  @set d{1, 2} \"nested-key\"\n  write \"DbRef: {@get d{1, 2}!}\"\n\n  ; Complex subscript expression\n  let idx = 2\n  @set d{1, idx} \"dynamic\"\n  write \"Dynamic key: {@get d{1, idx}!}\"\n\n  ; Block expression in interpolation (note: `{{` is escape, so `{{{ ... }}}` needed)\n  write \"Block: {{{ 2 * 21 }}}\"\n\n  ; Unwrap in interpolation\n  let opt: Option[Int] = ?999\n  write \"Unwrapped: {opt!}\"\n}\n\nfun double(n: Int) -> Int { n * 2 }\n"
---
"Hello, World!"
"1 + 2 = 3"
"Result: 52"
"Int: 42, Float: 3.14, Bool: true, Char: 'X'"
"Point: (10, 20)"
"First: 1, Second: 2"
"Double of 5: 10"
"Incremented: 100"
"Tuple: 100, hello"
"Braces: { and }"
"Mixed: 42 in {curly} braces"
"test"
"prefixtest"
"testsuffix"
"Ternary-like: less"
"Value: no quotes"
"Length: 5"
"Map has key 1: true"
"Some: Option.Some(42), None: Option.None"
"Range: 1 .. 5"
"Precedence: 14"
"And: false, Or: true"
"Compare: true, true, true"
"Coalesced: 10"
"Piped: 10"
"Outer: Inner: 100"
"Direct if: big"
"DbRef: nested-key"
"Dynamic key: dynamic"
"Block: {42}"
"Unwrapped: 999"
