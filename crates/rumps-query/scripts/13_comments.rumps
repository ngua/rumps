; Test: comments
; This entire line is a comment

fun main() {
  ; Comments should be ignored by the lexer
  let x = 42 ; inline comment after code
  write x
  ; Expected: 42

  ; Multiple comment lines
  ; Line 1
  ; Line 2
  ; Line 3

  let y = 10 ; first inline
  let z = 20 ; second inline

  ; Comment with special characters: !@#$%^&*()
  ; Comment with "quotes" and 'apostrophes'
  ; Comment with numbers 12345

  write y + z ; should output 30
  ; Expected: 30

  ; Empty comment
  ;
  ;; Double semicolon
  ;;; Triple semicolon

  ; Comment at end of file
  write "Comment test complete"
  ; final comment
}
