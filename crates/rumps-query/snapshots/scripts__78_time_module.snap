source: crates/rumps-query/tests/scripts.rs
description: "; Time module primitives\n; Tests Time.now, Time.epoch, Time.parse, Time.format,\n; Time.add-seconds, Time.diff-seconds, Time.year, Time.month,\n; Time.day, Time.hour, Time.minute, Time.second\n\nfun main() {\n  ; ============ Time.epoch ============\n\n  let epoch = Time.epoch()\n  write epoch\n\n  ; Epoch components\n  write Time.year(epoch)    ; 1970\n  write Time.month(epoch)   ; 1\n  write Time.day(epoch)     ; 1\n  write Time.hour(epoch)    ; 0\n  write Time.minute(epoch)  ; 0\n  write Time.second(epoch)  ; 0\n\n  ; ============ Time.add-seconds ============\n\n  let one-hour = Time.add-seconds(epoch, 3600)\n  write Time.hour(one-hour)  ; 1\n\n  let one-day = Time.add-seconds(epoch, 86400)\n  write Time.day(one-day)  ; 2\n\n  ; Negative seconds (subtract)\n  let back = Time.add-seconds(one-hour, -3600)\n  write Time.hour(back)  ; 0\n\n  ; ============ Time.diff-seconds ============\n\n  let diff1 = Time.diff-seconds(one-hour, epoch)\n  write diff1  ; 3600.0\n\n  let diff2 = Time.diff-seconds(epoch, one-hour)\n  write diff2  ; -3600.0\n\n  let diff3 = Time.diff-seconds(one-day, epoch)\n  write diff3  ; 86400.0\n\n  ; ============ Time.format and Time.parse ============\n\n  ; Format epoch to ISO-like string\n  let fmt = Time.format(\"%Y-%m-%d %H:%M:%S %z\", epoch)\n  write fmt  ; 1970-01-01 00:00:00 +0000\n\n  ; Format with different patterns\n  let date-only = Time.format(\"%Y-%m-%d\", epoch)\n  write date-only  ; 1970-01-01\n\n  let time-only = Time.format(\"%H:%M:%S\", epoch)\n  write time-only  ; 00:00:00\n\n  ; Parse a date string back\n  let parsed = Time.parse(\"%Y-%m-%d %H:%M:%S %z\", \"2024-06-15 14:30:45 +0000\")\n  write :display(parsed)  ; Result[Time, String]\n\n  ; Check that parsed is Ok\n  write parsed is Result.Ok(_)  ; true\n\n  ; Unwrap and check components\n  let t = parsed!\n  write Time.year(t)    ; 2024\n  write Time.month(t)   ; 6\n  write Time.day(t)     ; 15\n  write Time.hour(t)    ; 14\n  write Time.minute(t)  ; 30\n  write Time.second(t)  ; 45\n\n  ; ============ Parse error handling ============\n\n  let bad-parse = Time.parse(\"%Y-%m-%d\", \"not-a-date\")\n  write bad-parse is Result.Err(_)  ; true\n\n  ; ============ Time.now ============\n\n  ; Just verify it runs and returns a Time\n  let now = Time.now()\n  write now is Time  ; true\n\n  ; ============ Chaining with pipeline ============\n\n  let chain = Time.add-seconds(Time.epoch(), 3661)  ; 1 hour, 1 minute, 1 second\n  write Time.hour(chain)    ; 1\n  write Time.minute(chain)  ; 1\n  write Time.second(chain)  ; 1\n\n  ; ============ Formatting variations ============\n\n  let t2 = Time.add-seconds(epoch, 90061)  ; 1 day + 1 hour + 1 minute + 1 second\n\n  write Time.format(\"%d/%m/%Y\", t2)  ; 02/01/1970\n  write Time.format(\"%I:%M %p\", t2)  ; 01:01 AM\n}\n"
