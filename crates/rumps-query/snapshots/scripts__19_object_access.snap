---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: object field access\n; Tests dot notation for objects (bracket notation is for arrays/maps only)\n\nfun main() {\n  let obj = { name: \"Alice\", age: 30, active: true }\n\n  ; Dot notation\n  write obj.name\n  ; Expected: Alice\n\n  write obj.age\n  ; Expected: 30\n\n  write obj.active\n  ; Expected: true\n\n  ; Nested object access (dot notation)\n  let rec = {\n    user: {\n      profile: {\n        first-name: \"Bob\",\n        last-name: \"Smith\"\n      },\n      scores: [90, 85, 95]\n    }\n  }\n\n  write rec.user.profile.first-name\n  ; Expected: Bob\n\n  write rec.user.profile.last-name\n  ; Expected: Smith\n\n  write rec.user.scores[0]\n  ; Expected: 90\n\n  write rec.user.scores[-1]\n  ; Expected: 95\n\n  ; Object with dashed keys (valid RUMPS identifiers)\n  let special = { my-key: \"value1\", another-key: \"value2\" }\n  write special.my-key\n  ; Expected: value1\n\n  write special.another-key\n  ; Expected: value2\n\n  ; Optional field access (`?.`) on objects\n  ; Returns `Some(value)` if field exists, `None` if missing\n\n  let person = { name: \"Carol\", age: 25 }\n\n  write person?.name\n  ; Expected: Option.Some(\"Carol\")\n\n  write person?.age\n  ; Expected: Option.Some(25)\n\n  write person?.email\n  ; Expected: Option.None\n\n  write person?.address\n  ; Expected: Option.None\n\n  ; Chained optional access\n  let nested = { user: { name: \"Dan\" } }\n  write nested?.user?.name\n  ; Expected: Option.Some(\"Dan\")\n\n  write nested?.user?.missing\n  ; Expected: Option.None\n\n  write nested?.missing?.anything\n  ; Expected: Option.None\n\n  write get-b({ a: 1 })\n  ; Expected: Option.None\n\n  write get-b({ a: 1, b: 2 })\n  ; Expected: Option.Some(2)\n\n  write \"Object access test complete\"\n}\n\n; Optional field access in function with typed parameter\n; The type `{ a: Int }` should allow `?.` on fields not in the type\nfun get-b(x: { a: Int }) {\n  x?.b\n}\n"
---
