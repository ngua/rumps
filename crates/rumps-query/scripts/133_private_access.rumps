; Private module member access errors
; Tests that private members (without `+`) cannot be accessed outside the module

MODULE Secrets {
  ; Private constant (no `+` prefix)
  LET hidden = 42

  ; Private function
  FUN internal() -> Int { 100 }

  ; Private TYPE
  TYPE Status = Pending | Done

  ; Private NEWTYPE
  NEWTYPE UserId = Int

  ; Private UNION
  UNION Payload = Int | String
}

; Accessing private constant should produce a type error
LET x = Secrets.hidden

; Accessing private function should produce a type error
LET y = Secrets.internal()

; Accessing private TYPE should produce a type error
LET z: Secrets.Status = Secrets.Status.Pending

; Accessing private NEWTYPE should produce a type error
LET w: Secrets.UserId = 123

; Accessing private UNION should produce a type error
LET v: Secrets.Payload = 456
