---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: @order primitive\n; Returns next subscript at a given level\n; NOTE: Uses locals only; globals require transaction blocks\n\nfun main() {\n  ; Set up test data\n  @set items{1} \"one\"\n  @set items{2} \"two\"\n  @set items{10} \"ten\"\n  @set items{\"A\"} \"alpha\"\n  @set items{\"B\"} \"beta\"\n\n  @set nested{1, \"A\"} \"nested 1A\"\n  @set nested{1, \"B\"} \"nested 1B\"\n  @set nested{2, \"X\"} \"nested 2X\"\n\n  ; First subscript at root (no after value, use {} for root)\n  let first = @order items{}\n  write first\n\n  ; Next subscript after 1\n  let after-1 = @order items{1}\n  write after-1\n\n  ; Next subscript after 2\n  let after-2 = @order items{2}\n  write after-2\n\n  ; Next subscript after 10\n  let after-10 = @order items{10}\n  write after-10\n\n  ; Past the last numeric key\n  let after-a = @order items{\"A\"}\n  write after-a\n\n  ; Past the last key entirely\n  let after-b = @order items{\"B\"}\n  write after-b\n\n  ; Next subscript at root after 1 (which is 2)\n  let nested-after-1 = @order nested{1}\n  write nested-after-1\n\n  ; Next subscript under nested{1} after \"A\"\n  let nested-1-after-a = @order nested{1, \"A\"}\n  write nested-1-after-a\n\n  ; Past last key under nested{1}\n  let nested-1-after-b = @order nested{1, \"B\"}\n  write nested-1-after-b\n\n  ; Next subscript at root after 2 (none)\n  let nested-after-2 = @order nested{2}\n  write nested-after-2\n\n  ; @order on non-existent variable (use {} for root)\n  let no-keys = @order empty{}\n  write no-keys\n\n  ; @order with different subscript types\n  @set mixed{true} \"bool key\"\n  @set mixed{42} \"int key\"\n  @set mixed{3.14} \"float key\"\n  @set mixed{\"str\"} \"string key\"\n\n  ; Bool comes first, then numbers, then strings\n  let mixed-first = @order mixed{}\n  write mixed-first\n\n  let mixed-after-true = @order mixed{true}\n  write mixed-after-true\n\n  ; Type annotation\n  let typed: Option[Subscript] = @order items{}\n  write typed\n\n  write \"@order test complete\"\n}\n"
---
Option.Some(1)
Option.Some(2)
Option.Some(10)
Option.Some("A")
Option.Some("B")
Option.None
Option.Some(2)
Option.Some("B")
Option.None
