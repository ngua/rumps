description: "; Error: HKT class for types with wrong number of unfilled params\n;\n; Tests three error cases:\n; 1. Type with 0 type params (`Point`)\n; 2. Fully applied type (`Pair[Int, String]`)\n; 3. Too many unfilled params (`Triple` with 3 params)\n\nfun main() { }\n\ntype Point = Point(Int, Int)\n\nclass Fallible for Point {\n  fun unwrap(p: Point) -> Int {\n    match p {\n      Point.Point(x, _) => { x }\n    }\n  }\n}\n\ntype Pair[A, B] = Pair(A, B)\n\nclass Fallible for Pair[Int, String] {\n  fun unwrap(p: Pair[Int, String]) -> String {\n    match p {\n      Pair.Pair(_, s) => { s }\n    }\n  }\n}\n\ntype Triple[A, B, C] = Triple(A, B, C)\n\nclass Fallible for Triple {\n  fun unwrap(t: Triple[A, B, C]) -> C {\n    match t {\n      Triple.Triple(_, _, c) => { c }\n    }\n  }\n}\n"
