---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: object field and bracket access\n; Tests dot notation and bracket notation for objects\n\nLET obj = { name: \"Alice\", age: 30, active: TRUE }\n\n; Dot notation\nOUTPUT obj.name\n; Expected: Alice\n\nOUTPUT obj.age\n; Expected: 30\n\nOUTPUT obj.active\n; Expected: TRUE\n\n; Bracket notation with string literal\nOUTPUT obj[\"name\"]\n; Expected: Alice\n\nOUTPUT obj[\"age\"]\n; Expected: 30\n\nOUTPUT obj[\"active\"]\n; Expected: TRUE\n\n; Bracket notation with string variable\nLET key = \"name\"\nOUTPUT obj[key]\n; Expected: Alice\n\nLET key2 = \"age\"\nOUTPUT obj[key2]\n; Expected: 30\n\n; Dynamic key lookup\nLET keys = [\"name\", \"age\", \"active\"]\nOUTPUT obj[keys[0]]\n; Expected: Alice\n\nOUTPUT obj[keys[1]]\n; Expected: 30\n\n; Nested object access (mixed notation)\nLET data = {\n  user: {\n    profile: {\n      firstName: \"Bob\",\n      lastName: \"Smith\"\n    },\n    scores: [90, 85, 95]\n  }\n}\n\nOUTPUT data.user.profile.firstName\n; Expected: Bob\n\nOUTPUT data[\"user\"][\"profile\"][\"lastName\"]\n; Expected: Smith\n\nOUTPUT data.user[\"profile\"].firstName\n; Expected: Bob\n\nOUTPUT data[\"user\"].profile[\"lastName\"]\n; Expected: Smith\n\nOUTPUT data.user.scores[0]\n; Expected: 90\n\nOUTPUT data.user.scores[-1]\n; Expected: 95\n\n; Object with numeric string keys\nLET nums = { \"1\": \"one\", \"2\": \"two\", \"3\": \"three\" }\nOUTPUT nums[\"1\"]\n; Expected: one\n\nOUTPUT nums[\"2\"]\n; Expected: two\n\n; Object with special characters in keys (via bracket)\nLET special = { \"my-key\": \"value1\", \"another.key\": \"value2\" }\nOUTPUT special[\"my-key\"]\n; Expected: value1\n\nOUTPUT special[\"another.key\"]\n; Expected: value2\n\nOUTPUT \"Object access test complete\"\n"
---
ERROR: parse error at 1219..1220: unexpected `:` (expected: OR, +, >=, <, ==, ?., indent, AND, (, ||, ., &&, //, dedent, newline, ++, -, !=, }, ??, [, /, >, %, *, <=)
