; Test: Unit literal
; Tests the `Unit` value literal

; Unit equals itself
WRITE Unit IS Unit
; Expected: true

; Unit in variable
LET u = Unit
WRITE u
; Expected: Unit

; Unit equality via variable
WRITE u IS Unit
; Expected: true

; Unit in tuple
LET pair = (1, Unit)
WRITE pair
; Expected: (1, Unit)

WRITE "Unit literal test complete"
