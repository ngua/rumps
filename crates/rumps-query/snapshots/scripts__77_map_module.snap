---
source: crates/rumps-query/tests/scripts.rs
description: "; Map module primitives\n; Tests Map.empty, Map.length, Map.keys, Map.values, Map.entries,\n; Map.has, Map.lookup, Map.insert, Map.remove, Map.merge, Map.from-entries\n;\n; Note: `{}` is ambiguous and parsed as an empty object. Use Map.empty() for empty maps.\n\nfun main() {\n  ; ============ Map literals ============\n\n  let m = { 1 => \"one\", 2 => \"two\", 3 => \"three\" }\n  write m\n\n  let str-keys = { \"a\" => 1, \"b\" => 2 }\n  write str-keys\n\n  ; ============ Map.empty ============\n\n  let e = Map.empty()\n  write e\n  write Map.length(e)  ; 0\n\n  ; ============ Map.length ============\n\n  write Map.length(m)  ; 3\n  write Map.length(str-keys)  ; 2\n\n  ; ============ Map.keys ============\n\n  let keys1 = Map.keys(m)\n  write keys1  ; [1, 2, 3]\n\n  let keys2 = Map.keys(str-keys)\n  write keys2  ; [\"a\", \"b\"]\n\n  let keys3 = Map.keys(e)\n  write keys3  ; []\n\n  ; ============ Map.values ============\n\n  let vals1 = Map.values(m)\n  write vals1  ; [\"one\", \"two\", \"three\"]\n\n  let vals2 = Map.values(str-keys)\n  write vals2  ; [1, 2]\n\n  let vals3 = Map.values(e)\n  write vals3  ; []\n\n  ; ============ Map.entries ============\n\n  let ent1 = Map.entries(m)\n  write ent1  ; [(1, \"one\"), (2, \"two\"), (3, \"three\")]\n\n  let ent2 = Map.entries(str-keys)\n  write ent2  ; [(\"a\", 1), (\"b\", 2)]\n\n  ; ============ Map.has ============\n\n  write Map.has(m, 1)  ; true\n  write Map.has(m, 2)  ; true\n  write Map.has(m, 4)  ; false\n  write Map.has(e, 1)  ; false\n\n  write Map.has(str-keys, \"a\")  ; true\n  write Map.has(str-keys, \"c\")  ; false\n\n  ; ============ Map.lookup ============\n\n  write Map.lookup(m, 1)  ; Some(\"one\")\n  write Map.lookup(m, 2)  ; Some(\"two\")\n  write Map.lookup(m, 4)  ; None\n  write Map.lookup(e, 1)  ; None\n\n  write Map.lookup(str-keys, \"a\")  ; Some(1)\n  write Map.lookup(str-keys, \"z\")  ; None\n\n  ; ============ Map.insert ============\n\n  let m2 = Map.insert(m, 4, \"four\")\n  write Map.length(m2)  ; 4\n  write Map.lookup(m2, 4)  ; Some(\"four\")\n\n  ; Original unchanged\n  write Map.length(m)  ; 3\n\n  ; Overwrite existing key\n  let m3 = Map.insert(m, 1, \"ONE\")\n  write Map.lookup(m3, 1)  ; Some(\"ONE\")\n\n  ; ============ Map.remove ============\n\n  let m4 = Map.remove(m, 2)\n  write Map.length(m4)  ; 2\n  write Map.has(m4, 2)  ; false\n  write Map.has(m4, 1)  ; true\n  write Map.has(m4, 3)  ; true\n\n  ; Remove non-existent key (no-op)\n  let m5 = Map.remove(m, 999)\n  write Map.length(m5)  ; 3\n\n  ; ============ Map.merge ============\n\n  let ma = { 1 => \"a\", 2 => \"b\" }\n  let mb = { 2 => \"B\", 3 => \"c\" }\n  let merged = Map.merge(ma, mb)\n  write Map.length(merged)  ; 3\n  write Map.lookup(merged, 1)  ; Some(\"a\")\n  write Map.lookup(merged, 2)  ; Some(\"B\") (second overwrites)\n  write Map.lookup(merged, 3)  ; Some(\"c\")\n\n  ; ============ Map.from-entries ============\n\n  let arr = [(1, \"x\"), (2, \"y\"), (3, \"z\")]\n  let from-arr = Map.from-entries(arr)\n  write Map.length(from-arr)  ; 3\n  write Map.lookup(from-arr, 1)  ; Some(\"x\")\n  write Map.lookup(from-arr, 2)  ; Some(\"y\")\n  write Map.lookup(from-arr, 3)  ; Some(\"z\")\n\n  ; ============ Chaining operations ============\n\n  let chain = { 1 => 10, 2 => 20, 3 => 30 }\n  let chain2 = Map.insert(chain, 4, 40)\n  let chain3 = Map.remove(chain2, 1)\n  write Map.length(chain3)  ; 3\n  write Map.keys(chain3)  ; [2, 3, 4]\n\n  ; ============ Float keys ============\n\n  let float-map = { 1.5 => \"half\", 2.5 => \"two-half\" }\n  write Map.has(float-map, 1.5)  ; true\n  write Map.lookup(float-map, 2.5)  ; Some(\"two-half\")\n\n  ; ============ Boolean keys ============\n\n  let bool-map = { true => \"yes\", false => \"no\" }\n  write Map.lookup(bool-map, true)  ; Some(\"yes\")\n  write Map.lookup(bool-map, false)  ; Some(\"no\")\n\n  ; ============ Index syntax (direct access) ============\n\n  write m[1]  ; \"one\"\n  write m[2]  ; \"two\"\n\n  write str-keys[\"a\"]  ; 1\n\n  ; ============ Optional index syntax (returns Option) ============\n\n  write m?[1]  ; Some(\"one\")\n  write m?[99]  ; None (key not found)\n\n  write str-keys?[\"a\"]  ; Some(1)\n  write str-keys?[\"missing\"]  ; None\n\n  ; Chaining with optional unwrap\n  write m?[1] ?? \"default\"  ; \"one\"\n  write m?[99] ?? \"default\"  ; \"default\"\n}\n"
