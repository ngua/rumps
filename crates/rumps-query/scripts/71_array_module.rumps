; Array module functions
; Tests Mappable:map, Filterable:filter, Foldable:fold, foreach

fun square(n: Int) -> Int { n * n }

fun is-positive(n: Int) -> Bool { n > 0 }

fun add(a: Int, b: Int) -> Int { a + b }

fun zip-add(za: Int, zb: Int) -> Int { za + zb }

fun cmp-int(ca: Int, cb: Int) -> Ordering {
  if ca < cb { Ordering.Lt } else {
    if ca == cb { Ordering.Eq } else { Ordering.Gt }
  }
}

fun cmp-desc(da: Int, db: Int) -> Ordering {
  if da > db { Ordering.Lt } else {
    if da == db { Ordering.Eq } else { Ordering.Gt }
  }
}

fun cmp-abs(aa: Int, ab: Int) -> Ordering {
  let abs-a = if aa < 0 { 0 - aa } else { aa }
  let abs-b = if ab < 0 { 0 - ab } else { ab }
  cmp-int(abs-a, abs-b)
}

newtype SortPerson = { name: String, age: Int }

newtype Parity = Int

class Eq for Parity {
  fun eq(a: Parity, b: Parity) -> Bool {
    let ai: Int = a
    let bi: Int = b
    ai % 2 == bi % 2
  }
}

fun cmp-by-age(pa: SortPerson, pb: SortPerson) -> Ordering {
  cmp-int(pa.age, pb.age)
}

fun iter-len(i: Array[Int]) -> Int {
  Iterable:length(i)
}

fun iter-sum(i: Array[Int]) -> Int {
  Foldable:fold((acc, x) => acc + x, 0, i)
}

fun main() {
  ; Mappable:map with closure
  let nums = [1, 2, 3, 4, 5]
  let doubled = Mappable:map(x => x * 2, nums)
  write doubled  ; [2, 4, 6, 8, 10]

  ; Mappable:map on empty array
  let empty = []
  let mapped-empty = Mappable:map(x => x + 1, empty)
  write mapped-empty  ; []

  ; Mappable:map with named function
  let squares = Mappable:map(square, [1, 2, 3])
  write squares  ; [1, 4, 9]

  ; Filterable:filter with closure
  let evens = Filterable:filter(x => x % 2 == 0, nums)
  write evens  ; [2, 4]

  ; Filterable:filter on empty array
  let filtered-empty = Filterable:filter(x => x > 0, empty)
  write filtered-empty  ; []

  ; Filterable:filter with named function
  let positives = Filterable:filter(is-positive, [-1, 0, 1, 2])
  write positives  ; [1, 2]

  ; Filterable:filter keeping all
  let all-kept = Filterable:filter(x => true, [1, 2, 3])
  write all-kept  ; [1, 2, 3]

  ; Filterable:filter keeping none
  let none-kept = Filterable:filter(x => false, [1, 2, 3])
  write none-kept  ; []

  ; Foldable:fold with sum
  let sum = Foldable:fold((acc, x) => acc + x, 0, nums)
  write sum  ; 15

  ; Foldable:fold on empty array returns initial value
  let empty-sum = Foldable:fold((acc, x) => acc + x, 100, empty)
  write empty-sum  ; 100

  ; Foldable:fold with string concatenation
  let words = ["hello", " ", "world"]
  let combined = Foldable:fold((acc, s) => "{acc}{s}", "", words)
  write combined  ; "hello world"

  ; Foldable:fold with named function
  let total = Foldable:fold(add, 0, [1, 2, 3, 4])
  write total  ; 10

  ; Combining Array functions
  let result = Foldable:fold(
    (acc, x) => acc + x,
    0,
    Mappable:map(x => x * x, Filterable:filter(x => x % 2 == 1, [1, 2, 3, 4, 5]))
  )
  write result  ; 1 + 9 + 25 = 35

  ; Pipeline usage with Array functions (using wrapper closures)
  let piped = [1, 2, 3, 4, 5]
    |> (arr => Filterable:filter(x => x > 2, arr))
    |> (arr => Mappable:map(x => x * 10, arr))
  write piped  ; [30, 40, 50]

  ; Module functions can be passed as first-class values
  let filter-fn = Filterable:filter
  let data = [1, 2, 3, 4, 5]
  let filtered = filter-fn(x => x > 2, data)
  write filtered  ; [3, 4, 5]

  ; Mappable:map with Option results (homogeneous tagged values)
  let with-opts = Mappable:map(x => Option.Some(x), [1, 2, 3])
  write with-opts  ; [Option.Some(1), Option.Some(2), Option.Some(3)]

  ; Nested Mappable:map (callback uses Array function)
  let nested = [[1, 2], [3, 4]]
  let doubled-nested = Mappable:map(arr => Mappable:map(x => x * 2, arr), nested)
  write doubled-nested  ; [[2, 4], [6, 8]]

  ; === foreach ===

  ; foreach for side effects (outputs each element)
  write "foreach:"
  let fe-result = foreach(x => { write x }, [10, 20, 30])
  write fe-result  ; Unit

  ; foreach on empty array (no side effects)
  let fe-empty = foreach(x => { write x }, [])
  write fe-empty  ; Unit

  ; `foreach` with collected `Range`
  write "range foreach:"
  let fe-range = foreach(n => { write n }, Range.collect(1 .. 4))
  write fe-range  ; Unit

  ; === Array.zip ===

  let a = [1, 2, 3]
  let b = ["a", "b", "c"]
  let zipped = Array.zip(a, b)
  write zipped

  ; Shorter array determines length
  let short = [1, 2]
  let long = ["a", "b", "c", "d"]
  write Array.zip(short, long)

  ; === Array.unzip ===

  let pairs: Array[(Int, String)] = [(1, "one"), (2, "two"), (3, "three")]
  let (unzip-nums, unzip-strs) = Array.unzip(pairs)
  write unzip-nums
  write unzip-strs

  ; Round-trip
  let x = [10, 20, 30]
  let y = [true, false, true]
  let (x2, y2) = Array.unzip(Array.zip(x, y))
  write x2
  write y2

  ; === Array.intersperse ===

  let inter-words = ["hello", "world", "!"]
  write Array.intersperse(",", inter-words)

  let inter-nums = [1, 2, 3, 4]
  write Array.intersperse(0, inter-nums)

  ; Empty array
  let inter-empty: Array[Int] = []
  write Array.intersperse(0, inter-empty)

  ; Single element
  write Array.intersperse(0, [42])

  ; === Array.zip-with ===

  let xs = [1, 2, 3]
  let ys = [10, 20, 30]
  write Array.zip-with(zip-add, xs, ys)

  ; With closure
  let multiplied = Array.zip-with((ma, mb) => ma * mb, [2, 3, 4], [5, 6, 7])
  write multiplied

  ; With shorter array
  write Array.zip-with(zip-add, [1, 2, 3, 4, 5], [10, 20])

  ; === Array.sort-by ===

  let unsorted = [3, 1, 4, 1, 5, 9, 2, 6]
  write Array.sort-by(cmp-int, unsorted)
  write Array.sort-by(Ord:compare, unsorted)

  ; Sort descending (reverse comparator)
  write Array.sort-by(cmp-desc, unsorted)

  ; Sort by absolute value
  let signed = [-5, 3, -1, 4, -2]
  write Array.sort-by(cmp-abs, signed)

  ; Sort objects by field
  let people = [
    { name: "Alice", age: 30 },
    { name: "Bob", age: 25 },
    { name: "Carol", age: 35 }
  ]
  let by-age = Array.sort-by(cmp-by-age, people)
  write Mappable:map(p => p.name, by-age)

  ; === Array.contains ===

  write Array.contains([1, 2, 3], 2)
  write Array.contains([1, 2, 3], 9)
  write Array.contains([], 1)
  write Array.contains(["hello", "world"], "hello")

  ; Uses the user `Eq` instance, not representation equality
  let p2: Parity = 2
  let p4: Parity = 4
  let p5: Parity = 5
  write Array.contains([p2], p4)
  write Array.contains([p2], p5)

  ; === Chained operations ===

  ; zip, map, filter chain
  let indices = [0, 1, 2, 3, 4]
  let values = [10, 25, 30, 15, 40]
  let indexed = Array.zip(indices, values)
  let chain-filtered = Filterable:filter(pair => pair.1 > 20, indexed)
  write chain-filtered

  ; zip-with to compute differences
  let before = [10, 20, 30]
  let after = [15, 18, 35]
  let diffs = Array.zip-with((db, da) => da - db, before, after)
  write diffs

  ; === Collected ranges with array constraints ===

  ; Collected ranges should satisfy `Iterable` constraints
  write iter-len(Range.collect(1 ..= 20))
  write iter-len([1, 2, 3, 4, 5])

  ; Collected ranges should satisfy `Foldable` constraints
  write iter-sum(Range.collect(1 ..= 5))
  write iter-sum([10, 20, 30])
}
