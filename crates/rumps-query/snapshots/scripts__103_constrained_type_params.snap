---
source: crates/rumps-query/tests/scripts.rs
description: "; Test constrained type parameters\n; Syntax: [T: Constraint1 + Constraint2]\n\n; ============================================================================\n; Basic constrained functions\n; ============================================================================\n\n; Numeric constraint: `T` must be `Int` or `Float`\nFUN add-numeric[T: Numeric](a: T, b: T) -> T {\n  a + b\n}\n\nWRITE add-numeric(1, 2)       ; 3\nWRITE add-numeric(1.5, 2.5)   ; 4.0\n\n; Stringable constraint: `T` can be converted to `String`\nFUN to-str[T: Stringable](x: T) -> String {\n  x AS String\n}\n\nWRITE to-str(42)        ; \"42\"\nWRITE to-str(true)      ; \"true\"\n\n; Jsonable constraint: `T` can be serialized to `Json`\nFUN to-json[T: Jsonable](x: T) -> Json {\n  x AS Json\n}\n\nWRITE to-json({a: 1, b: 2}) AS String   ; {\"a\":1,\"b\":2}\n\n; ============================================================================\n; Multiple constraints\n; ============================================================================\n\n; Multiple constraints with `+`\nFUN numeric-to-str[T: Numeric + Stringable](x: T) -> String {\n  (x + x) AS String\n}\n\nWRITE numeric-to-str(21)    ; \"42\"\nWRITE numeric-to-str(1.5)   ; \"3\"\n\n; ============================================================================\n; Mixed constrained and unconstrained\n; ============================================================================\n\n; Mix of constrained and unconstrained type parameters\nFUN pair-numeric[T: Numeric, U](x: T, y: U) -> (T, U) {\n  (x + x, y)\n}\n\nLET (n, s) = pair-numeric(21, \"hello\")\nWRITE n    ; 42\nWRITE s    ; \"hello\"\n\n; ============================================================================\n; Closures with constraints\n; ============================================================================\n\n; Closure with constrained type parameter; works with ANY Numeric type\nLET double = [T: Numeric](x: T) -> T => x + x\n\nWRITE double(10)    ; 20\nWRITE double(1.5)   ; 3.0\n\n; Higher-order function taking a constrained closure\nFUN apply-numeric[T: Numeric](f: (T) -> T, x: T) -> T {\n  f(x)\n}\n\nWRITE apply-numeric(double, 5)   ; 10\n\n; ============================================================================\n; Subscriptable constraint\n; ============================================================================\n\n; Subscriptable: type can be used as a DB subscript key\nFUN format-key[K: Subscriptable](k: K) -> String {\n  k AS String\n}\n\nWRITE format-key(42)        ; \"42\"\nWRITE format-key(\"foo\")     ; \"foo\"\nWRITE format-key(true)      ; \"true\"\n\n; ============================================================================\n; Storable constraint\n; ============================================================================\n\n; Storable: type can be stored in the database\nFUN identity-storable[V: Storable](v: V) -> V {\n  v\n}\n\nWRITE identity-storable(42)       ; 42\nWRITE identity-storable(\"hello\")  ; \"hello\"\nWRITE identity-storable(true)     ; true\n\n; ============================================================================\n; Iterable constraint with element type\n; ============================================================================\n\n; Iterable[T]: type must be Array or Range, yielding elements of type T\nFUN sum-all[T: Numeric, C: Iterable[T]](coll: C) -> T {\n  Iter.reduce((acc, x) => acc + x, 0, coll)\n}\n\nWRITE sum-all([1, 2, 3, 4, 5])     ; 15\nWRITE sum-all(1 .. 4)             ; 6 (1+2+3)\n"
