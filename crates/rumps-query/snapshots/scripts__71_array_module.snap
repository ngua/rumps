---
source: crates/rumps-query/tests/scripts.rs
description: "; Array module functions\n; Tests Mappable:map, Filterable:filter, Foldable:fold, foreach\n\nfun square(n: Int) -> Int { n * n }\n\nfun is-positive(n: Int) -> Bool { n > 0 }\n\nfun add(a: Int, b: Int) -> Int { a + b }\n\nfun zip-add(za: Int, zb: Int) -> Int { za + zb }\n\nfun cmp-int(ca: Int, cb: Int) -> Ordering {\n  if ca < cb { Ordering.Lt } else {\n    if ca == cb { Ordering.Eq } else { Ordering.Gt }\n  }\n}\n\nfun cmp-desc(da: Int, db: Int) -> Ordering {\n  if da > db { Ordering.Lt } else {\n    if da == db { Ordering.Eq } else { Ordering.Gt }\n  }\n}\n\nfun cmp-abs(aa: Int, ab: Int) -> Ordering {\n  let abs-a = if aa < 0 { 0 - aa } else { aa }\n  let abs-b = if ab < 0 { 0 - ab } else { ab }\n  cmp-int(abs-a, abs-b)\n}\n\nnewtype SortPerson = { name: String, age: Int }\n\nnewtype Parity = Int\n\nnewtype Rank = Int\n\nclass Eq for Parity {\n  fun eq(a: Parity, b: Parity) -> Bool {\n    let ai: Int = a\n    let bi: Int = b\n    ai % 2 == bi % 2\n  }\n}\n\nclass Ord for Rank {\n  fun compare(a: Rank, b: Rank) -> Ordering {\n    let ai: Int = a\n    let bi: Int = b\n    if ai > bi { Ordering.Lt } else {\n      if ai == bi { Ordering.Eq } else { Ordering.Gt }\n    }\n  }\n}\n\nfun cmp-by-age(pa: SortPerson, pb: SortPerson) -> Ordering {\n  cmp-int(pa.age, pb.age)\n}\n\nfun iter-len(i: Array[Int]) -> Int {\n  Iterable:length(i)\n}\n\nfun iter-sum(i: Array[Int]) -> Int {\n  Foldable:fold((acc, x) => acc + x, 0, i)\n}\n\nfun main() {\n  ; Mappable:map with closure\n  let nums = [1, 2, 3, 4, 5]\n  let doubled = Mappable:map(x => x * 2, nums)\n  write doubled  ; [2, 4, 6, 8, 10]\n\n  ; Mappable:map on empty array\n  let empty = []\n  let mapped-empty = Mappable:map(x => x + 1, empty)\n  write mapped-empty  ; []\n\n  ; Mappable:map with named function\n  let squares = Mappable:map(square, [1, 2, 3])\n  write squares  ; [1, 4, 9]\n\n  ; Filterable:filter with closure\n  let evens = Filterable:filter(x => x % 2 == 0, nums)\n  write evens  ; [2, 4]\n\n  ; Filterable:filter on empty array\n  let filtered-empty = Filterable:filter(x => x > 0, empty)\n  write filtered-empty  ; []\n\n  ; Filterable:filter with named function\n  let positives = Filterable:filter(is-positive, [-1, 0, 1, 2])\n  write positives  ; [1, 2]\n\n  ; Filterable:filter keeping all\n  let all-kept = Filterable:filter(x => true, [1, 2, 3])\n  write all-kept  ; [1, 2, 3]\n\n  ; Filterable:filter keeping none\n  let none-kept = Filterable:filter(x => false, [1, 2, 3])\n  write none-kept  ; []\n\n  ; Foldable:fold with sum\n  let sum = Foldable:fold((acc, x) => acc + x, 0, nums)\n  write sum  ; 15\n\n  ; Foldable:fold on empty array returns initial value\n  let empty-sum = Foldable:fold((acc, x) => acc + x, 100, empty)\n  write empty-sum  ; 100\n\n  ; Foldable:fold with string concatenation\n  let words = [\"hello\", \" \", \"world\"]\n  let combined = Foldable:fold((acc, s) => \"{acc}{s}\", \"\", words)\n  write combined  ; \"hello world\"\n\n  ; Foldable:fold with named function\n  let total = Foldable:fold(add, 0, [1, 2, 3, 4])\n  write total  ; 10\n\n  ; Combining Array functions\n  let result = Foldable:fold(\n    (acc, x) => acc + x,\n    0,\n    Mappable:map(x => x * x, Filterable:filter(x => x % 2 == 1, [1, 2, 3, 4, 5]))\n  )\n  write result  ; 1 + 9 + 25 = 35\n\n  ; Pipeline usage with Array functions (using wrapper closures)\n  let piped = [1, 2, 3, 4, 5]\n    |> (arr => Filterable:filter(x => x > 2, arr))\n    |> (arr => Mappable:map(x => x * 10, arr))\n  write piped  ; [30, 40, 50]\n\n  ; Module functions can be passed as first-class values\n  let filter-fn = Filterable:filter\n  let data = [1, 2, 3, 4, 5]\n  let filtered = filter-fn(x => x > 2, data)\n  write filtered  ; [3, 4, 5]\n\n  ; Mappable:map with Option results (homogeneous tagged values)\n  let with-opts = Mappable:map(x => Option.Some(x), [1, 2, 3])\n  write with-opts  ; [Option.Some(1), Option.Some(2), Option.Some(3)]\n\n  ; Nested Mappable:map (callback uses Array function)\n  let nested = [[1, 2], [3, 4]]\n  let doubled-nested = Mappable:map(arr => Mappable:map(x => x * 2, arr), nested)\n  write doubled-nested  ; [[2, 4], [6, 8]]\n\n  ; === foreach ===\n\n  ; foreach for side effects (outputs each element)\n  write \"foreach:\"\n  let fe-result = foreach(x => { write x }, [10, 20, 30])\n  write fe-result  ; Unit\n\n  ; foreach on empty array (no side effects)\n  let fe-empty = foreach(x => { write x }, [])\n  write fe-empty  ; Unit\n\n  ; `foreach` with collected `Range`\n  write \"range foreach:\"\n  let fe-range = foreach(n => { write n }, Range.collect(1 .. 4))\n  write fe-range  ; Unit\n\n  ; === Array.zip ===\n\n  let a = [1, 2, 3]\n  let b = [\"a\", \"b\", \"c\"]\n  let zipped = Array.zip(a, b)\n  write zipped\n\n  ; Shorter array determines length\n  let short = [1, 2]\n  let long = [\"a\", \"b\", \"c\", \"d\"]\n  write Array.zip(short, long)\n\n  ; === Array.unzip ===\n\n  let pairs: Array[(Int, String)] = [(1, \"one\"), (2, \"two\"), (3, \"three\")]\n  let (unzip-nums, unzip-strs) = Array.unzip(pairs)\n  write unzip-nums\n  write unzip-strs\n\n  ; Round-trip\n  let x = [10, 20, 30]\n  let y = [true, false, true]\n  let (x2, y2) = Array.unzip(Array.zip(x, y))\n  write x2\n  write y2\n\n  ; === Array.intersperse ===\n\n  let inter-words = [\"hello\", \"world\", \"!\"]\n  write Array.intersperse(\",\", inter-words)\n\n  let inter-nums = [1, 2, 3, 4]\n  write Array.intersperse(0, inter-nums)\n\n  ; Empty array\n  let inter-empty: Array[Int] = []\n  write Array.intersperse(0, inter-empty)\n\n  ; Single element\n  write Array.intersperse(0, [42])\n\n  ; === Array.zip-with ===\n\n  let xs = [1, 2, 3]\n  let ys = [10, 20, 30]\n  write Array.zip-with(zip-add, xs, ys)\n\n  ; With closure\n  let multiplied = Array.zip-with((ma, mb) => ma * mb, [2, 3, 4], [5, 6, 7])\n  write multiplied\n\n  ; With shorter array\n  write Array.zip-with(zip-add, [1, 2, 3, 4, 5], [10, 20])\n\n  ; === Array.sort-by ===\n\n  let unsorted = [3, 1, 4, 1, 5, 9, 2, 6]\n  write Array.sort-by(cmp-int, unsorted)\n  write Array.sort-by(Ord:compare, unsorted)\n\n  ; Sort descending (reverse comparator)\n  write Array.sort-by(cmp-desc, unsorted)\n\n  ; Sort by absolute value\n  let signed = [-5, 3, -1, 4, -2]\n  write Array.sort-by(cmp-abs, signed)\n\n  ; Sort objects by field\n  let people = [\n    { name: \"Alice\", age: 30 },\n    { name: \"Bob\", age: 25 },\n    { name: \"Carol\", age: 35 }\n  ]\n  let by-age = Array.sort-by(cmp-by-age, people)\n  write Mappable:map(p => p.name, by-age)\n\n  ; === Array.contains ===\n\n  write Array.contains([1, 2, 3], 2)\n  write Array.contains([1, 2, 3], 9)\n  write Array.contains([], 1)\n  write Array.contains([\"hello\", \"world\"], \"hello\")\n\n  ; Uses the user `Eq` instance, not representation equality\n  let p2: Parity = 2\n  let p4: Parity = 4\n  let p5: Parity = 5\n  write Array.contains([p2], p4)\n  write Array.contains([p2], p5)\n\n  let empty-ints: Array[Int] = []\n\n  ; === Array Phase `2` additions ===\n\n  write Array.minimum(empty-ints)\n  write Array.minimum([3, 1, 4, 1, 5])\n  write Array.maximum(empty-ints)\n  write Array.maximum([3, 1, 4, 1, 5])\n\n  let r1: Rank = 1\n  let r3: Rank = 3\n  let min-rank-id: Rank = Array.minimum([r1, r3]) ?? r1\n  let max-rank-id: Rank = Array.maximum([r1, r3]) ?? r1\n  let min-rank: Int = min-rank-id\n  let max-rank: Int = max-rank-id\n  write min-rank\n  write max-rank\n\n  write Array.elem-index([10, 20, 10], 10)\n  write Array.elem-index([10, 20, 10], 99)\n  write Array.elem-index(empty-ints, 10)\n  write Array.elem-index([p5, p2], p4)\n\n  ; === Array Phase `1` additions ===\n\n  write Array.last(empty-ints)\n  write Array.last([10, 20, 30])\n\n  write Array.init(empty-ints)\n  write Array.init([42])\n  write Array.init([1, 2, 3])\n\n  write Array.uncons(empty-ints)\n  write Array.uncons([1, 2, 3])\n\n  write Array.unsnoc(empty-ints)\n  write Array.unsnoc([1, 2, 3])\n\n  write Array.take(-2, [1, 2, 3])\n  write Array.take(2, [1, 2, 3])\n  write Array.take(99, [1, 2, 3])\n\n  write Array.drop(-2, [1, 2, 3])\n  write Array.drop(2, [1, 2, 3])\n  write Array.drop(99, [1, 2, 3])\n\n  write Array.split-at(-2, [1, 2, 3])\n  write Array.split-at(2, [1, 2, 3])\n  write Array.split-at(99, [1, 2, 3])\n\n  write Array.indexed([\"a\", \"b\", \"c\"])\n  write Array.indexed(empty-ints)\n\n  write Array.singleton(\"one\")\n  write Array.cons(0, [1, 2, 3])\n\n  ; === Array Phase `4` additions ===\n\n  write Array.set-at([1, 2, 3], 1, 99)\n  write Array.set-at([1, 2, 3], -1, 99)\n  write Array.set-at([1, 2, 3], 9, 99)\n\n  write Array.remove-at([1, 2, 3], 1)\n  write Array.remove-at([1, 2, 3], -1)\n  write Array.remove-at([1, 2, 3], 9)\n\n  write Array.insert-at([1, 2, 3], -1, 99)\n  write Array.insert-at([1, 2, 3], 1, 99)\n  write Array.insert-at([1, 2, 3], 9, 99)\n\n  write Array.adjust-at(x => x * 10, [1, 2, 3], 1)\n  write Array.adjust-at(x => x * 10, [1, 2, 3], -1)\n  write Array.adjust-at(x => x * 10, [1, 2, 3], 9)\n  write Array.adjust-at(x => {\n    write \"adjust-at-called\"\n    x * 10\n  }, empty-ints, 0)\n\n  ; === Array Phase `5` additions ===\n\n  write Array.flatten([[1, 2], [], [3, 4]])\n  let flat-empty: Array[Int] = Array.flatten([])\n  write flat-empty\n  write Array.flatten([[true], [false, true]])\n\n  let chunk-zero: Word = 0\n  let chunk-two: Word = 2\n  let chunk-big: Word = 99\n  write Array.chunks-of(chunk-zero, [1, 2, 3])\n  write Array.chunks-of(chunk-two, [1, 2, 3, 4, 5])\n  write Array.chunks-of(chunk-big, [1, 2, 3])\n  write Array.chunks-of(chunk-two, empty-ints)\n\n  let window-zero: Word = 0\n  let window-two: Word = 2\n  let window-three: Word = 3\n  let window-big: Word = 99\n  write Array.windows(window-zero, [1, 2, 3])\n  write Array.windows(window-two, [1, 2, 3, 4])\n  write Array.windows(window-three, [1, 2])\n  write Array.windows(window-big, [1, 2, 3])\n  write Array.windows(window-two, empty-ints)\n\n  write Array.replicate(-2, \"x\")\n  write Array.replicate(0, \"x\")\n  write Array.replicate(3, \"x\")\n  write Array.replicate(2, [1, 2])\n\n  ; === Array Phase `3` additions ===\n\n  write Array.any(x => x > 3, [1, 2, 4])\n  write Array.any(x => x > 3, [1, 2, 3])\n  write Array.any(x => x > 0, empty-ints)\n\n  write \"array-any-short\"\n  write Array.any(x => {\n    write x\n    x == 2\n  }, [1, 2, 3])\n\n  write Array.all(x => x > 0, [1, 2, 3])\n  write Array.all(x => x > 0, [1, 0, 2])\n  write Array.all(x => x > 0, empty-ints)\n\n  write \"array-all-short\"\n  write Array.all(x => {\n    write x\n    x < 2\n  }, [1, 2, 3])\n\n  write Array.find(x => x % 2 == 0, [1, 3, 4, 6])\n  write Array.find(x => x % 2 == 0, [1, 3, 5])\n  write Array.find(x => x % 2 == 0, empty-ints)\n\n  write \"array-find-short\"\n  write Array.find(x => {\n    write x\n    x == 2\n  }, [1, 2, 3])\n\n  write Array.find-index(x => x % 2 == 0, [1, 3, 4, 6])\n  write Array.find-index(x => x % 2 == 0, [1, 3, 5])\n  write Array.find-index(x => x % 2 == 0, empty-ints)\n\n  write \"array-find-index-short\"\n  write Array.find-index(x => {\n    write x\n    x == 2\n  }, [1, 2, 3])\n\n  write Array.find-indices(x => x % 2 == 0, [1, 2, 3, 4, 6])\n  write Array.find-indices(x => x % 2 == 0, [1, 3, 5])\n  write Array.find-indices(x => x % 2 == 0, empty-ints)\n\n  write Array.take-while(x => x < 4, [1, 2, 4, 3])\n  write Array.take-while(x => x < 4, [1, 2, 3])\n  write Array.take-while(x => x < 4, empty-ints)\n\n  write \"array-take-while-short\"\n  write Array.take-while(x => {\n    write x\n    x < 2\n  }, [1, 2, 3])\n\n  write Array.drop-while(x => x < 4, [1, 2, 4, 3])\n  write Array.drop-while(x => x < 4, [1, 2, 3])\n  write Array.drop-while(x => x < 4, empty-ints)\n\n  write \"array-drop-while-short\"\n  write Array.drop-while(x => {\n    write x\n    x < 2\n  }, [1, 2, 3])\n\n  write Array.span(x => x < 4, [1, 2, 4, 3])\n  write Array.span(x => x < 4, [1, 2, 3])\n  write Array.span(x => x < 4, empty-ints)\n\n  write \"array-span-short\"\n  write Array.span(x => {\n    write x\n    x < 2\n  }, [1, 2, 3])\n\n  write Array.break(x => x >= 4, [1, 2, 4, 3])\n  write Array.break(x => x >= 4, [1, 2, 3])\n  write Array.break(x => x >= 4, empty-ints)\n\n  write \"array-break-short\"\n  write Array.break(x => {\n    write x\n    x >= 2\n  }, [1, 2, 3])\n\n  write Array.partition(x => x % 2 == 0, [1, 2, 3, 4])\n  write Array.partition(x => x % 2 == 0, empty-ints)\n\n  write Array.concat-map(x => [x, x * 10], [1, 2, 3])\n  let empty-concat: Array[Int] = Array.concat-map(x => [x], empty-ints)\n  write empty-concat\n\n  write Array.map-option(\n    x => if x % 2 == 0 { Option.Some(x * 10) } else { Option.None },\n    [1, 2, 3, 4]\n  )\n  write Array.map-option(x => Option.None: Option[Int], [1, 2, 3])\n  let empty-options: Array[Int] = Array.map-option(\n    x => Option.Some(x),\n    empty-ints\n  )\n  write empty-options\n\n  ; === Chained operations ===\n\n  ; zip, map, filter chain\n  let indices = [0, 1, 2, 3, 4]\n  let values = [10, 25, 30, 15, 40]\n  let indexed = Array.zip(indices, values)\n  let chain-filtered = Filterable:filter(pair => pair.1 > 20, indexed)\n  write chain-filtered\n\n  ; zip-with to compute differences\n  let before = [10, 20, 30]\n  let after = [15, 18, 35]\n  let diffs = Array.zip-with((db, da) => da - db, before, after)\n  write diffs\n\n  ; === Collected ranges with array constraints ===\n\n  ; Collected ranges should satisfy `Iterable` constraints\n  write iter-len(Range.collect(1 ..= 20))\n  write iter-len([1, 2, 3, 4, 5])\n\n  ; Collected ranges should satisfy `Foldable` constraints\n  write iter-sum(Range.collect(1 ..= 5))\n  write iter-sum([10, 20, 30])\n}\n"
