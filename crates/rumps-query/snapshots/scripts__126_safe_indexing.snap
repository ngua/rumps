---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: safe indexing with `?[]` syntax\n; Tests optional index access that returns `Option` instead of panicking\n\n; Array safe indexing\nLET arr = [10, 20, 30]\n\n; Valid indices return Some\n@OUTPUT arr?[0]\n; Expected: Option.Some(10)\n\n@OUTPUT arr?[1]\n; Expected: Option.Some(20)\n\n@OUTPUT arr?[2]\n; Expected: Option.Some(30)\n\n; Negative indices\n@OUTPUT arr?[-1]\n; Expected: Option.Some(30)\n\n@OUTPUT arr?[-2]\n; Expected: Option.Some(20)\n\n; Out of bounds returns None\n@OUTPUT arr?[3]\n; Expected: Option.None\n\n@OUTPUT arr?[100]\n; Expected: Option.None\n\n@OUTPUT arr?[-4]\n; Expected: Option.None\n\n@OUTPUT arr?[-100]\n; Expected: Option.None\n\n; String safe indexing\nLET s = \"hello\"\n\n@OUTPUT s?[0]\n; Expected: Option.Some('h')\n\n@OUTPUT s?[4]\n; Expected: Option.Some('o')\n\n@OUTPUT s?[-1]\n; Expected: Option.Some('o')\n\n@OUTPUT s?[5]\n; Expected: Option.None\n\n@OUTPUT s?[-6]\n; Expected: Option.None\n\n; Empty collections\nLET empty: Array[Int] = []\n@OUTPUT empty?[0]\n; Expected: Option.None\n\nLET empty-str = \"\"\n@OUTPUT empty-str?[0]\n; Expected: Option.None\n\n; Map safe indexing (same as regular indexing since maps already return Option)\nLET m = { \"a\" => 1, \"b\" => 2 }\n@OUTPUT m?[\"a\"]\n; Expected: Option.Some(1)\n\n@OUTPUT m?[\"z\"]\n; Expected: Option.None\n\n; Chain with unwrap or coalesce\n@OUTPUT arr?[0] ?? -1\n; Expected: 10\n\n@OUTPUT arr?[100] ?? -1\n; Expected: -1\n\n; Use with pattern matching\nMATCH arr?[0] {\n  Option.Some(x) => @OUTPUT \"Got: \" ++ (x AS String)\n  Option.None => @OUTPUT \"Nothing\"\n}\n; Expected: Got: 10\n\nMATCH arr?[999] {\n  Option.Some(x) => @OUTPUT \"Got: \" ++ (x AS String)\n  Option.None => @OUTPUT \"Nothing\"\n}\n; Expected: Nothing\n\n@OUTPUT \"Safe indexing test complete\"\n"
---
Option.Some(10)
Option.Some(20)
Option.Some(30)
Option.Some(30)
Option.Some(20)
Option.None
Option.None
Option.None
Option.None
Option.Some('h')
Option.Some('o')
Option.Some('o')
Option.None
Option.None
Option.None
Option.None
Option.Some(1)
Option.None
10
-1
"Got: 10"
"Nothing"
"Safe indexing test complete"
