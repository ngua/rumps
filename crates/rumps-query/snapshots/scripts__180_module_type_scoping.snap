---
source: crates/rumps-query/tests/scripts.rs
description: "; Module type scoping tests\n;\n; Tests that type, newtype, and union declared in a module can be used\n; without full qualification from within the same module.\n\n; Import to bring class instances into scope\nimport Shapes.{ }\n\nfun main() {\n  ; ============ type variants with unqualified type names ============\n\n  let c = Shapes.Circle.Circle(2.0)\n  write :display(c)\n  write Shapes.area(c)\n\n  ; ============ newtype with unqualified type names ============\n\n  let dist: Units.Meters = 10.0\n  write Units.meters-to-feet(dist)\n  write Units.double(dist)\n\n  ; ============ union with unqualified type names ============\n\n  let v1: Data.Value = 42\n  let v2: Data.Value = \"hello\"\n  let v3: Data.Value = true\n  write Data.describe(v1)\n  write Data.describe(v2)\n  write Data.describe(v3)\n\n  ; ============ type with type parameters unqualified ============\n\n  let box1 = Container.Box.Box(42)\n  let box2: Container.Box[Int] = Container.Box.Empty\n  write Container.unwrap-or(box1, 0)\n  write Container.unwrap-or(box2, -1)\n  write Container.unwrap-or(Container.wrap(100), 0)\n\n  ; ============ Mixed types in same module ============\n\n  let id: Mixed.Id = 123\n  let status = Mixed.Status.Done\n  let payload: Mixed.Payload = \"data\"\n  write Mixed.process(id, status, payload)\n}\n\nmodule Shapes {\n  +variant Circle = Circle(Float)\n\n  ; Use unqualified `Circle` in class declaration\n  class Display for Circle {\n    fun display(c: Circle) -> String {\n      match c {\n        Circle.Circle(r) => { \"Circle(r={r})\" }\n      }\n    }\n  }\n\n  ; Function using unqualified type in signature\n  +fun area(c: Circle) -> Float {\n    match c {\n      Circle.Circle(r) => { 3.14159 * r * r }\n    }\n  }\n}\n\nmodule Units {\n  #(transparent)\n  +newtype Meters = +Float\n  #(transparent)\n  +newtype Feet = +Float\n\n  ; Function using unqualified newtypes in signature\n  +fun meters-to-feet(m: Meters) -> Feet {\n    m * 3.28084\n  }\n\n  ; Function returning unqualified newtype\n  +fun double(m: Meters) -> Meters {\n    m * 2.0\n  }\n}\n\nmodule Data {\n  +union Value = Int | String | Bool\n\n  ; Function using unqualified union in signature\n  +fun describe(v: Value) -> String {\n    if v is Int { \"integer\" } else {\n      if v is String { \"string\" } else { \"boolean\" }\n    }\n  }\n}\n\nmodule Container {\n  +variant Box[T] = Box(T) | Empty\n\n  ; Function using unqualified parameterized type\n  +fun unwrap-or[T](b: Box[T], default: T) -> T {\n    match b {\n      Box.Box(v) => { v }\n      Box.Empty => { default }\n    }\n  }\n\n  ; Function creating unqualified variant\n  +fun wrap[T](v: T) -> Box[T] {\n    Box.Box(v)\n  }\n}\n\nmodule Mixed {\n  +variant Status = Pending | Done\n  #(transparent)\n  +newtype Id = +Int\n  +union Payload = Int | String\n\n  ; Function using all three unqualified\n  +fun process(id: Id, status: Status, payload: Payload) -> String {\n    let s = match status {\n      Status.Pending => { \"pending\" }\n      Status.Done => { \"done\" }\n    }\n    let p = if payload is Int { \"int\" } else { \"string\" }\n    \"id={id}, status={s}, payload={p}\"\n  }\n}\n"
