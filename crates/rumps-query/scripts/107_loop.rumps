; Test: loop loop construct
; Continuation-passing style loop with explicit state

fun main() {
  ; Basic: count to 5
  let count = loop 1 (n, cont) => {
    if n > 5 {
      n - 1  ; return last valid value
    } else {
      cont(n + 1)
    }
  }
  write count

  ; Sum from 1 to 10
  let sum = loop { acc: 0, i: 1 } (state, cont) => {
    if state.i > 10 {
      state.acc
    } else {
      cont({ acc: state.acc + state.i, i: state.i + 1 })
    }
  }
  write sum

  ; Factorial of 5
  let factorial = loop { result: 1, n: 5 } (state, cont) => {
    if state.n <= 1 {
      state.result
    } else {
      cont({ result: state.result * state.n, n: state.n - 1 })
    }
  }
  write factorial

  ; Early exit based on condition
  let early = loop 0 (n, cont) => {
    if n == 3 {
      "stopped at 3"
    } else {
      cont(n + 1)
    }
  }
  write early

  ; Collect even numbers from 0 to 10
  let evens = loop { i: 0, acc: [] } (state, cont) => {
    if state.i > 10 {
      state.acc
    } else {
      if state.i % 2 == 0 {
        cont({ i: state.i + 1, acc: Array.concat(state.acc, [state.i]) })
      } else {
        cont({ i: state.i + 1, acc: state.acc })
      }
    }
  }
  write :display(evens)

  ; Using @order to iterate through subscripts
  @set data{1} "one"
  @set data{2} "two"
  @set data{3} "three"
  @set data{4} "four"

  ; Collect keys using @order and loop
  let keys = loop { key: @order data{}, acc: [] } (state, cont) => {
    match state.key {
      Option.None => state.acc
      Option.Some(s) => {
        let s = (s read Int)!
        cont({
          key: @order data{s},
          acc: Array.concat(state.acc, [s])
        })
      }
    }
  }
  write :display(keys)

  ; Collect all values using @order
  let vals = loop { key: @order data{}, acc: "" } (state, cont) => {
    match state.key {
      Option.None => state.acc
      Option.Some(k) => {
        let ki = (k read Int)!
        let v = @get data{ki}!
        cont({
          key: @order data{ki},
          acc: "{state.acc}{v} "
        })
      }
    }
  }
  write vals

  ; Large iteration count (previously caused stack overflow at ~100k)
  let big = loop 0 (n, cont) => {
    if n >= 200000 {
      n
    } else {
      cont(n + 1)
    }
  }
  write big

  write "loop test complete"
}
