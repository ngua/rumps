; Test: arrays and objects
; Tests array and object literals, indexing, and field access

; Array literal
LET arr = [1, 2, 3, 4, 5]
WRITE arr
; Expected: [1, 2, 3, 4, 5]

; Empty array
LET empty = []
WRITE empty
; Expected: []

; Array indexing
LET nums = [10, 20, 30]
WRITE nums[0]
; Expected: 10

WRITE nums[1]
; Expected: 20

WRITE nums[2]
; Expected: 30

; Object literal
LET obj = { name: "Alice", age: 30 }
WRITE obj
; Expected: { name: "Alice", age: 30 }

; Empty object
LET empty-obj = {}
WRITE empty-obj
; Expected: {}

; Field access with dot notation
LET person = { name: "Bob", age: 25, active: TRUE }
WRITE person.name
; Expected: Bob

WRITE person.age
; Expected: 25

WRITE person.active
; Expected: true

; Nested objects
LET nested = {
  user: {
    name: "Charlie",
    address: {
      city: "NYC",
      zip: "10001"
    }
  }
}
WRITE nested.user.name
; Expected: Charlie

WRITE nested.user.address.city
; Expected: NYC

; Object with array value
LET rec = {
  items: [1, 2, 3],
  count: 3
}
WRITE rec.items
; Expected: [1, 2, 3]

WRITE rec.items[0]
; Expected: 1

; Array of objects
LET users = [
  { name: "Alice", score: 100 },
  { name: "Bob", score: 85 }
]
WRITE users[0].name
; Expected: Alice

WRITE users[1].score
; Expected: 85

WRITE "Arrays/Objects test complete"
