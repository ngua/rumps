---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: object field access\n; Tests dot notation for objects (bracket notation is for arrays/maps only)\n\nLET obj = { name: \"Alice\", age: 30, active: TRUE }\n\n; Dot notation\n@OUTPUT obj.name\n; Expected: Alice\n\n@OUTPUT obj.age\n; Expected: 30\n\n@OUTPUT obj.active\n; Expected: TRUE\n\n; Nested object access (dot notation)\nLET rec = {\n  user: {\n    profile: {\n      first-name: \"Bob\",\n      last-name: \"Smith\"\n    },\n    scores: [90, 85, 95]\n  }\n}\n\n@OUTPUT rec.user.profile.first-name\n; Expected: Bob\n\n@OUTPUT rec.user.profile.last-name\n; Expected: Smith\n\n@OUTPUT rec.user.scores[0]\n; Expected: 90\n\n@OUTPUT rec.user.scores[-1]\n; Expected: 95\n\n; Object with dashed keys (valid RUMPS identifiers)\nLET special = { my-key: \"value1\", another-key: \"value2\" }\n@OUTPUT special.my-key\n; Expected: value1\n\n@OUTPUT special.another-key\n; Expected: value2\n\n; Optional field access (`?.`) on objects\n; Returns `Some(value)` if field exists, `None` if missing\n\nLET person = { name: \"Carol\", age: 25 }\n\n@OUTPUT person?.name\n; Expected: Option.Some(\"Carol\")\n\n@OUTPUT person?.age\n; Expected: Option.Some(25)\n\n@OUTPUT person?.email\n; Expected: Option.None\n\n@OUTPUT person?.address\n; Expected: Option.None\n\n; Chained optional access\nLET nested = { user: { name: \"Dan\" } }\n@OUTPUT nested?.user?.name\n; Expected: Option.Some(\"Dan\")\n\n@OUTPUT nested?.user?.missing\n; Expected: Option.None\n\n@OUTPUT nested?.missing?.anything\n; Expected: Option.None\n\n; Optional field access in function with typed parameter\n; The type `{ a: Int }` should allow `?.` on fields not in the type\nfun get_b(x: { a: Int }) {\n  x?.b\n}\n\n@OUTPUT get_b({ a: 1 })\n; Expected: Option.None\n\n@OUTPUT get_b({ a: 1, b: 2 })\n; Expected: Option.Some(2)\n\n@OUTPUT \"Object access test complete\"\n"
---
"Alice"
30
TRUE
"Bob"
"Smith"
90
95
"value1"
"value2"
Option.Some("Carol")
Option.Some(25)
Option.None
Option.None
Option.Some("Dan")
Option.None
Option.None
Option.None
Option.Some(2)
"Object access test complete"
