; Test Array.sort with various types

type Priority = Low | Medium | High

type Event = Click(Int, Int) | Scroll(Int) | Resize(Int, Int)

fun main() {
  ; --- Scalars ---
  write Array.sort([3, 1, 4, 1, 5, 9, 2, 6])
  write Array.sort(["banana", "apple", "cherry"])
  write Array.sort([true, false, true, false])
  write Array.sort([3.14, 1.0, 2.71])

  ; --- Option ---
  ; None < Some, then by payload
  write Array.sort([Option.Some(3), Option.None, Option.Some(1), Option.None, Option.Some(2)])

  ; --- Result ---
  ; Err < Ok, then by payload
  write Array.sort([Result.Ok(2), Result.Err("b"), Result.Ok(1), Result.Err("a")])

  ; --- Tuples ---
  ; Lexicographic ordering
  write Array.sort([(2, "b"), (1, "z"), (2, "a"), (1, "a")])
  write Array.sort([(1, 2, 3), (1, 1, 9), (1, 2, 1)])

  ; --- Nested Options ---
  write Array.sort([Option.Some(Option.Some(2)), Option.Some(Option.None), Option.None, Option.Some(Option.Some(1))])

  ; --- User-defined sum type ---
  let tasks = [Priority.High, Priority.Low, Priority.Medium, Priority.Low, Priority.High]
  write Array.sort(tasks)

  ; --- Sum type with payloads ---
  let events = [Event.Resize(100, 200), Event.Click(5, 5), Event.Scroll(10), Event.Click(1, 1), Event.Scroll(5)]
  write Array.sort(events)

  ; --- Objects ---
  write Array.sort([{ a: 2 }, { a: 1 }, { a: 3 }])
  write Array.sort([{ x: 1, y: 2 }, { x: 1, y: 1 }, { x: 0, y: 9 }])

  ; --- Arrays of arrays ---
  write Array.sort([[3, 1], [1, 2], [1, 1], [2, 0]])

  ; --- Mixed with pipeline ---
  let sorted-options = [Option.Some(5), Option.None, Option.Some(3)] |> Array.sort
  write sorted-options
}
