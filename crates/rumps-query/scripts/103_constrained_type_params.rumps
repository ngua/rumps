; Test constrained type parameters
; Syntax: [T: Constraint1 + Constraint2]

fun main() {
  write add-numeric(1, 2)       ; 3
  write add-numeric(1.5, 2.5)   ; 4.0

  write to-str(42)        ; "42"
  write to-str(true)      ; "true"

  write to-json({a: 1, b: 2}) as String   ; {"a":1,"b":2}

  ; ============================================================================
  ; Multiple constraints
  ; ============================================================================

  write numeric-to-str(21)    ; "42"
  write numeric-to-str(1.5)   ; "3"

  ; ============================================================================
  ; Mixed constrained and unconstrained
  ; ============================================================================

  let (n, s) = pair-numeric(21, "hello")
  write n    ; 42
  write s    ; "hello"

  ; ============================================================================
  ; Closures with constraints
  ; ============================================================================

  ; Closure with constrained type parameter; works with any `Additive` type
  let double = [T: Additive](x: T) -> T => x + x

  write double(10)    ; 20
  write double(1.5)   ; 3.0

  write apply-numeric(double, 5)   ; 10

  ; ============================================================================
  ; Into[Subscript] constraint
  ; ============================================================================

  write format-key(42)        ; "42"
  write format-key("foo")     ; "foo"
  write format-key(true)      ; "true"

  ; ============================================================================
  ; Into[Storable] constraint
  ; ============================================================================

  write identity-storable(42)       ; 42
  write identity-storable("hello")  ; "hello"
  write identity-storable(true)     ; true

  ; ============================================================================
  ; Foldable constraint with element type
  ; ============================================================================

  write sum-all([1, 2, 3, 4, 5])     ; 15
  write sum-all(Range.collect(1 .. 4)) ; 6 (1+2+3)
}

; ============================================================================
; Basic constrained functions
; ============================================================================

; `Additive` constraint: `T` supports `+`
fun add-numeric[T: Additive](a: T, b: T) -> T {
  a + b
}

; Into constraint: `T` can be converted to `String`
fun to-str[T: Into[String]](x: T) -> String {
  x as String
}

; Into constraint: `T` can be serialized to `Json`
fun to-json[T: Into[Json]](x: T) -> Json {
  x as Json
}

; Multiple constraints with `+`
fun numeric-to-str[T: Additive + Into[String]](x: T) -> String {
  (x + x) as String
}

; Mix of constrained and unconstrained type parameters
fun pair-numeric[T: Additive, U](x: T, y: U) -> (T, U) {
  (x + x, y)
}

; Higher-order function taking a constrained closure
fun apply-numeric[T: Additive](f: (T) -> T, x: T) -> T {
  f(x)
}

; Into[Subscript] + Into[String]: key type for DB subscripts, displayable
fun format-key[K: Into[Subscript] + Into[String]](k: K) -> String {
  k as String
}

; Into[Storable]: type can be stored in the database
fun identity-storable[V: Into[Storable]](v: V) -> V {
  v
}

; Foldable: type must support element-wise reduction
fun sum-all[T: Numeric + Additive, F: Foldable](coll: F[T]) -> T {
  Foldable:reduce((acc, x) => acc + x, 0, coll)
}
