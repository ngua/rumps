---
source: crates/rumps-query/tests/scripts.rs
description: "; Math module primitives\n; Tests Math.abs, Math.min, Math.max, Math.floor, Math.ceil,\n; Math.round, Math.sqrt, Math.log\n; Also tests Math.Trig submodule: sin, cos, tan, asin, acos, atan, atan2\n\n; ============ Math.abs ============\n\nWRITE Math.abs(-5.0)   ; 5.0\nWRITE Math.abs(5.0)    ; 5.0\nWRITE Math.abs(0.0)    ; 0.0\n\nLET neg-float = -42.0\nWRITE Math.abs(neg-float)  ; 42.0\n\nWRITE Math.abs(-3.5)  ; 3.5\nWRITE Math.abs(3.5)   ; 3.5\n\nLET neg-float2 = -2.718\nWRITE Math.abs(neg-float2)  ; 2.718\n\n; ============ Math.min ============\n\nWRITE Math.min(3.0, 7.0)   ; 3.0\nWRITE Math.min(7.0, 3.0)   ; 3.0\nWRITE Math.min(5.0, 5.0)   ; 5.0\n\nLET min-a = 10.0\nLET min-b = 20.0\nWRITE Math.min(min-a, min-b)  ; 10.0\n\nWRITE Math.min(-5.0, -3.0)  ; -5.0\nWRITE Math.min(-5.0, 3.0)   ; -5.0\n\n; Float min\nWRITE Math.min(2.5, 7.3)  ; 2.5\nWRITE Math.min(7.3, 2.5)  ; 2.5\n\nWRITE Math.min(3.0, 2.5)  ; 2.5\nWRITE Math.min(2.5, 3.0)  ; 2.5\n\n; ============ Math.max ============\n\nWRITE Math.max(3.0, 7.0)   ; 7.0\nWRITE Math.max(7.0, 3.0)   ; 7.0\nWRITE Math.max(5.0, 5.0)   ; 5.0\n\nLET max-a = 10.0\nLET max-b = 20.0\nWRITE Math.max(max-a, max-b)  ; 20.0\n\nWRITE Math.max(-5.0, -3.0)  ; -3.0\nWRITE Math.max(-5.0, 3.0)   ; 3.0\n\n; Float max\nWRITE Math.max(2.5, 7.3)  ; 7.3\nWRITE Math.max(7.3, 2.5)  ; 7.3\n\nWRITE Math.max(3.0, 7.5)  ; 7.5\nWRITE Math.max(7.5, 3.0)  ; 7.5\n\n; ============ Math.floor ============\n\nWRITE Math.floor(3.7)   ; 3\nWRITE Math.floor(3.2)   ; 3\nWRITE Math.floor(3.0)   ; 3\nWRITE Math.floor(-3.2)  ; -4\nWRITE Math.floor(-3.7)  ; -4\n\nLET floor-val = 5.9\nWRITE Math.floor(floor-val)  ; 5\n\n; ============ Math.ceil ============\n\nWRITE Math.ceil(3.2)   ; 4\nWRITE Math.ceil(3.7)   ; 4\nWRITE Math.ceil(3.0)   ; 3\nWRITE Math.ceil(-3.2)  ; -3\nWRITE Math.ceil(-3.7)  ; -3\n\nLET ceil-val = 5.1\nWRITE Math.ceil(ceil-val)  ; 6\n\n; ============ Math.round ============\n\nWRITE Math.round(3.4)   ; 3\nWRITE Math.round(3.5)   ; 4\nWRITE Math.round(3.6)   ; 4\nWRITE Math.round(-3.4)  ; -3\nWRITE Math.round(-3.5)  ; -4\n\nLET round-val = 2.7\nWRITE Math.round(round-val)  ; 3\n\n; ============ Math.sqrt ============\n\nWRITE Math.sqrt(16.0)   ; 4.0\nWRITE Math.sqrt(25.0)   ; 5.0\nWRITE Math.sqrt(2.0)    ; ~1.414...\nWRITE Math.sqrt(0.0)    ; 0.0\nWRITE Math.sqrt(1.0)    ; 1.0\n\nLET sqrt-val = 9.0\nWRITE Math.sqrt(sqrt-val)  ; 3.0\n\nWRITE Math.sqrt(2.25)  ; 1.5\n\n; ============ Math.log ============\n\nWRITE Math.log(1.0)      ; 0.0\nWRITE Math.log(2.718281828)  ; ~1.0\n\nLET log-e = 2.718281828\nLET log-result = Math.log(log-e)\nWRITE Math.round(log-result)  ; 1 (close to 1.0)\n\n; ============ Math.Trig.sin ============\n\nWRITE Math.Trig.sin(0.0)  ; 0.0\n\nLET sin-zero = 0.0\nWRITE Math.Trig.sin(sin-zero)  ; 0.0\n\n; ============ Math.Trig.cos ============\n\nWRITE Math.Trig.cos(0.0)  ; 1.0\n\nLET cos-zero = 0.0\nWRITE Math.Trig.cos(cos-zero)  ; 1.0\n\n; ============ Math.Trig.tan ============\n\nWRITE Math.Trig.tan(0.0)  ; 0.0\n\n; ============ Math.Trig.asin ============\n\nWRITE Math.Trig.asin(0.0)  ; 0.0\nWRITE Math.Trig.asin(1.0)  ; ~1.5707... (pi/2)\n\n; ============ Math.Trig.acos ============\n\nWRITE Math.Trig.acos(1.0)  ; 0.0\nWRITE Math.Trig.acos(0.0)  ; ~1.5707... (pi/2)\n\n; ============ Math.Trig.atan ============\n\nWRITE Math.Trig.atan(0.0)  ; 0.0\nWRITE Math.Trig.atan(1.0)  ; ~0.7853... (pi/4)\n\n; ============ Math.Trig.atan2 ============\n\nWRITE Math.Trig.atan2(0.0, 1.0)  ; 0.0\nWRITE Math.Trig.atan2(1.0, 1.0)  ; ~0.7853... (pi/4)\nWRITE Math.Trig.atan2(1.0, 0.0)  ; ~1.5707... (pi/2)\n\n; ============ Chaining operations ============\n\n; abs of min\nLET chain-a = -5.0\nLET chain-b = -3.0\nWRITE Math.abs(Math.min(chain-a, chain-b))  ; 5.0\n\n; floor of sqrt\nWRITE Math.floor(Math.sqrt(10.0))  ; 3\n\n; ceil of log\nWRITE Math.ceil(Math.log(10.0))  ; 3\n\n; ============ Pipeline usage ============\n\nLET pipe-val = -16.0\nLET pipe-result = pipe-val\n  |> Math.abs\n  |> Math.sqrt\nWRITE pipe-result  ; 4.0\n\nLET pipe-float = 7.8\nLET pipe-rounded = pipe-float\n  |> Math.round\nWRITE pipe-rounded  ; 8\n"
