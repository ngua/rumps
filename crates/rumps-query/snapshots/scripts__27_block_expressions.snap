---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: Block and IF expressions in expression contexts\n; Tests that blocks and IF can appear anywhere an expression is expected\n\n; === Single-arm IF returns Unit ===\n; Single-arm IF always evaluates to Unit (for side effects only)\nLET res = IF TRUE { OUTPUT \"side effect\" }\nOUTPUT res\n; Expected: Unit\n\n; === IF/ELSE expression in LET binding ===\nLET a = IF TRUE { \"yes\" } ELSE { \"no\" }\nOUTPUT a\n\nLET b = IF FALSE { \"yes\" } ELSE { \"no\" }\nOUTPUT b\n\n; Nested IF/ELSE expressions\nLET nested = IF TRUE {\n  IF FALSE { 1 } ELSE { 2 }\n} ELSE {\n  3\n}\nOUTPUT nested\n\n; IF/ELSE in arithmetic\nLET sum = 10 + IF TRUE { 5 } ELSE { 0 }\nOUTPUT sum\n\n; IF/ELSE as argument\nOUTPUT IF TRUE { \"direct if\" } ELSE { \"nope\" }\n\n; === Block expressions ===\n\n; Block expression in LET binding\nLET blk = { 1 + 2 }\nOUTPUT blk\n\n; Block with statements and tail\nLET computed = {\n  LET tmp = 10\n  tmp * 2\n}\nOUTPUT computed\n\n; Block in arithmetic\nLET expr = { 5 } + { 3 }\nOUTPUT expr\n\n; IF/ELSE with block that has statements\nLET complex = IF TRUE {\n  LET inner = 100\n  inner + 1\n} ELSE {\n  0\n}\nOUTPUT complex\n\n; Chained conditionals (all IF/ELSE)\nLET grade = 85\nLET letter = IF grade >= 90 { \"A\" } ELSE {\n  IF grade >= 80 { \"B\" } ELSE {\n    IF grade >= 70 { \"C\" } ELSE { \"F\" }\n  }\n}\nOUTPUT letter\n\n; === Blocks without tail return Unit ===\nLET no-tail = {\n  LET tmp = 42\n  OUTPUT tmp\n}\nOUTPUT no-tail\n; Expected: Unit\n\nOUTPUT \"Block expressions test complete\"\n"
---
"side effect"
Unit
