; Test: Power operator (**)
; Tests exponentiation with right-associativity

fun main() {
  ; === Int ** Int ===

  let sq = 2 ** 10
  write sq
  ; Expected: 1024

  let cube = 3 ** 3
  write cube
  ; Expected: 27

  let zero-pow = 5 ** 0
  write zero-pow
  ; Expected: 1

  let one-pow = 7 ** 1
  write one-pow
  ; Expected: 7

  ; === Float ** Float ===

  let sqrt2 = 2.0 ** 0.5
  write sqrt2
  ; Expected: 1.4142135623730951 (approximately)

  let cubert = 8.0 ** (1.0 / 3.0)
  write cubert
  ; Expected: 2.0

  ; === Negative exponent (Int -> Float) ===

  let half = 2 ** -1
  write half
  ; Expected: 0.5

  let quarter = 2 ** -2
  write quarter
  ; Expected: 0.25

  ; === Mixed Int/Float ===

  let mixed1 = 4 ** 0.5
  write mixed1
  ; Expected: 2

  let mixed2 = 2.0 ** 3
  write mixed2
  ; Expected: 8

  ; === Right-associativity ===
  ; 2 ** 3 ** 2 should be 2 ** (3 ** 2) = 2 ** 9 = 512
  ; not (2 ** 3) ** 2 = 8 ** 2 = 64

  let right-assoc = 2 ** 3 ** 2
  write right-assoc
  ; Expected: 512

  ; === Precedence: higher than multiplication ===
  ; 2 * 3 ** 2 should be 2 * (3 ** 2) = 2 * 9 = 18
  ; not (2 * 3) ** 2 = 6 ** 2 = 36

  let prec = 2 * 3 ** 2
  write prec
  ; Expected: 18

  ; === Combinations ===

  let combo = 10 ** 2 + 5
  write combo
  ; Expected: 105

  let combo2 = (2 + 3) ** 2
  write combo2
  ; Expected: 25

  write "Power test complete"
}
