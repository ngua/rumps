---
source: crates/rumps-query/tests/scripts.rs
description: "; Iterable:collect; materializes an iterable into an Array\n\nFUN main() {\n  ; Collect exclusive range\n  WRITE Iterable:collect(1 .. 5)\n\n  ; Collect inclusive range\n  WRITE Iterable:collect(1 ..= 3)\n\n  ; Collect empty range\n  WRITE Iterable:collect(5 .. 5)\n\n  ; Collect negative range\n  WRITE Iterable:collect(-2 .. 2)\n\n  ; Collect array (identity)\n  WRITE Iterable:collect([10, 20, 30])\n\n  ; Collect then map\n  LET squares = Mappable:map(x => x * x, Iterable:collect(1 .. 5))\n  WRITE squares\n\n  ; Collect then filter\n  LET evens = Filterable:filter(x => x % 2 == 0, Iterable:collect(1 ..= 10))\n  WRITE evens\n\n  ; Collect then reduce\n  LET sum = Foldable:reduce((a, x) => a + x, 0, Iterable:collect(1 ..= 5))\n  WRITE sum\n}\n"
