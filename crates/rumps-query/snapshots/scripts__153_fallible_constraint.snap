---
source: crates/rumps-query/tests/scripts.rs
description: "; Test Fallible constraint for Option/Result polymorphism\n\nfun main() {\n  ; ============================================================================\n  ; Basic Fallible constraint with inner type\n  ; ============================================================================\n\n  ; Works with Option\n  let opt = Option.Some(42)\n  write unwrap(opt)\n\n  ; Works with Result\n  let res = Result.Ok(\"hello\")\n  write unwrap(res)\n\n  ; ============================================================================\n  ; Fallible with coalesce\n  ; ============================================================================\n\n  write or-else(Option.Some(10), 0)\n  write or-else(Option.None, 99)\n  write or-else(Result.Ok(5), 0)\n  write or-else(Result.Err(\"oops\"), -1)\n\n  ; ============================================================================\n  ; Closure with Fallible constraint\n  ; ============================================================================\n\n  let safe-get = [T, F: Fallible](x: F[T], default: T) -> T => x ?? default\n\n  write safe-get(Option.Some(100), 0)\n  write safe-get(Option.None, 42)\n\n  ; ============================================================================\n  ; Combining Fallible with other constraints\n  ; ============================================================================\n\n  write unwrap-numeric(Option.Some(123))\n  write unwrap-numeric(Option.None: Option[Int])\n  write unwrap-numeric(Result.Ok(4.5))\n\n  ; ============================================================================\n  ; Union types with Fallible constraint\n  ; ============================================================================\n\n  write fallible-unwrap(Option.Some(42))\n  write fallible-unwrap(Result.Ok(99))\n\n  write fallible-or-default(Option.Some(10), 0)\n  write fallible-or-default(Option.None, 77)\n  write fallible-or-default(Result.Ok(5), 0)\n  write fallible-or-default(Result.Err(\"oops\"), -1)\n}\n\n; Generic unwrap function that works on any Option[T] or Result[T, E]\nfun unwrap[T, F: Fallible](x: F[T]) -> T {\n  x!\n}\n\n; Generic or-else function\nfun or-else[T, F: Fallible](x: F[T], default: T) -> T {\n  x ?? default\n}\n\n; Fallible + Numeric inner type\nfun unwrap-numeric[T: Numeric, F: Fallible](x: F[T]) -> T {\n  x ?? 0\n}\n\n; Union of fallible types should satisfy Fallible constraint\nfun fallible-unwrap(x: Option[Int] | Result[Int, String]) -> Int {\n  x!\n}\n\n; Union with coalesce\nfun fallible-or-default(x: Option[Int] | Result[Int, String], default: Int) -> Int {\n  x ?? default\n}\n"
