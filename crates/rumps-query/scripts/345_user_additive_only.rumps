; User type with only `Additive`.

fun main() {
  let a = AddOnly.AddOnly(10)
  let b = AddOnly.AddOnly(3)
  write "operator add: {:display(a + b)}"
  write "method add: {:display(Additive:add(a, b))}"
}

#(deriving: Display)
variant AddOnly = AddOnly(Int)

class Additive for AddOnly {
  fun zero() -> AddOnly {
    AddOnly.AddOnly(0)
  }

  fun add(a: AddOnly, b: AddOnly) -> AddOnly {
    match a {
      AddOnly.AddOnly(x) => {
        match b {
          AddOnly.AddOnly(y) => { AddOnly.AddOnly(x + y + 100) }
        }
      }
    }
  }
}
