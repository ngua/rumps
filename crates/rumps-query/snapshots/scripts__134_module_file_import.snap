source: crates/rumps-query/tests/scripts.rs
description: "; Module file imports\n; Tests importing modules from files using `module Name from \"path\"` syntax\n\n; Import module from file (path relative to script directory)\nmodule MyMath from \"../modules/lib/mymath.rumps\"\n\nfun main() {\n  ; ============ Test constants from imported module ============\n\n  write MyMath.pi > 3.0  ; true\n  write MyMath.e > 2.0  ; true\n\n  ; ============ Test functions from imported module ============\n\n  write MyMath.square(5)  ; 25\n  write MyMath.double(7)  ; 14\n  write MyMath.is-positive(10)  ; true\n  write MyMath.is-positive(-5)  ; false\n\n  ; ============ Use imported functions in expressions ============\n\n  let sq = MyMath.square(4)\n  let dbl = MyMath.double(sq)\n  write dbl  ; 32\n\n  ; ============ Pass imported function as value ============\n\n  let f = MyMath.double\n  write f(100)  ; 200\n\n  ; ============ Test function referencing sibling constant ============\n\n  write MyMath.area(2.0)  ; pi * 4 = 12.56636\n}\n"
