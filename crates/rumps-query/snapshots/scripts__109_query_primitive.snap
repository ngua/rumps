---
source: crates/rumps-query/tests/scripts.rs
description: "; Test: @query primitive\n; Returns full key path to the next node with a value\n; NOTE: Uses locals only; globals require transaction blocks\n\nfun main() {\n  ; Set up single-level test data\n  @set items{1} \"one\"\n  @set items{2} \"two\"\n  @set items{10} \"ten\"\n\n  ; First key path (no after position, use {} for root)\n  let first = @query items{}\n  write first\n\n  ; Next key path after {1}\n  let after-1 = @query items{1}\n  write after-1\n\n  ; Next key path after {2}\n  let after-2 = @query items{2}\n  write after-2\n\n  ; Past the last key\n  let after-10 = @query items{10}\n  write after-10\n\n  ; @query on non-existent variable (use {} for root)\n  let no-keys = @query empty{}\n  write no-keys\n\n  ; Type annotation\n  let typed: Option[Array[Subscript]] = @query items{}\n  write typed\n\n  ; Use with match\n  let msg = match @query items{} {\n    Option.Some(path) => { \"found path of length: {Iterable:length(path)}\" }\n    Option.None => { \"no nodes\" }\n  }\n  write msg\n\n  ; Use with coalesce\n  let path = @query items{} ?? []\n  write path\n\n  ; Using unwrap on result\n  let path2 = (@query items{1})!\n  write path2\n\n  ; Spread syntax to continue iteration\n  @set data{1} \"a\"\n  @set data{2} \"b\"\n  @set data{3} \"c\"\n\n  let k1 = @query data{} ?? []\n  write k1\n  let k2 = @query data{...k1} ?? []\n  write k2\n  let k3 = @query data{...k2} ?? []\n  write k3\n  let k4 = @query data{...k3}\n  write k4\n\n  ; === Nested data tests ===\n  ; @query should skip intermediate nodes (ancestors with no value)\n\n  @set patients{1, \"age\"} 30\n  @set patients{1, \"name\"} \"Alice\"\n  @set patients{2, \"name\"} \"Bob\"\n\n  ; First key should be [1, \"age\"], not [1]\n  let p1 = @query patients{} ?? []\n  write p1\n\n  ; After [1, \"age\"] should be [1, \"name\"], not [1] or [2]\n  let p2 = @query patients{1, \"age\"} ?? []\n  write p2\n\n  ; After [1, \"name\"] should be [2, \"name\"], skipping intermediate [2]\n  let p3 = @query patients{1, \"name\"} ?? []\n  write p3\n\n  ; After [2, \"name\"] should be None\n  let p4 = @query patients{2, \"name\"}\n  write p4\n\n  ; Deep nesting test\n  @set deep{1, 2, 3, \"leaf\"} \"value\"\n\n  ; Should return [1, 2, 3, \"leaf\"], skipping [1], [1, 2], [1, 2, 3]\n  let d1 = @query deep{} ?? []\n  write d1\n\n  write \"@query test complete\"\n}\n"
---
Option.Some([ 1 ])
Option.Some([ 2 ])
Option.Some([ 10 ])
Option.None
Option.None
Option.Some([ 1 ])
"found path of length: 1"
[ 1 ]
[ 2 ]
[ 1 ]
[ 2 ]
[ 3 ]
Option.None
[ 1, "age" ]
[ 1, "name" ]
[ 2, "name" ]
Option.None
[ 1, 2, 3, "leaf" ]
"@query test complete"
