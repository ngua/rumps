; Test: object field access
; Tests dot notation for objects (bracket notation is for arrays/maps only)

LET obj = { name: "Alice", age: 30, active: TRUE }

; Dot notation
OUTPUT obj.name
; Expected: Alice

OUTPUT obj.age
; Expected: 30

OUTPUT obj.active
; Expected: TRUE

; Nested object access (dot notation)
LET data = {
  user: {
    profile: {
      first-name: "Bob",
      last-name: "Smith"
    },
    scores: [90, 85, 95]
  }
}

OUTPUT data.user.profile.first-name
; Expected: Bob

OUTPUT data.user.profile.last-name
; Expected: Smith

OUTPUT data.user.scores[0]
; Expected: 90

OUTPUT data.user.scores[-1]
; Expected: 95

; Object with dashed keys (valid RUMPS identifiers)
LET special = { my-key: "value1", another-key: "value2" }
OUTPUT special.my-key
; Expected: value1

OUTPUT special.another-key
; Expected: value2

OUTPUT "Object access test complete"
