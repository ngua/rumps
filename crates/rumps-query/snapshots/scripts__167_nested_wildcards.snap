description: "; Nested wildcards in is checks\n\nfun main() {\n  ; Simple wildcard\n  let x: Option[Int] = Option.Some(42)\n  write x is Option[_]\n\n  ; 2 levels: Array[Option[_]]\n  let arr: Array[Option[Int]] = [Option.Some(1), Option.None]\n  write arr is Array[_]\n  write arr is Array[Option[_]]\n\n  ; 2 levels: Option[Array[_]]\n  let opt: Option[Array[Int]] = Option.Some([1, 2, 3])\n  write opt is Option[_]\n  write opt is Option[Array[_]]\n\n  ; 3 levels\n  let v3: Array[Option[Result[Int, String]]] = [Option.Some(Result.Ok(42))]\n  write v3 is Array[Option[Result[_, _]]]\n\n  ; 4 levels\n  let v4: Array[Option[Result[Array[Int], String]]] = [Option.Some(Result.Ok([1]))]\n  write v4 is Array[Option[Result[Array[_], _]]]\n\n  ; 5 levels\n  let v5: Array[Option[Result[Array[Option[Int]], String]]] = [Option.Some(Result.Ok([Option.Some(1)]))]\n  write v5 is Array[Option[Result[Array[Option[_]], _]]]\n\n  ; 6 levels (maximum supported)\n  let v6: Array[Option[Result[Array[Option[Result[Int, String]]], String]]] = [Option.Some(Result.Ok([Option.Some(Result.Ok(1))]))]\n  write v6 is Array[Option[Result[Array[Option[Result[_, _]]], _]]]\n\n  ; Negative cases: mismatched nested types\n  let arr2: Array[Option[Int]] = [Option.Some(1)]\n  write arr2 is Array[Result[_, _]]\n\n  let opt2: Option[Int] = Option.Some(42)\n  write opt2 is Option[Array[_]]\n}\n"
