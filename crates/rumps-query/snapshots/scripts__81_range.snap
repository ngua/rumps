---
source: crates/rumps-query/tests/scripts.rs
description: "; Range operator tests\n; Tests exclusive (`..`) and inclusive (`..=`) ranges\n; NOTE: Range operators require spaces around `..` and `..=`\n\nfun double(n: Int) -> Int { n * 2 }\n\nfun main() {\n  ; Basic exclusive range display\n  let r1 = 1 .. 5\n  write r1  ; 1..5\n\n  ; Basic inclusive range display\n  let r2 = 1 ..= 5\n  write r2  ; 1..=5\n\n  ; Range with expressions: binds looser than additive\n  ; So `1 .. n + 1` parses as `1..(n + 1)`, not `(1..n) + 1`\n  let n = 3\n  let r3 = 0 .. n + 1\n  write r3  ; 0..4\n\n  ; Collect range to array then map (Range is not Mappable)\n  let squares = Mappable:map(x => x * x, Range.collect(1 .. 4))\n  write squares  ; [1, 4, 9]\n\n  ; Collect inclusive range to array then map\n  let cubes = Mappable:map(x => x * x * x, Range.collect(1 ..= 3))\n  write cubes  ; [1, 8, 27]\n\n  ; Filterable:filter with range (collect first)\n  let evens = Filterable:filter(x => x % 2 == 0, Range.collect(1 .. 10))\n  write evens  ; [2, 4, 6, 8]\n\n  ; Filterable:filter with inclusive range (collect first)\n  let odd = Filterable:filter(x => x % 2 != 0, Range.collect(1 ..= 5))\n  write odd  ; [1, 3, 5]\n\n  ; Foldable:reduce with range (sum 1..5 = 1+2+3+4 = 10)\n  let sum1 = Foldable:reduce((acc, x) => acc + x, 0, Range.collect(1 .. 5))\n  write sum1  ; 10\n\n  ; Foldable:reduce with inclusive range (sum 1..=5 = 1+2+3+4+5 = 15)\n  let sum2 = Foldable:reduce((acc, x) => acc + x, 0, Range.collect(1 ..= 5))\n  write sum2  ; 15\n\n  ; Factorial using range and reduce\n  let fact5 = Foldable:reduce((acc, x) => acc * x, 1, Range.collect(1 ..= 5))\n  write fact5  ; 120\n\n  ; Chaining operations with ranges (collect first)\n  let filtered = Filterable:filter(x => x > 2, Range.collect(1 ..= 5))\n  let result = Mappable:map(x => x * 10, filtered)\n  write result  ; [30, 40, 50]\n\n  ; Empty range (start >= end for exclusive)\n  let empty = Range.collect(5 .. 5)\n  write empty  ; []\n\n  ; Negative ranges\n  let negatives = Range.collect(-3 .. 1)\n  write negatives  ; [-3, -2, -1, 0]\n\n  ; Range with named function (collect first)\n  let doubles = Mappable:map(double, Range.collect(1 .. 5))\n  write doubles  ; [2, 4, 6, 8]\n\n  ; Range to `Array[Int]` via `Into` (`as` cast)\n  write ((1 .. 5) as Array[Int])      ; [1, 2, 3, 4]\n  write ((1 ..= 5) as Array[Int])     ; [1, 2, 3, 4, 5]\n  write ((3 .. 3) as Array[Int])      ; []\n  write ((-2 .. 2) as Array[Int])     ; [-2, -1, 0, 1]\n}\n"
---
1 .. 5
1 ..= 5
0 .. 4
[ 1, 4, 9 ]
[ 1, 8, 27 ]
[ 2, 4, 6, 8 ]
[ 1, 3, 5 ]
10
15
120
[ 30, 40, 50 ]
[  ]
[ -3, -2, -1, 0 ]
[ 2, 4, 6, 8 ]
[ 1, 2, 3, 4 ]
[ 1, 2, 3, 4, 5 ]
[  ]
[ -2, -1, 0, 1 ]
