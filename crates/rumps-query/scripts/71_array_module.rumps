; Array module functions
; Tests Mappable:map, Filterable:filter, Foldable:fold, Foldable:fold-map, foreach

fun square(n: Int) -> Int { n * n }

fun is-positive(n: Int) -> Bool { n > 0 }

fun add(a: Int, b: Int) -> Int { a + b }

fun zip-add(za: Int, zb: Int) -> Int { za + zb }

fun cmp-int(ca: Int, cb: Int) -> Ordering {
  if ca < cb { Ordering.Lt } else {
    if ca == cb { Ordering.Eq } else { Ordering.Gt }
  }
}

fun cmp-desc(da: Int, db: Int) -> Ordering {
  if da > db { Ordering.Lt } else {
    if da == db { Ordering.Eq } else { Ordering.Gt }
  }
}

fun cmp-abs(aa: Int, ab: Int) -> Ordering {
  let abs-a = if aa < 0 { 0 - aa } else { aa }
  let abs-b = if ab < 0 { 0 - ab } else { ab }
  cmp-int(abs-a, abs-b)
}

newtype SortPerson = { name: String, age: Int }

newtype Parity = Int

newtype Rank = Int

class Eq for Parity {
  fun eq(a: Parity, b: Parity) -> Bool {
    let ai: Int = a
    let bi: Int = b
    ai % 2 == bi % 2
  }
}

class Ord for Rank {
  fun compare(a: Rank, b: Rank) -> Ordering {
    let ai: Int = a
    let bi: Int = b
    if ai > bi { Ordering.Lt } else {
      if ai == bi { Ordering.Eq } else { Ordering.Gt }
    }
  }
}

fun cmp-by-age(pa: SortPerson, pb: SortPerson) -> Ordering {
  cmp-int(pa.age, pb.age)
}

fun iter-len(i: Array[Int]) -> Int {
  Iterable:length(i)
}

fun iter-sum(i: Array[Int]) -> Int {
  Foldable:fold((acc, x) => acc + x, 0, i)
}

fun main() {
  ; Mappable:map with closure
  let nums = [1, 2, 3, 4, 5]
  let doubled = Mappable:map(x => x * 2, nums)
  write :display(doubled)  ; [2, 4, 6, 8, 10]

  ; Mappable:map on empty array
  let empty = []
  let mapped-empty = Mappable:map(x => x + 1, empty)
  write :display(mapped-empty)  ; []

  ; Mappable:map with named function
  let squares = Mappable:map(square, [1, 2, 3])
  write :display(squares)  ; [1, 4, 9]

  ; Filterable:filter with closure
  let evens = Filterable:filter(x => x % 2 == 0, nums)
  write :display(evens)  ; [2, 4]

  ; Filterable:filter on empty array
  let filtered-empty = Filterable:filter(x => x > 0, empty)
  write :display(filtered-empty)  ; []

  ; Filterable:filter with named function
  let positives = Filterable:filter(is-positive, [-1, 0, 1, 2])
  write :display(positives)  ; [1, 2]

  ; Filterable:filter keeping all
  let all-kept = Filterable:filter(x => true, [1, 2, 3])
  write :display(all-kept)  ; [1, 2, 3]

  ; Filterable:filter keeping none
  let none-kept = Filterable:filter(x => false, [1, 2, 3])
  write :display(none-kept)  ; []

  ; Foldable:fold with sum
  let sum = Foldable:fold((acc, x) => acc + x, 0, nums)
  write sum  ; 15

  ; Foldable:fold on empty array returns initial value
  let empty-sum = Foldable:fold((acc, x) => acc + x, 100, empty)
  write empty-sum  ; 100

  ; Foldable:fold with string concatenation
  let words = ["hello", " ", "world"]
  let combined = Foldable:fold((acc, s) => "{acc}{s}", "", words)
  write combined  ; "hello world"

  ; Foldable:fold with named function
  let total = Foldable:fold(add, 0, [1, 2, 3, 4])
  write total  ; 10

  ; `Foldable:fold-map` with `String` and `Array` outputs
  write Foldable:fold-map(x => "{x}", [1, 2, 3])
  let empty-fold-map: Array[Int] = Foldable:fold-map(x => [x], empty)
  write :display(empty-fold-map)
  write :display(Foldable:fold-map(x => [x, x * 10], [1, 2, 3]))

  ; Combining Array functions
  let result = Foldable:fold(
    (acc, x) => acc + x,
    0,
    Mappable:map(x => x * x, Filterable:filter(x => x % 2 == 1, [1, 2, 3, 4, 5]))
  )
  write result  ; 1 + 9 + 25 = 35

  ; Pipeline usage with Array functions (using wrapper closures)
  let piped = [1, 2, 3, 4, 5]
    |> (arr => Filterable:filter(x => x > 2, arr))
    |> (arr => Mappable:map(x => x * 10, arr))
  write :display(piped)  ; [30, 40, 50]

  ; Module functions can be passed as first-class values
  let filter-fn = Filterable:filter
  let data = [1, 2, 3, 4, 5]
  let filtered = filter-fn(x => x > 2, data)
  write :display(filtered)  ; [3, 4, 5]

  ; Mappable:map with Option results (homogeneous tagged values)
  let with-opts = Mappable:map(x => Option.Some(x), [1, 2, 3])
  write :display(with-opts)  ; [Option.Some(1), Option.Some(2), Option.Some(3)]

  ; Nested Mappable:map (callback uses Array function)
  let nested = [[1, 2], [3, 4]]
  let doubled-nested = Mappable:map(arr => Mappable:map(x => x * 2, arr), nested)
  write :display(doubled-nested)  ; [[2, 4], [6, 8]]

  ; === foreach ===

  ; foreach for side effects (outputs each element)
  write "foreach:"
  let fe-result = foreach(x => { write x }, [10, 20, 30])
  write :display(fe-result)  ; Unit

  ; foreach on empty array (no side effects)
  let fe-empty = foreach(x => { write x }, [])
  write :display(fe-empty)  ; Unit

  ; `foreach` with collected `Range`
  write "range foreach:"
  let fe-range = foreach(n => { write n }, Range.collect(1 .. 4))
  write :display(fe-range)  ; Unit

  ; === Array.zip ===

  let a = [1, 2, 3]
  let b = ["a", "b", "c"]
  let zipped = Array.zip(a, b)
  write :display(zipped)

  ; Shorter array determines length
  let short = [1, 2]
  let long = ["a", "b", "c", "d"]
  write :display(Array.zip(short, long))

  ; === Array.unzip ===

  let pairs: Array[(Int, String)] = [(1, "one"), (2, "two"), (3, "three")]
  let (unzip-nums, unzip-strs) = Array.unzip(pairs)
  write :display(unzip-nums)
  write :display(unzip-strs)

  ; Round-trip
  let x = [10, 20, 30]
  let y = [true, false, true]
  let (x2, y2) = Array.unzip(Array.zip(x, y))
  write :display(x2)
  write :display(y2)

  ; === Array.intersperse ===

  let inter-words = ["hello", "world", "!"]
  write :display(Array.intersperse(",", inter-words))

  let inter-nums = [1, 2, 3, 4]
  write :display(Array.intersperse(0, inter-nums))

  ; Empty array
  let inter-empty: Array[Int] = []
  write :display(Array.intersperse(0, inter-empty))

  ; Single element
  write :display(Array.intersperse(0, [42]))

  ; === Array.zip-with ===

  let xs = [1, 2, 3]
  let ys = [10, 20, 30]
  write :display(Array.zip-with(zip-add, xs, ys))

  ; With closure
  let multiplied = Array.zip-with((ma, mb) => ma * mb, [2, 3, 4], [5, 6, 7])
  write :display(multiplied)

  ; With shorter array
  write :display(Array.zip-with(zip-add, [1, 2, 3, 4, 5], [10, 20]))

  ; === Array.sort-by ===

  let unsorted = [3, 1, 4, 1, 5, 9, 2, 6]
  write :display(Array.sort-by(cmp-int, unsorted))
  write :display(Array.sort-by(Ord:compare, unsorted))

  ; Sort descending (reverse comparator)
  write :display(Array.sort-by(cmp-desc, unsorted))

  ; Sort by absolute value
  let signed = [-5, 3, -1, 4, -2]
  write :display(Array.sort-by(cmp-abs, signed))

  ; Sort objects by field
  let people = [
    { name: "Alice", age: 30 },
    { name: "Bob", age: 25 },
    { name: "Carol", age: 35 }
  ]
  let by-age = Array.sort-by(cmp-by-age, people)
  write :display(Mappable:map(p => p.name, by-age))

  ; === Array.contains ===

  write Array.contains([1, 2, 3], 2)
  write Array.contains([1, 2, 3], 9)
  write Array.contains([], 1)
  write Array.contains(["hello", "world"], "hello")

  ; Uses the user `Eq` instance, not representation equality
  let p2: Parity = 2
  let p4: Parity = 4
  let p5: Parity = 5
  write Array.contains([p2], p4)
  write Array.contains([p2], p5)

  let empty-ints: Array[Int] = []

  ; === Array Phase `2` additions ===

  write :display(Array.minimum(empty-ints))
  write :display(Array.minimum([3, 1, 4, 1, 5]))
  write :display(Array.maximum(empty-ints))
  write :display(Array.maximum([3, 1, 4, 1, 5]))

  let r1: Rank = 1
  let r3: Rank = 3
  let min-rank-id: Rank = Array.minimum([r1, r3]) ?? r1
  let max-rank-id: Rank = Array.maximum([r1, r3]) ?? r1
  let min-rank: Int = min-rank-id
  let max-rank: Int = max-rank-id
  write min-rank
  write max-rank

  write :display(Array.elem-index([10, 20, 10], 10))
  write :display(Array.elem-index([10, 20, 10], 99))
  write :display(Array.elem-index(empty-ints, 10))
  write :display(Array.elem-index([p5, p2], p4))

  ; === Array Phase `1` additions ===

  write :display(Array.last(empty-ints))
  write :display(Array.last([10, 20, 30]))

  write :display(Array.init(empty-ints))
  write :display(Array.init([42]))
  write :display(Array.init([1, 2, 3]))

  write :display(Array.uncons(empty-ints))
  write :display(Array.uncons([1, 2, 3]))

  write :display(Array.unsnoc(empty-ints))
  write :display(Array.unsnoc([1, 2, 3]))

  write :display(Array.take(-2, [1, 2, 3]))
  write :display(Array.take(2, [1, 2, 3]))
  write :display(Array.take(99, [1, 2, 3]))

  write :display(Array.drop(-2, [1, 2, 3]))
  write :display(Array.drop(2, [1, 2, 3]))
  write :display(Array.drop(99, [1, 2, 3]))

  write :display(Array.split-at(-2, [1, 2, 3]))
  write :display(Array.split-at(2, [1, 2, 3]))
  write :display(Array.split-at(99, [1, 2, 3]))

  write :display(Array.indexed(["a", "b", "c"]))
  write :display(Array.indexed(empty-ints))

  write :display(Array.singleton("one"))
  write :display(Array.cons(0, [1, 2, 3]))

  ; === Array Phase `4` additions ===

  write :display(Array.set-at([1, 2, 3], 1, 99))
  write :display(Array.set-at([1, 2, 3], -1, 99))
  write :display(Array.set-at([1, 2, 3], 9, 99))

  write :display(Array.remove-at([1, 2, 3], 1))
  write :display(Array.remove-at([1, 2, 3], -1))
  write :display(Array.remove-at([1, 2, 3], 9))

  write :display(Array.insert-at([1, 2, 3], -1, 99))
  write :display(Array.insert-at([1, 2, 3], 1, 99))
  write :display(Array.insert-at([1, 2, 3], 9, 99))

  write :display(Array.adjust-at(x => x * 10, [1, 2, 3], 1))
  write :display(Array.adjust-at(x => x * 10, [1, 2, 3], -1))
  write :display(Array.adjust-at(x => x * 10, [1, 2, 3], 9))
  write :display(Array.adjust-at(x => {
    write "adjust-at-called"
    x * 10
  }, empty-ints, 0))

  ; === Array Phase `5` additions ===

  write :display(Array.flatten([[1, 2], [], [3, 4]]))
  let flat-empty: Array[Int] = Array.flatten([])
  write :display(flat-empty)
  write :display(Array.flatten([[true], [false, true]]))

  let chunk-zero: Word = 0
  let chunk-two: Word = 2
  let chunk-big: Word = 99
  write :display(Array.chunks-of(chunk-zero, [1, 2, 3]))
  write :display(Array.chunks-of(chunk-two, [1, 2, 3, 4, 5]))
  write :display(Array.chunks-of(chunk-big, [1, 2, 3]))
  write :display(Array.chunks-of(chunk-two, empty-ints))

  let window-zero: Word = 0
  let window-two: Word = 2
  let window-three: Word = 3
  let window-big: Word = 99
  write :display(Array.windows(window-zero, [1, 2, 3]))
  write :display(Array.windows(window-two, [1, 2, 3, 4]))
  write :display(Array.windows(window-three, [1, 2]))
  write :display(Array.windows(window-big, [1, 2, 3]))
  write :display(Array.windows(window-two, empty-ints))

  write :display(Array.replicate(-2, "x"))
  write :display(Array.replicate(0, "x"))
  write :display(Array.replicate(3, "x"))
  write :display(Array.replicate(2, [1, 2]))

  ; === Array Phase `3` additions ===

  write Array.any(x => x > 3, [1, 2, 4])
  write Array.any(x => x > 3, [1, 2, 3])
  write Array.any(x => x > 0, empty-ints)

  write "array-any-short"
  write Array.any(x => {
    write x
    x == 2
  }, [1, 2, 3])

  write Array.all(x => x > 0, [1, 2, 3])
  write Array.all(x => x > 0, [1, 0, 2])
  write Array.all(x => x > 0, empty-ints)

  write "array-all-short"
  write Array.all(x => {
    write x
    x < 2
  }, [1, 2, 3])

  write :display(Array.find(x => x % 2 == 0, [1, 3, 4, 6]))
  write :display(Array.find(x => x % 2 == 0, [1, 3, 5]))
  write :display(Array.find(x => x % 2 == 0, empty-ints))

  write "array-find-short"
  write :display(Array.find(x => {
    write x
    x == 2
  }, [1, 2, 3]))

  write :display(Array.find-index(x => x % 2 == 0, [1, 3, 4, 6]))
  write :display(Array.find-index(x => x % 2 == 0, [1, 3, 5]))
  write :display(Array.find-index(x => x % 2 == 0, empty-ints))

  write "array-find-index-short"
  write :display(Array.find-index(x => {
    write x
    x == 2
  }, [1, 2, 3]))

  write :display(Array.find-indices(x => x % 2 == 0, [1, 2, 3, 4, 6]))
  write :display(Array.find-indices(x => x % 2 == 0, [1, 3, 5]))
  write :display(Array.find-indices(x => x % 2 == 0, empty-ints))

  write :display(Array.take-while(x => x < 4, [1, 2, 4, 3]))
  write :display(Array.take-while(x => x < 4, [1, 2, 3]))
  write :display(Array.take-while(x => x < 4, empty-ints))

  write "array-take-while-short"
  write :display(Array.take-while(x => {
    write x
    x < 2
  }, [1, 2, 3]))

  write :display(Array.drop-while(x => x < 4, [1, 2, 4, 3]))
  write :display(Array.drop-while(x => x < 4, [1, 2, 3]))
  write :display(Array.drop-while(x => x < 4, empty-ints))

  write "array-drop-while-short"
  write :display(Array.drop-while(x => {
    write x
    x < 2
  }, [1, 2, 3]))

  write :display(Array.span(x => x < 4, [1, 2, 4, 3]))
  write :display(Array.span(x => x < 4, [1, 2, 3]))
  write :display(Array.span(x => x < 4, empty-ints))

  write "array-span-short"
  write :display(Array.span(x => {
    write x
    x < 2
  }, [1, 2, 3]))

  write :display(Array.break(x => x >= 4, [1, 2, 4, 3]))
  write :display(Array.break(x => x >= 4, [1, 2, 3]))
  write :display(Array.break(x => x >= 4, empty-ints))

  write "array-break-short"
  write :display(Array.break(x => {
    write x
    x >= 2
  }, [1, 2, 3]))

  write :display(Array.partition(x => x % 2 == 0, [1, 2, 3, 4]))
  write :display(Array.partition(x => x % 2 == 0, empty-ints))

  write :display(Array.concat-map(x => [x, x * 10], [1, 2, 3]))
  let empty-concat: Array[Int] = Array.concat-map(x => [x], empty-ints)
  write :display(empty-concat)

  write :display(Array.map-option(
    x => if x % 2 == 0 { Option.Some(x * 10) } else { Option.None },
    [1, 2, 3, 4]
  ))
  write :display(Array.map-option(x => Option.None: Option[Int], [1, 2, 3]))
  let empty-options: Array[Int] = Array.map-option(
    x => Option.Some(x),
    empty-ints
  )
  write :display(empty-options)

  ; === Chained operations ===

  ; zip, map, filter chain
  let indices = [0, 1, 2, 3, 4]
  let values = [10, 25, 30, 15, 40]
  let indexed = Array.zip(indices, values)
  let chain-filtered = Filterable:filter(pair => pair.1 > 20, indexed)
  write :display(chain-filtered)

  ; zip-with to compute differences
  let before = [10, 20, 30]
  let after = [15, 18, 35]
  let diffs = Array.zip-with((db, da) => da - db, before, after)
  write :display(diffs)

  ; === Collected ranges with array constraints ===

  ; Collected ranges should satisfy `Iterable` constraints
  write iter-len(Range.collect(1 ..= 20))
  write iter-len([1, 2, 3, 4, 5])

  ; Collected ranges should satisfy `Foldable` constraints
  write iter-sum(Range.collect(1 ..= 5))
  write iter-sum([10, 20, 30])
}
