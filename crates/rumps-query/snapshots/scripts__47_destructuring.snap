---
source: crates/rumps-query/tests/scripts.rs
description: "; Destructuring bindings\n\n; === Tuple destructuring ===\n\nLET pair = (1, 2)\nLET (a, b) = pair\n@OUTPUT a\n@OUTPUT b\n\n; Nested tuple\nLET nested = ((1, 2), (3, 4))\nLET ((x1, y1), (x2, y2)) = nested\n@OUTPUT x1\n@OUTPUT y1\n@OUTPUT x2\n@OUTPUT y2\n\n; === Object destructuring ===\n\nLET person = { name: \"Alice\", age: 30 }\nLET { name, age } = person\n@OUTPUT name\n@OUTPUT age\n\n; Object with rename\nLET point = { x: 10, y: 20 }\nLET { x: px, y: py } = point\n@OUTPUT px\n@OUTPUT py\n\n; === Array destructuring ===\n\nLET arr = [1, 2, 3]\nLET [first, second, third] = arr\n@OUTPUT first\n@OUTPUT second\n@OUTPUT third\n\n; Array with rest (bind)\nLET nums = [1, 2, 3, 4, 5]\nLET [head, ...tail] = nums\n@OUTPUT head\n@OUTPUT tail\n\n; Array with rest (ignore)\nLET long = [10, 20, 30, 40, 50]\nLET [first2, second2, ..] = long\n@OUTPUT first2\n@OUTPUT second2\n\n; === Wildcard ===\n\nLET triple = (100, 200, 300)\nLET (keep, _, last) = triple\n@OUTPUT keep\n@OUTPUT last\n\n; Wildcard discards entire value\nLET _ = \"discarded\"\n@OUTPUT \"wildcard works\"\n\n; === Mixed nesting ===\n\nLET data = { coords: (10, 20), name: \"origin\" }\nLET { coords: (cx, cy), name: label } = data\n@OUTPUT cx\n@OUTPUT cy\n@OUTPUT label\n\n; === In expressions ===\n\nLET result = {\n  LET (x, y) = (5, 10)\n  x + y\n}\n@OUTPUT result\n\n@OUTPUT \"Destructuring test complete\"\n"
