source: crates/rumps-query/tests/scripts.rs
description: "; Let-bound method values instantiate and dispatch independently per use.\n\nimport Methods.{ map as imported-map, tag as imported-tag }\n\nvariant Wrapper = Wrapper(Int)\nvariant Label = Label(String)\nnewtype Score = Int\n\nclass MyInto[T] C {\n  fun convert(x: C) -> T\n}\n\nclass MyInto[Label] for Wrapper {\n  fun convert(x: Wrapper) -> Label {\n    match x {\n      Wrapper.Wrapper(n) => { Label.Label(\"w:{n}\") }\n    }\n  }\n}\n\nclass MyInto[Int] for Wrapper {\n  fun convert(x: Wrapper) -> Int {\n    match x {\n      Wrapper.Wrapper(n) => { n }\n    }\n  }\n}\n\nclass MyTag[T] C {\n  fun tag(x: C) -> String\n}\n\nclass MyTag[Label] for Wrapper {\n  fun tag(x: Wrapper) -> String {\n    match x {\n      Wrapper.Wrapper(n) => { \"label:{n}\" }\n    }\n  }\n}\n\nclass MyTag[Int] for Wrapper {\n  fun tag(x: Wrapper) -> String {\n    match x {\n      Wrapper.Wrapper(n) => { \"int:{n}\" }\n    }\n  }\n}\n\nclass MyMap F {\n  fun my-map[A, B](f: (A) -> B, x: F[A]) -> F[B]\n}\n\nclass MyMap for (T,) {\n  fun my-map(f, x) {\n    (x.0, f(x.1))\n  }\n}\n\nclass MyMap for (T, U,) {\n  fun my-map(f, x) {\n    (x.0, x.1, f(x.2))\n  }\n}\n\nclass MyFront F {\n  fun front-map[A, B](tag: (String, Int, Int), f: (A) -> B, x: F[A]) -> F[B]\n}\n\nclass MyFront for (T,) {\n  fun front-map(tag, f, x) {\n    (x.0, f(x.1))\n  }\n}\n\nclass MyFront for (T, U,) {\n  fun front-map(tag, f, x) {\n    (x.0, x.1, f(x.2))\n  }\n}\n\nclass MyLead F {\n  fun lead-map[A, B](n: Int, tag: (String, Int, Int), f: (A) -> B, x: F[A]) -> F[B]\n}\n\nclass MyLead for (T,) {\n  fun lead-map(n, tag, f, x) {\n    (x.0, f(x.1))\n  }\n}\n\nclass MyLead for (T, U,) {\n  fun lead-map(n, tag, f, x) {\n    (x.0, x.1, f(x.2))\n  }\n}\n\nclass FnMaker C {\n  fun make-fn(x: C) -> ((Int) -> Int)\n}\n\nclass FnMaker for Wrapper {\n  fun make-fn(x: Wrapper) -> ((Int) -> Int) {\n    (n: Int) -> Int => n + 100\n  }\n}\n\nfun id[T](x: T) -> T {\n  x\n}\n\nfun use-map(map: (((Int) -> Int), (String, Int)) -> (String, Int)) -> (String, Int) {\n  map(x => x + 5, (\"param\", 6))\n}\n\nfun use-front(map: ((String, Int, Int), ((Int) -> Int), (String, Int)) -> (String, Int)) -> (String, Int) {\n  map((\"not\", 1, 2), x => x + 9, (\"front\", 10))\n}\n\nfun main() {\n  let len = Iterable:length\n  write len([1, 2, 3])\n  write len(Range.collect(1 ..= 5))\n\n  let neg = Negatable:neg\n  write neg(5)\n  write neg(3.5)\n\n  let w = Wrapper.Wrapper(99)\n  let conv-label = MyInto[Label]:convert\n  let conv-int = MyInto[Int]:convert\n  write conv-label(w)\n  write conv-int(w)\n\n  let tag-label = MyTag[Label]:tag\n  let tag-int = MyTag[Int]:tag\n  write tag-label(w)\n  write tag-int(w)\n\n  let my-map = MyMap:my-map\n  let alias-map = my-map\n  write my-map(x => x + 1, (\"hello\", 42))\n  write my-map(x => x * 10, (1, \"two\", 3))\n  write alias-map(x => x + 2, (\"alias\", 40))\n\n  let inc-map = my-map(x => x + 1)\n  write inc-map((\"partial\", 4))\n\n  let id-map = id(MyMap:my-map)\n  write id-map(x => x + 6, (\"id\", 7))\n  write use-map(MyMap:my-map)\n  write use-front(MyFront:front-map)\n  let lead-map = MyLead:lead-map(1)\n  write lead-map((\"not\", 1, 2), x => x + 8, (\"lead\", 14))\n\n  let id-tag = id(MyTag[Label]:tag)\n  write id-tag(w)\n\n  let empty = Default[Option[Int]]:default\n  write empty()\n  let into-score = Into[Score]:into\n  let score = into-score(77)\n  write Into[Int]:into(score)\n  let try-int = TryInto[Int]:try-into\n  write try-int(\"42\")\n\n  let make-fn = FnMaker:make-fn\n  let made = make-fn(w)\n  write made(23)\n\n  let mod-map = Methods.map\n  write mod-map(x => x * 3, (\"module\", 7))\n  write imported-map(x => x + 4, (\"import\", 8))\n  write Methods.tag(w)\n  write imported-tag(w)\n}\n\nmodule Methods {\n  +let map = MyMap:my-map\n  +let tag = MyTag[Label]:tag\n}\n"
