; Test: string operations
; Tests string literals and concatenation

fun main() {
  ; Simple string
  let s = "Hello"
  write s
  ; Expected: Hello

  ; Empty string
  let empty = ""
  write empty
  ; Expected: (empty line)

  ; String with spaces
  let spaced = "Hello World"
  write spaced
  ; Expected: Hello World

  ; String concatenation (using interpolation)
  let a = "Hello"
  let b = "World"
  let c = "{a} {b}"
  write c
  ; Expected: Hello World

  ; Concatenate literals
  write "{"foo"}{"bar"}"
  ; Expected: foobar

  ; Concatenate with numbers (interpolation auto-coerces)
  write "Value: {42}"
  ; Expected: Value: 42

  write "Pi is {3.14}"
  ; Expected: Pi is 3.14

  ; Concatenate with booleans
  write "Flag is {true}"
  ; Expected: Flag is true

  ; Multiple concatenations
  let first = "one"
  let second = "two"
  let third = "three"
  write "{first}, {second}, {third}"
  ; Expected: one, two, three

  ; Escape sequences (if supported)
  let escaped = "Line1\nLine2"
  write escaped
  ; Expected: Line1 (newline) Line2

  let tabbed = "Col1\tCol2"
  write tabbed
  ; Expected: Col1 (tab) Col2

  let quoted = "He said \"Hello\""
  write quoted
  ; Expected: He said "Hello"

  write "String test complete"
}
